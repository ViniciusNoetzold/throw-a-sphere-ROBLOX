      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">FlightService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.ConfigFlight)
local Reveals = require(Shared.ConfigReveal)
local Events = require(Shared.ConfigEvents)
local Math = require(Shared.FlightMath)
local Variants = require(Shared.VariantMath)
local Flight = {}
local ctx: any
local sessions: {[Player]: any} = {}
local requests: {[Player]: number} = {}
local lastEncounters: {[Player]: string} = {}
local decisions: {[Player]: string} = {}
local rng = Random.new()
function Flight.IsActive(player: Player): boolean return sessions[player] ~= nil end

local function send(player: Player, payload: any)
    if player.Parent then ctx.Remotes.FlightUpdate:FireClient(player, payload) end
end
local function ready(player: Player): (any, BasePart?)
    local profile = ctx.Data.Get(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not profile or not ctx.Data.IsLoaded(player) or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return nil, nil end
    return profile, root
end
local function isReusable(profile: any, orb: any, benefits: any): boolean
    return (orb.IsPrismatic and benefits.EternalPrism == true)
        or (orb.Tier ~= nil and orb.Tier <= (profile.OrbTier or 0))
end
local function eligible(player: Player, profile: any): (boolean, any)
    local orb = Config.Orbs[profile.EquippedOrb]
    local benefits = ctx.Monetization.GetBenefits(player)
    if not orb or (orb.IsPrismatic and not benefits.EternalPrism) then return false, benefits end
    if not isReusable(profile, orb, benefits) and (profile.Orbs[profile.EquippedOrb] or 0) < 1 then return false, benefits end
    return ctx.Sanctuary.CanCapture(player), benefits
end
local function releaseStance(entry: any)
    local root = entry.Root
    if root and root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = entry.WasAnchored
    end
    local humanoid = entry.Humanoid
    if humanoid and humanoid.Parent then humanoid.AutoRotate = entry.WasAutoRotate end
end

function Flight.Prepare(player: Player, automatic: boolean?): boolean
    local now = Workspace:GetServerTimeNow()
    if now < (requests[player] or 0) then return false end
    requests[player] = now + 0.15
    if sessions[player] or ctx.Data.IsBusy(player) or (ctx.Training and ctx.Training.IsTraining(player)) then return false end
    local profile, root = ready(player)
    if not profile or not root then return false end
    if not Math.AtLine(root.Position, Rules.LinePosition, Rules.LineWidth, Rules.LineDepth) then return false end
    if ctx.EncounterPools and not ctx.EncounterPools[ctx.Layout.BiomeOrder[1]].Comum then
        requests[player] = now + 2
        send(player, {State = "Blocked", Message = "Abra a versão com os modelos da equipe."})
        return false
    end
    if not eligible(player, profile) then
        requests[player] = now + 1
        send(player, {State = "Blocked", Message = "Confira a orbe equipada e o espaço na coleção."})
        return false
    end
    if not automatic and profile.AutomationSettings and profile.AutomationSettings.Throw
        and ctx.Monetization.GetBenefits(player).AutoThrow then return false end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid then return false end
    local entry = {
        Id = HttpService:GenerateGUID(false), State = "Charging", StartedAt = now,
        Character = character, Root = root, WasAnchored = root.Anchored,
        Humanoid = humanoid, WasAutoRotate = humanoid.AutoRotate,
        Automatic = automatic == true,
    }
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    root.Anchored, humanoid.AutoRotate = true, false
    if CFrame then character:PivotTo(CFrame.lookAt(root.Position, root.Position + Rules.Direction)) end
    sessions[player] = entry
    decisions[player] = nil
    local order = ctx.Layout.BiomeOrder
    local maximum = Rules.MaxDistance or Rules.ZoneLength * #order
    local reach, unlocked = Math.Limit(maximum, order, Rules.ZoneLength, maximum, profile.Level, Rules.Milestones, ctx.EncounterPools)
    send(player, {State = "Charging", Id = entry.Id, StartedAt = now, Period = Rules.MeterPeriod,
        NextBiome = order[unlocked + 1], Goal = Rules.Milestones and Rules.Milestones[unlocked + 1],
        Level = profile.Level, Reach = reach})
    task.delay(Rules.ChargeTimeout, function() if sessions[player] == entry and entry.State == "Charging" then Flight.Cancel(player, entry.Id) end end)
    return true
end
function Flight.Cancel(player: Player, id: any): boolean
    local entry = sessions[player]
    if not entry or type(id) ~= "string" or #id > 80 or id ~= entry.Id then return false end
    -- Rollback is only allowed before resolution; a client can never refund an awarded drop.
    local profile = ctx.Data.Get(player)
    if entry.State == "Flying" then
        if profile and entry.Consumed then profile.Orbs[entry.OrbId] = (profile.Orbs[entry.OrbId] or 0) + entry.Count end
        ctx.Data.Unlock(player, entry.Owner)
        player:SetAttribute("FlightInProgress", false)
        ctx.Data.MarkDirty(player)
        ctx.Data.Sync(player)
    elseif entry.State == "Resolving" then return false end
    sessions[player] = nil
    releaseStance(entry)
    send(player, {State = "Cancelled", Id = id})
    return true
end
local function finish(player: Player, entry: any)
    if sessions[player] ~= entry or entry.State ~= "Flying" then return end
    local profile, root = ready(player)
    if not profile or not root or player.Character ~= entry.Character then Flight.Cancel(player, entry.Id); return end
    entry.State = "Resolving"
    local drops = {}
    local ok, result = pcall(function()
        local benefits = ctx.Monetization.GetBenefits(player)
        local bundle, best, totalXP = {}, nil, 0
        local previous = lastEncounters[player]
        local quality = entry.Power * .55 + entry.ZoneProgress * .45
        for _ = 1, entry.Count do
            -- Species is rolled here, after the flight. Never accepted from a client.
            local id, chance
            if ctx.EncounterPools then
                id, chance = Math.Encounter(ctx.EncounterPools[entry.BiomeId], Rules.RarityDenominators, rng, entry.RareBoost, previous)
            else
                id, chance = Math.Species(Config.Creatures, entry.BiomeId, Events.SpeciesWeights, rng:NextNumber(), quality, previous)
            end
            assert(id, "Biome has no eligible creatures")
            previous = id
            local definition = Config.Creatures[id]
            local orb = Config.Orbs[entry.OrbId]
            local strengthBonus = math.min(.6, entry.Strength / (20 + entry.ZoneIndex * 14) * .32)
            local aim = 1 + entry.Power * .35 + entry.ZoneProgress * .15 + strengthBonus + (if entry.Perfect then .2 else 0)
            local luck = ctx.Gameplay.GetLuck(profile, benefits, ctx.Weather.GetLuckMultiplier(), os.time())
            local elemental = if (entry.OrbId == "Rubi" and definition.Element == "Fogo") or (entry.OrbId == "Safira" and (definition.Element == "Agua" or definition.Element == "Gelo")) then 1.1 else 1
            local probability = Config.CalculateShakeProbability(orb.Power * elemental, aim, luck, definition.Difficulty, orb.IsMaster)
            local shakes = 0
            for shake = 1, 3 do if probability >= 1 or rng:NextNumber() < probability then shakes = shake else break end end
            local captured = shakes == 3
            local variantLuck = luck * math.sqrt(entry.RareBoost)
            local mutation, mutationChance = Variants.FromQuantile(Config.Mutations, variantLuck, rng:NextNumber())
            local size, sizeChance = Variants.FromQuantile(Config.Sizes, variantLuck, rng:NextNumber())
            local combinationChance = chance * (mutationChance or 1) * (sizeChance or 1)
            local income = math.floor(definition.BaseIncomePerSec * mutation.Multiplier * size.Multiplier)
            local xp = if captured then definition.BaseXP else math.max(5, math.floor(definition.BaseXP * 0.35)) + (if entry.Perfect then 15 else 0)
            local fragments = 0
            if captured then
                local record = {Uid = HttpService:GenerateGUID(false), CreatureId = id, Mutation = mutation.Name, Size = size.Name, IncomePerSec = income, CapturedAt = os.time(), FusionStage = 0, SpawnChance = combinationChance}
                assert(ctx.Sanctuary.AddCapture(player, record), "Reserved inventory capacity was lost")
                table.insert(drops, record)
                profile.TotalCaptures += 1
                profile.PityBonus = 0
                ctx.Rewards.OnProgress(player, "Captures", 1)
            else
                profile.PityBonus = math.min(1, profile.PityBonus + 0.05)
                fragments = ctx.Drops.AwardFailureFragments(player)
            end
            if entry.Perfect then ctx.Rewards.OnProgress(player, "Criticals", 1) end
            local _, gained = ctx.Progression.GrantXP(player, xp)
            totalXP += gained
            local item = {Thrower = player, CreatureId = id, CreatureName = definition.Name, Rarity = definition.Rarity,
                Captured = captured, ShakesPassed = shakes, MutationName = mutation.Name, SizeName = size.Name,
                IncomePerSec = income, XPGained = gained, FragmentsGained = fragments, Probability = probability, SpawnChance = combinationChance}
            table.insert(bundle, item)
            if not best or Reveals[item.Rarity].Rank > Reveals[best.Rarity].Rank then best = item end
        end
        best = table.clone(best)
        best.Bundle, best.XPGained = bundle, totalXP
        best.FlightId, best.HitPos, best.StartPos = entry.Id, entry.EndPos, entry.StartPos
        best.OrbColor, best.Distance, best.BiomeId, best.OrbId = entry.Color, entry.Distance, entry.BiomeId, entry.OrbId
        best.IsCritical, best.IsLongShot = entry.Perfect, false
        best.NextBiome, best.NextMilestone = entry.NextBiome, entry.NextMilestone
        best.RareBoost = entry.RareBoost
        best.NewLevel, best.LeveledUp = profile.Level, profile.Level > entry.Level
        best.PresentationDuration = (Rules.CaptureIntroSeconds or 3.1) + Reveals[best.Rarity].Duration
        return best
    end)
    player:SetAttribute("FlightInProgress", false)
    if not ok then
        -- A partial award must never be refunded or retried. Preserve it and freeze writes.
        sessions[player] = nil
        releaseStance(entry)
        ctx.Data.Freeze(player, "Não foi possível concluir a revelação com segurança. Entre novamente.")
        send(player, {State = "Cancelled", Id = entry.Id})
        warn("[FlightService] Resolution failed:", result)
        return
    end
    ctx.Data.MarkDirty(player)
    local saved = ctx.Data.SaveNow(player)
    if not saved then
        sessions[player] = nil
        releaseStance(entry)
        ctx.Data.Freeze(player, "Não foi possível salvar o resultado do arremesso.")
        send(player, {State = "Cancelled", Id = entry.Id})
        return
    end
    lastEncounters[player] = result.CreatureId
    ctx.Data.Unlock(player, entry.Owner)
    entry.State = "Revealing"
    for _, record in drops do
        local dropped, problem = pcall(ctx.Drops.OnCapture, player, record, entry.StartPos)
        if not dropped then warn("[FlightService] Drop visual failed:", problem) end
    end
    ctx.Data.Sync(player)
    send(player, {State = "Landed", Id = entry.Id, Result = result, Automatic = entry.Automatic})
    ctx.Remotes.ThrowResult:FireAllClients(result)
    task.delay(result.PresentationDuration + 0.3, function()
        if sessions[player] == entry then
            sessions[player] = nil
            releaseStance(entry)
            if not entry.Automatic then decisions[player] = entry.Id end
            send(player, {State = "Ready", Id = entry.Id})
        end
    end)
end
function Flight.Launch(player: Player, id: any, automatic: boolean?): boolean
    local entry = sessions[player]
    if not entry or entry.State ~= "Charging" or type(id) ~= "string" or #id > 80 or id ~= entry.Id then return false end
    local now = Workspace:GetServerTimeNow()
    local elapsed = now - entry.StartedAt
    if elapsed < 0.1 then send(player, {State = "Charging", Id = entry.Id, StartedAt = entry.StartedAt, Period = Rules.MeterPeriod}); return false end
    if elapsed > Rules.ChargeTimeout or ctx.Data.IsBusy(player) then Flight.Cancel(player, id); return false end
    local profile, root = ready(player)
    if not profile or not root or entry.Character ~= player.Character or not Math.AtLine(root.Position,Rules.LinePosition,Rules.LineWidth,Rules.LineDepth) then Flight.Cancel(player, id); return false end
    local valid, benefits = eligible(player, profile)
    if not valid then Flight.Cancel(player, id); return false end
    local owner = "Flight:" .. entry.Id
    if not ctx.Data.TryLock(player, owner) then Flight.Cancel(player, id); return false end
    local orbId, orb = profile.EquippedOrb, Config.Orbs[profile.EquippedOrb]
    local infinite = isReusable(profile, orb, benefits)
    local capacity = Config.Constants.MaxInventoryCreatures - ctx.Data.GetInventoryCount(profile)
    local count = math.min(if benefits.TripleThrow then 3 else 1, capacity, if infinite then 3 else profile.Orbs[orbId])
    local power = if automatic then 0.75 else Math.Power(elapsed, Rules.MeterPeriod)
    local raw = Math.Distance(profile.ThrowStrength, profile.Level, orb.Power, power, benefits.TitanArms)
    local order = ctx.Layout.BiomeOrder
    local maximum = Rules.MaxDistance or Rules.ZoneLength * #order
    local reach, unlocked = Math.Limit(maximum, order, Rules.ZoneLength, maximum, profile.Level, Rules.Milestones, ctx.EncounterPools)
    local levelDistance = if Rules.Milestones then Math.LevelDistance(unlocked, Rules.ZoneLength, power) else 0
    local distance = math.min(reach, raw + levelDistance)
    local biome, zoneIndex, zoneProgress = Math.Zone(distance, ctx.Layout.BiomeOrder, Rules.ZoneLength)
    entry.State, entry.Owner, entry.OrbId, entry.Consumed, entry.Count = "Flying", owner, orbId, not infinite, count
    entry.Power, entry.Perfect, entry.Distance, entry.BiomeId = power, power >= Rules.PerfectThreshold, distance, biome
    entry.Strength, entry.ZoneIndex, entry.ZoneProgress = profile.ThrowStrength, zoneIndex, zoneProgress
    entry.RareBoost = Math.RareBoost(distance, Rules.MaxDistance or Rules.ZoneLength * #order, power, orb.RareBoost)
    if Rules.Milestones then
        entry.NextBiome = order[unlocked + 1]
        entry.NextMilestone = Rules.Milestones[unlocked + 1]
    end
    entry.StartPos, entry.EndPos, entry.Color = root.Position + Vector3.new(0, 2, 0), Rules.LaunchOrigin + Rules.Direction * distance, orb.Color
    entry.Level = profile.Level
    entry.Duration = Rules.WindupSeconds + math.clamp(3.5 + distance / 500, Rules.MinFlightSeconds, Rules.MaxFlightSeconds)
    if player.Character and CFrame then player.Character:PivotTo(CFrame.lookAt(root.Position,root.Position+Rules.Direction)) end
    if not infinite then profile.Orbs[orbId] -= count end
    player:SetAttribute("FlightInProgress", true)
    ctx.Data.MarkDirty(player)
    ctx.Data.Sync(player, true)
    send(player, {State = "Flying", Id = id, StartedAt = now, Duration = entry.Duration, StartPos = entry.StartPos,
        EndPos = entry.EndPos, Power = power, Perfect = entry.Perfect, Distance = distance, BiomeId = biome, Color = orb.Color, OrbId = orbId, OrbRareBoost = orb.RareBoost, Count = count})
    ctx.Remotes.ThrowWindup:FireAllClients({Thrower=player,Power=power,Style=Math.ThrowStyle(power),StartedAt=now})
    task.delay(entry.Duration, function() finish(player, entry) end)
    return true
end
function Flight.AutoThrow(player: Player): boolean
    if not ctx.Monetization.GetBenefits(player).AutoThrow then return false end
    if not Flight.Prepare(player, true) then return false end
    local entry = sessions[player]
    task.delay(0.2, function() if sessions[player] == entry then Flight.Launch(player, entry.Id, true) end end)
    return true
end
function Flight.Choose(player: Player, id: any, choice: any): boolean
    if type(id) ~= "string" or #id > 80 or decisions[player] ~= id or sessions[player] then return false end
    if choice ~= "Retry" and choice ~= "Base" then return false end
    local profile, root = ready(player)
    if not profile or not root or ctx.Data.IsBusy(player) or (ctx.Training and ctx.Training.IsTraining(player)) then return false end
    if not Math.AtLine(root.Position, Rules.LinePosition, Rules.LineWidth, Rules.LineDepth) then return false end
    if choice == "Base" then
        local position = ctx.World.GetSanctuaryReturnPosition(player)
        if not position or not player.Character then return false end
        player.Character:PivotTo(CFrame.new(position))
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        player:SetAttribute("CurrentBiome", "Hub")
    end
    decisions[player] = nil
    send(player, {State = "ChoiceAccepted", Id = id, Choice = choice})
    return true
end
function Flight.Init(context: any)
    ctx = context
    ctx.Layout = ctx.Layout or require(Shared.ConfigWorld)
    ctx.Remotes.PrepareThrow.OnServerEvent:Connect(function(player) Flight.Prepare(player) end)
    ctx.Remotes.LaunchThrow.OnServerEvent:Connect(function(player, id) Flight.Launch(player, id, false) end)
    ctx.Remotes.CancelThrow.OnServerEvent:Connect(function(player, id)
        local entry = sessions[player]
        -- Flight cannot be cancelled/refunded remotely after launch.
        if entry and entry.State == "Charging" then Flight.Cancel(player, id) end
    end)
    ctx.Remotes.ChooseAfterThrow.OnServerEvent:Connect(function(player, id, choice)
        if decisions[player] == id and id ~= nil and not Flight.Choose(player, id, choice) then
            send(player, {State = "ChoiceRejected", Id = id})
        end
    end)
    local function bind(player: Player)
        player.CharacterRemoving:Connect(function()
            decisions[player] = nil
            local entry = sessions[player]
            if entry then Flight.Cancel(player, entry.Id) end
        end)
    end
    Players.PlayerAdded:Connect(bind)
    for _, player in Players:GetPlayers() do bind(player) end
    Players.PlayerRemoving:Connect(function(player)
        local entry = sessions[player]
        if entry then Flight.Cancel(player, entry.Id) end
        requests[player], decisions[player], lastEncounters[player] = nil, nil, nil
    end)
end
return Flight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">FlightWorldService</string>
          <string name="Source"><![CDATA[--!strict
-- Grounded course geometry. Distance marks use the same zone lengths as flight resolution.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Rules = require(ReplicatedStorage.Shared.ConfigFlight)
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.ConfigWorld)
local World = {}
function World.Init(ctx: any)
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "FlightCorridor", workspace
    local function part(name: string, size: Vector3, position: Vector3, color: Color3, neon: boolean?): Part
        local p = Instance.new("Part")
        p.Name, p.Size, p.Position, p.Color = name, size, position, color
        p.Anchored, p.TopSurface = true, Enum.SurfaceType.Studs
        if neon then
            p.Material = Enum.Material.Neon
            p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
        end
        p.Parent = folder
        return p
    end
    local charcoal = Color3.fromRGB(42, 49, 61)
    local cream = Color3.fromRGB(255, 247, 202)
    local yellow = Color3.fromRGB(255, 199, 52)
    local function sign(beam: Part, caption: string, ink: Color3)
        local plate = part("CourseSign", Vector3.new(28, 1.9, .32),
            beam.Position + Vector3.new(0, .32, beam.Size.Z / 2 + .16), charcoal)
        plate.CanCollide, plate.CanTouch, plate.CanQuery = false, false, false
        local panel = Instance.new("SurfaceGui")
        panel.Name, panel.Face, panel.LightInfluence = "CourseLettering", Enum.NormalId.Back, .12
        panel.CanvasSize, panel.Parent = Vector2.new(560, 52), plate
        local text = Instance.new("TextLabel")
        text.Size, text.BackgroundTransparency, text.Parent = UDim2.fromScale(1, 1), 1, panel
        text.Text, text.TextColor3, text.TextScaled = caption, ink, true
        text.Font = Enum.Font.GothamBlack
    end
    local line = Rules.LinePosition
    local stone = Color3.fromRGB(128, 135, 137)
    part("CorridorEarth", Vector3.new(164, 51, Rules.MaxDistance + 30),
        Rules.LaunchOrigin + Vector3.new(0, -29, 10 - (Rules.MaxDistance + 30) / 2), Color3.fromRGB(106, 75, 52))
    for step = 0, 7 do
        for _, side in {-1, 1} do
            part("LaunchPathTile", Vector3.new(14.8, .34, 14.8), Vector3.new(side * 7.5, -.01, -98 + step * 15),
                if (step + side) % 3 == 0 then stone:Lerp(charcoal, .24) else stone)
        end
    end
    local pad = part("YellowLaunchLine", Vector3.new(Rules.LineWidth, .4, Rules.LineDepth), line + Vector3.new(0, -1.75, 0), yellow)
    pad.TopSurface = Enum.SurfaceType.Studs
    part("LaunchApron", Vector3.new(74, 1, 30), line + Vector3.new(0, -2.5, 12), charcoal)
    for _, side in {-1, 1} do
        part("StripeEdge", Vector3.new(Rules.LineWidth, .07, 1.1), pad.Position + Vector3.new(0, .22, side * (Rules.LineDepth / 2 - 1)), cream, true)
        part("ArchFoot", Vector3.new(6, 1, 7), line + Vector3.new(side * 33, -1.25, -6), charcoal)
        part("ArchTower", Vector3.new(4.5, 16, 4.5), line + Vector3.new(side * 33, 6, -6), Color3.fromRGB(252, 144, 64))
        part("ArchLight", Vector3.new(1.5, 11, .55), line + Vector3.new(side * 33, 6, -3.4), cream, true)
    end
    local arch = part("LaunchArch", Vector3.new(70, 3.3, 4.5), line + Vector3.new(0, 14.5, -6), charcoal)
    part("ArchCornice", Vector3.new(74, .9, 5.8), arch.Position + Vector3.new(0, 1.85, 0), stone)
    part("ArchInlay", Vector3.new(38, .72, .24), arch.Position + Vector3.new(0, -1.15, 2.3), yellow, true)
    sign(arch, "PISTA DE ORBES", cream)
    for _, x in {-20, 0, 20} do
        for _, side in {-1, 1} do
            local arrow = part("LaunchChevron", Vector3.new(.65, .06, 4), pad.Position + Vector3.new(x + side * 1.25, .24, 4), charcoal, true)
            arrow.Material = Enum.Material.SmoothPlastic
            arrow.CFrame *= CFrame.Angles(0, math.rad(side * 48), 0)
        end
    end
    local barrier = part("PlayerBarrier", Vector3.new(68, 80, 3), Rules.LaunchOrigin + Vector3.new(0, 36, -2), Color3.new(1, 1, 1))
    barrier.Transparency, barrier.CanQuery = 1, false
    -- Physical barrier plus server correction: the track is reserved for the orb.
    if not ctx.DisableLoops then task.spawn(function()
        while folder.Parent do
            task.wait(0.15)
            for _, player in Players:GetPlayers() do
                local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") then
                    local p=root.Position
                    if p.Y >= -7 and math.abs(p.X)<36 and p.Z<Rules.LaunchOrigin.Z-1 and p.Z>Rules.LaunchOrigin.Z-Rules.MaxDistance-30 then
                        player.Character:PivotTo(CFrame.lookAt(Rules.LinePosition+Vector3.new(0,2,3),Rules.LinePosition+Vector3.new(0,2,-20)))
                        root.AssemblyLinearVelocity=Vector3.zero
                    end
                end
            end
        end
    end) end
    local accents = {
        Color3.fromRGB(156, 214, 88), Color3.fromRGB(111, 229, 200),
        Color3.fromRGB(250, 144, 70), Color3.fromRGB(165, 223, 250),
        Color3.fromRGB(232, 186, 104), Color3.fromRGB(178, 140, 239),
    }
    local white = Color3.fromRGB(243, 236, 211)
    for index, id in Layout.BiomeOrder do
        local biome = Layout.Biomes[id]
        local palette = biome.Colors
        local origin = Rules.LaunchOrigin + Rules.Direction * ((index - 1) * Rules.ZoneLength)
        local accent = accents[index]
        local masonry = charcoal:Lerp(accent, .24)
        local road = charcoal:Lerp(accent, .34)
        local segments = math.ceil(Rules.ZoneLength / Layout.TileSize)
        local step = Rules.ZoneLength / segments
        part("RoadFoundation_" .. id, Vector3.new(70, 1.8, Rules.ZoneLength),
            origin + Vector3.new(0, -3.02, -Rules.ZoneLength / 2), masonry)
        for segment = 0, segments - 1 do
            local center = origin + Vector3.new(0, -2.46, -(segment + .5) * step)
            for _, side in {-1, 1} do
                local tileColor = if (segment + side) % 3 == 0 then road:Lerp(white, .1) else road
                part("Runway_" .. id, Vector3.new(23.7, 1.1, step - .14), center + Vector3.new(side * 12, 0, 0), tileColor)
                part("ShoulderPaver", Vector3.new(8.2, .8, step - .2), center + Vector3.new(side * 28.2, .05, 0),
                    if (segment + side) % 3 == 1 then accent:Lerp(masonry, .32) else masonry)
                part("Kerb", Vector3.new(1.1, .22, step - .22), center + Vector3.new(side * 24.1, .57, 0),
                    if segment % 2 == 0 then accent else white)
                if segment % 2 == 0 then
                    part("TrackReflector", Vector3.new(.9, .09, 2.1), center + Vector3.new(side * 23, .59, 0), accent, true)
                end
            end
            local dash = part("CenterDash", Vector3.new(1.15, .05, 11), center + Vector3.new(0, .58, 0), white)
            dash.CanCollide, dash.CanTouch, dash.CanQuery = false, false, false
        end
        for _, side in {-1, 1} do
            local mid = origin + Vector3.new(side * 34.8, 0, -Rules.ZoneLength / 2)
            part("TunnelWall_" .. id, Vector3.new(4.4, 28, Rules.ZoneLength), mid + Vector3.new(0, 11, 0), masonry)
            part("WallBase", Vector3.new(5.1, 4, Rules.ZoneLength), mid + Vector3.new(0, 0, 0), charcoal)
            part("WallCornice", Vector3.new(6, 1.6, Rules.ZoneLength), mid + Vector3.new(0, 25, 0), road)
            part("WallRibbon", Vector3.new(.35, .65, Rules.ZoneLength), mid + Vector3.new(-side * 2.3, 5.4, 0), accent)
            for section = 1, 6 do
                local length = Rules.ZoneLength / 6
                local middle = origin + Vector3.new(0, 0, -(section - .5) * length)
                local wallTile = part("TunnelStudPanel", Vector3.new(.65, 17.4, length - 1.2),
                    middle + Vector3.new(side * 32.5, 14, 0), masonry:Lerp(accent, if section % 2 == 0 then .13 else .05))
                if side == 1 then wallTile.LeftSurface = Enum.SurfaceType.Studs else wallTile.RightSurface = Enum.SurfaceType.Studs end
                part("WallButtress", Vector3.new(3.7, 25, 3.2), middle + Vector3.new(side * 33, 11, length / 2 - 1.6), charcoal)
                local hill = 30 + (section * 7 + index * 3) % 13
                part("Hillside", Vector3.new(38, hill + 9, length),
                    middle + Vector3.new(side * 57.3, (hill - 9) / 2, 0), masonry:Lerp(palette[2], .35))
                part("HillsideCap", Vector3.new(38, 1.4, length), middle + Vector3.new(side * 57.3, hill + .2, 0),
                    accent:Lerp(masonry, .46))
            end
            for n = 1, 4 do
                local position = origin + Vector3.new(side * 28.6, -1.72, -n * Rules.ZoneLength / 5)
                part("LandmarkPedestal", Vector3.new(7, 1.15, 12), position, masonry)
                if index == 1 then
                    part("TreeTrunk", Vector3.new(1.7, 5.9, 1.7), position + Vector3.new(0, 3, 0), Color3.fromRGB(136, 90, 58))
                    for layer = 1, 3 do
                        local width = 7.7 - layer * 1.45
                        part("TreeLeaves", Vector3.new(width, 1.7, width), position + Vector3.new(0, 3.6 + layer * 1.5, 0),
                            accent:Lerp(palette[2], (4 - layer) * .23))
                    end
                    for _, offset in {-3, 3} do
                        part("FlowerBlock", Vector3.new(1.5, .8, 1.5), position + Vector3.new(side, .85, offset),
                            if offset < 0 then Color3.fromRGB(255, 197, 85) else Color3.fromRGB(240, 134, 159))
                    end
                elseif index == 2 then
                    local stem = part("MushroomStem", Vector3.new(2, 5.7, 2), position + Vector3.new(0, 3, 0), white)
                    stem.TopSurface = Enum.SurfaceType.Smooth
                    local cap = part("MushroomCap", Vector3.new(7, 2.8, 7), position + Vector3.new(0, 6.15, 0), accent)
                    cap.Shape = Enum.PartType.Ball
                    part("MushroomGlow", Vector3.new(2, .85, 2), position + Vector3.new(0, 7.35, 0), accent, true).Shape = Enum.PartType.Ball
                elseif index == 3 then
                    for layer = 1, 4 do
                        local width = 7 - layer * 1.25
                        part("BasaltStratum", Vector3.new(width, 1.65, width + 1), position + Vector3.new(0, layer * 1.55, 0),
                            if layer == 2 then road else charcoal)
                    end
                    part("EmberCore", Vector3.new(1.35, .6, 1.35), position + Vector3.new(0, 7.25, 0), accent, true)
                elseif index == 4 then
                    for blade = -1, 1 do
                        local shard = part("IceBlade", Vector3.new(1.8, 6.5 - math.abs(blade) * 2.6, 1.8),
                            position + Vector3.new(blade * 1.5, 3 - math.abs(blade), blade * 2.4), accent:Lerp(white, math.abs(blade) * .33))
                        shard.CFrame *= CFrame.Angles(0, math.rad(45), blade * .2)
                    end
                elseif index == 5 then
                    for _, offset in {-3, 3} do
                        part("RuinColumn", Vector3.new(2.1, 7.2, 2.1), position + Vector3.new(0, 3.8, offset), accent)
                    end
                    part("RuinLintel", Vector3.new(2.5, 1.2, 8.8), position + Vector3.new(0, 7.5, 0), accent:Lerp(white, .25))
                else
                    part("GeodeBase", Vector3.new(5, 3.8, 6), position + Vector3.new(0, 1.9, 0), charcoal)
                    for point = -1, 1 do
                        local crystal = part("CosmicGeode", Vector3.new(1.8, 4.5 - math.abs(point), 1.8),
                            position + Vector3.new(0, 3.1, point * 2.2), accent, true)
                        crystal.CFrame *= CFrame.Angles(point * .28, math.rad(45), side * .25)
                    end
                end
            end
        end
        if index > 1 then
            local gate = part("Gate_" .. id, Vector3.new(72, 3.2, 3.7), origin + Vector3.new(0, 23.8, 0), masonry, true)
            gate.Material = Enum.Material.SmoothPlastic
            for _, side in {-1, 1} do
                part("GatePost", Vector3.new(3, 24, 3.5), origin + Vector3.new(34 * side, 10, 0), accent, true)
                part("GateCapital", Vector3.new(5, 1.6, 5.4), origin + Vector3.new(34 * side, 22, 0), accent)
            end
            sign(gate, Config.Biomes[id].Name, white)
        end
        task.wait()
    end
    part("TrackBackstop", Vector3.new(74, 40, 9), Rules.LaunchOrigin + Rules.Direction * (Rules.MaxDistance + 5)
        + Vector3.new(0, 14, 0), charcoal)
end
return World
]]></string>
