  <Item class="ServerScriptService" referent="68">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="69">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Services = script.Parent.Services
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local FlightRules = require(Shared.ConfigFlight)
local FlightMath = require(Shared.FlightMath)
local Layout = require(Shared.ConfigWorld)
local meshFolder = Shared:WaitForChild("CreatureMeshes")
local encounterCreatures: typeof(Config.Creatures) = {}
local authoredCreatures: {[string]: boolean} = {}
for id, definition in Config.Creatures do
    local source = meshFolder:FindFirstChild(id)
    if source and source:IsA("ModuleScript") then
        authoredCreatures[id] = true
        encounterCreatures[id] = definition
    end
end
local ctx: any = {
    Remotes = Remotes,
    EncounterCreatures = encounterCreatures,
    AuthoredCreatures = authoredCreatures,
    EncounterPools = FlightMath.BuildPools(encounterCreatures, Layout.BiomeOrder, FlightRules.RegionalArt),
    Layout = Layout,
    FlightMath = FlightMath,
    FlightRules = FlightRules,
    Gameplay = require(ReplicatedStorage.Shared.GameplayMath),
    Data = require(Services.DataService),
    World = require(Services.WorldService),
    Spawn = require(Services.SpawnService),
    Sanctuary = require(Services.SanctuaryService),
    Progression = require(Services.ProgressionService),
    Capture = require(Services.CaptureService),
    Flight = require(Services.FlightService),
    Training = require(Services.TrainingService),
    Biomes = require(Services.BiomeService),
    Weather = require(Services.WeatherEventService),
    Boss = require(Services.BossService),
    Rewards = require(Services.RewardService),
    Fusion = require(Services.FusionService),
    Automation = require(Services.AutomationService),
    Monetization = require(Services.MonetizationService),
    Trade = require(Services.TradeService),
    Auctions = require(Services.AuctionService),
    Leaderboards = require(Services.LeaderboardPodiumService),
    Drops = require(Services.DropService),
}

-- Register every callback before asynchronous profile loads start.
-- Recover transactions before benefits, offline income and world assignment.
ctx.World.Init(ctx)
require(Services.FlightWorldService).Init(ctx)
ctx.Biomes.Init(ctx)
ctx.Boss.Init(ctx)
ctx.Weather.Init(ctx)
ctx.Spawn.Init(ctx)
ctx.Trade.Init(ctx)
ctx.Auctions.Init(ctx)
ctx.Monetization.Init(ctx)
ctx.Sanctuary.Init(ctx.Data, ctx.World, ctx)
ctx.Progression.Init(ctx.Data, ctx.Sanctuary, Remotes, ctx)
ctx.Rewards.Init(ctx)
ctx.Fusion.Init(ctx)
ctx.Capture.Init(ctx)
ctx.Flight.Init(ctx)
ctx.Training.Init(ctx)
ctx.Automation.Init(ctx)
ctx.Drops.Init(ctx)
ctx.Leaderboards.Init(ctx)
ctx.Data.AddSnapshotProvider(function(player: Player, profile: any)
    local benefits = ctx.Monetization.GetBenefits(player)
    return {
        EffectiveLuck = ctx.Gameplay.GetLuck(profile, benefits, ctx.Weather.GetLuckMultiplier(), os.time()),
        MaxRange = ctx.Gameplay.GetRange(profile, benefits),
        SlotCapacity = ctx.Gameplay.GetSlotCapacity(profile, benefits),
    }
end)
ctx.Data.Init(Remotes)
print("[ThrowASphere] Base integrada: captura, progressão, recompensas, mundo e economia.")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="70">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">AuctionService</string>
          <string name="Source"><![CDATA[--!strict
-- Room-local 120s auctions. Assets/coins are durably escrowed; the same
-- coordinator decision as trades makes settlement and recovery idempotent.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Settings = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigGameplay"))

local Auction = {}
local ctx: any
local initialized = false
local lots: { [string]: any } = {}
local refunds: { any } = {}
local lastAction: { [Player]: number } = {}

local function copy(value: any): any
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in value do result[key] = copy(child) end
	return result
end

local function money(value: any): boolean
	return type(value) == "number" and value == value and value > 0 and value < math.huge and value % 1 == 0
end

local function feedback(player: Player, message: string, success: boolean?)
	local remote = ctx.Remotes:FindFirstChild("ActionFeedback")
	if remote and player.Parent then remote:FireClient(player, {Message = message, Kind = if success then "Success" else "Error"}) end
end

local function eligible(player: Player): boolean
	local profile = ctx.Data.Get(player)
	return ctx.Data.IsLoaded(player) and profile ~= nil and profile.Level >= 15 and ctx.Biomes and ctx.Biomes.IsInTradingPlaza(player)
end

local function syncAll()
	for _, player in Players:GetPlayers() do if ctx.Data.Get(player) then ctx.Data.Sync(player) end end
end

local function usedInventory(profile: any): number
	return if ctx.Data.GetInventoryCount then ctx.Data.GetInventoryCount(profile) else #profile.CapturedCreatures
end

function Auction.GetSnapshot(player: Player): any
	local result = {}
	for id, lot in lots do
		table.insert(result, {
			AuctionId = id, Creature = copy(lot.Creature), SellerUserId = lot.SellerUserId, SellerName = lot.SellerName,
			MinimumBid = lot.MinimumBid, HighestBid = lot.HighestBid, HighestBidderUserId = lot.BuyerUserId or 0,
			EndsAt = lot.EndsAt, MyBidReserved = if lot.BuyerUserId == player.UserId then lot.HighestBid else 0,
		})
	end
	table.sort(result, function(a, b) return if a.EndsAt == b.EndsAt then a.AuctionId < b.AuctionId else a.EndsAt < b.EndsAt end)
	return result
end

local function applyOnline(lot: any, decision: any)
	local userIds = copy(lot.EscrowUsers)
	userIds[lot.SellerUserId] = true
	for userId in userIds do
		local player = Players:GetPlayerByUserId(userId)
		if player and ctx.Data.Get(player) then
			local owner = "AuctionSettle:" .. lot.Id
			if ctx.Data.TryLock(player, owner) then
				ctx.Trade.ApplyDecision(player, lot.Id, decision, owner)
				ctx.Data.Unlock(player, owner)
			else table.insert(refunds, {Player = player, Key = lot.Id, Decision = decision}) end
		end
	end
end

local function abort(lot: any): boolean
	local ok, decision = ctx.Trade.AbortCoordinator(lot.Id)
	if not ok or not decision then return false end
	if decision.State ~= "Aborted" and decision.State ~= "Committed" then return false end
	applyOnline(lot, decision)
	lots[lot.Id] = nil
	syncAll()
	return true
end

local function finish(lot: any)
	if lot.Busy then return end
	lot.Busy = true
	local seller = Players:GetPlayerByUserId(lot.SellerUserId)
	local buyer = if lot.BuyerUserId then Players:GetPlayerByUserId(lot.BuyerUserId) else nil
	if lot.CancelRequested or not seller or not buyer or not eligible(seller) or not eligible(buyer) then
		abort(lot); lot.Busy = false; return
	end
	local owner = "AuctionCommit:" .. lot.Id
	if not ctx.Data.TryLock(seller, owner) then lot.Busy = false; return end
	if not ctx.Data.TryLock(buyer, owner) then ctx.Data.Unlock(seller, owner); lot.Busy = false; return end
	local buyerProfile, sellerProfile = ctx.Data.Get(buyer), ctx.Data.Get(seller)
	local patches = {
		[tostring(seller.UserId)] = {GiveUids = {}, Receive = {}, CoinsDelta = lot.HighestBid},
		[tostring(buyer.UserId)] = {GiveUids = {}, Receive = {copy(lot.Creature)}, CoinsDelta = 0},
	}
	local valid = buyerProfile and sellerProfile and buyerProfile.PendingTransactions[lot.Id]
		and sellerProfile.PendingTransactions[lot.Id] and ctx.Trade.ValidatePatch(buyerProfile, patches[tostring(buyer.UserId)], lot.Id)
	local ok, decision
	if valid then
		ok, decision = ctx.Trade.UpdateCoordinator(lot.Id, function(previous: any)
			if previous and previous.State == "Open" then
				previous.State = "Committed"; previous.Participants = copy(patches); previous.DecidedAt = os.time()
			end
			return previous
		end)
	else ok, decision = ctx.Trade.AbortCoordinator(lot.Id) end
	if not ok or not decision or (decision.State ~= "Committed" and decision.State ~= "Aborted") then
		ctx.Data.Freeze(seller, "Seu leilão será recuperado ao entrar novamente.")
		ctx.Data.Freeze(buyer, "Seu leilão será recuperado ao entrar novamente.")
		lots[lot.Id] = nil
	else
		ctx.Trade.ApplyDecision(seller, lot.Id, decision, owner)
		ctx.Trade.ApplyDecision(buyer, lot.Id, decision, owner)
		lots[lot.Id] = nil
		feedback(seller, if decision.State == "Committed" then "Leilão concluído e salvo!" else "Leilão cancelado. Sua criatura será restituída.", true)
		feedback(buyer, if decision.State == "Committed" then "Sua criatura do leilão foi entregue!" else "Leilão cancelado. Suas moedas serão restituídas.", true)
	end
	ctx.Data.Unlock(seller, owner); ctx.Data.Unlock(buyer, owner)
	-- Earlier bidders with a delayed refund are absent from the winning patch
	-- and receive only their own escrow refund, never the seller/winner payout.
	if ok and decision and (decision.State == "Committed" or decision.State == "Aborted") then applyOnline(lot, decision) end
	lot.Busy = false
	syncAll()
end

local function listCreature(player: Player, payload: any)
	if not eligible(player) or ctx.Data.IsBusy(player) then feedback(player, "Visite a praça de trocas no nível 15 ou superior."); return end
	local count = 0
	for _, lot in lots do
		count += 1
		if lot.SellerUserId == player.UserId then feedback(player, "Você já tem um leilão nesta sala."); return end
	end
	if count >= (Settings.MaxAuctionLots or 10) then feedback(player, "Esta sala já tem dez leilões abertos."); return end
	local minimum = payload.MinimumBid
	if type(payload.Uid) ~= "string" or not money(minimum) then feedback(player, "Escolha a criatura e um lance mínimo inteiro positivo."); return end
	local profile = ctx.Data.Get(player)
	local creature = nil
	for _, record in profile.CapturedCreatures do if record.Uid == payload.Uid then creature = copy(record); break end end
	if not creature then return end
	local id = ctx.Trade.NewId("Auction")
	local owner = "AuctionList:" .. id
	if not ctx.Data.TryLock(player, owner) then return end
	profile = ctx.Data.Get(player)
	if not profile then ctx.Data.Unlock(player, owner); return end
	local lot = {Id = id, SellerUserId = player.UserId, SellerName = player.DisplayName, Creature = creature,
		MinimumBid = minimum, HighestBid = 0, BuyerUserId = nil, EndsAt = os.time() + (Settings.AuctionSeconds or 120),
		EscrowUsers = {}, Busy = false, CancelRequested = false}
	local ok, journal = ctx.Trade.UpdateCoordinator(id, function(previous: any)
		if previous then return previous end
		return {Kind = "Auction", State = "Prepared", Participants = {}, CreatedAt = os.time(), Lot = {
			SellerUserId = player.UserId, Creature = copy(creature), MinimumBid = minimum, EndsAt = lot.EndsAt,
		}}
	end)
	if not ok or not journal or journal.State ~= "Prepared" then ctx.Data.Unlock(player, owner); feedback(player, "Não foi possível abrir o leilão."); return end
	local snapshot = copy(profile)
	for index = #snapshot.CapturedCreatures, 1, -1 do if snapshot.CapturedCreatures[index].Uid == creature.Uid then table.remove(snapshot.CapturedCreatures, index) end end
	for index = #snapshot.SanctuarySlots, 1, -1 do if snapshot.SanctuarySlots[index] == creature.Uid then table.remove(snapshot.SanctuarySlots, index) end end
	snapshot.PendingTransactions[id] = {Kind = "Auction", CoordinatorKey = id, PartnerUserId = 0, GiveUids = {},
		Receive = {copy(creature)}, CoinsDelta = 0, State = "Prepared", ReservedSlots = 1}
	if not ctx.Data.Replace(player, snapshot) then
		ctx.Trade.AbortCoordinator(id)
		ctx.Data.Unlock(player, owner)
		feedback(player, "Não foi possível reservar sua criatura.")
		return
	end
	local saved = ctx.Data.SaveNow(player)
	if saved then
		ok, journal = ctx.Trade.UpdateCoordinator(id, function(previous: any)
			if previous and previous.State == "Prepared" then previous.State = "Open" end
			return previous
		end)
	end
	if not saved or not ok or not journal or journal.State ~= "Open" then
		local aborted, decision = ctx.Trade.AbortCoordinator(id)
		if aborted and decision then ctx.Trade.ApplyDecision(player, id, decision, owner)
		else ctx.Data.Freeze(player, "A restituição da sua criatura será recuperada ao entrar novamente.") end
		ctx.Data.Unlock(player, owner)
		return
	end
	lots[id] = lot
	ctx.Data.Unlock(player, owner)
	if ctx.Sanctuary and ctx.Sanctuary.Refresh then ctx.Sanctuary.Refresh(player) end
	syncAll()
	feedback(player, "Criatura reservada. Seu leilão dura 120 segundos nesta sala.", true)
end

local function bid(player: Player, lot: any, amount: any)
	if lot.Busy or lot.CancelRequested or os.time() >= lot.EndsAt or not eligible(player) or player.UserId == lot.SellerUserId or not money(amount)
		or amount < lot.MinimumBid or amount <= lot.HighestBid then feedback(player, "Lance inválido ou leilão indisponível."); return end
	local owner = "AuctionBid:" .. lot.Id
	if not ctx.Data.TryLock(player, owner) then return end
	lot.Busy = true
	local profile = ctx.Data.Get(player)
	if not profile then ctx.Data.Unlock(player, owner); lot.Busy = false; return end
	local alreadyLeading = lot.BuyerUserId == player.UserId
	if not alreadyLeading and profile.PendingTransactions[lot.Id] then
		feedback(player, "Aguarde a restituição do lance anterior antes de ofertar novamente.")
		ctx.Data.Unlock(player, owner); lot.Busy = false; return
	end
	local delta = amount - (if alreadyLeading then lot.HighestBid else 0)
	if profile.Coins < delta or (not alreadyLeading and usedInventory(profile) >= (Settings.MaxInventoryCreatures or 500)) then
		feedback(player, "Moedas ou espaço no inventário insuficientes.")
		ctx.Data.Unlock(player, owner); lot.Busy = false; return
	end
	local previousBuyer = lot.BuyerUserId
	local snapshot = copy(profile)
	snapshot.Coins -= delta
	snapshot.PendingTransactions[lot.Id] = {Kind = "Auction", CoordinatorKey = lot.Id, PartnerUserId = lot.SellerUserId,
		GiveUids = {}, Receive = {}, CoinsDelta = amount, State = "Prepared", ReservedSlots = 1}
	if not ctx.Data.Replace(player, snapshot) then
		ctx.Data.Unlock(player, owner); lot.Busy = false
		feedback(player, "Não foi possível reservar esse lance.")
		return
	end
	lot.EscrowUsers[player.UserId] = true
	local saved = ctx.Data.SaveNow(player)
	local ok, journal = false, nil
	if saved then
		ok, journal = ctx.Trade.UpdateCoordinator(lot.Id, function(previous: any)
			if previous and previous.State == "Open" then
				previous.Lot.HighestBid = amount; previous.Lot.BuyerUserId = player.UserId
			end
			return previous
		end)
	end
	ctx.Data.Unlock(player, owner)
	if not saved then ctx.Data.Freeze(player, "Seu lance será recuperado ao entrar novamente.") end
	if not saved or not ok or not journal or journal.State ~= "Open" then
		lot.CancelRequested = true; lot.Busy = false; finish(lot); return
	end
	lot.HighestBid = amount; lot.BuyerUserId = player.UserId
	if previousBuyer and previousBuyer ~= player.UserId then
		local previousPlayer = Players:GetPlayerByUserId(previousBuyer)
		if previousPlayer and ctx.Data.Get(previousPlayer) then
			if not ctx.Trade.RefundOpenAuction(previousPlayer, lot.Id) then table.insert(refunds, {Player = previousPlayer, Key = lot.Id}) end
			feedback(previousPlayer, "Seu lance foi superado; as moedas reservadas foram devolvidas ou estão em restituição.", true)
		end
	end
	lot.Busy = false
	syncAll()
	feedback(player, "Lance registrado. As moedas ficam reservadas até o resultado.", true)
end

function Auction.HandleAction(player: Player, action: any, payload: any)
	if type(action) ~= "string" or type(payload) ~= "table" then return end
	local now = os.clock()
	if now - (lastAction[player] or -math.huge) < 0.25 then return end
	lastAction[player] = now
	if action == "List" then listCreature(player, payload); return end
	local lot = type(payload.AuctionId) == "string" and lots[payload.AuctionId]
	if not lot then return end
	if action == "Bid" then bid(player, lot, payload.Amount)
	elseif action == "Cancel" and lot.SellerUserId == player.UserId and lot.HighestBid == 0 then
		lot.CancelRequested = true; finish(lot)
	end
end

function Auction.Tick()
	for _, lot in lots do
		if lot.CancelRequested or os.time() >= lot.EndsAt then finish(lot) end
	end
	for index = #refunds, 1, -1 do
		local item = refunds[index]
		if not ctx.Data.Get(item.Player) then table.remove(refunds, index)
		elseif not ctx.Data.IsBusy(item.Player) then
			local success
			if item.Decision then
				local owner = "AuctionRecovery:" .. item.Key
				if ctx.Data.TryLock(item.Player, owner) then
					success = ctx.Trade.ApplyDecision(item.Player, item.Key, item.Decision, owner)
					ctx.Data.Unlock(item.Player, owner)
				end
			else success = ctx.Trade.RefundOpenAuction(item.Player, item.Key) end
			if success then table.remove(refunds, index) end
		end
	end
end

function Auction.Init(context: any)
	assert(not initialized, "AuctionService.Init must only run once")
	initialized = true; ctx = context
	ctx.Data.AddSnapshotProvider(function(player: Player, _profile: any) return {Auctions = Auction.GetSnapshot(player)} end)
	ctx.Data.OnRemoving(function(player: Player)
		lastAction[player] = nil
		for _, lot in lots do
			if lot.SellerUserId == player.UserId or lot.BuyerUserId == player.UserId then lot.CancelRequested = true end
		end
		-- The departing profile's final save preserves its escrow; recovery
		-- refunds it on the next load, while the online partner is refunded now.
		task.defer(Auction.Tick)
	end)
	local remote = ctx.Remotes:WaitForChild("AuctionAction") :: RemoteEvent
	remote.OnServerEvent:Connect(Auction.HandleAction)
	task.spawn(function() while true do task.wait(1); Auction.Tick() end end)
end

return Auction
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">AutomationService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigProgression"))

local AutomationService = {}
local context: any
local lastRequests: {[Player]: number} = {}
local modes = {Throw = true, Train = true, Fusion = true}
local function permissions(player: Player): any
    local benefits = context.Monetization.GetBenefits(player)
    return {Throw = benefits.AutoThrow == true, Train = benefits.AutoThrow == true or benefits.GroupMember == true, Fusion = benefits.MegaCollector == true}
end

function AutomationService.SetMode(player: Player, mode: any, enabled: any): (boolean, string)
    if type(mode) ~= "string" or not modes[mode] or type(enabled) ~= "boolean" then return false, "Modo automático inválido." end
    if not context.Data.IsLoaded(player) or context.Data.IsBusy(player) then return false, "Aguarde concluir sua ação." end
    local now = os.clock()
    if now - (lastRequests[player] or -math.huge) < 0.3 then return false, "Aguarde concluir sua ação." end
    lastRequests[player] = now
    local profile = context.Data.Get(player)
    if enabled and not permissions(player)[mode] then return false, "Você ainda não possui acesso a este modo automático." end
    profile.AutomationSettings[mode] = enabled
    context.Data.MarkDirty(player)
    context.Data.Sync(player)
    return true, if enabled then "Modo automático ativado." else "Modo automático desativado."
end

function AutomationService.TickPlayer(player: Player)
    if not context.Data.IsLoaded(player) then return end
    local profile = context.Data.Get(player)
    if not profile or context.Data.IsBusy(player) then return end
    local granted = permissions(player)
    local settings = profile.AutomationSettings
    for mode in modes do
        if settings[mode] and not granted[mode] then settings[mode] = false; context.Data.MarkDirty(player) end
    end
    if settings.Train and context.World.IsInSanctuary(player) and not (context.Training and context.Training.IsTraining(player)) then context.Progression.Train(player) end
    if context.Data.IsBusy(player) then return end
    if settings.Throw then
        if context.Flight then context.Flight.AutoThrow(player)
        else
            local biome = context.Biomes.GetCurrentBiome(player)
            local target, hitPosition = context.Spawn.FindAutoTarget(player, biome)
            if target and hitPosition then context.Capture.TryThrow(player, target, hitPosition) end
        end
    end
    if context.Data.IsBusy(player) then return end
    if settings.Fusion and context.Fusion then
        local selected = context.Fusion.FindAutomaticSelection(player)
        if selected then context.Fusion.Fuse(player, selected) end
    end
end

function AutomationService.Init(ctx: any)
    context = ctx
    ctx.Remotes:WaitForChild("SetAutoMode").OnServerEvent:Connect(function(player: Player, mode: any, enabled: any)
        local success, message = AutomationService.SetMode(player, mode, enabled)
        ctx.Remotes.ActionFeedback:FireClient(player, {Message = message, Kind = if success then "Success" else "Error"})
    end)
    ctx.Data.AddSnapshotProvider(function(player: Player, profile: any)
        local allowed = permissions(player)
        local settings = profile.AutomationSettings
        return {Automation = {Throw = settings.Throw == true, Train = settings.Train == true, Fusion = settings.Fusion == true,
            CanThrow = allowed.Throw, CanTrain = allowed.Train, CanFusion = allowed.Fusion}}
    end)
    Players.PlayerRemoving:Connect(function(player: Player) lastRequests[player] = nil end)
    task.spawn(function()
        while true do
            task.wait(Rules.AutomationTickSeconds)
            for _, player in Players:GetPlayers() do
                local ok, message = pcall(AutomationService.TickPlayer, player)
                if not ok then warn("[AutomationService] A player tick failed:", message) end
            end
        end
    end)
end

return AutomationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">BiomeService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Biomes = {}
local ctx: any
local nextTravel: {[Player]: number} = {}
local nextUnlock: {[Player]: number} = {}

local function feedback(player: Player, message: string, errorKind: boolean?)
    local remote = ctx.Remotes:FindFirstChild("ActionFeedback")
    if remote then remote:FireClient(player, {Message = message, Kind = if errorKind then "Error" else "Success"}) end
end
function Biomes.CountBestiary(profile: any): number
    local count = 0
    for id, discovered in profile.Bestiary or {} do if discovered == true and Config.Creatures[id] then count += 1 end end
    return count
end
function Biomes.CanAccess(player: Player, id: string): boolean
    local profile = ctx.Data.Get(player)
    if not profile then return false end
    if id == "Hub" or id == "PradariaSolar" then return true end
    if id == "TradingPlaza" then return profile.Level >= 15 end
    local definition = Config.Biomes[id]
    return definition ~= nil and definition.Enabled == true and (profile.UnlockedBiomes or {})[id] == true
end
function Biomes.Unlock(player: Player, id: any): boolean
    if typeof(id) ~= "string" or #id > 40 or ctx.Data.IsBusy(player) then return false end
    local profile, definition = ctx.Data.Get(player), Config.Biomes[id]
    if not profile or not definition or not definition.Enabled then return false end
    if Biomes.CanAccess(player, id) then return true end
    local now = os.clock()
    if now < (nextUnlock[player] or 0) then return false end
    nextUnlock[player] = now + 0.4
    if profile.Level < definition.RequiredLevel or Biomes.CountBestiary(profile) < definition.RequiredBestiary then
        feedback(player, string.format("Precisa de nível %d e %d espécies descobertas.", definition.RequiredLevel, definition.RequiredBestiary), true)
        return false
    end
    if profile.Coins < definition.Cost then feedback(player, "Moedas insuficientes para abrir este bioma.", true); return false end
    -- This transaction never yields, so two requests cannot debit the same unlock twice.
    profile.Coins -= definition.Cost
    profile.UnlockedBiomes[id] = true
    ctx.Data.MarkDirty(player)
    ctx.Data.Sync(player)
    feedback(player, definition.Name .. " desbloqueado!")
    return true
end
function Biomes.Travel(player: Player, id: any): boolean
    if typeof(id) ~= "string" or #id > 40 or ctx.Data.IsBusy(player) then return false end
    if not Biomes.CanAccess(player, id) then feedback(player, "Desbloqueie o destino primeiro. A praça de trocas exige nível 15.", true); return false end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return false end
    local now = os.clock()
    if now < (nextTravel[player] or 0) then return false end
    local destination = if id == "Hub" then ctx.World.GetHubPosition() elseif id == "TradingPlaza" then ctx.World.GetTradingPosition() else ctx.World.GetBiomePosition(id)
    if not destination then return false end
    nextTravel[player] = now + 0.8
    character:PivotTo(CFrame.new(destination))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    player:SetAttribute("CurrentBiome", id)
    ctx.Data.Sync(player)
    return true
end
function Biomes.GetCurrentBiome(player: Player): string
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    return if root and root:IsA("BasePart") then ctx.World.GetBiomeAtPosition(root.Position) else "Hub"
end
function Biomes.IsInTradingPlaza(player: Player): boolean return Biomes.CanAccess(player, "TradingPlaza") and Biomes.GetCurrentBiome(player) == "TradingPlaza" end
function Biomes.ClaimNeonResearch(player: Player): boolean
    if not Biomes.CanAccess(player, "FlorestaNeon") or Biomes.GetCurrentBiome(player) ~= "FlorestaNeon" then return false end
    local profile = ctx.Data.Get(player)
    local key = "NeonResearch"
    if profile.OneTimeGrants[key] then
        feedback(player, "Pesquisa concluída. As criaturas daqui são para observação. Arremesse na faixa para capturar.")
        return false
    end
    if not ctx.Data.TryLock(player, key) then return false end
    profile.OneTimeGrants[key] = true
    local strength = math.min(20, math.max(0, 10000 - profile.ThrowStrength))
    profile.ThrowStrength += strength
    local _, gained = ctx.Progression.GrantXP(player, 80)
    ctx.Data.MarkDirty(player)
    local saved = ctx.Data.SaveNow(player)
    if not saved then ctx.Data.Freeze(player, "Salvamento da pesquisa indisponível.") end
    ctx.Data.Unlock(player, key)
    if not saved then return false end
    ctx.Data.Sync(player)
    feedback(player, "Pesquisa Neon concluída • +" .. strength .. " força e +" .. gained .. " XP. Volte à faixa para capturar.")
    return true
end
-- Internal rebirth hook: its caller already owns the profile transaction lock.
function Biomes.ReturnToMeadow(player: Player): boolean
    local character = player.Character
    local destination = ctx.World.GetBiomePosition("PradariaSolar")
    if not character or not destination or not ctx.Data.Get(player) then return false end
    character:PivotTo(CFrame.new(destination))
    player:SetAttribute("CurrentBiome", "PradariaSolar")
    return true
end
function Biomes.Init(context: any)
    ctx = context
    for _, item in {{"UnlockBiome", Biomes.Unlock}, {"TravelToBiome", Biomes.Travel}} do
        local remote = ctx.Remotes:FindFirstChild(item[1])
        if remote then remote.OnServerEvent:Connect(item[2]) end
    end
    if ctx.Data.AddSnapshotProvider then ctx.Data.AddSnapshotProvider(function(player) return {CurrentBiome = Biomes.GetCurrentBiome(player)} end) end
    Players.PlayerRemoving:Connect(function(player) nextTravel[player], nextUnlock[player] = nil, nil end)
end
return Biomes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">BossService</string>
          <string name="Source"><![CDATA[--!strict
-- Cooperative resistance is server-owned. The final hit cannot steal other contributors' rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Boss = {}
local ctx: any
local settings: any
local active: any

function Boss.GetState(): any
    if not active then return {Active = false} end
    local contributors = 0
    for _ in active.Contributors do contributors += 1 end
    return {Active = not active.Defeated, Id = active.Id, CreatureId = active.CreatureId, Stability = active.Stability, MaxStability = settings.Stability, EndsAt = active.EndsAt, Contributors = contributors}
end
function Boss.Start(eventId: string, creatureId: string, endsAt: number): boolean
    if active and not active.Defeated then return false end
    local definition = Config.Creatures[creatureId]
    if not definition then return false end
    local layout = ctx.WorldConfig or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigWorld"))
    local id = HttpService:GenerateGUID(false)
    local model = ctx.Spawn.Spawn(creatureId, layout.BossPosition, {BiomeId = "PradariaSolar", Kind = "Boss", BossId = id, EventId = eventId, ExpiresAt = endsAt, NoRespawn = true})
    if not model then return false end
    active = {Id = id, EventId = eventId, CreatureId = creatureId, Model = model, Stability = settings.Stability, EndsAt = endsAt, Contributors = {}, Granted = {}, Defeated = false}
    local wild = if ctx.Spawn.Get then ctx.Spawn.Get(model) else nil
    active.Reward = {Mutation = if wild then wild.Mutation else "Normal", Size = if wild then wild.Size else "Normal", IncomePerSec = if wild then wild.IncomePerSec else definition.BaseIncomePerSec}
    if wild then active.Reward.MutationRoll, active.Reward.SizeRoll, active.Reward.VariantLuck = wild.MutationRoll, wild.SizeRoll, wild.VariantLuck end
    model:SetAttribute("BossStability", settings.Stability)
    model:SetAttribute("BossMaxStability", settings.Stability)
    return true
end
function Boss.CanHit(player: Player, model: Model): boolean
    return active ~= nil and not active.Defeated and active.Model == model and active.EndsAt > Workspace:GetServerTimeNow() and ctx.Data.Get(player) ~= nil
end

local function reward(encounter: any, player: Player, attempt: number)
    if encounter.Granted[player.UserId] or not ctx.Data.Get(player) then return end
    local owner = "BossReward:" .. encounter.Id
    if ctx.Data.IsBusy(player) or (ctx.Data.TryLock and not ctx.Data.TryLock(player, owner)) then
        if player.Parent then task.delay(1, function() reward(encounter, player, attempt + 1) end) end
        return
    end
    local profile = ctx.Data.Get(player)
    if not profile then if ctx.Data.Unlock then ctx.Data.Unlock(player, owner) end; return end
    local definition = Config.Creatures[encounter.CreatureId]
    local final = if ctx.Capture and ctx.Capture.ApplyVariantBonus then ctx.Capture.ApplyVariantBonus(player, encounter.Reward, encounter.CreatureId) else encounter.Reward
    local record = {Uid = HttpService:GenerateGUID(false), CreatureId = encounter.CreatureId, Mutation = final.Mutation, Size = final.Size, IncomePerSec = final.IncomePerSec, CapturedAt = os.time(), FusionStage = 0}
    local success, failure = pcall(function()
        -- Mark before callbacks: a second completion cannot grant this encounter twice.
        encounter.Granted[player.UserId] = true
        if ctx.Sanctuary.CanCapture(player) and ctx.Sanctuary.AddCapture(player, record) then
            profile.TotalCaptures = (profile.TotalCaptures or 0) + 1
            if ctx.Rewards then ctx.Rewards.OnProgress(player, "Captures", 1) end
        else
            ctx.Data.AddCoins(player, definition.BaseIncomePerSec * settings.CompensationIncomeSeconds)
            profile.Bestiary[encounter.CreatureId] = true
        end
        ctx.Progression.GrantXP(player, definition.BaseXP)
        ctx.Data.MarkDirty(player)
        if ctx.Drops and encounter.Model.PrimaryPart then ctx.Drops.OnCapture(player, record, encounter.Model.PrimaryPart.Position, true) end
    end)
    if ctx.Data.Unlock then ctx.Data.Unlock(player, owner) end
    if not success then warn("[Boss] Reward callback failed", failure); return end
    ctx.Data.Sync(player)
    local feedback = ctx.Remotes:FindFirstChild("ActionFeedback")
    if feedback then feedback:FireClient(player, {Message = "Chefe derrotado! Recompensa de contribuição recebida.", Kind = "Success"}) end
end
function Boss.TryHit(player: Player, model: Model, power: number): (boolean, boolean)
    if not Boss.CanHit(player, model) or power ~= power or power <= 0 or power == math.huge then return false, false end
    local encounter = active
    local damage = math.clamp(math.sqrt(power) * settings.PowerScale, settings.MinDamage, settings.MaxDamage)
    encounter.Contributors[player.UserId] = player
    encounter.Stability = math.max(0, encounter.Stability - damage)
    model:SetAttribute("BossStability", encounter.Stability)
    if encounter.Stability > 0 then return true, false end
    encounter.Defeated = true
    ctx.Spawn.Resolve(model, true)
    for _, contributor in encounter.Contributors do reward(encounter, contributor, 0) end
    if ctx.Weather then ctx.Weather.Broadcast() end
    return true, true
end
Boss.Damage = Boss.TryHit
function Boss.EndEvent(eventId: string)
    if active and active.EventId == eventId then
        ctx.Spawn.Retire(active.Model)
        active = nil
    end
end
function Boss.Init(context: any)
    ctx = context
    local config = ctx.EventConfig or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigEvents"))
    settings = config.Boss
    Players.PlayerRemoving:Connect(function(player)
        if active then active.Contributors[player.UserId] = nil end
    end)
end
return Boss
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">CaptureService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local CaptureService = {}
local random = Random.new()
local nextThrowAt: {[Player]: number} = {}
local nextRequestAt: {[Player]: number} = {}

local function finite(number: number): boolean
	return number == number and math.abs(number) < 1e6
end

local function validVector(value: any): boolean
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

function CaptureService.Init(dataService: any, spawnService: any?, progressionService: any?, sanctuaryService: any?, remotes: any?, context: any?)
	if dataService.Data and not spawnService then
		context = dataService
		dataService, spawnService, progressionService, sanctuaryService, remotes = context.Data, context.Spawn, context.Progression, context.Sanctuary, context.Remotes
	end
	local ctx = context
	local gameplay = if ctx then ctx.Gameplay or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameplayMath")) else nil
	local variants = if ctx then ctx.Variants or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VariantMath")) else nil
	function CaptureService.ApplyVariantBonus(player: Player, wild: any, creatureId: string?): (any, any)
		local profile = dataService.Get(player)
		local definition = Config.Creatures[creatureId or wild.CreatureId]
		if not profile or not definition or not variants or type(variants.Apply) ~= "function" then return wild, nil end
		local benefits = if ctx and ctx.Monetization then ctx.Monetization.GetBenefits(player) else {}
		return variants.Apply(wild, Config.Mutations, Config.Sizes, definition.BaseIncomePerSec, variants.GetPersonalLuck(profile, benefits, os.time()))
	end
	local requestThrow = remotes:WaitForChild("RequestThrow") :: RemoteEvent
	local throwResult = remotes:WaitForChild("ThrowResult") :: RemoteEvent
	local feedback = remotes:WaitForChild("ActionFeedback") :: RemoteEvent
	local function reject(player: Player, message: string)
		feedback:FireClient(player, {Message = message, Kind = "Error", Success = false})
	end
	local function perform(player: Player, target: any, hitPosition: any, burstExtra: boolean?): boolean?
		-- Cheap per-player throttling comes before vector/geometry work.
		local now = os.clock()
		if not burstExtra then
			if now < (nextRequestAt[player] or 0) then return end
			nextRequestAt[player] = now + 0.15
		end
		local profile = dataService.Get(player)
		if not profile then return end
		if dataService.IsBusy and dataService.IsBusy(player) then return end
		if not burstExtra and now < (nextThrowAt[player] or 0) then
			reject(player, "Espere terminar as balançadas.")
			return
		end
		if typeof(target) ~= "Instance" or not target:IsA("Model") or not validVector(hitPosition) then return end
		local wild = spawnService.Get(target)
		if not wild then return end
		if ctx and ctx.Biomes and not ctx.Biomes.CanAccess(player, wild.BiomeId or "PradariaSolar") then reject(player, "Desbloqueie este bioma antes de capturar suas criaturas."); return end
		local definition = Config.Creatures[wild.CreatureId]
		local orb = Config.Orbs[profile.EquippedOrb]
		if not definition or not orb then return end
		local benefits = if ctx and ctx.Monetization then ctx.Monetization.GetBenefits(player) else {}
		if orb.IsPrismatic and not benefits.EternalPrism then reject(player, "Esta orbe exige o passe Prismática Eterna."); return end
		local infinite = orb.IsPrismatic == true and benefits.EternalPrism == true
		local count = profile.Orbs[profile.EquippedOrb] or 0
		if count < 1 and not infinite then reject(player, "Sem orbes equipadas. Compre mais no painel."); return end
		if wild.Kind ~= "Boss" and not sanctuaryService.CanCapture(player) then reject(player, "Inventário cheio."); return end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
		local primary = target.PrimaryPart
		if not root or not root:IsA("BasePart") or not primary or not humanoid or humanoid.Health <= 0 then return end
		local distance = (root.Position - primary.Position).Magnitude
		local range = if gameplay then gameplay.GetRange(profile, benefits) else Config.GetMaxThrowRange(profile.ThrowStrength, profile.Level)
		if distance > range then reject(player, "Fora de alcance. Aproxime-se ou treine sua força."); return end
		local boxFrame, boxSize = target:GetBoundingBox()
		local localHit = boxFrame:PointToObjectSpace(hitPosition)
		local half = boxSize / 2 + Vector3.new(0.5, 0.5, 0.5)
		if math.abs(localHit.X) > half.X or math.abs(localHit.Y) > half.Y or math.abs(localHit.Z) > half.Z then return end
		local startPosition = root.Position + Vector3.new(0, 1.5, 0)
		local direction = hitPosition - startPosition
		if direction.Magnitude < 0.1 then return end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {character :: Model}
		local result = Workspace:Raycast(startPosition, direction.Unit * (direction.Magnitude + 2), params)
		if not result or not result.Instance:IsDescendantOf(target) then
			reject(player, "A criatura está atrás de um obstáculo.")
			return
		end
		-- The server raycast determines the actual impact and critical hit;
		-- the client never supplies luck, damage, inventory, or a trusted bool.
		local critical = result.Instance.Name == "Head"
		local longShot = distance > 90
		local aimBonus = Config.GetAimBonus(critical, distance)
		local elementBonus = if (profile.EquippedOrb == "Rubi" and definition.Element == "Fogo") or (profile.EquippedOrb == "Safira" and (definition.Element == "Agua" or definition.Element == "Gelo")) then 1.1 else 1
		if wild.Kind == "Boss" and ctx and ctx.Boss then
			if not ctx.Boss.CanHit(player, target) then return end
			if not infinite then profile.Orbs[profile.EquippedOrb] = count - 1 end
			nextThrowAt[player] = now + Config.Constants.ThrowCooldownSeconds
			local accepted, defeated = ctx.Boss.TryHit(player, target, orb.Power * aimBonus * elementBonus)
			if not accepted then if not infinite then profile.Orbs[profile.EquippedOrb] += 1 end; return end
			dataService.MarkDirty(player)
			dataService.Sync(player)
			throwResult:FireAllClients({Thrower = player, StartPos = startPosition, TargetModel = target, HitPos = result.Position, OrbColor = orb.Color, ShakesPassed = 0, Captured = false, IsBossHit = true, BossDefeated = defeated, CreatureName = definition.Name, CreatureId = wild.CreatureId, XPGained = 0, IsCritical = critical, IsLongShot = longShot})
			return true
		end
		local luck = if gameplay then gameplay.GetLuck(profile, benefits, if ctx.Weather then ctx.Weather.GetLuckMultiplier() else 1, os.time()) else (1 + (profile.Level - 1) * 0.015 + profile.PityBonus + profile.Rebirths * 0.5)
		local chance = Config.CalculateShakeProbability(orb.Power * elementBonus, aimBonus, luck, definition.Difficulty, orb.IsMaster)
		-- No yielding between stock verification, catch lock and consumption.
		if not spawnService.Lock(target, player.UserId) then reject(player, "Outro jogador já está capturando esta criatura."); return end
		if not infinite then profile.Orbs[profile.EquippedOrb] = count - 1 end
		nextThrowAt[player] = now + Config.Constants.ThrowCooldownSeconds
		local passed = 0
		for shake = 1, 3 do
			if chance >= 1 or random:NextNumber() < chance then passed = shake else break end
		end
		local captured = passed == 3
		local xp = 0
		local award, variantBonus = wild, nil
		local fragments = 0
		if captured then
			award, variantBonus = CaptureService.ApplyVariantBonus(player, wild)
			local record = {
				Uid = HttpService:GenerateGUID(false), CreatureId = wild.CreatureId,
				Mutation = award.Mutation, Size = award.Size, IncomePerSec = award.IncomePerSec,
				CapturedAt = os.time(),
				FusionStage = 0,
			}
			-- CanCapture was checked above and this section does not yield.
			local added = sanctuaryService.AddCapture(player, record)
			if not added then
				if not infinite then profile.Orbs[profile.EquippedOrb] += 1 end
				spawnService.Resolve(target, false)
				dataService.Sync(player)
				return
			end
			profile.PityBonus = 0
			profile.TotalCaptures = (profile.TotalCaptures or 0) + 1
			xp = math.floor(definition.BaseXP * (if gameplay then 1 else 1 + profile.Rebirths * 0.5))
			if ctx and ctx.Rewards then ctx.Rewards.OnProgress(player, "Captures", 1) end
			if ctx and ctx.Drops then ctx.Drops.OnCapture(player, record, result.Position) end
		else
			profile.PityBonus = math.min(1, profile.PityBonus + 0.05)
			xp = math.max(5, math.floor(definition.BaseXP * 0.35)) + (if critical then 15 else 0)
			if ctx and ctx.Drops then fragments = ctx.Drops.AwardFailureFragments(player) end
		end
		local oldLevel = profile.Level
		if critical and ctx and ctx.Rewards then ctx.Rewards.OnProgress(player, "Criticals", 1) end
		local _, grantedXP = progressionService.GrantXP(player, xp)
		if typeof(grantedXP) == "number" then xp = grantedXP end
		spawnService.Resolve(target, captured)
		dataService.MarkDirty(player)
		dataService.Sync(player)
		throwResult:FireAllClients({
			Thrower = player, StartPos = startPosition, TargetModel = target,
			HitPos = result.Position, OrbColor = orb.Color, ShakesPassed = passed,
			Captured = captured, MutationName = award.Mutation, SizeName = award.Size,
			CreatureName = definition.Name, CreatureId = wild.CreatureId,
			IncomePerSec = award.IncomePerSec, XPGained = xp, VariantBonus = variantBonus, FragmentsGained = fragments,
			LeveledUp = profile.Level > oldLevel, NewLevel = profile.Level,
			Probability = chance, IsCritical = critical, IsLongShot = longShot,
			SpawnChance = wild.SpawnChance,
		})
		return true
	end
	function CaptureService.TryThrow(player: Player, target: any, hitPosition: any): boolean
		local accepted = perform(player, target, hitPosition, false) == true
		if not accepted or not ctx or not ctx.Monetization or not ctx.Monetization.GetBenefits(player).TripleThrow then return accepted end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or not target.PrimaryPart then return accepted end
		local forward = target.PrimaryPart.Position - root.Position
		if forward.Magnitude < 0.1 then return accepted end
		local candidates = {}
		for _, entry in spawnService.GetAll() do
			local model = entry.Model
			if model ~= target and model.PrimaryPart then
				local vector = model.PrimaryPart.Position - root.Position
				if vector.Magnitude > 0.1 and forward.Unit:Dot(vector.Unit) >= math.cos(math.rad(25)) then table.insert(candidates, {Model = model, Distance = vector.Magnitude}) end
			end
		end
		table.sort(candidates, function(a, b) return a.Distance < b.Distance end)
		local extras = 0
		for _, candidate in candidates do
			if perform(player, candidate.Model, candidate.Model.PrimaryPart.Position, true) then extras += 1 end
			if extras >= 2 then break end
		end
		return accepted
	end
	requestThrow.OnServerEvent:Connect(function(player: Player, target: any, hitPosition: any)
		-- The flight meter is the only public throw path in the new game loop.
		-- Legacy targeted mechanics remain callable internally for their regression suite.
		if ctx and ctx.Flight then return end
		CaptureService.TryThrow(player, target, hitPosition)
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		nextThrowAt[player] = nil
		nextRequestAt[player] = nil
	end)
end

return CaptureService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Production profiles use a renewable UpdateAsync session lease. Studio is ephemeral by default.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Settings = Config.Constants

export type Capture = {
	Uid: string,
	CreatureId: string,
	Mutation: string,
	Size: string,
	IncomePerSec: number,
	CapturedAt: number,
	FusionStage: number?,
	SpawnChance: number?,
}

export type Profile = {
	Coins: number,
	Gems: number,
	XP: number,
	Level: number,
	Rebirths: number,
	ThrowStrength: number,
	TrainingLevel: number,
	TrainingXP: number,
	PityBonus: number,
	EquippedOrb: string,
	Orbs: { [string]: number },
	OrbTier: number,
	TrainingMachine: number,
	CapturedCreatures: { Capture },
	SanctuarySlots: { string },
	Bestiary: { [string]: boolean },
	LastSeen: number,
	UnlockedBiomes: { [string]: boolean },
	OfflineReward: number,
	IncomePerSec: number,
	TotalCoinsEarned: number,
	TotalCaptures: number,
	FirstJoinedAt: number,
	ExtraSanctuarySlots: number,
	DailyStreak: number,
	LastDailyClaim: number,
	PlaytimeDay: number,
	OnlineSecondsToday: number,
	PlaytimeClaimed: {[string]: boolean},
	MissionDay: number,
	MissionCounters: {[string]: number},
	MissionClaimed: {[string]: boolean},
	BestiaryRewardClaimed: {[string]: boolean},
	RedeemedCodes: {[string]: boolean},
	Consumables: {[string]: number},
	Boosts: {[string]: {Multiplier: number, ExpiresAt: number}},
	Titles: {[string]: boolean},
	WeeklyPets: number,
	FusionReadyAt: number,
	OrbFragments: number,
	VIPLastClaim: number,
	GroupRewardClaimed: boolean,
	AutomationSettings: {[string]: boolean},
	OneTimeGrants: {[string]: boolean},
	ProcessedReceipts: {[string]: boolean},
	PendingTransactions: {[string]: any},
	AppliedTransactions: {[string]: boolean},
}

type LoadedCallback = (Player, Profile) -> ()
local DataService = {}
local profiles: { [Player]: Profile } = {}
local leaving: { [Player]: boolean } = {}
local saving: { [Player]: boolean } = {}
local removalStarted: { [Player]: boolean } = {}
local loading: { [Player]: boolean } = {}
local operationLocks: {[Player]: string} = {}
local initializationFailed: {[Player]: boolean} = {}
local snapshotProviders: {(Player, Profile) -> any} = {}
local leaseExpires: { [Player]: number } = {}
local loadedCallbacks: { LoadedCallback } = {}
local removingCallbacks: { LoadedCallback } = {}
local remotes: Folder
local store: GlobalDataStore?
local initialized = false
local shuttingDown = false
local persistent = false
local sessionId = if game.JobId ~= "" then game.JobId else HttpService:GenerateGUID(false)
local SCHEMA_VERSION = 2

local function copy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = copy(child)
	end
	return result
end

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function newProfile(): Profile
	return {
		Coins = Settings.InitialCoins,
		Gems = 0,
		XP = 0,
		Level = 1,
		Rebirths = 0,
		ThrowStrength = Settings.InitialThrowStrength,
		TrainingLevel = 1, TrainingXP = 0,
		PityBonus = 0,
		EquippedOrb = "Comum",
		Orbs = { Comum = Settings.InitialOrbs },
		OrbTier = 1,
		TrainingMachine = 1,
		CapturedCreatures = {},
		SanctuarySlots = {},
		Bestiary = {},
		LastSeen = os.time(),
		UnlockedBiomes = { PradariaSolar = true },
		OfflineReward = 0,
		IncomePerSec = 0,
		TotalCoinsEarned = Settings.InitialCoins,
		TotalCaptures = 0,
		FirstJoinedAt = os.time(),
		ExtraSanctuarySlots = 0,
		DailyStreak = 0, LastDailyClaim = 0,
		PlaytimeDay = 0, OnlineSecondsToday = 0, PlaytimeClaimed = {},
		MissionDay = 0, MissionCounters = {Captures = 0, Criticals = 0, Fusions = 0}, MissionClaimed = {},
		BestiaryRewardClaimed = {}, RedeemedCodes = {}, Consumables = {}, Boosts = {}, Titles = {},
		WeeklyPets = 0, FusionReadyAt = 0, OrbFragments = 0, VIPLastClaim = 0,
		GroupRewardClaimed = false,
		AutomationSettings = {Throw = false, Train = false, Fusion = false},
		OneTimeGrants = {}, ProcessedReceipts = {}, PendingTransactions = {}, AppliedTransactions = {},
	}
end

-- Reject incompatible/corrupt saves rather than replacing them with a fresh profile.
local function validKey(key: any): boolean
	return type(key) == "string" and #key > 0 and #key <= 200
end

local function validateBooleanMap(value: any, name: string)
	assert(type(value) == "table", "Invalid map: " .. name)
	local count = 0
	for key, flag in pairs(value) do
		count += 1
		assert(count <= 20000 and validKey(key) and type(flag) == "boolean", "Invalid map entry: " .. name)
	end
end

local function validateArray(value: any, name: string, limit: number)
	assert(type(value) == "table" and #value <= limit, "Invalid array: " .. name)
	local count = 0
	for index in pairs(value) do
		count += 1
		assert(type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #value, "Sparse array: " .. name)
	end
	assert(count == #value, "Sparse array: " .. name)
end

local function validateCapture(record: any)
	assert(type(record) == "table" and validKey(record.Uid), "Invalid captured record")
	assert(Config.Creatures[record.CreatureId] ~= nil, "Unknown saved creature")
	assert(type(record.Mutation) == "string" and type(record.Size) == "string", "Invalid variant")
	assert(finite(record.IncomePerSec) and record.IncomePerSec >= 0, "Invalid saved income")
	assert(finite(record.CapturedAt) and record.CapturedAt >= 0, "Invalid capture timestamp")
	if record.FusionStage ~= nil then
		assert(finite(record.FusionStage) and record.FusionStage % 1 == 0 and record.FusionStage >= 0 and record.FusionStage <= 3, "Invalid fusion stage")
	end
	if record.SpawnChance ~= nil then
		assert(finite(record.SpawnChance) and record.SpawnChance > 0 and record.SpawnChance <= 1, "Invalid spawn probability")
	end
end

local function validateJournalValue(value: any, depth: number, budget: {number})
	budget[1] += 1
	assert(depth <= 9 and budget[1] <= 12000, "Transaction journal is too large")
	local kind = type(value)
	if kind == "table" then
		for key, child in pairs(value) do
			assert(validKey(key) or (type(key) == "number" and finite(key) and key >= 1 and key % 1 == 0), "Invalid journal key")
			validateJournalValue(child, depth + 1, budget)
		end
	elseif kind == "number" then assert(finite(value), "Invalid journal number")
	elseif kind == "string" then assert(#value <= 4096, "Invalid journal string")
	else assert(kind == "boolean", "Invalid journal value") end
end

local function decode(envelope: any): Profile
	assert(type(envelope) == "table", "Invalid saved profile envelope")
	assert(envelope.SchemaVersion == 1 or envelope.SchemaVersion == SCHEMA_VERSION, "Unsupported saved profile version")
	if envelope.Session ~= nil then
		assert(type(envelope.Session) == "table" and type(envelope.Session.Id) == "string" and finite(envelope.Session.ExpiresAt), "Invalid saved session lease")
	end
	local data = envelope.Data
	assert(type(data) == "table", "Missing saved profile data")
	for _, key in ipairs({ "Coins", "XP", "Level", "Orbs", "CapturedCreatures", "SanctuarySlots", "LastSeen" }) do
		assert(data[key] ~= nil, "Missing essential saved field: " .. key)
	end
	local result = newProfile() :: any
	for key, default in pairs(result) do
		local value = data[key]
		if value ~= nil then
			assert(type(value) == type(default), "Invalid saved field: " .. key)
			if type(default) == "number" then
				assert(finite(value) and value >= 0, "Invalid saved number: " .. key)
			end
			result[key] = copy(value)
		end
	end
	-- v1 did not record lifetime counters. Preserve at least its current balance
	-- and collection; no earlier spending/captures can be reconstructed.
	if data.TotalCoinsEarned == nil then result.TotalCoinsEarned = result.Coins end
	if data.TotalCaptures == nil then result.TotalCaptures = #result.CapturedCreatures end
	if data.FirstJoinedAt == nil then result.FirstJoinedAt = result.LastSeen end
	assert(result.Level >= 1 and result.Level <= Settings.MaxLevel, "Invalid saved level")
	assert(result.Level % 1 == 0, "Non-integral saved level")
	assert(result.TrainingLevel >= 1 and result.TrainingLevel <= Settings.MaxTrainingLevel and result.TrainingLevel % 1 == 0 and result.TrainingXP < 1e8, "Invalid academy progression")
	Config.ReconcileTrainingXP(result)
	assert(type(Config.Orbs[result.EquippedOrb]) == "table", "Unknown equipped orb")
	for orbId, quantity in pairs(result.Orbs) do
		assert(type(orbId) == "string" and Config.Orbs[orbId] ~= nil, "Unknown saved orb")
		assert(finite(quantity) and quantity >= 0 and quantity % 1 == 0, "Invalid orb quantity")
	end
	assert(result.OrbTier >= 1 and result.OrbTier <= 7 and result.OrbTier % 1 == 0, "Invalid orb evolution")
	assert(result.TrainingMachine >= 1 and result.TrainingMachine <= Settings.MaxTrainingMachine and result.TrainingMachine % 1 == 0, "Invalid training machine")
	if data.OrbTier == nil then
		for orbId, quantity in result.Orbs do
			local tier = Config.Orbs[orbId].Tier
			if tier and quantity > 0 then result.OrbTier = math.max(result.OrbTier, tier) end
		end
	end
	validateArray(result.CapturedCreatures, "CapturedCreatures", Settings.MaxInventoryCreatures or 500)
	local captureIds = {}
	for _, record in ipairs(result.CapturedCreatures) do
		validateCapture(record)
		assert(not captureIds[record.Uid], "Duplicate captured record")
		captureIds[record.Uid] = true
	end
	validateArray(result.SanctuarySlots, "SanctuarySlots", Settings.MaxSanctuarySlots or 24)
	local equippedIds = {}
	for _, uid in ipairs(result.SanctuarySlots) do
		assert(type(uid) == "string" and captureIds[uid] and not equippedIds[uid], "Invalid sanctuary slot")
		equippedIds[uid] = true
	end
	for _, key in {"Bestiary", "UnlockedBiomes", "PlaytimeClaimed", "MissionClaimed", "BestiaryRewardClaimed", "RedeemedCodes", "Titles", "OneTimeGrants", "ProcessedReceipts", "AppliedTransactions"} do
		validateBooleanMap(result[key], key)
	end
	for _, key in {"TotalCaptures", "Rebirths", "ExtraSanctuarySlots", "DailyStreak", "PlaytimeDay", "OnlineSecondsToday", "MissionDay", "WeeklyPets", "OrbFragments"} do
		assert(result[key] % 1 == 0, "Non-integral saved field: " .. key)
	end
	assert(result.DailyStreak <= 7 and result.ExtraSanctuarySlots <= (Settings.MaxSanctuarySlots or 24), "Invalid progression capacity")
	for _, key in {"Captures", "Criticals", "Fusions"} do
		local amount = result.MissionCounters[key]
		if amount == nil then result.MissionCounters[key] = 0
		else assert(finite(amount) and amount >= 0 and amount % 1 == 0, "Invalid mission counter") end
	end
	for key, amount in pairs(result.MissionCounters) do
		assert((key == "Captures" or key == "Criticals" or key == "Fusions") and finite(amount), "Unknown mission counter")
	end
	for key, amount in pairs(result.Consumables) do
		assert(validKey(key) and finite(amount) and amount >= 0 and amount % 1 == 0, "Invalid consumable")
	end
	for key, boost in pairs(result.Boosts) do
		assert((key == "Luck" or key == "Coins" or key == "XP") and type(boost) == "table", "Invalid boost category")
		assert(finite(boost.Multiplier) and boost.Multiplier >= 1 and boost.Multiplier <= 1000, "Invalid boost multiplier")
		assert(finite(boost.ExpiresAt) and boost.ExpiresAt >= 0, "Invalid boost expiration")
	end
	for _, key in {"Throw", "Train", "Fusion"} do
		if result.AutomationSettings[key] == nil then result.AutomationSettings[key] = false end
		assert(type(result.AutomationSettings[key]) == "boolean", "Invalid automation setting")
	end
	for key in pairs(result.AutomationSettings) do assert(key == "Throw" or key == "Train" or key == "Fusion", "Unknown automation setting") end
	local pendingCount = 0
	for id, transaction in pairs(result.PendingTransactions) do
		pendingCount += 1
		assert(pendingCount <= 100 and validKey(id) and type(transaction) == "table", "Invalid pending transaction")
		validateJournalValue(transaction, 0, {0})
		if transaction.ReservedSlots ~= nil then assert(finite(transaction.ReservedSlots) and transaction.ReservedSlots >= 0 and transaction.ReservedSlots <= 500 and transaction.ReservedSlots % 1 == 0, "Invalid reserved slots") end
		if transaction.Receive ~= nil then
			validateArray(transaction.Receive, "Transaction.Receive", 500)
			for _, record in transaction.Receive do validateCapture(record) end
		end
	end
	result.OfflineReward = 0
	result.IncomePerSec = 0 -- Recomputed from equipped records by SanctuaryService.
	return result :: Profile
end

local function runCallbacks(callbacks: { LoadedCallback }, player: Player, profile: Profile, stopWhenLeaving: boolean?): boolean
	for _, callback in ipairs(callbacks) do
		-- Recovery and receipt callbacks can replace the validated profile table.
		local currentProfile = if stopWhenLeaving then profiles[player] or profile else profile
		local ok, err = pcall(callback, player, currentProfile)
		if not ok then
			warn("[DataService] Profile callback failed:", err)
			return false
		end
		if stopWhenLeaving and (leaving[player] or not player.Parent) then return false end
	end
	return true
end

function DataService.Get(player: Player): Profile?
	if leaving[player] then
		return nil
	end
	return profiles[player]
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil and not leaving[player] and not loading[player] and not removalStarted[player]
end

function DataService.IsPersistent(): boolean
	return persistent
end

function DataService.IsBusy(player: Player): boolean
	return operationLocks[player] ~= nil or loading[player] == true or leaving[player] == true or removalStarted[player] == true
end

function DataService.TryLock(player: Player, owner: string): boolean
	if type(owner) ~= "string" or #owner == 0 or #owner > 256 or not profiles[player] or leaving[player] or removalStarted[player] or operationLocks[player] then return false end
	operationLocks[player] = owner
	return true
end

function DataService.Unlock(player: Player, owner: string)
	if operationLocks[player] == owner then operationLocks[player] = nil end
end

function DataService.Freeze(player: Player, message: string?)
	leaving[player] = true
	operationLocks[player] = "Frozen"
	player:Kick(message or "Sua operação está sendo protegida. Entre novamente para reconciliar seu progresso salvo.")
end

function DataService.GetReservedSlots(profile: any): number
	local total = 0
	for _, transaction in pairs(profile.PendingTransactions or {}) do
		local reserved = transaction.ReservedSlots
		if finite(reserved) then total += math.max(0, math.floor(reserved))
		elseif type(transaction.Receive) == "table" then total += #transaction.Receive end
	end
	return total
end

function DataService.GetInventoryCount(profile: any): number
	return #(profile.CapturedCreatures or {}) + DataService.GetReservedSlots(profile)
end

function DataService.AddCoins(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not finite(amount) or amount <= 0 then return false end
	local balance = profile.Coins + amount
	local lifetime = profile.TotalCoinsEarned + amount
	if not finite(balance) or not finite(lifetime) then return false end
	profile.Coins = balance
	profile.TotalCoinsEarned = lifetime
	return true
end

function DataService.AddSnapshotProvider(callback: (Player, Profile) -> any)
	table.insert(snapshotProviders, callback)
end

function DataService.Replace(player: Player, replacement: any): boolean
	if not profiles[player] or leaving[player] or not operationLocks[player] then return false end
	local ok, validated = pcall(decode, {SchemaVersion = SCHEMA_VERSION, Data = replacement})
	if not ok then return false end
	validated.IncomePerSec = replacement.IncomePerSec
	validated.OfflineReward = replacement.OfflineReward
	profiles[player] = validated
	return true
end

function DataService.MarkDirty(_player: Player)
	-- Every loaded session is saved periodically, even when idle, to renew its lease.
end

local PUBLIC_FIELDS = {
	"Coins", "Gems", "XP", "Level", "Rebirths", "ThrowStrength", "PityBonus", "EquippedOrb", "Orbs",
	"TrainingLevel", "TrainingXP", "TrainingMachine", "OrbTier",
	"CapturedCreatures", "SanctuarySlots", "Bestiary", "UnlockedBiomes", "OfflineReward", "IncomePerSec",
	"TotalCoinsEarned", "TotalCaptures", "ExtraSanctuarySlots", "DailyStreak", "LastDailyClaim", "PlaytimeDay",
	"OnlineSecondsToday", "PlaytimeClaimed", "MissionDay", "MissionCounters", "MissionClaimed", "BestiaryRewardClaimed",
	"Consumables", "Boosts", "Titles", "WeeklyPets", "FusionReadyAt", "OrbFragments", "VIPLastClaim", "AutomationSettings",
}

function DataService.Sync(player: Player, allowBusy: boolean?)
	local profile = DataService.Get(player)
	if not profile or not player.Parent or loading[player] or (DataService.IsBusy(player) and not allowBusy) then
		return
	end
	local snapshot: any = {}
	for _, key in PUBLIC_FIELDS do snapshot[key] = copy((profile :: any)[key]) end
	snapshot.MaxRange = Config.GetMaxThrowRange(profile.ThrowStrength, profile.Level)
	snapshot.XPRequired = Config.GetXPRequiredForLevel(profile.Level)
	snapshot.DataMode = if persistent then "DataStore" else "StudioMemory"
	snapshot.ServerTime = os.time()
	snapshot.InventoryCapacity = Settings.MaxInventoryCreatures or 500
	snapshot.InventoryReservedSlots = DataService.GetReservedSlots(profile)
	snapshot.SlotCapacity = math.min(Settings.MaxSanctuarySlots or 24, Settings.BaseSanctuarySlots + profile.ExtraSanctuarySlots + (if profile.Level >= 5 then 1 else 0) + (if profile.Level >= 15 then 1 else 0))
	for _, provider in snapshotProviders do
		local ok, extension = pcall(provider, player, profile)
		if ok and type(extension) == "table" then
			for key, value in extension do snapshot[key] = copy(value) end
		elseif not ok then warn("[DataService] Snapshot provider failed:", extension) end
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local coins = stats:FindFirstChild("Moedas") :: NumberValue
		local level = stats:FindFirstChild("Nivel") :: IntValue
		local captures = stats:FindFirstChild("Capturas") :: IntValue
		coins.Value = profile.Coins
		level.Value = profile.Level
		captures.Value = profile.TotalCaptures
	end
	local stateUpdate = remotes:WaitForChild("StateUpdate") :: RemoteEvent
	stateUpdate:FireClient(player, snapshot)
end

function DataService.OnLoaded(callback: LoadedCallback)
	table.insert(loadedCallbacks, callback)
	for player, profile in pairs(profiles) do
		if not leaving[player] then
			callback(player, profile)
		end
	end
end

function DataService.OnRemoving(callback: LoadedCallback)
	table.insert(removingCallbacks, callback)
end

local function save(player: Player, release: boolean, preserveLastSeen: boolean?): boolean
	local start = os.clock()
	while saving[player] do
		if os.clock() - start > 20 then
			return false
		end
		task.wait(0.1)
	end
	local profile = profiles[player]
	if not profile then
		return true
	end
	saving[player] = true
	local snapshot = copy(profile)
	if not preserveLastSeen then
		snapshot.LastSeen = os.time()
	end
	local valid, validationError = pcall(decode, {SchemaVersion = SCHEMA_VERSION, Data = snapshot})
	if not valid then
		saving[player] = nil
		warn("[DataService] Refused an invalid outgoing profile:", validationError)
		if not release then DataService.Freeze(player, "Seu progresso anterior foi preservado. Entre novamente para continuar.") end
		return false
	end
	if not persistent then saving[player] = nil; return true end
	local success = false
	local lockLost = false
	for attempt = 1, 3 do
		local written = false
		local expiry = os.time() + Settings.SessionLeaseSeconds
		local ok, err = pcall(function()
			(store :: GlobalDataStore):UpdateAsync("Player_" .. player.UserId, function(previous: any)
				written = false -- UpdateAsync may invoke this callback more than once.
				if type(previous) ~= "table" or type(previous.Session) ~= "table" or previous.Session.Id ~= sessionId then
					lockLost = true
					return nil
				end
				written = true
				return {
					SchemaVersion = SCHEMA_VERSION,
					Data = snapshot,
					Session = if release then nil else { Id = sessionId, ExpiresAt = expiry },
				}
			end)
		end)
		if ok and written then
			success = true
			leaseExpires[player] = if release then nil else expiry
			break
		end
		if lockLost then
			warn("[DataService] Session lease lost for", player.UserId)
			break
		end
		warn("[DataService] Save attempt failed for", player.UserId, err)
		if attempt < 3 then
			task.wait(attempt)
		end
	end
	saving[player] = nil
	if not success and not release and (lockLost or os.time() >= (leaseExpires[player] or 0) - 15) then
		leaving[player] = true -- Freeze mutations immediately when ownership is uncertain.
		player:Kick("Sua sessão de dados perdeu a conexão. Entre novamente para proteger o progresso salvo.")
	end
	return success
end

function DataService.SaveNow(player: Player): boolean
	if not profiles[player] or leaving[player] or initializationFailed[player] then return false end
	return save(player, false)
end

-- Callback recovery can durably reconcile a trade/receipt before a later callback
-- fails. Release ownership using the latest stored Data, never an older snapshot.
local function releasePreservingData(player: Player)
	if not persistent then return end
	local ok, err = pcall(function()
		(store :: GlobalDataStore):UpdateAsync("Player_" .. player.UserId, function(previous: any)
			if type(previous) ~= "table" or type(previous.Session) ~= "table" or previous.Session.Id ~= sessionId then return nil end
			return {SchemaVersion = previous.SchemaVersion, Data = previous.Data, Session = nil}
		end)
	end)
	if not ok then warn("[DataService] Lease release deferred:", err) end
end

local function load(player: Player)
	if loading[player] or profiles[player] then
		return
	end
	loading[player] = true
	local profile: Profile?
	if persistent then
		for attempt = 1, 3 do
			local acquired = false
			local loadedProfile: Profile? = nil
			local busy = false
			local expiry = os.time() + Settings.SessionLeaseSeconds
			local ok, err = pcall(function()
				(store :: GlobalDataStore):UpdateAsync("Player_" .. player.UserId, function(previous: any)
					acquired = false
					loadedProfile = nil
					if previous ~= nil then
						loadedProfile = decode(previous)
						local lease = previous.Session
						if type(lease) == "table" and lease.Id ~= sessionId and finite(lease.ExpiresAt) and lease.ExpiresAt > os.time() then
							busy = true
							return nil
						end
					else
						loadedProfile = newProfile()
					end
					acquired = true
					return {
						SchemaVersion = SCHEMA_VERSION,
						Data = loadedProfile,
						Session = { Id = sessionId, ExpiresAt = expiry },
					}
				end)
			end)
			if ok and acquired and loadedProfile then
				profile = loadedProfile
				leaseExpires[player] = expiry
				break
			end
			warn("[DataService] Load blocked for", player.UserId, if busy then "another session owns the lease" else tostring(err))
			if attempt < 3 then
				task.wait(attempt * 2)
			end
		end
	else
		profile = newProfile()
	end
	if not profile then
		loading[player] = nil
		if player.Parent then
			player:Kick("Não foi possível carregar seus dados com segurança. Feche outra sessão e tente novamente em instantes.")
		end
		return
	end
	profiles[player] = profile
	if not player.Parent or shuttingDown then
		save(player, true)
		profiles[player] = nil
		loading[player] = nil
		return
	end
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for name, kind in pairs({ Moedas = "NumberValue", Nivel = "IntValue", Capturas = "IntValue" }) do
		local value = Instance.new(kind)
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
	player:SetAttribute("DataMode", if persistent then "DataStore" else "StudioMemory")
	if not runCallbacks(loadedCallbacks, player, profile, true) then
		initializationFailed[player] = true
		leaving[player] = true
		runCallbacks(removingCallbacks, player, profile)
		releasePreservingData(player)
		profiles[player] = nil
		leaseExpires[player] = nil
		loading[player] = nil
		leaving[player] = nil
		operationLocks[player] = nil
		initializationFailed[player] = nil
		player:Kick("Não foi possível iniciar sua sessão. Seu progresso anterior foi preservado; tente novamente.")
		return
	end
	player:SetAttribute("DataLoaded", true)
	loading[player] = nil
	DataService.Sync(player)
end

local function remove(player: Player)
	if removalStarted[player] then
		while profiles[player] do
			task.wait(0.1)
		end
		return
	end
	local profile = profiles[player]
	if not profile then
		return
	end
	removalStarted[player] = true
	-- Let an already-owned receipt/consumable transaction finish its durable
	-- write or refund. New requests cannot acquire locks during this window.
	local deadline = os.clock() + 20
	while operationLocks[player] and not leaving[player] and os.clock() < deadline do task.wait(0.1) end
	profile = profiles[player] or profile
	leaving[player] = true
	runCallbacks(removingCallbacks, player, profile)
	if not save(player, true) then
		warn("[DataService] Could not save on departure:", player.UserId, "The last successful autosave is preserved.")
	end
	profiles[player] = nil
	leaving[player] = nil
	leaseExpires[player] = nil
	removalStarted[player] = nil
	operationLocks[player] = nil
	initializationFailed[player] = nil
end

function DataService.Init(remoteFolder: Folder)
	assert(not initialized, "DataService.Init must only run once")
	initialized = true
	remotes = remoteFolder
	persistent = not RunService:IsStudio() or Settings.StudioPersistence == true
	if persistent then
		store = DataStoreService:GetDataStore(Settings.DataStoreName)
	else
		warn("[Throw a Sphere] StudioMemory: progress resets when Play stops. Production always uses DataStore.")
	end
	local lastRequest: { [Player]: number } = {}
	(remotes:WaitForChild("RequestState") :: RemoteEvent).OnServerEvent:Connect(function(player: Player)
		local now = os.clock()
		if now - (lastRequest[player] or -math.huge) >= 1 then
			lastRequest[player] = now
			DataService.Sync(player)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(load, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
		remove(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(load, player)
	end
	task.spawn(function()
		while not shuttingDown do
			task.wait(Settings.AutoSaveSeconds)
			for player in pairs(profiles) do
				if not leaving[player] then
					task.spawn(save, player, false)
				end
			end
		end
	end)
	if persistent then
		task.spawn(function()
			while not shuttingDown do
				task.wait(5)
				for player, expiry in pairs(leaseExpires) do
					if not leaving[player] and os.time() >= expiry - 15 then
						-- Freeze before expiration even if a DataStore request is stalled.
						leaving[player] = true
						player:Kick("Não foi possível renovar sua sessão de dados. Entre novamente para proteger o progresso salvo.")
					end
				end
			end
		end)
	end
	game:BindToClose(function()
		shuttingDown = true
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				remove(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while (pending > 0 or next(loading) ~= nil) and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
