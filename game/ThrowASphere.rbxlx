      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">FusionService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("ConfigProgression"))

local FusionService = {}
local context: any
local lastRequests: {[Player]: number} = {}
local function benefits(player: Player): any return context.Monetization.GetBenefits(player) end
local function feedback(player: Player, message: string, success: boolean)
    context.Remotes.ActionFeedback:FireClient(player, {Message = message, Kind = if success then "Success" else "Error"})
end

function FusionService.GetRequiredCount(player: Player): number
    return if benefits(player).FusionXP then Rules.FusionPassCount else Rules.FusionCount
end

function FusionService.Fuse(player: Player, uids: any): (boolean, string)
    local data = context.Data
    if not data.IsLoaded(player) or data.IsBusy(player) then return false, "Aguarde concluir sua ação." end
    local now = os.clock()
    if now - (lastRequests[player] or -math.huge) < 0.4 then return false, "Aguarde a máquina de fusão." end
    lastRequests[player] = now
    if type(uids) ~= "table" then return false, "Selecione suas criaturas." end
    local required = FusionService.GetRequiredCount(player)
    local seen: {[string]: boolean} = {}
    local count = 0
    for index, uid in pairs(uids) do
        if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > required or type(uid) ~= "string" or #uid > 80 or seen[uid] then return false, "Seleção de fusão inválida." end
        seen[uid] = true
        count += 1
    end
    if count ~= required then return false, "Escolha " .. required .. " criaturas idênticas." end
    local profile = data.Get(player)
    if not profile or profile.Level < Rules.FusionLevel then return false, "A fusão desbloqueia no nível " .. Rules.FusionLevel .. "." end
    if (profile.FusionReadyAt or 0) > os.time() then return false, "A máquina está recarregando." end
    local selected = {}
    for _, record in profile.CapturedCreatures do if seen[record.Uid] then table.insert(selected, record) end end
    if #selected ~= required then return false, "Uma criatura selecionada não está no seu inventário." end
    local first = selected[1]
    if context.AuthoredCreatures and not context.AuthoredCreatures[first.CreatureId] then
        return false, "A arte desta criatura ainda está pendente."
    end
    for _, record in selected do
        if record.CreatureId ~= first.CreatureId or record.Mutation ~= first.Mutation or record.Size ~= first.Size then return false, "Use a mesma espécie, mutação e tamanho." end
    end
    local recipe, definition = Rules.FusionRecipes[first.Mutation], Config.Creatures[first.CreatureId]
    if not recipe or not definition then return false, "Esta mutação não possui uma fusão superior." end
    local inventoryCount = if data.GetInventoryCount then data.GetInventoryCount(profile) else #profile.CapturedCreatures
    if inventoryCount - required + 1 > (Config.Constants.MaxInventoryCreatures or 500) then return false, "Libere espaço reservado antes de concluir esta fusão." end
    local sizeMultiplier: number? = nil
    for _, size in Config.Sizes do if size.Name == first.Size then sizeMultiplier = size.Multiplier end end
    if not sizeMultiplier then return false, "O tamanho desta criatura não pode ser fundido." end
    if not data.TryLock(player, "Fusion") then return false, "Aguarde concluir sua ação." end
    local ok, message = pcall(function()
        local kept = {}
        for _, record in profile.CapturedCreatures do if not seen[record.Uid] then table.insert(kept, record) end end
        local keptSlots = {}
        for _, uid in profile.SanctuarySlots do if not seen[uid] then table.insert(keptSlots, uid) end end
        profile.CapturedCreatures, profile.SanctuarySlots = kept, keptSlots
        local output = {
            Uid = HttpService:GenerateGUID(false), CreatureId = first.CreatureId,
            Mutation = recipe.Mutation, Size = first.Size, FusionStage = recipe.Stage,
            IncomePerSec = math.floor(definition.BaseIncomePerSec * (sizeMultiplier :: number) * recipe.Multiplier), CapturedAt = os.time(),
        }
        assert(context.Sanctuary.AddCapture(player, output), "Fusion output could not be added")
        profile.FusionReadyAt = os.time() + (if benefits(player).FusionXP then Rules.FusionPassCooldownSeconds else Rules.FusionCooldownSeconds)
        if context.Rewards then context.Rewards.OnProgress(player, "Fusions", 1) end
        data.MarkDirty(player)
    end)
    if not ok then
        data.Unlock(player, "Fusion")
        data.Freeze(player, "A fusão foi interrompida para proteger seus dados.")
        warn("[FusionService]", message)
        return false, "Não foi possível concluir esta fusão com segurança."
    end
    local saved = data.SaveNow(player)
    data.Unlock(player, "Fusion")
    if not saved then data.Freeze(player, "Não foi possível salvar sua fusão com segurança."); return false, "Salvamento indisponível." end
    data.Sync(player)
    return true, definition.Name .. " " .. recipe.Mutation .. " fundida!"
end

function FusionService.FindAutomaticSelection(player: Player): {string}?
    local profile = context.Data.Get(player)
    if not profile or profile.Level < Rules.FusionLevel or (profile.FusionReadyAt or 0) > os.time() then return nil end
    -- Auto-fusion never consumes displayed creatures; manual selection stays explicit.
    local displayed: {[string]: boolean} = {}
    for _, uid in profile.SanctuarySlots do displayed[uid] = true end
    local groups: {[string]: {string}} = {}
    local required = FusionService.GetRequiredCount(player)
    for _, record in profile.CapturedCreatures do
        if context.AuthoredCreatures and not context.AuthoredCreatures[record.CreatureId] then continue end
        local definition = Config.Creatures[record.CreatureId]
        if definition and definition.Rarity == "Comum" and record.Mutation == "Normal" and not displayed[record.Uid] then
            local key = record.CreatureId .. ":" .. record.Mutation .. ":" .. record.Size
            local group = groups[key] or {}
            groups[key] = group
            table.insert(group, record.Uid)
            if #group == required then return group end
        end
    end
    return nil
end

function FusionService.Init(ctx: any)
    context = ctx
    ctx.Remotes:WaitForChild("FuseCreatures").OnServerEvent:Connect(function(player: Player, uids: any)
        local success, message = FusionService.Fuse(player, uids)
        feedback(player, message, success)
    end)
    ctx.Data.AddSnapshotProvider(function(player: Player, profile: any)
        return {Fusion = {RequiredCount = FusionService.GetRequiredCount(player), ReadyAt = profile.FusionReadyAt or 0, Unlocked = profile.Level >= Rules.FusionLevel}}
    end)
    Players.PlayerRemoving:Connect(function(player: Player) lastRequests[player] = nil end)
end

return FusionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">LeaderboardPodiumService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Numbers = require(Shared:WaitForChild("NumberFormatter"))
local Layout = require(Shared:WaitForChild("ConfigWorld"))
local Rankings = {}
local ctx: any
local ordered: any
local summaries: any
local lastResult: any = {Mode = "Session", UpdatedAt = 0, Boards = {Coins = {}, Capture = {}, Level = {}, Bestiary = {}}}
local busy = false
local boards: {[string]: TextLabel} = {}
local podium: {[number]: BasePart} = {}
local displayed: {[number]: string} = {}
local avatars: {[number]: Model} = {}
local keys = {"Coins", "Capture", "Level", "Bestiary"}
local titles = {Coins = "MOEDAS TOTAIS", Capture = "MELHOR CAPTURA • $/s", Level = "NÍVEL E REBIRTHS", Bestiary = "BESTIÁRIO"}

function Rankings.EncodeScore(value: number): number
    if value ~= value or value < 0 or value == math.huge then return 0 end
    return math.floor(math.log10(value + 1) * 1000000 + 0.5)
end
local function summarize(player: Player, profile: any): any
    local bestIncome, strongest = 0, nil
    local equipped: {[string]: boolean} = {}
    for _, uid in profile.SanctuarySlots or {} do equipped[uid] = true end
    for _, creature in profile.CapturedCreatures do
        bestIncome = math.max(bestIncome, creature.IncomePerSec)
        if equipped[creature.Uid] and (not strongest or creature.IncomePerSec > strongest.IncomePerSec) then
            strongest = {CreatureId = creature.CreatureId, Mutation = creature.Mutation, Size = creature.Size, IncomePerSec = creature.IncomePerSec}
        end
    end
    return {UserId = player.UserId, DisplayName = player.DisplayName, Coins = profile.TotalCoinsEarned or profile.Coins,
        Capture = bestIncome, Level = profile.Level + profile.Rebirths * 100, Bestiary = ctx.Biomes.CountBestiary(profile),
        ActualLevel = profile.Level, Rebirths = profile.Rebirths, Strongest = strongest}
end
local function sessionBoards(): any
    local result = {Coins = {}, Capture = {}, Level = {}, Bestiary = {}}
    for _, player in Players:GetPlayers() do
        local profile = ctx.Data.Get(player)
        if profile then
            local entry = summarize(player, profile)
            for _, key in keys do table.insert(result[key], entry) end
        end
    end
    for _, key in keys do table.sort(result[key], function(a, b) return if a[key] == b[key] then a.UserId < b.UserId else a[key] > b[key] end) end
    return result
end
local function globalBoards(localBoards: any): any
    if not ordered then
        local newOrdered = {}
        local prefix = Config.Constants.DataStoreName .. "_Ranks_v2_"
        for _, key in keys do newOrdered[key] = DataStoreService:GetOrderedDataStore(prefix .. key) end
        local newSummaries = DataStoreService:GetDataStore(prefix .. "Summaries")
        ordered, summaries = newOrdered, newSummaries
    end
    local cache = {}
    for _, entry in localBoards.Coins do
        summaries:SetAsync(tostring(entry.UserId), entry)
        cache[entry.UserId] = entry
        for _, key in keys do ordered[key]:SetAsync(tostring(entry.UserId), Rankings.EncodeScore(entry[key])) end
    end
    local result = {}
    for _, key in keys do
        result[key] = {}
        local page = ordered[key]:GetSortedAsync(false, 10):GetCurrentPage()
        for _, item in page do
            local userId = tonumber(item.key)
            if userId and not cache[userId] then cache[userId] = summaries:GetAsync(item.key) end
            local entry = userId and cache[userId]
            if type(entry) == "table" and type(entry.DisplayName) == "string" and type(entry[key]) == "number" then table.insert(result[key], entry) end
        end
    end
    return result
end
local function valueLabel(key: string, entry: any): string
    if key == "Coins" or key == "Capture" then return "$" .. Numbers.Format(entry[key]) .. (if key == "Capture" then "/s" else "") end
    if key == "Level" then return "NV." .. entry.ActualLevel .. " • " .. entry.Rebirths .. " rebirths" end
    return entry.Bestiary .. "/30 espécies"
end
local function displayPodium(entries: {any})
    local folder = ctx.World.GetPodiumFolder()
    if not folder then return end
    for rank = 1, 3 do
        local entry, pedestal = entries[rank], podium[rank]
        local signature = if entry then tostring(entry.UserId) .. ":" .. (if entry.Strongest then entry.Strongest.CreatureId .. entry.Strongest.Mutation .. entry.Strongest.Size else "") else ""
        if signature == displayed[rank] then continue end
        local previous = folder:FindFirstChild("Winner_" .. rank)
        if previous then previous:Destroy() end
        displayed[rank] = signature
        if not entry or not pedestal then continue end
        local holder = Instance.new("Folder")
        holder.Name, holder.Parent = "Winner_" .. rank, folder
        if not avatars[entry.UserId] and entry.UserId > 0 then
            local ok, avatar = pcall(function() return Players:CreateHumanoidModelFromUserIdAsync(entry.UserId) end)
            if ok then avatars[entry.UserId] = avatar end
        end
        if avatars[entry.UserId] then
            local avatar = avatars[entry.UserId]:Clone()
            avatar.Name = entry.DisplayName
            for _, descendant in avatar:GetDescendants() do
                if descendant:IsA("BasePart") then descendant.CanCollide = false end
                if descendant:IsA("BaseScript") then descendant.Enabled = false end
            end
            local root = avatar:FindFirstChild("HumanoidRootPart")
            if root and root:IsA("BasePart") then root.Anchored = true end
            avatar:PivotTo(CFrame.new(pedestal.Position + Vector3.new(-2, pedestal.Size.Y / 2 + 3.2, 0)))
            avatar.Parent = holder
        end
        local definition = entry.Strongest and Config.Creatures[entry.Strongest.CreatureId]
        if definition and ctx.AuthoredCreatures and ctx.AuthoredCreatures[entry.Strongest.CreatureId] then
            local pet = Instance.new("Model")
            pet.Name = "StrongestCreature"
            pet:SetAttribute("CreatureId", entry.Strongest.CreatureId)
            pet:SetAttribute("Mutation", entry.Strongest.Mutation)
            pet:SetAttribute("Size", entry.Strongest.Size)
            local root = Instance.new("Part")
            root.Anchored, root.CanCollide, root.CanQuery, root.CanTouch, root.Transparency = true, false, false, false, 1
            root.Position = pedestal.Position + Vector3.new(3, pedestal.Size.Y / 2 + 1.1, 0)
            root.Parent = pet
            pet.PrimaryPart, pet.Parent = root, holder
            ctx.World.Label(root, definition.Name, Vector3.new(0, 2, 0))
            CollectionService:AddTag(pet, "PodiumCreature")
        end
        local oldLabel = pedestal:FindFirstChild("Label")
        if oldLabel then oldLabel:Destroy() end
        ctx.World.Label(pedestal, "#" .. rank .. " " .. entry.DisplayName, Vector3.new(0, 7, 0))
    end
    local used: {[number]: boolean} = {}
    for rank = 1, math.min(3, #entries) do used[entries[rank].UserId] = true end
    for userId, avatar in avatars do if not used[userId] then avatar:Destroy(); avatars[userId] = nil end end
end
local function render()
    for _, key in keys do
        local lines = {titles[key], if lastResult.Mode == "Global" then "GLOBAL" else "DESTA SESSÃO"}
        for rank, entry in lastResult.Boards[key] do if rank > 10 then break end; table.insert(lines, rank .. ". " .. entry.DisplayName .. "  " .. valueLabel(key, entry)) end
        if boards[key] then boards[key].Text = table.concat(lines, "\n") end
    end
    displayPodium(lastResult.Boards.Coins)
end
function Rankings.Refresh()
    if busy then return end
    busy = true
    local ok, problem = pcall(function()
        local localBoards = sessionBoards()
        if ctx.Data.IsPersistent and ctx.Data.IsPersistent() then
            local globalOK, globalResult = pcall(globalBoards, localBoards)
            if globalOK then lastResult = {Mode = "Global", UpdatedAt = os.time(), Boards = globalResult}
            elseif lastResult.UpdatedAt == 0 then lastResult = {Mode = "SessionFallback", UpdatedAt = os.time(), Boards = localBoards}
            else warn("[Rankings] Keeping previous result after store failure:", globalResult) end
        else lastResult = {Mode = "Session", UpdatedAt = os.time(), Boards = localBoards} end
        render()
    end)
    busy = false
    if not ok then warn("[Rankings] Refresh failed:", problem) end
end
function Rankings.GetState(): any return lastResult end
function Rankings.Init(context: any)
    ctx = context
    local folder = ctx.World.GetPodiumFolder()
    if folder then
        for rank = 1, 3 do
            local pedestal = Instance.new("Part")
            pedestal.Name, pedestal.Anchored = "Place_" .. rank, true
            local height = if rank == 1 then 6 elseif rank == 2 then 4 else 2
            pedestal.Size = Vector3.new(12, height, 10)
            pedestal.Position = Layout.HubPosition + Vector3.new(if rank == 1 then 0 elseif rank == 2 then -15 else 15, height / 2, 12)
            pedestal.Color = if rank == 1 then Color3.fromRGB(255,212,63) elseif rank == 2 then Color3.fromRGB(190,205,220) else Color3.fromRGB(190,120,65)
            pedestal.Parent, podium[rank] = folder, pedestal
        end
        for index, key in keys do
            local board = Instance.new("Part")
            board.Name, board.Anchored, board.Size = "Leaderboard_" .. key, true, Vector3.new(27, 16, 1)
            board.Position, board.Color, board.Parent = Vector3.new(-45 + (index - 1) * 30, 9, 124), Color3.fromRGB(20,26,48), folder
            local surface = Instance.new("SurfaceGui")
            surface.Name, surface.Face, surface.CanvasSize, surface.Parent = "Board", Enum.NormalId.Front, Vector2.new(700, 500), board
            local text = Instance.new("TextLabel")
            text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
            text.Font, text.TextSize, text.TextWrapped = Enum.Font.GothamBold, 26, true
            text.TextColor3, text.TextYAlignment, text.Parent = Color3.new(1,1,1), Enum.TextYAlignment.Top, surface
            boards[key] = text
        end
    end
    if ctx.Data.AddSnapshotProvider then ctx.Data.AddSnapshotProvider(function() return {Leaderboards = lastResult} end) end
    if ctx.Data.OnLoaded then ctx.Data.OnLoaded(function() task.defer(Rankings.Refresh) end) end
    if not ctx.DisableLoops then task.spawn(function() while true do task.wait(60); Rankings.Refresh() end end) end
end
return Rankings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("ConfigMonetizacao"))
local Settings = require(Shared:WaitForChild("ConfigGameplay"))

local Monetization = {}
local ctx: any
local benefits: { [Player]: { [string]: boolean } } = {}
local checking: { [Player]: boolean } = {}
local initialized = false

local function copy(value: any): any
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in value do result[key] = copy(child) end
	return result
end

local function validId(id: any): boolean
	return type(id) == "number" and id > 0 and id < math.huge and id % 1 == 0
end

local function addCoins(profile: any, amount: number)
	profile.Coins += amount
	profile.TotalCoinsEarned = (profile.TotalCoinsEarned or 0) + amount
end

function Monetization.GetBenefits(player: Player): { [string]: boolean }
	return copy(benefits[player] or {})
end

local function refreshWorld(player: Player)
	if ctx.Sanctuary and ctx.Sanctuary.Refresh then ctx.Sanctuary.Refresh(player) end
	ctx.Data.Sync(player)
end

local function grantStarter(player: Player): boolean
	local profile = ctx.Data.Get(player)
	if not profile or profile.OneTimeGrants.StarterPack then return profile ~= nil end
	local owner = "StarterPack"
	if not ctx.Data.TryLock(player, owner) then return false end
	profile = ctx.Data.Get(player)
	if not profile or profile.OneTimeGrants.StarterPack then ctx.Data.Unlock(player, owner); return profile ~= nil end
	local snapshot = copy(profile)
	local used = if ctx.Data.GetInventoryCount then ctx.Data.GetInventoryCount(profile) else #profile.CapturedCreatures
	if used >= (Settings.MaxInventoryCreatures or 500) then ctx.Data.Unlock(player, owner); return false end
	addCoins(snapshot, 50000)
	snapshot.Orbs.Rubi = (snapshot.Orbs.Rubi or 0) + 10
	-- A curated promotional record, independent of the wild creature's base income.
	table.insert(snapshot.CapturedCreatures, {
		Uid = HttpService:GenerateGUID(false), CreatureId = "Cybermantis", Mutation = "Dourada", Size = "Normal",
		IncomePerSec = 500, CapturedAt = os.time(), FusionStage = 0,
	})
	snapshot.Bestiary.Cybermantis = true
	local oldBoost = snapshot.Boosts.Luck or { Multiplier = 1, ExpiresAt = 0 }
	snapshot.Boosts.Luck = { Multiplier = math.max(2, oldBoost.Multiplier), ExpiresAt = math.max(os.time(), oldBoost.ExpiresAt) + 1200 }
	snapshot.OneTimeGrants.StarterPack = true
	if not ctx.Data.Replace(player, snapshot) then
		ctx.Data.Freeze(player, "A recompensa precisa ser recuperada com segurança ao entrar novamente.")
		ctx.Data.Unlock(player, owner)
		return false
	end
	local saved = ctx.Data.SaveNow(player)
	if not saved then ctx.Data.Freeze(player, "Não foi possível confirmar sua recompensa. Entre novamente para protegê-la.") end
	ctx.Data.Unlock(player, owner)
	if saved then refreshWorld(player) end
	return saved
end

function Monetization.RefreshBenefits(player: Player)
	if checking[player] then return end
	checking[player] = true
	local result: { [string]: boolean } = {}
	for _, item in Catalog.Items do
		if item.Kind == "GamePass" then
			result[item.Key] = false
			if validId(item.Id) then
				local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, item.Id) end)
				-- Keep a verified session entitlement when a refresh cannot reach Roblox.
				result[item.Key] = if ok then owns == true else (benefits[player] or {})[item.Key] == true
			end
		end
	end
	result.GroupMember = false
	if validId(Settings.GroupId) then
		local ok, member = pcall(function() return player:IsInGroupAsync(Settings.GroupId) end)
		result.GroupMember = if ok then member == true else (benefits[player] or {}).GroupMember == true
	end
	checking[player] = nil
	if not player.Parent or not ctx.Data.Get(player) then return end
	benefits[player] = result
	if result.StarterPack then grantStarter(player) end
	refreshWorld(player)
end

local function productForId(productId: number): any
	for _, item in Catalog.Items do
		if item.Kind == "Product" and validId(item.Id) and item.Id == productId then return item end
	end
	return nil
end

function Monetization.ProcessReceipt(receipt: any): any
	local pending = Enum.ProductPurchaseDecision.NotProcessedYet
	if type(receipt) ~= "table" or not validId(receipt.PlayerId) or not validId(receipt.ProductId)
		or type(receipt.PurchaseId) ~= "string" or #receipt.PurchaseId == 0 or #receipt.PurchaseId > 200 then return pending end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not ctx.Data.IsLoaded(player) then return pending end
	local item = productForId(receipt.ProductId)
	if not item or item.FulfillmentReady ~= true then return pending end
	local owner = "Receipt:" .. receipt.PurchaseId
	if not ctx.Data.TryLock(player, owner) then return pending end
	local profile = ctx.Data.Get(player)
	if not profile then ctx.Data.Unlock(player, owner); return pending end
	local snapshot = copy(profile)
	if not snapshot.ProcessedReceipts[receipt.PurchaseId] then
		local masters = { MasterOrb1 = 1, MasterOrb3 = 3, MasterOrb10 = 10 }
		local quantity = masters[item.Key]
		if quantity then snapshot.Orbs.Mestre = (snapshot.Orbs.Mestre or 0) + quantity
		elseif item.Key == "SanctuarySlot" then
			-- A token is redeemable when capacity allows; purchases can never vanish at the cap.
			snapshot.Consumables.SanctuarySlot = (snapshot.Consumables.SanctuarySlot or 0) + 1
		elseif item.Key == "PotionPack" then
			snapshot.Consumables.PotionLuck3 = (snapshot.Consumables.PotionLuck3 or 0) + 1
			snapshot.Consumables.PotionCoins3 = (snapshot.Consumables.PotionCoins3 or 0) + 1
		elseif item.Key == "GlobalLuckTotem" or item.Key == "SummonEvent" or item.Key == "SkipFusion" then
			snapshot.Consumables[item.Key] = (snapshot.Consumables[item.Key] or 0) + 1
		else ctx.Data.Unlock(player, owner); return pending end
		snapshot.ProcessedReceipts[receipt.PurchaseId] = true
		if not ctx.Data.Replace(player, snapshot) then
			ctx.Data.Freeze(player, "A compra será recuperada com segurança ao entrar novamente.")
			ctx.Data.Unlock(player, owner)
			return pending
		end
	end
	local saved = ctx.Data.SaveNow(player)
	if not saved then ctx.Data.Freeze(player, "A confirmação da compra será recuperada ao entrar novamente.") end
	ctx.Data.Unlock(player, owner)
	if not saved then return pending end
	refreshWorld(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.Init(context: any)
	assert(not initialized, "MonetizationService.Init must only run once")
	initialized = true
	ctx = context
	ctx.Data.AddSnapshotProvider(function(player: Player, _profile: any)
		return { Benefits = Monetization.GetBenefits(player), SalesEnabled = Catalog.SalesEnabled == true }
	end)
	ctx.Data.OnLoaded(function(player: Player) Monetization.RefreshBenefits(player) end)
	ctx.Data.OnRemoving(function(player: Player) benefits[player] = nil; checking[player] = nil end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, _passId: number, purchased: boolean)
		if purchased and ctx.Data.IsLoaded(player) then Monetization.RefreshBenefits(player) end
	end)
	MarketplaceService.ProcessReceipt = Monetization.ProcessReceipt
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("ConfigProgression"))
local GameplayMath = require(Shared:WaitForChild("GameplayMath"))

local ProgressionService = {}
local dataService: any
local sanctuaryService: any
local context: any = nil
local lastActions: {[Player]: {[string]: number}} = {}
local remotes: any
local xpUntilCap: {[number]: number} = {[Config.Constants.MaxLevel] = 0}
for level = Config.Constants.MaxLevel - 1, 1, -1 do
    xpUntilCap[level] = xpUntilCap[level + 1] + Config.GetXPRequiredForLevel(level)
end
local function benefits(player: Player): any
    return if context and context.Monetization then context.Monetization.GetBenefits(player) else {}
end
local function allowed(player: Player, action: string, cooldown: number): boolean
    if not dataService.IsLoaded(player) or (dataService.IsBusy and dataService.IsBusy(player)) then return false end
    local actions = lastActions[player] or {}
    lastActions[player] = actions
    local now = os.clock()
    if now - (actions[action] or -math.huge) < cooldown then return false end
    actions[action] = now
    return true
end
local function feedback(player: Player, message: string, kind: string?)
    (remotes:WaitForChild("ActionFeedback") :: RemoteEvent):FireClient(player, {Message = message, Kind = kind or "Error"})
end
local function addCoins(player: Player, profile: any, amount: number)
    if dataService.AddCoins then dataService.AddCoins(player, amount) else profile.Coins += amount end
end
local function commit(player: Player, owner: string, mutation: (any) -> (boolean, string)): (boolean, string)
    if not dataService.TryLock or not dataService.TryLock(player, owner) then return false, "Aguarde concluir a operação atual." end
    local profile = dataService.Get(player)
    local ok, accepted, message = pcall(mutation, profile)
    if not ok then
        dataService.Unlock(player, owner)
        dataService.Freeze(player, "Não foi possível concluir esta operação com segurança.")
        warn("[Progression] Transaction failed:", accepted)
        return false, "Operação interrompida para proteger seus dados."
    end
    if not accepted then dataService.Unlock(player, owner); return false, message end
    local saved = dataService.SaveNow(player)
    dataService.Unlock(player, owner)
    if not saved then dataService.Freeze(player, "Não foi possível salvar seu progresso com segurança."); return false, "Salvamento indisponível." end
    dataService.Sync(player)
    return true, message
end

function ProgressionService.GrantXP(player: Player, amount: number): (boolean, number)
    local profile = dataService.Get(player)
    if not profile or type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount == math.huge then return false, 0 end
    if profile.Level >= Config.Constants.MaxLevel then profile.XP = 0; return false, 0 end
    local multiplier = if GameplayMath.GetXPMultiplier then GameplayMath.GetXPMultiplier(profile, benefits(player), os.time()) else 1
    local requested = math.floor(amount * multiplier)
    if requested ~= requested or requested == math.huge then return false, 0 end
    local remaining = xpUntilCap[profile.Level] - (profile.XP or 0)
    local gained = math.min(requested, math.max(0, remaining))
    profile.XP += gained
    local leveled = false
    while profile.Level < Config.Constants.MaxLevel and profile.XP >= Config.GetXPRequiredForLevel(profile.Level) do
        profile.XP -= Config.GetXPRequiredForLevel(profile.Level)
        profile.Level += 1
        addCoins(player, profile, profile.Level * 25)
        leveled = true
    end
    if profile.Level == Config.Constants.MaxLevel then profile.XP = 0 end
    if profile.Titles then
        if profile.Level >= 10 then profile.Titles.Cacador = true end
        if profile.Level >= 25 then profile.Titles.MestreDasOrbes = true end
    end
    if leveled then sanctuaryService.Refresh(player) end
    dataService.MarkDirty(player)
    return leveled, gained
end

function ProgressionService.Train(player: Player): (boolean, string)
    if context and context.Training and context.Training.IsTraining(player) then return false, "Você já está treinando na academia." end
    if not allowed(player, "TrainThrowPower", 0.5) then return false, "Aguarde o próximo treino." end
    local profile = dataService.Get(player)
    if not profile then return false, "Carregando seus dados." end
    local gain = if GameplayMath.GetTrainingGain then GameplayMath.GetTrainingGain(profile, benefits(player)) else Config.Constants.TrainingStrength or 1
    profile.ThrowStrength = math.min(10000, profile.ThrowStrength + gain)
    addCoins(player, profile, Config.Constants.TrainingCoins or 5)
    dataService.MarkDirty(player)
    dataService.Sync(player)
    return true, "Treino concluído."
end

function ProgressionService.Rebirth(player: Player): (boolean, string)
    if not allowed(player, "Rebirth", 1) then return false, "Aguarde concluir sua ação." end
    return commit(player, "Rebirth", function(profile)
        if not profile or profile.Level < Rules.RebirthLevel then return false, "Rebirth exige nível " .. Rules.RebirthLevel .. "." end
        profile.Rebirths += 1
        profile.Gems += Rules.RebirthGems
        profile.Level, profile.XP, profile.Coins = 1, 0, Rules.RebirthStartingCoins
        profile.PityBonus = 0
        profile.UnlockedBiomes = {PradariaSolar = true}
        local capacity = sanctuaryService.GetSlotCapacity(profile, benefits(player))
        while #profile.SanctuarySlots > capacity do table.remove(profile.SanctuarySlots) end
        sanctuaryService.Refresh(player)
        if context and context.Biomes and context.Biomes.ReturnToMeadow then context.Biomes.ReturnToMeadow(player) end
        return true, "Rebirth concluído! +5 gemas e bônus permanentes."
    end)
end

function ProgressionService.BuySlot(player: Player): (boolean, string)
    if not allowed(player, "BuySlot", 0.5) then return false, "Aguarde concluir sua ação." end
    return commit(player, "BuySlot", function(profile)
        if not profile then return false, "Carregando seus dados." end
        local capacity = sanctuaryService.GetSlotCapacity(profile, benefits(player))
        if capacity >= Rules.MaxSanctuarySlots then return false, "Seu santuário já tem 24 espaços." end
        local cost = Rules.GetExtraSlotCost(profile.ExtraSanctuarySlots or 0)
        if profile.Coins < cost then return false, "Moedas insuficientes para este espaço." end
        profile.Coins -= cost
        profile.ExtraSanctuarySlots = (profile.ExtraSanctuarySlots or 0) + 1
        sanctuaryService.Refresh(player)
        return true, "Mais um espaço liberado no santuário!"
    end)
end

function ProgressionService.EvolveOrb(player: Player, expectedTier: any): (boolean, string)
    if type(expectedTier) ~= "number" or not allowed(player, "EvolveOrb", 0.4) then
        return false, "Aguarde para evoluir a orbe."
    end
    return commit(player, "EvolveOrb", function(profile)
        if not profile or expectedTier ~= profile.OrbTier + 1 then return false, "Confira a próxima evolução." end
        for id, orb in Config.Orbs do
            if orb.Tier == expectedTier then
                local price, fragments = GameplayMath.GetOrbEvolutionPrice(orb.Price, profile.OrbFragments or 0)
                if profile.Coins < price then return false, "Moedas insuficientes para evoluir." end
                profile.Coins -= price
                profile.OrbFragments = (profile.OrbFragments or 0) - fragments
                profile.OrbTier, profile.EquippedOrb = expectedTier, id
                return true, orb.Name .. " evoluída e equipada!"
            end
        end
        return false, "Sua orbe já chegou à última evolução."
    end)
end

function ProgressionService.Init(service: any, sanctuary: any, remoteFolder: any, ctx: any?)
    dataService, sanctuaryService, remotes, context = service, sanctuary, remoteFolder, ctx
    local equipRemote = remotes:WaitForChild("EquipOrb") :: RemoteEvent
    local trainRemote = remotes:WaitForChild("TrainThrowPower") :: RemoteEvent
    equipRemote.OnServerEvent:Connect(function(player: Player, id: any)
        if typeof(id) ~= "string" or not allowed(player, "EquipOrb", 0.2) then return end
        local profile = dataService.Get(player)
        local orb = Config.Orbs[id]
        local infinite = orb and orb.IsPrismatic and benefits(player).EternalPrism == true
        local evolved = profile and orb and orb.Tier and orb.Tier <= (profile.OrbTier or 0)
        if not profile or not orb or ((profile.Orbs[id] or 0) < 1 and not infinite and not evolved) then feedback(player, "Você precisa ter essa orbe no inventário."); return end
        profile.EquippedOrb = id
        dataService.MarkDirty(player)
        dataService.Sync(player)
    end)
    trainRemote.OnServerEvent:Connect(function(player: Player) ProgressionService.Train(player) end)
    for name, action in {RebirthRequest = ProgressionService.Rebirth, BuySanctuarySlot = ProgressionService.BuySlot, EvolveOrb = ProgressionService.EvolveOrb} do
        local remote = remotes:FindFirstChild(name)
        if remote then remote.OnServerEvent:Connect(function(player: Player, argument: any)
            local success, message = action(player, argument)
            feedback(player, message, if success then "Success" else "Error")
        end) end
    end
    if service.AddSnapshotProvider then service.AddSnapshotProvider(function(player: Player, profile: any)
        local capacity = sanctuaryService.GetSlotCapacity(profile, benefits(player))
        return {Progression = {RebirthLevel = Rules.RebirthLevel, RebirthGems = Rules.RebirthGems, CanRebirth = profile.Level >= Rules.RebirthLevel,
            SlotCapacity = capacity, NextSlotCost = if capacity < Rules.MaxSanctuarySlots then Rules.GetExtraSlotCost(profile.ExtraSanctuarySlots or 0) else 0}}
    end) end
    Players.PlayerRemoving:Connect(function(player: Player) lastActions[player] = nil end)
end

return ProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("ConfigRecompensas"))

local RewardService = {}
local context: any
local lastRequests: {[Player]: {[string]: number}} = {}
local lastOnlineAt: {[Player]: number} = {}
local function dayKey(now: number): number return math.floor(now / 86400) end
local function finite(value: any): boolean return type(value) == "number" and value == value and math.abs(value) < math.huge end
local function allowed(player: Player, action: string): boolean
    if not context.Data.IsLoaded(player) or context.Data.IsBusy(player) then return false end
    local requests = lastRequests[player] or {}
    lastRequests[player] = requests
    if os.clock() - (requests[action] or -math.huge) < 0.4 then return false end
    requests[action] = os.clock()
    return true
end
local function resetMissionDay(profile: any, now: number)
    if profile.MissionDay == dayKey(now) then return end
    profile.MissionDay = dayKey(now)
    profile.MissionCounters = {Captures = 0, Criticals = 0, Fusions = 0}
    profile.MissionClaimed = {}
end
local function updateOnline(player: Player, profile: any, now: number)
    local previous = lastOnlineAt[player] or now
    lastOnlineAt[player] = now
    if profile.PlaytimeDay ~= dayKey(now) then
        profile.PlaytimeDay = dayKey(now)
        profile.PlaytimeClaimed = {}
        profile.OnlineSecondsToday = math.max(0, now - math.max(previous, profile.PlaytimeDay * 86400))
    else
        profile.OnlineSecondsToday += math.max(0, math.min(86400, now - previous))
    end
end
local function commit(player: Player, owner: string, mutation: (any) -> (boolean, string)): (boolean, string)
    local data = context.Data
    if not data.TryLock(player, owner) then return false, "Aguarde concluir a operação atual." end
    local ok, accepted, message = pcall(mutation, data.Get(player))
    if not ok then
        data.Unlock(player, owner)
        data.Freeze(player, "Uma recompensa foi interrompida para proteger seus dados.")
        warn("[RewardService]", accepted)
        return false, "Não foi possível concluir esta recompensa com segurança."
    end
    if not accepted then data.Unlock(player, owner); return false, message end
    local saved = data.SaveNow(player)
    data.Unlock(player, owner)
    if not saved then data.Freeze(player, "Não foi possível salvar esta recompensa com segurança."); return false, "Salvamento indisponível." end
    data.Sync(player)
    return true, message
end
local function integerMap(map: any, catalog: any): boolean
    if map == nil then return true end
    if type(map) ~= "table" then return false end
    for id, amount in pairs(map) do
        if type(id) ~= "string" or not catalog[id] or not finite(amount) or amount < 0 or amount % 1 ~= 0 then return false end
    end
    return true
end

function RewardService.CanGrant(profile: any, reward: any): (boolean, string)
    if not profile or type(reward) ~= "table" then return false, "Recompensa não disponível." end
    for _, key in {"Coins", "Gems", "XP", "WeeklyPets"} do
        local value = reward[key]
        if value ~= nil and (not finite(value) or value < 0 or value % 1 ~= 0) then return false, "Configuração de recompensa inválida." end
    end
    if not integerMap(reward.Orbs, Config.Orbs) or not integerMap(reward.Consumables, Rules.Consumables) then return false, "Itens de recompensa inválidos." end
    if reward.Creature then
        if type(reward.Creature) ~= "table" or not Config.Creatures[reward.Creature.Id] then return false, "Criatura de recompensa indisponível." end
        local count = if context.Data.GetInventoryCount then context.Data.GetInventoryCount(profile) else #profile.CapturedCreatures
        local available = not context.AuthoredCreatures or context.AuthoredCreatures[reward.Creature.Id]
        if available and count >= (Config.Constants.MaxInventoryCreatures or 500) then return false, "Libere espaço no inventário para receber esta criatura." end
        local foundMutation, foundSize = false, false
        for _, item in Config.Mutations do if item.Name == reward.Creature.Mutation then foundMutation = true end end
        for _, item in Config.Sizes do if item.Name == reward.Creature.Size then foundSize = true end end
        if not foundMutation or not foundSize then return false, "Variante de recompensa inválida." end
    end
    if reward.Titles ~= nil then
        if type(reward.Titles) ~= "table" then return false, "Título de recompensa inválido." end
        for name, enabled in reward.Titles do if type(name) ~= "string" or #name > 80 or enabled ~= true then return false, "Título de recompensa inválido." end end
    end
    return true, ""
end

-- Internal server API. The caller owns any needed transaction lock and save.
function RewardService.GrantReward(player: Player, reward: any): (boolean, string)
    local profile = context.Data.Get(player)
    local valid, message = RewardService.CanGrant(profile, reward)
    if not valid then return false, message end
    local coinAmount = (reward.Coins or 0) * (if reward.ScaleCoinsWithLevel then math.max(1, profile.Level) else 1)
    if coinAmount > 0 then context.Data.AddCoins(player, coinAmount) end
    profile.Gems += reward.Gems or 0
    profile.WeeklyPets += reward.WeeklyPets or 0
    for id, quantity in reward.Orbs or {} do profile.Orbs[id] = (profile.Orbs[id] or 0) + quantity end
    for id, quantity in reward.Consumables or {} do profile.Consumables[id] = (profile.Consumables[id] or 0) + quantity end
    for title in reward.Titles or {} do profile.Titles[title] = true end
    if reward.Creature and (not context.AuthoredCreatures or context.AuthoredCreatures[reward.Creature.Id]) then
        local definition = Config.Creatures[reward.Creature.Id]
        local mutationMultiplier, sizeMultiplier = 1, 1
        for _, item in Config.Mutations do if item.Name == reward.Creature.Mutation then mutationMultiplier = item.Multiplier end end
        for _, item in Config.Sizes do if item.Name == reward.Creature.Size then sizeMultiplier = item.Multiplier end end
        local record = {Uid = HttpService:GenerateGUID(false), CreatureId = definition.Id, Mutation = reward.Creature.Mutation,
            Size = reward.Creature.Size, IncomePerSec = math.floor(definition.BaseIncomePerSec * mutationMultiplier * sizeMultiplier), CapturedAt = os.time()}
        assert(context.Sanctuary.AddCapture(player, record), "Reward creature could not be added")
    end
    if (reward.XP or 0) > 0 then context.Progression.GrantXP(player, reward.XP) end
    context.Data.MarkDirty(player)
    return true, "Recompensa recebida!"
end

function RewardService.ClaimDaily(player: Player): (boolean, string)
    if not allowed(player, "Daily") then return false, "Aguarde concluir sua ação." end
    return commit(player, "DailyReward", function(profile)
        local now = os.time()
        if profile.LastDailyClaim > 0 and now - profile.LastDailyClaim < Rules.DailyIntervalSeconds then return false, "A recompensa diária ainda não está pronta." end
        local nextDay = if profile.LastDailyClaim == 0 or now - profile.LastDailyClaim >= Rules.StreakBreakSeconds then 1 else profile.DailyStreak % 7 + 1
        local success, message = RewardService.GrantReward(player, Rules.Daily[nextDay])
        if not success then return false, message end
        profile.DailyStreak, profile.LastDailyClaim = nextDay, now
        return true, "Recompensa diária " .. nextDay .. "/7 recebida!"
    end)
end

function RewardService.ClaimPlaytime(player: Player, rewardId: any): (boolean, string)
    if not finite(rewardId) or rewardId % 1 ~= 0 or not Rules.Playtime[rewardId] then return false, "Presente inválido." end
    if not allowed(player, "Playtime") then return false, "Aguarde concluir sua ação." end
    return commit(player, "PlaytimeReward", function(profile)
        updateOnline(player, profile, os.time())
        local id, reward = tostring(rewardId), Rules.Playtime[rewardId]
        if profile.PlaytimeClaimed[id] then return false, "Você já recebeu este presente hoje." end
        if profile.OnlineSecondsToday < reward.Seconds then return false, "Continue jogando para liberar este presente." end
        local success, message = RewardService.GrantReward(player, reward)
        if not success then return false, message end
        profile.PlaytimeClaimed[id] = true
        return true, "Presente de tempo de jogo recebido!"
    end)
end

function RewardService.OnProgress(player: Player, kind: string, amount: number?)
    local profile = context.Data.Get(player)
    if not profile then return end
    local aliases = {Capture = "Captures", Critical = "Criticals", Fusion = "Fusions"}
    local counter = aliases[kind] or kind
    if counter ~= "Captures" and counter ~= "Criticals" and counter ~= "Fusions" then return end
    local count = amount or 1
    if not finite(count) or count <= 0 or count % 1 ~= 0 then return end
    resetMissionDay(profile, os.time())
    if profile.Level < Rules.MissionLevel then return end
    profile.MissionCounters[counter] = (profile.MissionCounters[counter] or 0) + count
    context.Data.MarkDirty(player)
end

function RewardService.ClaimMission(player: Player, missionId: any): (boolean, string)
    if type(missionId) ~= "string" or not Rules.Missions[missionId] then return false, "Missão inválida." end
    if not allowed(player, "Mission") then return false, "Aguarde concluir sua ação." end
    return commit(player, "MissionReward", function(profile)
        resetMissionDay(profile, os.time())
        local mission = Rules.Missions[missionId]
        local requiredLevel = math.max(Rules.MissionLevel, mission.RequiredLevel or Rules.MissionLevel)
        if profile.Level < requiredLevel then return false, "Esta missão exige nível " .. requiredLevel .. "." end
        if profile.MissionClaimed[missionId] then return false, "Missão já resgatada hoje." end
        if (profile.MissionCounters[mission.Counter] or 0) < mission.Target then return false, "Complete o objetivo antes de resgatar." end
        local biome = if context.Biomes then context.Biomes.GetCurrentBiome(player) else "PradariaSolar"
        local orbId = Rules.BiomeOrbs[biome] or "Comum"
        local success, message = RewardService.GrantReward(player, {Orbs = {[orbId] = mission.OrbQuantity}, XP = mission.XP, Gems = mission.Gems})
        if not success then return false, message end
        profile.MissionClaimed[missionId] = true
        return true, "Missão concluída! Orbes, XP e gemas recebidos."
    end)
end

function RewardService.ClaimBestiary(player: Player, biomeId: any): (boolean, string)
    if type(biomeId) ~= "string" or not Config.Biomes[biomeId] then return false, "Bioma inválido." end
    if not allowed(player, "Bestiary") then return false, "Aguarde concluir sua ação." end
    return commit(player, "BestiaryReward", function(profile)
        if profile.BestiaryRewardClaimed[biomeId] then return false, "Bônus deste bioma já recebido." end
        local required = 0
        for id, definition in context.EncounterCreatures or Config.Creatures do
            if definition.Biome == biomeId then required += 1; if not profile.Bestiary[id] then return false, "Descubra todas as criaturas deste bioma." end end
        end
        if required == 0 then return false, "Este bioma ainda não possui uma coleção." end
        local success, message = RewardService.GrantReward(player, {Coins = Rules.BestiaryCoins[biomeId] or 0, Titles = {["Bestiario_" .. biomeId] = true}})
        if not success then return false, message end
        profile.BestiaryRewardClaimed[biomeId] = true
        return true, "Bestiário completo! +10% de sorte permanente e recompensa recebida."
    end)
end

function RewardService.RedeemCode(player: Player, codeText: any): (boolean, string)
    if type(codeText) ~= "string" or #codeText > 64 then return false, "Código inválido." end
    if not allowed(player, "Code") then return false, "Aguarde concluir sua ação." end
    local code = string.upper(codeText:match("^%s*(.-)%s*$") or "")
    local definition = Rules.Codes[code]
    if type(definition) ~= "table" then return false, "Este código não está ativo." end
    if definition.ExpiresAt ~= nil and not finite(definition.ExpiresAt) then return false, "Código temporariamente indisponível." end
    if definition.MinLevel ~= nil and (not finite(definition.MinLevel) or definition.MinLevel < 1 or definition.MinLevel % 1 ~= 0) then return false, "Código temporariamente indisponível." end
    return commit(player, "CodeReward", function(profile)
        if definition.ExpiresAt and os.time() >= definition.ExpiresAt then return false, "Este código expirou." end
        if profile.RedeemedCodes[code] then return false, "Você já resgatou este código." end
        if profile.Level < (definition.MinLevel or 1) then return false, "Seu nível ainda não libera este código." end
        local success, message = RewardService.GrantReward(player, definition.Reward or definition)
        if not success then return false, message end
        profile.RedeemedCodes[code] = true
        return true, "Código resgatado!"
    end)
end

function RewardService.ClaimGroup(player: Player): (boolean, string)
    if not allowed(player, "Group") then return false, "Aguarde concluir sua ação." end
    if not context.Monetization.GetBenefits(player).GroupMember then return false, "Entre no grupo oficial para liberar este bônus." end
    return commit(player, "GroupReward", function(profile)
        if profile.GroupRewardClaimed then return false, "Seu bônus de grupo já foi reconhecido." end
        profile.GroupRewardClaimed, profile.Titles.Grupo = true, true
        context.Sanctuary.Refresh(player)
        return true, "Bônus de grupo reconhecido: sorte, espaço extra e Auto-Treino!"
    end)
end

function RewardService.ClaimVIP(player: Player): (boolean, string)
    if not allowed(player, "VIP") then return false, "Aguarde concluir sua ação." end
    if not context.Monetization.GetBenefits(player).GoldenVIP then return false, "Este baú exige o passe VIP Dourado." end
    return commit(player, "VIPReward", function(profile)
        local timestamp = os.time()
        if (profile.VIPLastClaim or 0) > 0 and timestamp - profile.VIPLastClaim < Rules.VIP.IntervalSeconds then return false, "Seu próximo baú VIP ainda não está pronto." end
        local success, message = RewardService.GrantReward(player, Rules.VIP.Reward)
        if not success then return false, message end
        profile.VIPLastClaim = timestamp
        return true, "Baú VIP diário recebido!"
    end)
end

local function useGlobalEffect(player: Player, itemId: string, item: any): (boolean, string)
    local data = context.Data
    if not data.TryLock(player, "GlobalConsumable") then return false, "Aguarde concluir sua ação." end
    local profile = data.Get(player)
    if not profile or (profile.Consumables[itemId] or 0) < 1 then data.Unlock(player, "GlobalConsumable"); return false, "Você não possui este consumível." end
    profile.Consumables[itemId] -= 1
    if not data.SaveNow(player) then
        data.Unlock(player, "GlobalConsumable")
        data.Freeze(player, "Não foi possível salvar o uso deste item com segurança.")
        return false, "Salvamento indisponível; o efeito não foi ativado."
    end
    -- Global effects only run after the debit is durable. A rejected effect is
    -- refunded durably under the same lock, so no other operation can spend it.
    local ok, activated = pcall(function()
        if not context.Weather then return false end
        if item.Kind == "GlobalLuck" then return context.Weather.ActivateGlobalLuck(player, item.Multiplier, item.Duration) end
        return context.Weather.SummonEvent(player)
    end)
    if not ok or activated ~= true then
        profile.Consumables[itemId] += 1
        local refunded = data.SaveNow(player)
        data.Unlock(player, "GlobalConsumable")
        if not refunded then data.Freeze(player, "A devolução deste item está sendo protegida. Entre novamente."); return false, "Não foi possível confirmar a devolução com segurança." end
        data.Sync(player)
        return false, "O evento não pôde ser ativado. Seu consumível foi devolvido."
    end
    data.Unlock(player, "GlobalConsumable")
    data.Sync(player)
    return true, "Consumível global ativado!"
end

function RewardService.UseConsumable(player: Player, itemId: any): (boolean, string)
    if type(itemId) ~= "string" or not Rules.Consumables[itemId] then return false, "Consumível inválido." end
    if not allowed(player, "Consumable") then return false, "Aguarde concluir sua ação." end
    local definition = Rules.Consumables[itemId]
    if definition.Kind == "GlobalLuck" or definition.Kind == "SummonEvent" then return useGlobalEffect(player, itemId, definition) end
    return commit(player, "Consumable", function(profile)
        if (profile.Consumables[itemId] or 0) < 1 then return false, "Você não possui este consumível." end
        local item, now = Rules.Consumables[itemId], os.time()
        if item.Stat then
            local previous = profile.Boosts[item.Stat]
            local active = previous and previous.ExpiresAt > now
            if active and previous.Multiplier > item.Multiplier then return false, "Uma poção mais forte já está ativa." end
            local expires = if active and previous.Multiplier == item.Multiplier then previous.ExpiresAt + item.Duration else now + item.Duration
            profile.Boosts[item.Stat] = {Multiplier = item.Multiplier, ExpiresAt = expires}
        elseif item.Kind == "SkipFusion" then
            if (profile.FusionReadyAt or 0) <= now then return false, "A máquina de fusão já está pronta." end
            profile.FusionReadyAt = 0
        elseif item.Kind == "SanctuarySlot" then
            if context.Sanctuary.GetSlotCapacity(profile, context.Monetization.GetBenefits(player)) >= 24 then return false, "Você já tem 24 espaços. O token foi preservado." end
            profile.ExtraSanctuarySlots += 1
        else return false, "Consumível não disponível." end
        profile.Consumables[itemId] -= 1
        context.Sanctuary.Refresh(player)
        return true, "Consumível ativado!"
    end)
end

function RewardService.GetSnapshot(player: Player, profile: any): any
    local now = os.time()
    local currentDay = dayKey(now)
    local elapsed = math.max(0, now - (lastOnlineAt[player] or now))
    local seconds = if profile.PlaytimeDay == currentDay then profile.OnlineSecondsToday + elapsed else math.max(0, now - math.max(lastOnlineAt[player] or now, currentDay * 86400))
    local nextDay = if profile.LastDailyClaim == 0 or now - profile.LastDailyClaim >= Rules.StreakBreakSeconds then 1 else profile.DailyStreak % 7 + 1
    return {Rewards = {
        Daily = {NextDay = nextDay, CanClaim = profile.LastDailyClaim == 0 or now - profile.LastDailyClaim >= Rules.DailyIntervalSeconds, NextClaimAt = if profile.LastDailyClaim == 0 then 0 else profile.LastDailyClaim + Rules.DailyIntervalSeconds},
        Playtime = {DayKey = currentDay, Seconds = seconds, Claimed = if profile.PlaytimeDay == currentDay then profile.PlaytimeClaimed else {}},
        Missions = {DayKey = currentDay, Counters = if profile.MissionDay == currentDay then profile.MissionCounters else {Captures = 0, Criticals = 0, Fusions = 0}, Claimed = if profile.MissionDay == currentDay then profile.MissionClaimed else {}, Unlocked = profile.Level >= Rules.MissionLevel},
        VIP = {CanClaim = context.Monetization.GetBenefits(player).GoldenVIP == true and ((profile.VIPLastClaim or 0) == 0 or now - profile.VIPLastClaim >= Rules.VIP.IntervalSeconds), NextClaimAt = if (profile.VIPLastClaim or 0) == 0 then 0 else profile.VIPLastClaim + Rules.VIP.IntervalSeconds},
    }}
end

function RewardService.Init(ctx: any)
    context = ctx
    ctx.Data.OnLoaded(function(player: Player, profile: any)
        lastOnlineAt[player] = os.time()
        updateOnline(player, profile, os.time())
        resetMissionDay(profile, os.time())
    end)
    ctx.Data.OnRemoving(function(player: Player, profile: any)
        updateOnline(player, profile, os.time())
        lastOnlineAt[player], lastRequests[player] = nil, nil
    end)
    local actions = {ClaimDailyReward = RewardService.ClaimDaily, ClaimPlaytimeReward = RewardService.ClaimPlaytime,
        ClaimMissionReward = RewardService.ClaimMission, ClaimBestiaryReward = RewardService.ClaimBestiary,
        RedeemCode = RewardService.RedeemCode, UseConsumable = RewardService.UseConsumable, ClaimGroupReward = RewardService.ClaimGroup, ClaimVIPReward = RewardService.ClaimVIP}
    for name, action in actions do
        local remote = ctx.Remotes:FindFirstChild(name)
        if remote then remote.OnServerEvent:Connect(function(player: Player, id: any)
            local success, message = action(player, id)
            ctx.Remotes.ActionFeedback:FireClient(player, {Message = message, Kind = if success then "Success" else "Error"})
        end) end
    end
    ctx.Data.AddSnapshotProvider(RewardService.GetSnapshot)
    task.spawn(function()
        while true do
            task.wait(1)
            for _, player in Players:GetPlayers() do
                local profile = ctx.Data.Get(player)
                if profile and not ctx.Data.IsBusy(player) then updateOnline(player, profile, os.time()); ctx.Data.MarkDirty(player) end
            end
        end
    end)
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">SanctuaryService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local GameplayMath = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameplayMath"))

local SanctuaryService = {}
local dataService: any
local worldService: any
local context: any = nil
local function benefits(player: Player): any
	return if context and context.Monetization then context.Monetization.GetBenefits(player) else {}
end

function SanctuaryService.HasArt(id: string): boolean
	return not context or not context.AuthoredCreatures or context.AuthoredCreatures[id] == true
end

local function recordIndex(records: {any}, uid: any): number?
	if type(uid) ~= "string" or #uid > 80 then return nil end
	for index, record in records do
		if record.Uid == uid then return index end
	end
	return nil
end

local function bestRecords(profile: any): {any}
	local candidates = {}
	for _, record in profile.CapturedCreatures do
		if SanctuaryService.HasArt(record.CreatureId) then table.insert(candidates, record) end
	end
	table.sort(candidates, function(a, b)
		if a.IncomePerSec ~= b.IncomePerSec then return a.IncomePerSec > b.IncomePerSec end
		return a.Uid < b.Uid
	end)
	return candidates
end

function SanctuaryService.GetSlotCapacity(profile: any, playerBenefits: any?): number
	if GameplayMath.GetSlotCapacity then return GameplayMath.GetSlotCapacity(profile, playerBenefits or {}) end
	return Config.Constants.BaseSanctuarySlots + (if profile.Level >= 5 then 1 else 0) + (if profile.Level >= 15 then 1 else 0)
end

function SanctuaryService.CalculateBaseIncome(profile: any, playerBenefits: any?, shares: {[string]: number}?): number
	local records: { [string]: any } = {}
	for _, record in ipairs(profile.CapturedCreatures) do
		records[record.Uid] = record
	end
	local elementCounts: { [string]: number } = {}
	local equipped = {}
	local seen = {}
	for index, uid in ipairs(profile.SanctuarySlots) do
		if index > SanctuaryService.GetSlotCapacity(profile, playerBenefits) then
			break
		end
		local record = records[uid]
		local definition = record and Config.Creatures[record.CreatureId]
		if definition and not seen[uid] and (SanctuaryService.HasArt(record.CreatureId) or (context and context.AuthoredCreatures and not next(context.AuthoredCreatures))) then
			seen[uid] = true
			table.insert(equipped, record)
			elementCounts[definition.Element] = (elementCounts[definition.Element] or 0) + 1
		end
	end
	local starterTrio = false
	local starters = { Pyrokit = false, Aquapup = false, Sproutling = false }
	for _, record in ipairs(equipped) do
		if starters[record.CreatureId] ~= nil then
			starters[record.CreatureId] = true
		end
	end
	starterTrio = starters.Pyrokit and starters.Aquapup and starters.Sproutling
	local income = 0
	for _, record in ipairs(equipped) do
		local count = elementCounts[Config.Creatures[record.CreatureId].Element]
		local groupBonus = if count >= 6 then 1.6 elseif count >= 3 then 1.25 else 1
		local share = record.IncomePerSec * groupBonus
		income += share
		if shares then shares[record.Uid] = share * (if starterTrio then 1.4 else 1) end
	end
	return income * (if starterTrio then 1.4 else 1)
end

function SanctuaryService.CalculateIncome(profile: any, playerBenefits: any?, now: number?, shares: {[string]: number}?): number
	local multiplier = if GameplayMath.GetIncomeMultiplier then GameplayMath.GetIncomeMultiplier(profile, playerBenefits or {}, now or os.time()) else 1 + profile.Rebirths
	local income = SanctuaryService.CalculateBaseIncome(profile, playerBenefits, shares) * multiplier
	if shares then for uid, share in shares do shares[uid] = share * multiplier end end
	return income
end

function SanctuaryService.Refresh(player: Player)
	local profile = dataService.Get(player)
	if profile then
		profile.IncomePerSec = SanctuaryService.CalculateIncome(profile, benefits(player))
		worldService.UpdateSanctuary(player, profile)
	end
end

function SanctuaryService.CanCapture(player: Player): boolean
	local profile = dataService.Get(player)
	if not profile then return false end
	local count = if dataService.GetInventoryCount then dataService.GetInventoryCount(profile) else #profile.CapturedCreatures
	return count < (Config.Constants.MaxInventoryCreatures or 500)
end

function SanctuaryService.AddCapture(player: Player, record: any): boolean
	local profile = dataService.Get(player)
	if not profile or not SanctuaryService.HasArt(record.CreatureId) or not SanctuaryService.CanCapture(player) then
		return false
	end
	table.insert(profile.CapturedCreatures, record)
	profile.Bestiary[record.CreatureId] = true
	if #profile.SanctuarySlots < SanctuaryService.GetSlotCapacity(profile, benefits(player)) then
		table.insert(profile.SanctuarySlots, record.Uid)
	end
	SanctuaryService.Refresh(player)
	dataService.MarkDirty(player)
	return true
end

function SanctuaryService.Manage(player: Player, action: any, uid: any, outgoing: any): (boolean, string)
	if action ~= "Best" and action ~= "Replace" and action ~= "Sell" then return false, "Ação inválida." end
	if not dataService.IsLoaded(player) or dataService.IsBusy(player) then return false, "Aguarde a ação atual." end
	local profile = dataService.Get(player)
	if not profile then return false, "Carregando suas criaturas." end
	local slots, records = profile.SanctuarySlots, profile.CapturedCreatures
	if action == "Best" then
		local nextSlots = {}
		local capacity = SanctuaryService.GetSlotCapacity(profile, benefits(player))
		for index, record in bestRecords(profile) do
			if index > capacity then break end
			table.insert(nextSlots, record.Uid)
		end
		if #nextSlots == 0 then return false, "Nenhuma criatura com modelo disponível." end
		profile.SanctuarySlots = nextSlots
	elseif action == "Replace" then
		local index = recordIndex(records, uid)
		local slot = if type(outgoing) == "string" and #outgoing <= 80 then table.find(slots, outgoing) else nil
		if not index or not slot or table.find(slots, uid) or not SanctuaryService.HasArt(records[index].CreatureId) then
			return false, "Atualize a seleção e escolha novamente."
		end
		slots[slot] = uid
	else
		local index = recordIndex(records, uid)
		if not index or table.find(slots, uid) then return false, "Só é possível vender criaturas do inventário." end
		local owner = "SellCreature"
		if not dataService.TryLock(player, owner) then return false, "Aguarde a ação atual." end
		local price = GameplayMath.GetCreatureSalePrice(records[index].IncomePerSec)
		if not dataService.AddCoins(player, price) then
			dataService.Unlock(player, owner)
			return false, "O saldo não pôde ser atualizado."
		end
		table.remove(records, index)
		dataService.MarkDirty(player)
		local saved = dataService.SaveNow(player)
		if not saved then dataService.Freeze(player, "Salvamento da venda indisponível.") end
		dataService.Unlock(player, owner)
		if not saved then return false, "Não foi possível confirmar a venda." end
	end
	SanctuaryService.Refresh(player)
	dataService.MarkDirty(player)
	dataService.Sync(player)
	return true, if action == "Best" then "Curral atualizado com as melhores rendas." elseif action == "Replace" then "Criatura substituída." else "Criatura vendida."
end

function SanctuaryService.Init(service: any, world: any, ctx: any?)
	dataService = service
	worldService = world
	context = ctx
	dataService.OnLoaded(function(player: Player, profile: any)
		worldService.AssignSanctuary(player)
		if context and context.AuthoredCreatures and next(context.AuthoredCreatures) then
			local oldCount = #profile.SanctuarySlots
			local visible: {[string]: boolean} = {}
			for _, record in profile.CapturedCreatures do
				if SanctuaryService.HasArt(record.CreatureId) then visible[record.Uid] = true end
			end
			local slots = profile.SanctuarySlots
			for index = #slots, 1, -1 do
				if not visible[slots[index]] then table.remove(slots, index) end
			end
			if #slots < oldCount then
				local target = math.min(oldCount, SanctuaryService.GetSlotCapacity(profile, benefits(player)))
				for _, record in bestRecords(profile) do
					if #slots >= target then break end
					if not table.find(slots, record.Uid) then table.insert(slots, record.Uid) end
				end
			end
		end
		local playerBenefits = benefits(player)
		profile.IncomePerSec = SanctuaryService.CalculateIncome(profile, playerBenefits)
		local elapsed = math.clamp(os.time() - profile.LastSeen, 0, Config.Constants.MaxOfflineSeconds)
		-- No offline grant in ephemeral Studio sessions (LastSeen is initialized at join).
		profile.OfflineReward = if GameplayMath.GetOfflineIncome then math.floor(GameplayMath.GetOfflineIncome(profile, SanctuaryService.CalculateBaseIncome(profile, playerBenefits), elapsed, playerBenefits, os.time())) else math.floor(elapsed * profile.IncomePerSec)
		if service.AddCoins then service.AddCoins(player, profile.OfflineReward) else profile.Coins += profile.OfflineReward end
		profile.LastSeen = os.time()
		worldService.UpdateSanctuary(player, profile)
	end)
	dataService.OnRemoving(function(player: Player)
		worldService.ReleaseSanctuary(player)
	end)
	local remoteFolder = ReplicatedStorage:WaitForChild("Remotes")
	local lastEquip: { [Player]: number } = {}
	local manage = remoteFolder:FindFirstChild("ManageCreature")
	if manage and manage:IsA("RemoteEvent") then
		manage.OnServerEvent:Connect(function(player, action, uid, outgoing)
			local now = os.clock()
			if now - (lastEquip[player] or -math.huge) < .3 then return end
			lastEquip[player] = now
			local ok, message = SanctuaryService.Manage(player, action, uid, outgoing)
			local feedback = remoteFolder:WaitForChild("ActionFeedback") :: RemoteEvent
			feedback:FireClient(player, {Message = message, Kind = if ok then "Success" else "Error"})
		end)
	end
	(remoteFolder:WaitForChild("EquipToSanctuary") :: RemoteEvent).OnServerEvent:Connect(function(player: Player, uid: any)
		if typeof(uid) ~= "string" or #uid > 80 then
			return
		end
		if not service.IsLoaded(player) or (service.IsBusy and service.IsBusy(player)) then return end
		local now = os.clock()
		if now - (lastEquip[player] or -math.huge) < 0.25 then
			return
		end
		lastEquip[player] = now
		local profile = dataService.Get(player)
		if not profile then
			return
		end
		local index = recordIndex(profile.CapturedCreatures, uid)
		if not index then
			return
		end
		local slot = table.find(profile.SanctuarySlots, uid)
		if slot then
			table.remove(profile.SanctuarySlots, slot)
		elseif SanctuaryService.HasArt(profile.CapturedCreatures[index].CreatureId) and #profile.SanctuarySlots < SanctuaryService.GetSlotCapacity(profile, benefits(player)) then
			table.insert(profile.SanctuarySlots, uid)
		else
			(remoteFolder:WaitForChild("ActionFeedback") :: RemoteEvent):FireClient(player, { Message = "Curral cheio ou arte indisponível. Confira o inventário.", Kind = "Error" })
			return
		end
		SanctuaryService.Refresh(player)
		dataService.MarkDirty(player)
		dataService.Sync(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastEquip[player] = nil
	end)
	if service.AddSnapshotProvider then service.AddSnapshotProvider(function(player: Player, profile: any)
		return {SlotCapacity = SanctuaryService.GetSlotCapacity(profile, benefits(player))}
	end) end
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = dataService.Get(player)
				if profile and (not (service.IsBusy and service.IsBusy(player)) or (player.GetAttribute and player:GetAttribute("FlightInProgress") == true)) then
					local shares = if worldService.UpdateSanctuaryIncome then {} else nil
					profile.IncomePerSec = SanctuaryService.CalculateIncome(profile, benefits(player), nil, shares)
					if shares then worldService.UpdateSanctuaryIncome(player, shares) end
					if service.AddCoins then service.AddCoins(player, profile.IncomePerSec) else profile.Coins += profile.IncomePerSec end
					dataService.Sync(player)
				end
			end
		end
	end)
end

return SanctuaryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local NumberFormatter = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormatter"))

export type WildRecord = {
	CreatureId: string,
	Mutation: string,
	Size: string,
	IncomePerSec: number,
	Scale: number,
	SpawnPosition: Vector3,
	LockedUntil: number,
	LockedBy: number?,
	LockVersion: number,
	PendingCaptured: boolean,
	BiomeId: string?, Kind: string?, EventId: string?, BossId: string?, ExpiresAt: number?,
	SpawnChance: number?, NoRespawn: boolean?, Retiring: boolean?,
	MutationRoll: number?, SizeRoll: number?, VariantLuck: number?,
}

local SpawnService = {}
local random = Random.new()
local registry: {[Model]: WildRecord} = {}
local wildFolder: Folder? = nil
local ctx: any
local settings: any
local gameplay: any

local function rollWeighted(items: {any}, luck: number?): (any, number)
	local total = 0
	local factor = luck or 1
	for _, item in ipairs(items) do total += item.Weight * (if item.Name ~= "Normal" then factor else 1) end
	local roll = random:NextNumber(0, total)
	local accumulated = 0
	for _, item in ipairs(items) do
		accumulated += item.Weight * (if item.Name ~= "Normal" then factor else 1)
		if roll < accumulated then return item, roll / total end
	end
	return items[#items], 1 - 1e-12
end

local function createPart(model: Model, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local item = Instance.new("Part")
	item.Name = name
	item.Anchored = true
	item.CanCollide = false
	item.Size = size
	item.Position = position
	item.Color = color
	item.TopSurface = Enum.SurfaceType.Studs
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = model
	return item
end

function SpawnService.Spawn(creatureId: string, position: Vector3, options: any?): Model?
	if ctx and ctx.AuthoredCreatures and not ctx.AuthoredCreatures[creatureId] then return nil end
	options = options or {}
	local definition = Config.Creatures[creatureId]
	assert(definition, "Unknown creature: " .. creatureId)
	local luck = if ctx and ctx.Weather then ctx.Weather.GetLuckMultiplier() else 1
	local mutation, mutationRoll = rollWeighted(Config.Mutations, luck)
	local size, sizeRoll = rollWeighted(Config.Sizes, luck)
	local scale = size.Scale
	local model = Instance.new("Model")
	model.Name = creatureId
	local color = definition.BodyColor
	if mutation.Name ~= "Normal" and mutation.Color then color = color:Lerp(mutation.Color, 0.6) end
	local body = createPart(model, "Body", Vector3.new(3, 2, 2.5) * scale, position + Vector3.new(0, 1.1 * scale, 0), color)
	local head = createPart(model, "Head", Vector3.new(1.8, 1.5, 1.8) * scale, position + Vector3.new(0, 2.7 * scale, -0.4 * scale), color:Lerp(Color3.new(1, 1, 1), 0.18))
	body.Transparency, head.Transparency = 1, 1
	model.PrimaryPart = body
	local income = math.floor(definition.BaseIncomePerSec * mutation.Multiplier * size.Multiplier)
	registry[model] = {
		CreatureId = creatureId, Mutation = mutation.Name, Size = size.Name,
		IncomePerSec = income, Scale = scale, SpawnPosition = position,
		LockedUntil = 0, LockedBy = nil, LockVersion = 0, PendingCaptured = false,
		BiomeId = options.BiomeId or definition.Biome or "PradariaSolar", Kind = options.Kind or "Wild",
		EventId = options.EventId, BossId = options.BossId, ExpiresAt = options.ExpiresAt,
		SpawnChance = options.SpawnChance, NoRespawn = options.NoRespawn == true,
		MutationRoll = mutationRoll, SizeRoll = sizeRoll, VariantLuck = luck,
	}
	model:SetAttribute("CreatureId", creatureId)
	model:SetAttribute("ArtScale", scale)
	model:SetAttribute("Mutation", mutation.Name)
	model:SetAttribute("Size", size.Name)
	model:SetAttribute("IncomePerSec", income)
	model:SetAttribute("LockedUntil", 0)
	model:SetAttribute("CaptureOwner", 0)
	model:SetAttribute("BiomeId", registry[model].BiomeId)
	model:SetAttribute("Kind", registry[model].Kind)
	if options.ExpiresAt then model:SetAttribute("ExpiresAt", options.ExpiresAt) end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CreatureLabel"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(230, 76)
	billboard.StudsOffset = Vector3.new(0, 2 * scale, 0)
	billboard.MaxDistance = 24
	billboard.Enabled = options.Kind == "Boss"
	billboard.Parent = head
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 0.1
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 15
	textLabel.Text = string.format("%s [%s]\n%s • %s\n$%s/s", definition.Name, definition.Rarity, mutation.Name, size.Name, NumberFormatter.Format(income))
	textLabel.Parent = billboard
	model.Parent = wildFolder
	return model
end

function SpawnService.ChooseSpecies(biomeId: string): (string?, number?)
	if ctx and ctx.EncounterPools then
		local groups = ctx.EncounterPools[biomeId]
		if not groups then return nil, nil end
		return ctx.FlightMath.Encounter(groups, ctx.FlightRules.RarityDenominators, random)
	end
	local secretChance = settings and settings.SecretSpawnChance or 0
	if secretChance > 0 and random:NextNumber() < secretChance then return "Omnisfera", secretChance end
	local pool, total = {}, 0
	for id, definition in (ctx and ctx.EncounterCreatures) or Config.Creatures do
		if definition.Biome == biomeId then
			local weight = settings.SpeciesWeights[definition.Rarity] or 1
			total += weight
			table.insert(pool, {Id = id, Weight = weight})
		end
	end
	table.sort(pool, function(a, b) return a.Id < b.Id end)
	if total <= 0 then return nil, nil end
	local roll, accumulated = random:NextNumber(0, total), 0
	for _, item in pool do
		accumulated += item.Weight
		if roll < accumulated then return item.Id, (1 - secretChance) * item.Weight / total end
	end
	return pool[#pool].Id, (1 - secretChance) * pool[#pool].Weight / total
end

function SpawnService.Init(worldOrContext: any, context: any?)
	ctx = context or (if worldOrContext.Data then worldOrContext else nil)
	if wildFolder then return end
	local folder = Instance.new("Folder")
	folder.Name = "CriaturasSelvagens"
	folder.Parent = Workspace
	wildFolder = folder
	if ctx then
		settings = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigEvents"))
		gameplay = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameplayMath"))
		local layout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigWorld"))
		for _, biomeId in layout.BiomeOrder do
			local species = {}
			if ctx.EncounterPools then
				local groups = ctx.EncounterPools[biomeId]
				if biomeId == "FlorestaNeon" then
					-- Display a representative cross-section, including large silhouettes.
					for _, id in {"Floradine", "Flutterwing", "Lancewasp", "Jungleking", "Velvetlynx", "Dustwing"} do
						if ctx.AuthoredCreatures[id] then table.insert(species, id) end
					end
				end
				if #species == 0 then species = groups.Comum or {} end
			else
				for id, definition in Config.Creatures do
					if definition.Biome == biomeId then table.insert(species, id) end
				end
				table.sort(species)
			end
			for index, position in ctx.World.GetSpawnPoints(biomeId) do
				if #species > 0 then SpawnService.Spawn(species[(index - 1) % #species + 1], position, {BiomeId = biomeId}) end
			end
			task.wait()
		end
		if not ctx.DisableLoops then task.spawn(function()
			while true do
				task.wait(0.5)
				local timestamp = Workspace:GetServerTimeNow()
				for model, record in registry do
					if model.Parent and model.PrimaryPart and not record.PendingCaptured and not record.Retiring and record.Kind == "Wild" and record.LockedUntil <= timestamp then
						local offset = Vector3.new(math.sin(timestamp * 0.3 + record.SpawnPosition.X) * 4, 0, math.cos(timestamp * 0.3 + record.SpawnPosition.Z) * 4)
						local destination = record.SpawnPosition + offset
						local displacement = Vector3.new(destination.X - model.PrimaryPart.Position.X, 0, destination.Z - model.PrimaryPart.Position.Z)
						model:PivotTo(model:GetPivot() + displacement)
					end
				end
			end
		end) end
		return
	end
	local initial = {
		{"Sproutling", Vector3.new(-18, 0.15, -2)},
		{"Pyrokit", Vector3.new(0, 0.15, -9)},
		{"Aquapup", Vector3.new(18, 0.15, -2)},
		{"Voltmouse", Vector3.new(-27, 0.15, -15)},
		{"Fluffhop", Vector3.new(0, 0.15, -23)},
		{"Buzzleaf", Vector3.new(27, 0.15, -15)},
	}
	for _, entry in ipairs(initial) do
		SpawnService.Spawn(entry[1] :: string, entry[2] :: Vector3)
	end
end

function SpawnService.Get(model: Model): WildRecord?
	local record = registry[model]
	if not record or not model.Parent or record.PendingCaptured or record.Retiring then return nil end
	if record.ExpiresAt and Workspace:GetServerTimeNow() >= record.ExpiresAt then return nil end
	return record
end

function SpawnService.Lock(model: Model, userId: number): boolean
	local record = SpawnService.Get(model)
	local now = Workspace:GetServerTimeNow()
	if not record or record.LockedUntil > now then return false end
	record.LockedUntil = now + Config.Constants.CaptureLockSeconds
	record.LockedBy = userId
	record.LockVersion += 1
	model:SetAttribute("LockedUntil", record.LockedUntil)
	model:SetAttribute("CaptureOwner", userId)
	return true
end

function SpawnService.Resolve(model: Model, captured: boolean)
	local record = registry[model]
	if not record then return end
	local lockVersion = record.LockVersion
	-- Retain visual model during the animation, but make successful captures
	-- unavailable to every future request immediately.
	record.PendingCaptured = captured
	task.delay(Config.Constants.CaptureLockSeconds, function()
		-- A delayed unlock from a failed attempt must not release a newer lock
		-- acquired after this attempt's timeout.
		if registry[model] ~= record or record.LockVersion ~= lockVersion then return end
		if captured then
			registry[model] = nil
			model:Destroy()
				if not record.NoRespawn then task.delay(2, function()
					if wildFolder and wildFolder.Parent then
						local id, chance = record.CreatureId, nil
						if ctx and record.BiomeId then id, chance = SpawnService.ChooseSpecies(record.BiomeId) end
						if id then SpawnService.Spawn(id, record.SpawnPosition, {BiomeId = record.BiomeId, SpawnChance = chance}) end
					end
				end) end
		else
			record.LockedUntil = 0
			record.LockedBy = nil
			if model.Parent then
				model:SetAttribute("LockedUntil", 0)
				model:SetAttribute("CaptureOwner", 0)
			end
			if record.Retiring then SpawnService.Retire(model) end
		end
	end)
end

function SpawnService.GetAll(): {{Model: Model, Record: WildRecord}}
	local result = {}
	for model, record in registry do if SpawnService.Get(model) then table.insert(result, {Model = model, Record = record}) end end
	return result
end
function SpawnService.Retire(model: Model)
	local record = registry[model]
	if not record then return end
	record.Retiring, record.NoRespawn = true, true
	local remaining = record.LockedUntil - Workspace:GetServerTimeNow()
	if record.PendingCaptured or remaining > 0 then
		task.delay(math.max(0.2, remaining + 0.2), function() if registry[model] == record then SpawnService.Retire(model) end end)
		return
	end
	registry[model] = nil
	model:Destroy()
end
function SpawnService.RemoveEvent(eventId: string)
	for model, record in registry do if record.EventId == eventId then SpawnService.Retire(model) end end
end
function SpawnService.FindAutoTarget(player: Player, biomeId: string?): (Model?, Vector3?)
	if not ctx then return nil, nil end
	local profile = ctx.Data.Get(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not profile or not root or not root:IsA("BasePart") then return nil, nil end
	local benefits = if ctx.Monetization then ctx.Monetization.GetBenefits(player) else {}
	local range = gameplay.GetRange(profile, benefits)
	local nearest, best = nil, math.huge
	for _, entry in SpawnService.GetAll() do
		local model, record = entry.Model, entry.Record
		if model.PrimaryPart and (not biomeId or record.BiomeId == biomeId) and (not ctx.Biomes or ctx.Biomes.CanAccess(player, record.BiomeId or "PradariaSolar")) and record.LockedUntil <= Workspace:GetServerTimeNow() then
			local distance = (root.Position - model.PrimaryPart.Position).Magnitude
			if distance <= range and distance < best then nearest, best = model, distance end
		end
	end
	return nearest, if nearest and nearest.PrimaryPart then nearest.PrimaryPart.Position else nil
end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[--!strict
-- One durable decision coordinates both profiles. Prepared assets are unusable
-- under the profile locks; committed patches are replayed idempotently on load.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Settings = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigGameplay"))

local Trade = {}
local ctx: any
local initialized = false
local coordinatorStore: any = nil
local memoryCoordinators: { [string]: any } = {}
local sessions: { [string]: any } = {}
local playerSessions: { [Player]: string } = {}
local lastAction: { [Player]: number } = {}

local function copy(value: any): any
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in value do result[key] = copy(child) end
	return result
end

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function feedback(player: Player, message: string, success: boolean?)
	local remote = ctx.Remotes:FindFirstChild("ActionFeedback")
	if remote and player.Parent then remote:FireClient(player, {Message = message, Kind = if success then "Success" else "Error"}) end
end

local function sync(player: Player, allowBusy: boolean?)
	if ctx.Data.Get(player) then ctx.Data.Sync(player, allowBusy) end
end

function Trade.NewId(prefix: string?): string
	return (prefix or "Trade") .. "_" .. string.gsub(HttpService:GenerateGUID(false), "-", "")
end

-- These coordinator operations are also used by the local auction escrow.
function Trade.UpdateCoordinator(key: string, transform: (any) -> any): (boolean, any)
	local ok, result = pcall(function()
		if not ctx.Data.IsPersistent() then
			local nextValue = transform(copy(memoryCoordinators[key]))
			if nextValue ~= nil then memoryCoordinators[key] = copy(nextValue) end
			return copy(memoryCoordinators[key])
		end
		if not coordinatorStore then coordinatorStore = DataStoreService:GetDataStore("ThrowASphere_Transactions_v2") end
		return coordinatorStore:UpdateAsync(key, function(previous: any) return transform(copy(previous)) end)
	end)
	return ok, result
end

function Trade.ReadCoordinator(key: string): (boolean, any)
	-- UpdateAsync supplies a current value and avoids GetAsync's per-server cache.
	return Trade.UpdateCoordinator(key, function(previous: any) return previous end)
end

function Trade.AbortCoordinator(key: string): (boolean, any)
	return Trade.UpdateCoordinator(key, function(previous: any)
		if type(previous) == "table" and (previous.State == "Prepared" or previous.State == "Open") then
			previous.State = "Aborted"
			previous.DecidedAt = os.time()
		end
		return previous
	end)
end

local function refresh(player: Player)
	if ctx.Data.Get(player) and ctx.Sanctuary and ctx.Sanctuary.Refresh then ctx.Sanctuary.Refresh(player) end
	sync(player)
end

local function validCapture(record: any): boolean
	return type(record) == "table" and type(record.Uid) == "string" and #record.Uid > 0 and #record.Uid <= 80
		and type(record.CreatureId) == "string" and type(record.Mutation) == "string" and type(record.Size) == "string"
		and finite(record.IncomePerSec) and record.IncomePerSec >= 0 and finite(record.CapturedAt)
end

function Trade.ValidatePatch(profile: any, patch: any, ignoreKey: string?): (boolean, string?)
	if type(patch) ~= "table" or type(patch.GiveUids) ~= "table" or type(patch.Receive) ~= "table" or not finite(patch.CoinsDelta) then return false, "Transação inválida." end
	local owned, giving, incoming = {}, {}, {}
	for _, record in profile.CapturedCreatures do owned[record.Uid] = true end
	for _, uid in patch.GiveUids do
		if type(uid) ~= "string" or not owned[uid] or giving[uid] then return false, "Uma criatura da oferta não está disponível." end
		giving[uid] = true
	end
	for _, record in patch.Receive do
		if not validCapture(record) or incoming[record.Uid] or (owned[record.Uid] and not giving[record.Uid]) then return false, "Criatura recebida duplicada ou inválida." end
		incoming[record.Uid] = true
	end
	local reserved = if ctx.Data.GetReservedSlots then ctx.Data.GetReservedSlots(profile) else 0
	local ignored = if ignoreKey then profile.PendingTransactions[ignoreKey] else nil
	if ignored then reserved = math.max(0, reserved - (ignored.ReservedSlots or 0)) end
	if #profile.CapturedCreatures - #patch.GiveUids + #patch.Receive + reserved > (Settings.MaxInventoryCreatures or 500) then return false, "Não há espaço no inventário." end
	if profile.Coins + patch.CoinsDelta < 0 or not finite(profile.Coins + patch.CoinsDelta) then return false, "Moedas insuficientes." end
	return true, nil
end

local function patched(profile: any, patch: any, key: string, markApplied: boolean): any
	local result = copy(profile)
	local giving: { [string]: boolean } = {}
	for _, uid in patch.GiveUids or {} do giving[uid] = true end
	local captures = {}
	local owned = {}
	for _, record in result.CapturedCreatures do
		if not giving[record.Uid] then table.insert(captures, record); owned[record.Uid] = true end
	end
	for _, record in patch.Receive or {} do
		assert(validCapture(record), "Invalid transaction capture")
		-- A retry can observe a receive that was already applied. Never clone its UID.
		if not owned[record.Uid] then table.insert(captures, copy(record)); owned[record.Uid] = true end
		result.Bestiary[record.CreatureId] = true
	end
	result.CapturedCreatures = captures
	local slots = {}
	for _, uid in result.SanctuarySlots do if owned[uid] then table.insert(slots, uid) end end
	result.SanctuarySlots = slots
	result.Coins += patch.CoinsDelta or 0
	assert(finite(result.Coins) and result.Coins >= 0, "Invalid transaction balance")
	result.PendingTransactions[key] = nil
	if markApplied then result.AppliedTransactions[key] = true end
	-- Transfers do not create lifetime coins/capture counts and cannot inflate ranks.
	return result
end

function Trade.ApplyDecision(player: Player, key: string, decision: any, owner: string): boolean
	if type(decision) ~= "table" or (decision.State ~= "Committed" and decision.State ~= "Aborted") then return false end
	local profile = ctx.Data.Get(player)
	if not profile then return false end
	local pending = profile.PendingTransactions[key]
	if not pending then return true end
	if profile.AppliedTransactions[key] then
		local snapshot = copy(profile)
		snapshot.PendingTransactions[key] = nil
		if not ctx.Data.Replace(player, snapshot) then ctx.Data.Freeze(player, "Sua transação requer recuperação segura."); return false end
	else
		local patch = nil
		if decision.State == "Committed" then patch = (decision.Participants or {})[tostring(player.UserId)] end
		if not patch then
			-- Auction escrows have already removed the asset/coins. On abort, or
			-- for an outbid participant absent from the winner set, refund them.
			patch = if pending.Kind == "Auction" then {GiveUids = {}, Receive = pending.Receive or {}, CoinsDelta = pending.CoinsDelta or 0}
				else {GiveUids = {}, Receive = {}, CoinsDelta = 0}
		end
		if not ctx.Data.Replace(player, patched(profile, patch, key, true)) then ctx.Data.Freeze(player, "Sua transação requer recuperação segura."); return false end
	end
	if not ctx.Data.SaveNow(player) then
		ctx.Data.Freeze(player, "Sua transação será recuperada com segurança ao entrar novamente.")
		return false
	end
	refresh(player)
	return true
end

-- Refund an outbid escrow while the auction remains open. Clearing the pending
-- record and returning the balance happen in the same durable profile write.
function Trade.RefundOpenAuction(player: Player, key: string): boolean
	local owner = "AuctionRefund:" .. key
	if not ctx.Data.TryLock(player, owner) then return false end
	local profile = ctx.Data.Get(player)
	local pending = profile and profile.PendingTransactions[key]
	if not pending then ctx.Data.Unlock(player, owner); return profile ~= nil end
	local snapshot = patched(profile, {GiveUids = {}, Receive = pending.Receive or {}, CoinsDelta = pending.CoinsDelta or 0}, key, false)
	if not ctx.Data.Replace(player, snapshot) then
		ctx.Data.Freeze(player, "Sua restituição requer recuperação segura.")
		ctx.Data.Unlock(player, owner)
		return false
	end
	local saved = ctx.Data.SaveNow(player)
	if not saved then ctx.Data.Freeze(player, "Sua restituição será recuperada ao entrar novamente.") end
	ctx.Data.Unlock(player, owner)
	if saved then refresh(player) end
	return saved
end

function Trade.RecoverPlayer(player: Player, profile: any)
	local keys = {}
	for key in profile.PendingTransactions do table.insert(keys, key) end
	table.sort(keys)
	if #keys == 0 then return end
	local owner = "Recovery"
	assert(ctx.Data.TryLock(player, owner), "Recovery could not acquire profile")
	for _, key in keys do
		local ok, decision = Trade.ReadCoordinator(key)
		if not ok or type(decision) ~= "table" then
			ctx.Data.Unlock(player, owner)
			error("Transaction coordinator unavailable; profile preserved")
		end
		if decision.State == "Prepared" or decision.State == "Open" then ok, decision = Trade.AbortCoordinator(key) end
		if not ok or type(decision) ~= "table" or (decision.State ~= "Committed" and decision.State ~= "Aborted") then
			ctx.Data.Unlock(player, owner)
			error("Transaction decision unavailable; profile preserved")
		end
		if not Trade.ApplyDecision(player, key, decision, owner) then
			ctx.Data.Unlock(player, owner)
			error("Transaction recovery save failed; profile preserved")
		end
	end
	ctx.Data.Unlock(player, owner)
end

local function releaseSession(session: any)
	for _, player in session.Players do ctx.Data.Unlock(player, session.Id) end
end

local function removeSession(session: any, message: string?)
	releaseSession(session)
	sessions[session.Id] = nil
	for _, player in session.Players do
		if playerSessions[player] == session.Id then playerSessions[player] = nil end
		if message then feedback(player, message, true) end
		sync(player)
	end
end

local function locationAllowed(player: Player): boolean
	return ctx.Biomes ~= nil and ctx.Biomes.IsInTradingPlaza ~= nil and ctx.Biomes.IsInTradingPlaza(player)
end

local function eligible(player: Player): boolean
	local profile = ctx.Data.Get(player)
	return ctx.Data.IsLoaded(player) and profile ~= nil and profile.Level >= 15 and locationAllowed(player)
end

function Trade.GetSnapshot(player: Player): any
	local session = sessions[playerSessions[player] or ""]
	if not session then return {} end
	local partner = if session.Players[1] == player then session.Players[2] else session.Players[1]
	local partnerCreatures = {}
	local partnerProfile = ctx.Data.Get(partner)
	if partnerProfile then
		local offered = {}
		for _, uid in session.Offers[partner.UserId] do offered[uid] = true end
		for _, record in partnerProfile.CapturedCreatures do if offered[record.Uid] then table.insert(partnerCreatures, copy(record)) end end
	end
	return {
		SessionId = session.Id, PartnerUserId = partner.UserId, PartnerName = partner.DisplayName,
		Revision = session.Revision, Phase = session.Phase,
		ReadyAt = if session.ReadyAt then os.time() + math.max(0, session.ReadyAt - os.clock()) else 0,
		MyOffer = copy(session.Offers[player.UserId]), PartnerOffer = copy(session.Offers[partner.UserId]),
		PartnerCreatures = partnerCreatures,
		MyReady = session.Ready[player.UserId] == true, PartnerReady = session.Ready[partner.UserId] == true,
		MyConfirmed = session.Confirmed[player.UserId] == true, PartnerConfirmed = session.Confirmed[partner.UserId] == true,
		InviterUserId = session.Players[1].UserId,
	}
end

local function syncSession(session: any)
	for _, player in session.Players do sync(player, session.Phase == "Review" or session.Phase == "Committing") end
end

local function findRecords(profile: any, uids: any): ({any}?, string?)
	if type(uids) ~= "table" or #uids > (Settings.MaxTradeOfferCreatures or 8) then return nil, "Oferta inválida." end
	local byUid = {}
	for _, record in profile.CapturedCreatures do byUid[record.Uid] = record end
	local seen, records = {}, {}
	for key, uid in uids do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #uids then return nil, "Oferta inválida." end
		if type(uid) ~= "string" or not byUid[uid] or seen[uid] then return nil, "Você não possui uma das criaturas ofertadas." end
		seen[uid] = true
		table.insert(records, copy(byUid[uid]))
	end
	if #records ~= #uids then return nil, "Oferta inválida." end
	return records, nil
end

local function execute(session: any)
	local patches = {}
	local players = session.Players
	for index, player in players do
		local partner = players[3 - index]
		local profile, other = ctx.Data.Get(player), ctx.Data.Get(partner)
		if not profile or not other or not eligible(player) then removeSession(session, "A troca foi cancelada."); return end
		local received = findRecords(other, session.Offers[partner.UserId])
		if not received then removeSession(session, "Uma oferta mudou. A troca foi cancelada."); return end
		patches[tostring(player.UserId)] = { GiveUids = copy(session.Offers[player.UserId]), Receive = received, CoinsDelta = 0 }
		local valid, reason = Trade.ValidatePatch(profile, patches[tostring(player.UserId)])
		if not valid then removeSession(session, reason); return end
	end
	local ok, journal = Trade.UpdateCoordinator(session.Id, function(previous: any)
		if previous ~= nil then return previous end
		return {Kind = "Trade", State = "Prepared", Participants = patches, CreatedAt = os.time()}
	end)
	if not ok or not journal or journal.State ~= "Prepared" then
		removeSession(session, "Não foi possível preparar a troca. Nada foi transferido."); return
	end
	local prepared = true
	for index, player in players do
		local profile = ctx.Data.Get(player)
		if not profile then prepared = false; break end
		local snapshot = copy(profile)
		local patch = patches[tostring(player.UserId)]
		snapshot.PendingTransactions[session.Id] = {
			Kind = "Trade", CoordinatorKey = session.Id, PartnerUserId = players[3 - index].UserId,
			GiveUids = copy(patch.GiveUids), Receive = copy(patch.Receive), CoinsDelta = 0, State = "Prepared",
			ReservedSlots = math.max(0, #patch.Receive - #patch.GiveUids),
		}
		if not ctx.Data.Replace(player, snapshot) then prepared = false; break end
		if not ctx.Data.SaveNow(player) then prepared = false; break end
	end
	if prepared then
		for _, player in players do if not player.Parent or not ctx.Data.Get(player) then prepared = false end end
	end
	if prepared then
		ok, journal = Trade.UpdateCoordinator(session.Id, function(previous: any)
			if previous and previous.State == "Prepared" then previous.State = "Committed"; previous.DecidedAt = os.time() end
			return previous
		end)
	else ok, journal = Trade.AbortCoordinator(session.Id) end
	if not ok or not journal or (journal.State ~= "Committed" and journal.State ~= "Aborted") then
		for _, player in players do if ctx.Data.Get(player) then ctx.Data.Freeze(player, "A decisão da troca será recuperada ao entrar novamente.") end end
		removeSession(session)
		return
	end
	for _, player in players do
		if ctx.Data.Get(player) then Trade.ApplyDecision(player, session.Id, journal, session.Id) end
	end
	removeSession(session, if journal.State == "Committed" then "Troca concluída e salva!" else "Troca cancelada. Suas criaturas foram preservadas.")
end

function Trade.HandleAction(player: Player, action: any, payload: any)
	if type(action) ~= "string" or type(payload) ~= "table" then return end
	local now = os.clock()
	if now - (lastAction[player] or -math.huge) < 0.15 then return end
	lastAction[player] = now
	if action == "Invite" then
		if not eligible(player) or ctx.Data.IsBusy(player) or playerSessions[player] then feedback(player, "Vá à praça de trocas no nível 15 ou superior."); return end
		if not finite(payload.TargetUserId) then return end
		local target = Players:GetPlayerByUserId(payload.TargetUserId)
		if not target or target == player or not eligible(target) or ctx.Data.IsBusy(target) or playerSessions[target] then feedback(player, "Esse jogador não está disponível para troca."); return end
		local id = Trade.NewId()
		local session = { Id = id, Players = {player, target}, Offers = {[player.UserId] = {}, [target.UserId] = {}},
			Revision = 1, Phase = "Invited", Ready = {}, Confirmed = {}, ExpiresAt = now + 60 }
		sessions[id] = session; playerSessions[player] = id; playerSessions[target] = id
		syncSession(session)
		return
	end
	local session = sessions[playerSessions[player] or ""]
	if not session or payload.SessionId ~= session.Id or session.Phase == "Committing" then return end
	if action == "Cancel" then removeSession(session, "Troca cancelada."); return end
	if not eligible(player) then removeSession(session, "A troca foi cancelada ao sair da praça."); return end
	if action == "Accept" then
		if session.Phase ~= "Invited" or player == session.Players[1] then return end
		session.Phase = "Offering"; session.ExpiresAt = now + 180; syncSession(session); return
	end
	if payload.Revision ~= session.Revision or session.Phase == "Invited" then feedback(player, "A oferta mudou. Confira a versão atual."); return end
	if action == "Offer" then
		local profile = ctx.Data.Get(player)
		if not profile then return end
		local records, reason = findRecords(profile, payload.Uids)
		if not records then feedback(player, reason or "Oferta inválida."); return end
		releaseSession(session)
		session.Offers[player.UserId] = copy(payload.Uids)
		session.Revision += 1; session.Ready = {}; session.Confirmed = {}; session.ReadyAt = nil
		session.Phase = "Offering"; session.ExpiresAt = now + 180
		syncSession(session)
	elseif action == "Ready" and session.Phase == "Offering" then
		session.Ready[player.UserId] = true
		local first, second = session.Players[1], session.Players[2]
		if session.Ready[first.UserId] and session.Ready[second.UserId] then
			if #session.Offers[first.UserId] + #session.Offers[second.UserId] == 0 then session.Ready = {}; feedback(player, "Escolha ao menos uma criatura."); syncSession(session); return end
			if not eligible(first) or not eligible(second) or not ctx.Data.TryLock(first, session.Id) then session.Ready = {}; syncSession(session); return end
			if not ctx.Data.TryLock(second, session.Id) then ctx.Data.Unlock(first, session.Id); session.Ready = {}; syncSession(session); return end
			session.Phase = "Review"; session.ReadyAt = now + 3; session.ExpiresAt = now + 60
		end
		syncSession(session)
	elseif action == "Confirm" and session.Phase == "Review" then
		if now < session.ReadyAt then feedback(player, "Revise a troca e aguarde os 3 segundos."); return end
		session.Confirmed[player.UserId] = true
		local first, second = session.Players[1], session.Players[2]
		if session.Confirmed[first.UserId] and session.Confirmed[second.UserId] then
			session.Phase = "Committing"
			syncSession(session)
			task.spawn(execute, session)
		else syncSession(session) end
	end
end

function Trade.Init(context: any)
	assert(not initialized, "TradeService.Init must only run once")
	initialized = true
	ctx = context
	ctx.Data.OnLoaded(Trade.RecoverPlayer)
	ctx.Data.OnRemoving(function(player: Player)
		lastAction[player] = nil
		local session = sessions[playerSessions[player] or ""]
		if session and session.Phase ~= "Committing" then removeSession(session, "O outro jogador saiu. Troca cancelada.") end
	end)
	ctx.Data.AddSnapshotProvider(function(player: Player, _profile: any)
		local candidates = {}
		for _, other in Players:GetPlayers() do
			if other ~= player and eligible(other) and not ctx.Data.IsBusy(other) and not playerSessions[other] then
				table.insert(candidates, {UserId = other.UserId, Name = other.DisplayName})
			end
		end
		table.sort(candidates, function(a, b) return a.UserId < b.UserId end)
		return {Trade = Trade.GetSnapshot(player), TradeCandidates = candidates}
	end)
	local remote = ctx.Remotes:WaitForChild("TradeAction") :: RemoteEvent
	remote.OnServerEvent:Connect(Trade.HandleAction)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, session in sessions do
				if session.Phase ~= "Committing" and (os.clock() >= session.ExpiresAt
					or not eligible(session.Players[1]) or not eligible(session.Players[2])) then removeSession(session, "Troca encerrada sem transferências.") end
			end
		end
	end)
end

return Trade
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">TrainingService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Workspace=game:GetService("Workspace")
local Http=game:GetService("HttpService")
local Rules=require(RS.Shared.ConfigTraining)
local Math=require(RS.Shared.TrainingMath)
local Training={}
local ctx:any
local sessions:{[Player]:any}={}
local requests:{[Player]:number}={}
local upgradeRequests: {[Player]: number} = {}

local function machine(profile: any): any
    return Rules.Machines[profile.TrainingMachine or 1]
end
function Training.IsTraining(player:Player):boolean return sessions[player]~=nil end
local function snapshot(player:Player):any
    local p=ctx.Data.Get(player)
    if not p then return {} end
    local s=sessions[player]
    local tier = p.TrainingMachine or 1
    local titan = ctx.Monetization.GetBenefits(player).TitanArms == true
    local stats = Math.Repetition(p.TrainingLevel, tier, titan, Rules)
    local nextStats = if Rules.Machines[tier + 1] then Math.Repetition(p.TrainingLevel, tier + 1, titan, Rules) else nil
    return {Active=s~=nil,Level=p.TrainingLevel,XP=p.TrainingXP,RequiredXP=Math.RequiredXP(p.TrainingLevel,Rules),
        MaxLevel = Rules.MaxLevel, Strength = p.ThrowStrength, Gain = stats.Force, XPPerRep = stats.XP,
        Reps = if s then s.Reps else 0, Interval = if s then s.Interval else stats.Interval, NextRepAt = if s then s.NextAt else nil,
        MachineTier = tier, MachineName = machine(p).Name, NextMachineStats = nextStats}
end
local function send(player:Player,state:string,extra:any?)
    local data=snapshot(player)
    data.State=state
    for k,v in extra or {} do data[k]=v end
    if player.Parent then ctx.Remotes.TrainingUpdate:FireClient(player,data) end
end
function Training.Stop(player:Player)
    local s=sessions[player]
    if not s then return end
    sessions[player]=nil
    player:SetAttribute("TrainingActive",false)
    if s.Root and s.Root.Parent then s.Root.Anchored=s.Anchored;s.Root.AssemblyLinearVelocity=Vector3.zero end
    if s.Humanoid and s.Humanoid.Parent then s.Humanoid.WalkSpeed=s.Speed;s.Humanoid.AutoRotate=s.AutoRotate end
    ctx.Remotes.TrainingPose:FireAllClients({Player=player,Active=false})
    send(player,"Stopped")
    ctx.Data.MarkDirty(player);ctx.Data.Sync(player)
end
function Training.Start(player:Player,travel:boolean?):boolean
    local now=Workspace:GetServerTimeNow()
    local profile = ctx.Data.Get(player)
    if now<(requests[player] or 0) or sessions[player] or ctx.Data.IsBusy(player) or not ctx.Data.IsLoaded(player) or not profile or (ctx.Flight and ctx.Flight.IsActive(player)) then return false end
    requests[player]=now+Rules.RequestCooldown
    local lot=ctx.World.GetSanctuary(player)
    local anchor=lot and lot:FindFirstChild("PersonalTraining")
    local character=player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not anchor or not anchor:IsA("BasePart") or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health<=0 then return false end
    if not travel and (root.Position-anchor.Position).Magnitude>16 then return false end
    local interval = Rules.RepSeconds - machine(profile).Speed
    local s={Character=character,Root=root,Humanoid=humanoid,Anchored=root.Anchored,Speed=humanoid.WalkSpeed,AutoRotate=humanoid.AutoRotate,
        Anchor=anchor,Reps=0,StartedAt=now,Interval=interval,NextAt=now+interval,QTE=nil}
    sessions[player]=s
    character:PivotTo(CFrame.lookAt(anchor.Position+Vector3.new(0,3,0),anchor.Position+Vector3.new(0,3,-10)))
    root.Anchored,humanoid.WalkSpeed,humanoid.AutoRotate=true,0,false
    player:SetAttribute("TrainingActive",true)
    ctx.Remotes.TrainingPose:FireAllClients({Player=player,Active=true,StartedAt=now,Interval=interval})
    send(player,"Started")
    return true
end
local function award(player: Player, stats: any): any
    local p=ctx.Data.Get(player)
    if not p then return {} end
    local appliedForce = math.min(stats.Force, math.max(0, Rules.MaxStrength - p.ThrowStrength))
    p.ThrowStrength += appliedForce
    local leveled, academyXP = Math.AddXP(p, stats.XP, Rules)
    local _, gainedPlayerXP = ctx.Progression.GrantXP(player, stats.PlayerXP)
    ctx.Data.MarkDirty(player)
    ctx.Data.Sync(player)
    return {GainAwarded = appliedForce, XPAwarded = academyXP, PlayerXPAwarded = gainedPlayerXP or 0, LeveledUp = leveled}
end
function Training.Tick()
    local now=Workspace:GetServerTimeNow()
    for player,s in sessions do
        local p=ctx.Data.Get(player)
        if not p or player.Character~=s.Character or not s.Root.Parent or s.Humanoid.Health<=0 or (s.Root.Position-s.Anchor.Position).Magnitude>10 then Training.Stop(player);continue end
        if ctx.Data.IsBusy(player) then s.NextAt=math.max(s.NextAt,now+0.2);continue end
        if s.QTE and now>s.QTE.ExpiresAt then s.QTE=nil;send(player,"Missed") end
        if now>=s.NextAt then
            -- Never catch up a paused server with a large burst of rewards.
            s.NextAt=now+s.Interval;s.Reps+=1
            local stats = Math.Repetition(p.TrainingLevel, p.TrainingMachine or 1, ctx.Monetization.GetBenefits(player).TitanArms == true, Rules)
            send(player, "Rep", award(player, stats))
            if s.Reps%Rules.QTEEvery==0 then
                local locations={{.23,.3},{.73,.45},{.29,.64},{.71,.27}}
                local point=locations[(math.floor(s.Reps/Rules.QTEEvery)-1)%#locations+1]
                s.QTE={Id=Http:GenerateGUID(false),ExpiresAt=now+Rules.QTESeconds,Stats=stats}
                send(player,"QTE",{Id=s.QTE.Id,ExpiresAt=s.QTE.ExpiresAt,X=point[1],Y=point[2]})
            end
        end
    end
end
function Training.HitQTE(player:Player,id:any):boolean
    if type(id)~="string" or #id>80 or ctx.Data.IsBusy(player) then return false end
    local s=sessions[player]
    local now=Workspace:GetServerTimeNow()
    if not s or player.Character~=s.Character or not s.QTE or s.QTE.Id~=id or now>s.QTE.ExpiresAt or not s.Root.Parent or (s.Root.Position-s.Anchor.Position).Magnitude>10 or s.Humanoid.Health<=0 then return false end
    local stats = s.QTE.Stats
    s.QTE=nil -- Consume before any callback: one bonus per three repetitions.
    send(player, "Perfect", award(player, stats))
    return true
end
function Training.Upgrade(player: Player, expectedTier: any): (boolean, string)
    local now = Workspace:GetServerTimeNow()
    if type(expectedTier) ~= "number" or now < (upgradeRequests[player] or 0) or ctx.Data.IsBusy(player)
        or (ctx.Flight and ctx.Flight.IsActive(player)) or sessions[player] then
        return false, "Pare o treino e conclua sua ação antes de evoluir."
    end
    upgradeRequests[player] = now + 0.4
    local profile = ctx.Data.Get(player)
    if not profile or not ctx.World.GetSanctuary(player) then return false, "Santuário indisponível." end
    local target = Rules.Machines[(profile.TrainingMachine or 1) + 1]
    if not target or expectedTier ~= (profile.TrainingMachine or 1) + 1 then return false, "Confira a próxima máquina." end
    if profile.TrainingLevel < target.Level then return false, "Alcance o nível " .. target.Level .. " na academia." end
    if profile.Coins < target.Cost then return false, "Moedas insuficientes para evoluir a máquina." end
    local lock = "TrainingMachine"
    if not ctx.Data.TryLock(player, lock) then return false, "Aguarde a ação atual." end
    profile.Coins -= target.Cost
    profile.TrainingMachine = expectedTier
    ctx.Data.MarkDirty(player)
    local saved = ctx.Data.SaveNow(player)
    ctx.Data.Unlock(player, lock)
    if not saved then
        ctx.Data.Freeze(player, "Salvamento da máquina indisponível.")
        return false, "Não foi possível salvar sua evolução."
    end
    ctx.World.UpdateTrainingMachine(player, expectedTier, target.Name)
    ctx.Data.Sync(player)
    return true, target.Name .. " liberada!"
end

function Training.Init(context:any)
    ctx=context
    ctx.Remotes.StartTraining.OnServerEvent:Connect(function(player) Training.Start(player,true) end)
    ctx.Remotes.StopTraining.OnServerEvent:Connect(Training.Stop)
    ctx.Remotes.TrainingQTE.OnServerEvent:Connect(Training.HitQTE)
    local upgrade = ctx.Remotes.UpgradeTrainingMachine
    if upgrade then upgrade.OnServerEvent:Connect(function(player, tier)
        local success, message = Training.Upgrade(player, tier)
        ctx.Remotes.ActionFeedback:FireClient(player, {Message = message, Kind = if success then "Success" else "Error"})
    end) end
    ctx.Data.AddSnapshotProvider(function(player)return {Training=snapshot(player)}end)
    local function bind(player:Player)player.CharacterRemoving:Connect(function()Training.Stop(player)end)end
    Players.PlayerAdded:Connect(bind)
    for _,player in Players:GetPlayers() do bind(player) end
    Players.PlayerRemoving:Connect(function(player)Training.Stop(player);requests[player]=nil;upgradeRequests[player]=nil end)
    if not ctx.DisableLoops then task.spawn(function()while true do task.wait(.1);Training.Tick()end end)end
end
return Training
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">WeatherEventService</string>
          <string name="Source"><![CDATA[--!strict
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Weather = {}
local ctx: any
local settings: any
local active: any = nil
local serial, rotation, nextEventAt = 0, 0, 0
local totemEndsAt, totemMultiplier, totemOwner = 0, 1, ""

local function now(): number return Workspace:GetServerTimeNow() end
function Weather.GetLuckMultiplier(): number
    return (if active and active.EndsAt > now() then active.LuckMultiplier else 1) * (if totemEndsAt > now() then totemMultiplier else 1)
end
function Weather.GetState(): any
    return {
        Id = if active then active.Id else "", EventId = if active then active.EventId else "",
        Name = if active then active.Name else "SEM EVENTO ATIVO", StartedAt = if active then active.StartedAt else 0,
        EndsAt = if active then active.EndsAt else 0, NextAt = nextEventAt,
        LuckMultiplier = Weather.GetLuckMultiplier(), TotemEndsAt = totemEndsAt, TotemOwner = totemOwner,
        Boss = if ctx and ctx.Boss then ctx.Boss.GetState() else nil,
    }
end
Weather.GetSnapshot = Weather.GetState
function Weather.Broadcast()
    local remote = ctx and ctx.Remotes:FindFirstChild("WorldStateUpdate")
    if remote then remote:FireAllClients(Weather.GetState()) end
end
function Weather.Start(eventId: string?): boolean
    if active then return false end
    rotation = rotation % #settings.Order + 1
    local key = eventId or settings.Order[rotation]
    local definition = settings.Definitions[key]
    if not definition then return false end
    serial += 1
    local timestamp = now()
    active = {Id = "Event_" .. serial, EventId = key, Name = definition.Name, StartedAt = timestamp, EndsAt = timestamp + settings.Duration, LuckMultiplier = definition.LuckMultiplier}
    nextEventAt = timestamp + settings.Interval
    if definition.SpecialCreatureId then
        local layout = ctx.WorldConfig or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigWorld"))
        ctx.Spawn.Spawn(definition.SpecialCreatureId, layout.EventPosition, {BiomeId = "PradariaSolar", Kind = "Event", EventId = active.Id, ExpiresAt = active.EndsAt, NoRespawn = true})
    end
    if ctx.Boss then ctx.Boss.Start(active.Id, definition.BossCreatureId, active.EndsAt) end
    Weather.Broadcast()
    return true
end
function Weather.Step(timestamp: number?)
    local current = timestamp or now()
    if active and current >= active.EndsAt then
        local id = active.Id
        active = nil
        ctx.Spawn.RemoveEvent(id)
        if ctx.Boss then ctx.Boss.EndEvent(id) end
        Weather.Broadcast()
    end
    if not active and current >= nextEventAt then Weather.Start() end
end
function Weather.ActivateGlobalLuck(player: Player, multiplier: number?, duration: number?): boolean
    if not ctx.Data.Get(player) then return false end
    local strength = multiplier or settings.TotemMultiplier
    local seconds = duration or settings.TotemDuration
    if strength ~= strength or seconds ~= seconds or strength < 1 or seconds <= 0 or seconds == math.huge then return false end
    strength = math.clamp(strength, 1, settings.TotemMultiplier)
    seconds = math.min(seconds, settings.TotemDuration)
    local timestamp = now()
    if totemEndsAt >= timestamp + settings.MaxTotemSeconds then return false end
    totemEndsAt = math.min(timestamp + settings.MaxTotemSeconds, math.max(timestamp, totemEndsAt) + seconds)
    totemMultiplier, totemOwner = math.max(totemMultiplier, strength), player.DisplayName
    Weather.Broadcast()
    return true
end
function Weather.UseTotem(player: Player): boolean return Weather.ActivateGlobalLuck(player, settings.TotemMultiplier, settings.TotemDuration) end
function Weather.SummonEvent(player: Player, eventId: string?): boolean
    if not ctx.Data.Get(player) then return false end
    return Weather.Start(eventId)
end
function Weather.Init(context: any)
    ctx = context
    settings = ctx.EventConfig or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigEvents"))
    nextEventAt = now() + settings.Interval
    if ctx.Data.AddSnapshotProvider then ctx.Data.AddSnapshotProvider(function() return {Weather = Weather.GetState()} end) end
    local request = ctx.Remotes:FindFirstChild("RequestWorldState")
    local lastRequest: {[Player]: number} = {}
    if request then request.OnServerEvent:Connect(function(player)
        if not ctx.Data.Get(player) or now() - (lastRequest[player] or 0) < 1 then return end
        lastRequest[player] = now()
        local remote = ctx.Remotes:FindFirstChild("WorldStateUpdate")
        if remote then remote:FireClient(player, Weather.GetState()) end
    end) end
    if not ctx.DisableLoops then task.spawn(function() while true do task.wait(1); Weather.Step(); Weather.Broadcast() end end) end
end
return Weather
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[--!strict
-- Generated world and interaction anchors shared by all Roblox builds.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local NumberFormatter = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormatter"))
local Layout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigWorld"))

local TrainingRules = require(ReplicatedStorage.Shared.ConfigTraining)

local WorldService = {}
local worldFolder: Folder? = nil
local lots: {Model} = {}
local owners: {[Player]: number} = {}
local displaySignatures: {[Player]: string} = {}
local ctx: any

type SafeArea = {Center: Vector3, Size: Vector3, ReturnAt: Vector3}
local safeAreas: {SafeArea} = {}

local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local item = Instance.new("Part")
	item.Name = name
	item.Anchored = true
	item.Size = size
	item.Position = position
	item.Color = color
	item.TopSurface = Enum.SurfaceType.Studs
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = parent
	return item
end

local function retainingWall(parent: Instance, center: Vector3, length: number, inward: Vector3, tint: Color3)
    local stone = Color3.fromRGB(96, 91, 83):Lerp(tint, .26)
    local moss = Color3.fromRGB(102, 163, 73):Lerp(tint, .33)
    local axis = Vector3.yAxis:Cross(inward)
    local function block(name: string, size: Vector3, offset: Vector3, color: Color3, decor: boolean?): Part
        local position = center + axis * offset.X + Vector3.yAxis * offset.Y + inward * offset.Z
        local item = part(parent, name, size, position, color)
        item.CFrame = CFrame.lookAt(position, position + inward)
        if decor then item.CanCollide, item.CanTouch, item.CanQuery = false, false, false end
        return item
    end
    block("TerraceWall", Vector3.new(length, 27, 5), Vector3.new(0, 12.5, 0), stone)
    block("WallFooting", Vector3.new(length, 2.6, 7), Vector3.new(0, .7, .3), stone:Lerp(Color3.new(), .2))
    block("GrassRim", Vector3.new(length, 1.25, 6.7), Vector3.new(0, 26.35, -.35), moss)
    local panels = math.ceil(length / 20)
    local width = length / panels
    for row = 0, 1 do
        local step = if row == 0 then width else width * .5
        local offset = -length / 2
        local index = 0
        while offset < length / 2 - .1 do
            local span = math.min(step, length / 2 - offset)
            local shade = if (index + row) % 2 == 0 then .17 else .07
            local brick = block("StuddedBrick", Vector3.new(span - .13, 10.3, 1.05),
                Vector3.new(offset + span / 2, 7.45 + row * 10.7, 2.7), stone:Lerp(Color3.new(1, 1, 1), shade), true)
            brick.FrontSurface = Enum.SurfaceType.Studs
            offset += span
            step, index = width, index + 1
        end
    end
    for index = 1, math.ceil(length / 55) do
        local step = length / math.ceil(length / 55)
        local span = (index - .5) * step - length / 2
        local skyline = 31 + (index * 7) % 14
        block("EarthBank", Vector3.new(step + .05, skyline + 13, 24),
            Vector3.new(span, (skyline - 13) / 2, -15), stone:Lerp(moss, .27))
        block("BankGrass", Vector3.new(step + .11, 1.2, 24.15),
            Vector3.new(span, skyline + .35, -15), moss)
    end
end

local function protectArea(parent: Instance, center: Vector3, size: Vector3, returnAt: Vector3, tint: Color3, runwayOpening: boolean?)
    table.insert(safeAreas, {Center = center, Size = size, ReturnAt = returnAt})
    local guards = Instance.new("Folder")
    guards.Name, guards.Parent = "RetainingWalls", parent
    for _, side in {-1, 1} do
        local x = center.X + side * (size.X / 2 - 1)
        local z = center.Z + side * (size.Z / 2 - 1)
        retainingWall(guards, Vector3.new(x, 0, center.Z), size.Z, Vector3.new(-side, 0, 0), tint)
        if runwayOpening and side == -1 then
            local halfGap = 36
            local length = size.X / 2 - halfGap
            for _, flank in {-1, 1} do
                retainingWall(guards, Vector3.new(center.X + flank * (halfGap + length / 2), 0, z),
                    length, Vector3.zAxis, tint)
            end
        else
            retainingWall(guards, Vector3.new(center.X, 0, z), size.X, Vector3.new(0, 0, -side), tint)
        end
    end
end

local function startFallProtection()
    local returnPoints: {[Player]: {Character: Model, Point: Vector3}} = {}
    Players.PlayerRemoving:Connect(function(player) returnPoints[player] = nil end)
    task.spawn(function()
        while worldFolder and worldFolder.Parent do
            task.wait(.12)
            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if not character or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then continue end
                local position = root.Position
                if position.Y < -7 then
                    local saved = returnPoints[player]
                    local destination = if saved and saved.Character == character then saved.Point else WorldService.GetHubPosition()
                    character:PivotTo(CFrame.new(destination))
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                elseif position.Y < 12 then
                    for _, area in safeAreas do
                        if math.abs(position.X - area.Center.X) < area.Size.X / 2 - 2
                            and math.abs(position.Z - area.Center.Z) < area.Size.Z / 2 - 2 then
                            local saved = returnPoints[player]
                            if not saved or saved.Character ~= character or saved.Point ~= area.ReturnAt then
                                returnPoints[player] = {Character = character, Point = area.ReturnAt}
                            end
                            break
                        end
                    end
                end
            end
        end
    end)
end

local function label(parent: BasePart, text: string, offset: Vector3): TextLabel
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Adornee = parent
	billboard.Size = UDim2.fromOffset(220, 60)
	billboard.StudsOffset = offset
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 38
	billboard.Parent = parent
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 14
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 0.15
	textLabel.TextWrapped = true
	textLabel.Text = text
	textLabel.Parent = billboard
	return textLabel
end

local function station(parent: Instance, name: string, position: Vector3, color: Color3, content: string, action: (Player) -> ())
	local anchor = part(parent, name, Vector3.new(10, 0.8, 8), position, color)
	label(anchor, content, Vector3.new(0, 5, 0))
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name, prompt.ActionText, prompt.ObjectText = "Interact", "Usar", content:gsub("\n.*", "")
	prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.HoldDuration = 14, false, 0.2
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 or (root.Position - anchor.Position).Magnitude > 19 then return end
		if ctx and ctx.Data and (not ctx.Data.IsLoaded(player) or ctx.Data.IsBusy(player)) then return end
		action(player)
	end)
end

function WorldService.Init(context: any?)
	ctx = context or ctx
	if worldFolder then return end
	local folder = Instance.new("Folder")
	folder.Name = "ThrowASphereWorld"
	folder.Parent = Workspace
	worldFolder = folder
	local grass = Color3.fromRGB(92, 176, 70)
	part(folder, "Mainland", Vector3.new(1730, 48, 490), Vector3.new(525, -25, -11), Color3.fromRGB(111, 91, 65))
	local hubFloor = part(folder, "Foundation", Vector3.new(290, 1, 330), Vector3.new(0, -0.6, 20), grass)
	protectArea(folder, hubFloor.Position, hubFloor.Size, Layout.HubPosition + Vector3.new(0, 4, 0), grass, true)
	for x = -7, 6 do
		for z = -5, 7 do
			local color = if (x + z) % 2 == 0 then Color3.fromRGB(113, 190, 78) else grass
			part(folder, "GrassTile", Vector3.new(16, 0.2, 16), Vector3.new(x * 16 + 8, 0, z * 16 + 8), color)
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PradariaSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 0.5, 10)
	spawn.Position = Vector3.new(0, 0.4, 20)
	spawn.Color = Color3.fromRGB(125, 211, 252)
	spawn.Parent = folder
	label(spawn, "PRADARIA SOLAR", Vector3.new(0, 5, 0))

	for index = 1, Layout.PlayerCapacity do
		local side = if index % 2 == 1 then -1 else 1
		local position = Vector3.new(side * 91, 0, -68 + math.floor((index - 1) / 2) * 52)
		local lot = Instance.new("Model")
		lot.Name = "Sanctuary_" .. index
		lot:SetAttribute("OwnerUserId", 0)
		lot.Parent = folder
		local platform = part(lot, "Platform", Vector3.new(44, 0.8, 49), position + Vector3.new(0, 0.35, 0), Color3.fromRGB(93, 189, 101))
		lot.PrimaryPart = platform
		local sign = part(lot, "Sign", Vector3.new(12, 3, 0.5), position + Vector3.new(9, 2.4, 22), Color3.fromRGB(25, 37, 62))
		sign.CanCollide = false
		label(sign, "SANTUÁRIO LIVRE", Vector3.new(0, 2, 0))
		local display = Instance.new("Folder")
		display.Name = "Creatures"
		display.Parent = lot
		local pen = Instance.new("Model")
		pen.Name, pen.Parent = "CreaturePen", lot
		local wool = Color3.fromRGB(255, 231, 177)
		local wood = Color3.fromRGB(159, 104, 66)
		local grass = part(pen, "Grass", Vector3.new(39, 0.3, 31), position + Vector3.new(0, 0.85, 5), Color3.fromRGB(125, 210, 104))
		grass.TopSurface = Enum.SurfaceType.Smooth
		for _, direction in {-1, 1} do
			for _, y in {1.7, 3.2} do
				part(pen, "SideRail", Vector3.new(.55, .65, 31), position + Vector3.new(direction * 19.5, y, 5), wool)
			end
			for _, z in {-10.5, 0, 10, 20.5} do
				part(pen, "FencePost", Vector3.new(1.1, 3.6, 1.1), position + Vector3.new(direction * 19.5, 2.5, z), wood)
			end
		end
		for _, y in {1.7, 3.2} do
			part(pen, "BackRail", Vector3.new(39, .65, .55), position + Vector3.new(0, y, -10.5), wool)
			for _, sideOfGate in {-1, 1} do
				part(pen, "FrontRail", Vector3.new(16, .65, .55), position + Vector3.new(sideOfGate * 11.5, y, 20.5), wool)
			end
		end
		table.insert(lots, lot)
		station(lot, "PersonalTraining", position + Vector3.new(0, 1, -18), Color3.fromRGB(255,158,65), "ACADEMIA", function(player)
			if ctx and ctx.Training and WorldService.GetSanctuary(player) == lot then ctx.Remotes.OpenPanel:FireClient(player, "Academia")
			elseif ctx and ctx.Progression and WorldService.IsAtSanctuary(player) then ctx.Progression.Train(player) end
		end)
		local gymBase = position + Vector3.new(0, 1.25, -18)
		part(lot, "GymDeck", Vector3.new(11.5, .26, 9.3), gymBase, Color3.fromRGB(52, 57, 66)).CanCollide = false
		for _,side in {-1,1} do
			local post=part(lot,"GymPost",Vector3.new(.65,6,.65),position+Vector3.new(side*3,4,-18),Color3.fromRGB(90,110,140))
			post.CanCollide=false
			part(lot, "GymShoe", Vector3.new(2, .6, 2), gymBase + Vector3.new(side * 3, .38, 0), Color3.fromRGB(34, 40, 53)).CanCollide = false
			local grip = part(lot, "Grip", Vector3.new(.95, .64, .64), position + Vector3.new(side * 1.45, 7, -18), Color3.fromRGB(32, 36, 44))
			grip.Shape, grip.CanCollide = Enum.PartType.Cylinder, false
		end
		local bar=part(lot,"GymBar",Vector3.new(7,.5,.5),position+Vector3.new(0,7,-18),Color3.fromRGB(255,200,70))
		bar.CanCollide=false
	end
	local tutorial = part(folder, "TutorialBoard", Vector3.new(26, 8, 1), Vector3.new(0, 5, 173), Color3.fromRGB(27, 40, 72))
	label(tutorial, "THROW A SPHERE!\nCapture → Santuário → $/s\nEvolua sua orbe e treine na academia", Vector3.new(0, 1, 0))
	for index, id in Layout.BiomeOrder do
		local center, colors = Layout.Biomes[id].Position, Layout.Biomes[id].Colors
		local zone = Instance.new("Folder")
		zone.Name, zone.Parent = id, folder
		if index > 1 then
			for x = -4, 3 do for z = -4, 3 do
				part(zone, "Tile", Vector3.new(25, 1, 25), center + Vector3.new(x * 25 + 12.5, -0.5, z * 25 + 12.5), colors[(x + z) % 2 + 1])
			end end
			protectArea(zone, center, Vector3.new(Layout.ZoneSize, 1, Layout.ZoneSize), center + Vector3.new(0, 4, 35), colors[2])
		end
		if id == "FlorestaNeon" then
			station(zone, "NeonResearch", center + Vector3.new(0, .8, 15), Color3.fromRGB(98, 232, 183),
				"PESQUISA NEON\n+20 FORÇA E +80 XP NA PRIMEIRA VISITA", function(player)
					if ctx and ctx.Biomes then ctx.Biomes.ClaimNeonResearch(player) end
				end)
		end
		local destination = id
		local purpose = if id == "FlorestaNeon" then " • Pesquisa" else ""
		station(folder, "Portal_" .. id, Vector3.new(-78 + (index - 1) * 31, 0.8, 116), colors[2], Config.Biomes[id].Name .. purpose .. "\n$" .. NumberFormatter.Format(Config.Biomes[id].Cost) .. " • " .. Config.Biomes[id].RequiredBestiary .. " espécies", function(player)
			if not ctx or not ctx.Biomes then return end
			if ctx.Biomes.CanAccess(player, destination) or ctx.Biomes.Unlock(player, destination) then ctx.Biomes.Travel(player, destination) end
		end)
		station(zone, "ReturnPortal", center + Vector3.new(0, 0.8, 75), colors[1], "VOLTAR AO HUB", function(player) if ctx and ctx.Biomes then ctx.Biomes.Travel(player, "Hub") end end)
		task.wait()
	end
	for _, info in {{"Orbes", -75}, {"Fusao", -45}, {"Diario", -15}, {"Rebirth", 15}, {"Loja", 45}, {"Bestiario", 75}} do
		local panelId = info[1] :: string
		station(folder, "Station_" .. panelId, Vector3.new(info[2] :: number, 0.8, 148), Color3.fromRGB(175,119,255), string.upper(panelId), function(player)
			local remote = ctx and ctx.Remotes:FindFirstChild("OpenPanel")
			if remote then remote:FireClient(player, panelId) end
		end)
	end
	station(folder, "TradingPortal", Vector3.new(-134, 0.8, 122), Color3.fromRGB(74,193,255), "PRAÇA DE TROCAS\nNÍVEL 15", function(player) if ctx and ctx.Biomes then ctx.Biomes.Travel(player, "TradingPlaza") end end)
	local tradingFloor = part(folder, "TradingFloor", Vector3.new(85, 1, 85), Layout.TradingPosition + Vector3.new(0, -0.5, 0), Color3.fromRGB(43,117,154))
	protectArea(tradingFloor, tradingFloor.Position, tradingFloor.Size, Layout.TradingPosition + Vector3.new(0, 4, 13), tradingFloor.Color)
	station(folder, "TradingDesk", Layout.TradingPosition, Color3.fromRGB(255,212,63), "TROCAS E LEILÕES", function(player)
		local remote = ctx and ctx.Remotes:FindFirstChild("OpenPanel")
		if remote then remote:FireClient(player, "Trocas") end
	end)
	station(folder, "TradingReturn", Layout.TradingPosition + Vector3.new(0, 0.8, 30), Color3.fromRGB(74,193,255), "VOLTAR AO HUB", function(player) if ctx and ctx.Biomes then ctx.Biomes.Travel(player, "Hub") end end)
	if not ctx or not ctx.DisableLoops then startFallProtection() end
end

function WorldService.GetSanctuary(player: Player): Model? return if owners[player] then lots[owners[player]] else nil end
function WorldService.GetSanctuaryReturnPosition(player: Player): Vector3?
	local lot = WorldService.GetSanctuary(player)
	local platform = lot and lot.PrimaryPart
	return if platform then platform.Position + Vector3.new(0, 4, 23) else nil
end
function WorldService.IsAtSanctuary(player: Player): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local lot = WorldService.GetSanctuary(player)
	return root ~= nil and root:IsA("BasePart") and lot ~= nil and lot.PrimaryPart ~= nil and (root.Position - lot.PrimaryPart.Position).Magnitude <= Layout.SanctuaryRadius
end
WorldService.IsInSanctuary = WorldService.IsAtSanctuary
function WorldService.GetHubPosition(): Vector3 return Layout.HubPosition + Vector3.new(0, 4, 0) end
function WorldService.GetTradingPosition(): Vector3 return Layout.TradingPosition + Vector3.new(0, 4, 0) end
function WorldService.GetBiomePosition(id: string): Vector3?
	return if Layout.Biomes[id] then Layout.Biomes[id].Position + Vector3.new(0, 4, 35) else nil
end
function WorldService.GetBiomeAtPosition(position: Vector3): string
	if (Vector3.new(position.X, 0, position.Z) - Layout.TradingPosition).Magnitude <= 45 then return "TradingPlaza" end
	for _, id in Layout.BiomeOrder do
		local center = Layout.Biomes[id].Position
		if math.abs(position.X - center.X) <= 100 and math.abs(position.Z - center.Z) <= 100 then return id end
	end
	return "Hub"
end
function WorldService.GetSpawnPoints(id: string): {Vector3}
	if id == "PradariaSolar" then return {} end
	local center, points = Layout.Biomes[id].Position, {}
	for _, offset in {Vector3.new(-30,0.15,5), Vector3.new(0,0.15,-5), Vector3.new(30,0.15,5), Vector3.new(-42,0.15,-28), Vector3.new(0,0.15,-38), Vector3.new(42,0.15,-28)} do table.insert(points, center + offset) end
	return points
end
function WorldService.GetFolder(): Folder? return worldFolder end
function WorldService.GetPodiumFolder(): Folder?
	if not worldFolder then return nil end
	local existing = worldFolder:FindFirstChild("Podium")
	if existing and existing:IsA("Folder") then return existing end
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Podium", worldFolder
	return folder
end
WorldService.Label = label

function WorldService.AssignSanctuary(player: Player): Model?
	local existing = owners[player]
	if existing then return lots[existing] end
	for index, lot in ipairs(lots) do
		if lot:GetAttribute("OwnerUserId") == 0 then
			owners[player] = index
			lot:SetAttribute("OwnerUserId", player.UserId)
			player:SetAttribute("SanctuaryIndex", index)
			return lot
		end
	end
	return nil
end

function WorldService.ReleaseSanctuary(player: Player)
	local index = owners[player]
	if not index then return end
	local lot = lots[index]
	lot:SetAttribute("OwnerUserId", 0)
	local display = lot:FindFirstChild("Creatures")
	if display then display:ClearAllChildren() end
	local sign = lot:FindFirstChild("Sign")
	local billboard = sign and sign:FindFirstChild("Label")
	local textLabel = billboard and billboard:FindFirstChildWhichIsA("TextLabel")
	if textLabel then textLabel.Text = "SANTUÁRIO LIVRE" end
	WorldService.UpdateTrainingMachine(player, 1, TrainingRules.Machines[1].Name)
	owners[player] = nil
	displaySignatures[player] = nil
end

local machineColors = {
    Color3.fromRGB(255, 193, 85), Color3.fromRGB(255, 121, 82), Color3.fromRGB(89, 204, 235),
    Color3.fromRGB(161, 106, 255), Color3.fromRGB(240, 114, 224),
    Color3.fromRGB(255, 113, 63), Color3.fromRGB(144, 160, 255), Color3.fromRGB(255, 224, 113),
}

function WorldService.UpdateTrainingMachine(player: Player, tier: number, name: string)
    local lot = WorldService.GetSanctuary(player)
    if not lot then return end
    local bar = lot:FindFirstChild("GymBar")
    local anchor = lot:FindFirstChild("PersonalTraining")
    if not anchor or anchor:GetAttribute("MachineTier") == tier then return end
    anchor:SetAttribute("MachineTier", tier)
    if bar and bar:IsA("BasePart") then
        local color = machineColors[tier]
        bar.Color = color
        bar.Material = if tier >= 6 then Enum.Material.Neon else Enum.Material.SmoothPlastic
        local previous = lot:FindFirstChild("MachineUpgradeArt")
        if previous then previous:Destroy() end
        local details = Instance.new("Folder")
        details.Name, details.Parent = "MachineUpgradeArt", lot
        for _, side in {-1, 1} do
            local plateCount = math.ceil(tier / 2)
            for index = 1, plateCount do
                local diameter = 1.4 + tier * .12 - index * .16
                local plate = part(details, "TrainingPlate", Vector3.new(.23, diameter, diameter),
                    bar.Position + Vector3.new(side * (2.18 + (index - 1) * .28), 0, 0), if index == 1 then color else color:Lerp(Color3.new(), index * .14))
                plate.Shape, plate.CanCollide, plate.CanQuery, plate.CanTouch = Enum.PartType.Cylinder, false, false, false
                plate.TopSurface = Enum.SurfaceType.Smooth
            end
            if tier >= 4 then
                local upright = part(details, "MachineLight", Vector3.new(.14, 4.5, .18),
                    bar.Position + Vector3.new(side * 3, -3, .4), color)
                upright.Material, upright.CanCollide, upright.CanTouch, upright.CanQuery = Enum.Material.Neon, false, false, false
            end
        end
    end
    local billboard = anchor:FindFirstChild("Label")
    local caption = billboard and billboard:FindFirstChildWhichIsA("TextLabel")
    if caption then caption.Text = name .. " • Nv. " .. tier end
end

function WorldService.UpdateSanctuaryIncome(player: Player, shares: {[string]: number})
    local lot = WorldService.GetSanctuary(player)
    local display = lot and lot:FindFirstChild("Creatures")
    if not display then return end
    for _, model in display:GetChildren() do
        local uid = model:GetAttribute("CaptureUID")
        local head = model:FindFirstChild("Head")
        local billboard = head and head:FindFirstChild("Label")
        local caption = billboard and billboard:FindFirstChildWhichIsA("TextLabel")
        if uid and caption then
            local value = "+$" .. NumberFormatter.Format(shares[uid] or 0) .. "/s"
            if caption.Text ~= value then caption.Text = value end
        end
    end
end

function WorldService.UpdateSanctuary(player: Player, profile: any)
	local index = owners[player]
	if not index then return end
	local lot = lots[index]
	local sign = lot:FindFirstChild("Sign")
	local billboard = sign and sign:FindFirstChild("Label")
	local textLabel = billboard and billboard:FindFirstChildWhichIsA("TextLabel")
	local playerBenefits = if ctx and ctx.Monetization then ctx.Monetization.GetBenefits(player) else {}
	local capacity = if ctx and ctx.Sanctuary then ctx.Sanctuary.GetSlotCapacity(profile, playerBenefits) else Config.Constants.BaseSanctuarySlots + (if profile.Level >= 5 then 1 else 0) + (if profile.Level >= 15 then 1 else 0)
	if textLabel then
		textLabel.Text = string.format("%s\n$%s/s • %d/%d slots", player.DisplayName, NumberFormatter.Format(profile.IncomePerSec or 0), #profile.SanctuarySlots, capacity)
	end
	local machineTier = profile.TrainingMachine or 1
	WorldService.UpdateTrainingMachine(player, machineTier, TrainingRules.Machines[machineTier].Name)
	local signature = table.concat(profile.SanctuarySlots, ":")
	if displaySignatures[player] == signature then return end
	displaySignatures[player] = signature
	local display = lot:FindFirstChild("Creatures")
	if not display then return end
	display:ClearAllChildren()
	local inventory: {[string]: any} = {}
	for _, record in ipairs(profile.CapturedCreatures) do inventory[record.Uid] = record end
	local platform = lot.PrimaryPart
	if not platform then return end
	for slot, uid in ipairs(profile.SanctuarySlots) do
		local record = inventory[uid]
		local definition = record and Config.Creatures[record.CreatureId]
		if not definition or slot > capacity then continue end
		if ctx and ctx.AuthoredCreatures and not ctx.AuthoredCreatures[record.CreatureId] then continue end
		local column, row = (slot - 1) % 6, math.floor((slot - 1) / 6)
		local home = platform.Position + Vector3.new((column - 2.5) * 5.8, 1.65, (row - 1.5) * 6.8 + 5)
		local model = Instance.new("Model")
		model.Name = record.CreatureId
		model:SetAttribute("CaptureUID", uid)
		model:SetAttribute("Mutation", record.Mutation)
		model:SetAttribute("Size", record.Size)
		for _, variant in Config.Sizes do
			if variant.Name == record.Size then model:SetAttribute("ArtScale", variant.Scale); break end
		end
		model:SetAttribute("PenHome", home)
		model:SetAttribute("WalkPhase", (slot * 2.399963) % (2 * math.pi))
		local function anchor(name: string, offset: Vector3): Part
			local piece = part(model, name, Vector3.one, home + offset, definition.BodyColor)
			piece.Transparency = 1
			piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
			return piece
		end
		model.PrimaryPart = anchor("Body", Vector3.zero)
		local head = anchor("Head", Vector3.new(0, .6, -.9))
		local caption = label(head, "+$" .. NumberFormatter.Format(record.IncomePerSec) .. "/s", Vector3.new(0, 1.55, 0))
		caption.TextColor3 = Color3.fromRGB(151, 255, 113)
		caption.TextSize = 16
		local billboard = caption.Parent :: BillboardGui
		billboard.Size, billboard.MaxDistance = UDim2.fromOffset(95, 24), 33
		model.Parent = display
		CollectionService:AddTag(model, "SanctuaryWalker")
	end
end

return WorldService
]]></string>
