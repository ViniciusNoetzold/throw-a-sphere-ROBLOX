      <Item class="LocalScript" referent="99">
        <Properties>
          <string name="Name">ClientWorldController</string>
          <string name="Source"><![CDATA[--!strict
-- Render the authored creatures on replicated encounter and podium anchors.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local CreatureArt = require(script.Parent:WaitForChild("CreatureArt"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Events = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigEvents"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local tracked: {[Model]: {Peak: Part?, Beam: Beam?, Glow: Highlight?, Sparkles: Sparkles?}} = {}
local state: any = nil
local correction = Instance.new("ColorCorrectionEffect")
correction.Name, correction.Parent = "ThrowASphereWeather", Lighting
local function observe(model: Instance)
    if not model:IsA("Model") or tracked[model] then return end
    local id = model:GetAttribute("CreatureId")
    local definition = id and Config.Creatures[id]
    if not definition then return end
    local root = model.PrimaryPart
    if not root then return end
    local scale = model:GetAttribute("ArtScale") or 1
    local item: any = {}
    local rarity = definition.Rarity
    if rarity == "Epica" then
        local sparkles = Instance.new("Sparkles")
        sparkles.Name, sparkles.SparkleColor, sparkles.Parent = "RaritySparkles", definition.BodyColor, root
        item.Sparkles = sparkles
    elseif rarity == "Mitica" or rarity == "Lendaria" or rarity == "Secreta" then
        local glow = Instance.new("Highlight")
        glow.Name, glow.Adornee = "RarityHighlight", model
        glow.FillTransparency, glow.OutlineTransparency, glow.OutlineColor = 0.9, 0.1, definition.BodyColor
        glow.Parent, item.Glow = model, glow
    end
    if rarity == "Lendaria" or rarity == "Secreta" then
        local peak = Instance.new("Part")
        peak.Name, peak.Anchored, peak.Transparency = "RarityPillarTip", true, 1
        peak.CanCollide, peak.CanTouch, peak.CanQuery, peak.Size = false, false, false, Vector3.new(0.1,0.1,0.1)
        peak.Position, peak.Parent = root.Position + Vector3.new(0, 42, 0), Workspace
        local lower, upper = Instance.new("Attachment"), Instance.new("Attachment")
        lower.Parent, upper.Parent = root, peak
        local beam = Instance.new("Beam")
        beam.Name, beam.Attachment0, beam.Attachment1 = "RarityPillar", lower, upper
        beam.Width0, beam.Width1, beam.FaceCamera, beam.LightEmission = 1.3, 0.2, true, 1
        beam.Color, beam.Transparency, beam.Parent = ColorSequence.new(definition.BodyColor), NumberSequence.new(0.45), root
        item.Peak, item.Beam = peak, beam
    end
    tracked[model] = item
    task.defer(CreatureArt.ShowOn, model, id, scale, 1.1 * scale)
end
local function observeWildFolder(folder: Instance)
    folder.ChildAdded:Connect(observe)
    for _, model in folder:GetChildren() do observe(model) end
end
local wildFolder = Workspace:FindFirstChild("CriaturasSelvagens")
if wildFolder then
    observeWildFolder(wildFolder)
else
    local connection: RBXScriptConnection
    connection = Workspace.ChildAdded:Connect(function(child)
        if child.Name ~= "CriaturasSelvagens" then return end
        connection:Disconnect()
        observeWildFolder(child)
    end)
end
for _, model in CollectionService:GetTagged("PodiumCreature") do observe(model) end
CollectionService:GetInstanceAddedSignal("PodiumCreature"):Connect(function(model) task.defer(observe, model) end)
CreatureArt.Loaded:Connect(function(id: string)
    for model in tracked do
        if model:GetAttribute("CreatureId") == id then
            local scale = model:GetAttribute("ArtScale") or 1
            CreatureArt.ShowOn(model, id, scale, 1.1 * scale)
        end
    end
end)
local function setState(value: any)
    if typeof(value) ~= "table" then return end
    state = value
    local event = Events.Definitions[value.EventId]
    correction.TintColor = if event then event.Color:Lerp(Color3.new(1,1,1), 0.82) else Color3.new(1,1,1)
end
local worldUpdate = remotes:FindFirstChild("WorldStateUpdate")
if worldUpdate then (worldUpdate :: RemoteEvent).OnClientEvent:Connect(setState) end
(remotes:WaitForChild("StateUpdate") :: RemoteEvent).OnClientEvent:Connect(function(snapshot: any) if typeof(snapshot) == "table" and snapshot.Weather then setState(snapshot.Weather) end end)
local request = remotes:FindFirstChild("RequestWorldState")
if request then (request :: RemoteEvent):FireServer() end
task.spawn(function()
    while player.Parent do
        task.wait(0.2)
        local wild = Workspace:FindFirstChild("CriaturasSelvagens")
        if wild then
            for _, model in wild:GetChildren() do observe(model) end
        end
        for _, model in CollectionService:GetTagged("PodiumCreature") do observe(model) end
        local hue = (Workspace:GetServerTimeNow() * 0.12) % 1
        for model, item in tracked do
            if not model.Parent then if item.Peak then item.Peak:Destroy() end; tracked[model] = nil; continue end
            local originalMesh = model:FindFirstChild("OriginalMesh")
            if originalMesh and originalMesh:IsA("BasePart") and model.PrimaryPart then
                local scale = model:GetAttribute("ArtScale") or 1
                originalMesh.CFrame = model.PrimaryPart.CFrame * CFrame.new(0, originalMesh.Size.Y / 2 - 1.1 * scale, 0)
            end
            local root = if originalMesh and originalMesh:IsA("BasePart") then originalMesh else model.PrimaryPart
            if item.Peak and root then item.Peak.Position = root.Position + Vector3.new(0, 42, 0) end
            if item.Beam and root then item.Beam.Enabled = root.LocalTransparencyModifier < 1 end
            if item.Glow and root then item.Glow.Enabled = root.LocalTransparencyModifier < 1 end
            if item.Sparkles and root then item.Sparkles.Enabled = root.LocalTransparencyModifier < 1 end
            if model:GetAttribute("Mutation") == "ArcoIris" then
                local color = Color3.fromHSV(hue, 0.8, 1)
                for _, descendant in model:GetDescendants() do
                    if descendant:IsA("BasePart") and descendant.Name ~= "Eye" and not descendant:GetAttribute("ArtPalette") then descendant.Color = color end
                end
                if item.Glow then item.Glow.OutlineColor = color end
            end
        end
        -- Timers come from server timestamps; the client only renders their remaining time.
        if state then player:SetAttribute("EventSecondsRemaining", math.max(0, (state.EndsAt or 0) - Workspace:GetServerTimeNow())) end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">CreatureArt</string>
          <string name="Source"><![CDATA[--!strict
-- Local copies share one original Blender mesh per species, including in ViewportFrames.
local AssetService = game:GetService("AssetService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Shared")
local sources = shared:WaitForChild("CreatureMeshes")
local variants = require(shared.ConfigMutacoes)

type Geometry = {Vertices: {number}, Faces: {number}, Colors: {number}}
type MeshData = Geometry & {Palettes: {[string]: {number}}?, Shapes: {[string]: Geometry}?, Scales: {[string]: number}?, ReferenceScale: number?}
type Template = {Part: MeshPart, RetainedMesh: EditableMesh?, Texture: EditableImage}
local CreatureArt = {}
local templates: {[string]: Template} = {}
local attempted: {[string]: boolean} = {}
local scales: {[string]: {[string]: number}} = {}
local referenceScales: {[string]: number} = {}
local loaded = Instance.new("BindableEvent")
CreatureArt.Loaded = loaded.Event

-- The source pack has Blender materials rather than image files. Rasterize the
-- original palette into a padded UV atlas so every displayed mesh has a texture.
local function atlas(mesh: EditableMesh, texture: EditableImage, rgb: {number}, grid: number): {{number}}
    local cell, edge = 8, grid * 8
    local pixels = buffer.create(edge * edge * 4)
    local uvs = {}
    for slot = 0, #rgb / 3 - 1 do
        local x, y = (slot % grid) * cell, math.floor(slot / grid) * cell
        local r, g, b = rgb[slot * 3 + 1], rgb[slot * 3 + 2], rgb[slot * 3 + 3]
        for row = y, y + cell - 1 do
            for column = x, x + cell - 1 do
                local index = (row * edge + column) * 4
                buffer.writeu8(pixels, index, math.floor(r * 255 + .5))
                buffer.writeu8(pixels, index + 1, math.floor(g * 255 + .5))
                buffer.writeu8(pixels, index + 2, math.floor(b * 255 + .5))
                buffer.writeu8(pixels, index + 3, 255)
            end
        end
        table.insert(uvs, {
            mesh:AddUV(Vector2.new((x + 3) / edge, (y + 3) / edge)),
            mesh:AddUV(Vector2.new((x + 5) / edge, (y + 3) / edge)),
            mesh:AddUV(Vector2.new((x + 4) / edge, (y + 5) / edge)),
        })
    end
    texture:WritePixelsBuffer(Vector2.zero, Vector2.new(edge, edge), pixels)
    return uvs
end

local function load(source: ModuleScript, palette: string?)
    local key = if palette then source.Name .. ":" .. palette else source.Name
    if attempted[key] then return end
    attempted[key] = true
    local mesh: EditableMesh? = nil
    local image: EditableImage? = nil
    local ok, problem = pcall(function()
        local data: MeshData = HttpService:JSONDecode(require(source))
        scales[source.Name] = data.Scales or {}
        referenceScales[source.Name] = data.ReferenceScale
        local geometry = (if palette and data.Shapes then data.Shapes[palette] else nil) or data
        local paletteColors = if palette and data.Palettes then data.Palettes[palette] else nil
        if palette and geometry == data and not paletteColors then return end
        local editable = AssetService:CreateEditableMesh()
        if not editable then error("Mesh memory unavailable") end
        mesh = editable
        local vertices: {number}, positions: {Vector3} = {}, {}
        for i = 1, #geometry.Vertices, 3 do
            local position = Vector3.new(geometry.Vertices[i], geometry.Vertices[i + 1], geometry.Vertices[i + 2])
            table.insert(positions, position)
            table.insert(vertices, editable:AddVertex(position))
        end
        local rgb = paletteColors or geometry.Colors
        local grid = math.ceil(math.sqrt(#rgb / 3))
        local texture = AssetService:CreateEditableImage({Size = Vector2.one * grid * 8})
        if not texture then error("Texture memory unavailable") end
        image = texture
        local uvs = atlas(editable, texture, rgb, grid)
        local normals: {[Vector3]: number} = {}
        for i = 1, #geometry.Faces, 4 do
            local a, b, c, material = geometry.Faces[i], geometry.Faces[i + 1], geometry.Faces[i + 2], geometry.Faces[i + 3]
            local normal = (positions[b] - positions[a]):Cross(positions[c] - positions[a])
            if normal.Magnitude < 1e-8 then continue end
            local unit = normal.Unit
            local normalId = normals[unit]
            if not normalId then normalId = editable:AddNormal(unit); normals[unit] = normalId end
            local triangle = editable:AddTriangle(vertices[a], vertices[b], vertices[c])
            editable:SetFaceUVs(triangle, uvs[material])
            editable:SetFaceNormals(triangle, {normalId, normalId, normalId})
        end
        local content = Content.fromObject(editable)
        local baked, result, opaque = pcall(function()
            return AssetService:CreateDataModelContentAsync(content)
        end)
        local options = {CollisionFidelity = Enum.CollisionFidelity.Box}
        local part: MeshPart? = nil
        if baked and result == Enum.CreateContentResult.Success then
            local success, value = pcall(function() return AssetService:CreateMeshPartAsync(opaque, options) end)
            if success then part = value; editable:Destroy(); mesh = nil end
        end
        local template = part or AssetService:CreateMeshPartAsync(content, options)
        template.Name = "OriginalMesh"
        template.TextureContent = Content.fromObject(texture)
        template:SetAttribute("ArtPalette", palette)
        template.Color = Color3.new(1, 1, 1)
        template.Material = Enum.Material.SmoothPlastic
        template.Anchored = true
        template.CanCollide, template.CanQuery, template.CanTouch = false, false, false
        templates[key] = {Part = template, RetainedMesh = mesh, Texture = texture}
        loaded:Fire(source.Name)
    end)
    if not ok then
        if mesh then mesh:Destroy() end
        if image then image:Destroy() end
        warn("[CreatureArt]", source.Name, problem)
    end
end

function CreatureArt.Size(id: string, name: any, fallback: number, mutation: any?): number
    local authored = scales[id]
    local reference = referenceScales[id]
    if name == "Enorme" or mutation == "Dourada" or mutation == "ArcoIris" then
        return reference or (authored and authored.Enorme) or math.max(1.85, fallback)
    end
    if name == "Titanica" and reference then return math.max(reference * 1.2, fallback) end
    return if authored and type(name) == "string" then authored[name] or fallback else fallback
end

function CreatureArt.Get(id: string, mutation: string?): MeshPart?
    local source = sources:FindFirstChild(id)
    if not source or not source:IsA("ModuleScript") then return nil end
    if not templates[id] then load(source) end
    local normal = templates[id]
    if not normal then return nil end
    local variantPart: Template? = nil
    if mutation == "Dourada" or mutation == "ArcoIris" then
        load(source, mutation)
        variantPart = templates[id .. ":" .. mutation]
    end
    local template = variantPart or normal
    local mesh = template.Part:Clone()
    if not variantPart and mutation and mutation ~= "Normal" then
        for _, style in variants.Mutations do
            if style.Name == mutation then mesh.Color = Color3.new(1, 1, 1):Lerp(style.Color, .55); break end
        end
    end
    return mesh
end

function CreatureArt.ShowOn(model: Model, id: string, scale: number, rootHeight: number, maxExtent: number?): MeshPart?
    local root = model.PrimaryPart
    if not root or not model.Parent then return nil end
    local mutation = model:GetAttribute("Mutation")
    local mesh = CreatureArt.Get(id, if typeof(mutation) == "string" then mutation else nil)
    if not mesh then return nil end
    local existing = model:FindFirstChild("OriginalMesh")
    if not model.Parent or (existing and existing:GetAttribute("ArtPalette") == mesh:GetAttribute("ArtPalette")) then
        mesh:Destroy()
        return nil
    end
    if existing then existing:Destroy() end
    scale = CreatureArt.Size(id, model:GetAttribute("Size"), scale, mutation)
    if maxExtent then scale = math.min(scale, maxExtent / math.max(mesh.Size.X, mesh.Size.Y, mesh.Size.Z)) end
    mesh.Size *= scale
    mesh.CFrame = root.CFrame * CFrame.new(0, mesh.Size.Y / 2 - rootHeight, 0)
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end
        if part:IsA("BillboardGui") then
            part.Adornee = mesh
            part.StudsOffset = Vector3.new(0, mesh.Size.Y / 2 + .7, 0)
        end
    end
    mesh.Parent = model
    return mesh
end

return CreatureArt
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="101">
        <Properties>
          <string name="Name">Throw</string>
        </Properties>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">OrbVisual</string>
            <string name="Source"><![CDATA[--!strict
local OrbVisual = {}

type Style = {Fittings: number, Metal: Color3, Shell: Color3, Halo: boolean?}
local steel = Color3.fromRGB(179, 209, 224)
local pearl = Color3.fromRGB(240, 243, 245)
local baseStyle: Style = {Fittings = 2, Metal = steel, Shell = pearl}
local styles: {[string]: Style} = {
    Esmeralda = {Fittings = 4, Metal = Color3.fromRGB(167, 230, 178), Shell = pearl},
    Rubi = {Fittings = 4, Metal = Color3.fromRGB(255, 185, 123), Shell = Color3.fromRGB(255, 217, 205)},
    Safira = {Fittings = 6, Metal = Color3.fromRGB(147, 225, 255), Shell = Color3.fromRGB(233, 247, 255)},
    Runica = {Fittings = 6, Metal = Color3.fromRGB(239, 192, 72), Shell = Color3.fromRGB(78, 67, 42)},
    Hextech = {Fittings = 8, Metal = Color3.fromRGB(100, 195, 215), Shell = Color3.fromRGB(44, 82, 101), Halo = true},
    Cosmica = {Fittings = 6, Metal = Color3.fromRGB(188, 143, 246), Shell = Color3.fromRGB(68, 47, 107), Halo = true},
    Mestre = {Fittings = 8, Metal = Color3.fromRGB(252, 215, 104), Shell = Color3.fromRGB(103, 49, 106), Halo = true},
    Prismatica = {Fittings = 8, Metal = Color3.fromRGB(239, 212, 255), Shell = pearl, Halo = true},
}

function OrbVisual.Create(color: Color3, diameter: number, orbId: string?): (Model, BasePart)
    local model = Instance.new("Model")
    model.Name = "Orb"
    local style = if orbId then styles[orbId] or baseStyle else baseStyle
    local function shape(name: string, kind: Enum.PartType, size: Vector3, frame: CFrame, tint: Color3, material: Enum.Material): Part
        local part = Instance.new("Part")
        part.Name, part.Shape, part.Size, part.CFrame = name, kind, size * diameter, frame
        part.Color, part.Material, part.Anchored = tint, material, true
        part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = false, false, false, false
        part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        part.Parent = model
        return part
    end
    local ink = color:Lerp(Color3.fromRGB(22, 29, 46), .77)
    local bright = color:Lerp(pearl, .32)
    local vertical = CFrame.Angles(0, 0, math.pi / 2)
    local core = shape("CeramicShell", Enum.PartType.Ball, Vector3.one, CFrame.new(), style.Shell:Lerp(color, .21), Enum.Material.SmoothPlastic)
    shape("Crown", Enum.PartType.Ball, Vector3.new(.95, .77, .95), CFrame.new(0, .16 * diameter, 0), color, Enum.Material.SmoothPlastic)
    shape("Collar", Enum.PartType.Cylinder, Vector3.new(.16, 1.055, 1.055), vertical, ink, Enum.Material.SmoothPlastic)
    for _, side in {-1, 1} do
        shape("MetalRim", Enum.PartType.Cylinder, Vector3.new(.026, 1.073, 1.073),
            CFrame.new(0, side * .073 * diameter, 0) * vertical, style.Metal, Enum.Material.Metal)
    end
    for index = 1, style.Fittings do
        local angle = (index - .5) * math.pi * 2 / style.Fittings
        local radial = Vector3.new(math.sin(angle), 0, math.cos(angle))
        local point = (radial * .51 + Vector3.new(0, .035, 0)) * diameter
        local seat = CFrame.lookAt(point, point + radial)
        shape("ShellClamp", Enum.PartType.Block, Vector3.new(.105, .23, .085), seat, style.Metal, Enum.Material.Metal)
        if style.Halo then
            shape("CoreVent", Enum.PartType.Block, Vector3.new(.061, .095, .038),
                seat * CFrame.new(0, -.013 * diameter, -.05 * diameter), bright, Enum.Material.Neon)
        end
    end
    local lens = CFrame.new(0, .026 * diameter, -.525 * diameter) * CFrame.Angles(0, math.pi / 2, 0)
    shape("LensHousing", Enum.PartType.Cylinder, Vector3.new(.11, .36, .36), lens, ink, Enum.Material.Metal)
    shape("LensTrim", Enum.PartType.Cylinder, Vector3.new(.047, .27, .27),
        lens * CFrame.new(.065 * diameter, 0, 0), style.Metal, Enum.Material.Metal)
    shape("Prism", Enum.PartType.Block, Vector3.new(.053, .171, .171),
        lens * CFrame.new(.093 * diameter, 0, 0) * CFrame.Angles(math.pi / 4, 0, 0), bright, Enum.Material.Neon)
    model.PrimaryPart = core
    return model, core
end

return OrbVisual
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">RevealDirector</string>
            <string name="Source"><![CDATA[--!strict
-- All effects are local and bounded. No reward decisions or external asset IDs live here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Config)
local Reveals = require(ReplicatedStorage.Shared.ConfigReveal)
local FlightRules = require(ReplicatedStorage.Shared.ConfigFlight)
local Numbers = require(ReplicatedStorage.Shared.NumberFormatter)
local CreatureArt = require(script.Parent.Parent:WaitForChild("CreatureArt"))
local OrbVisual = require(script.Parent:WaitForChild("OrbVisual"))
local Director = {}
type Actions = {Ready: () -> boolean, Submit: (string) -> ()}

local function label(parent: Instance, text: string, y: number, height: number, size: number, color: Color3): TextLabel
    local item = Instance.new("TextLabel")
    item.Size, item.Position = UDim2.new(0.94, 0, 0, height), UDim2.fromScale(0.03, y)
    item.BackgroundTransparency, item.Text, item.TextScaled = 1, text, true
    item.Font, item.TextColor3, item.TextStrokeTransparency = Enum.Font.GothamBlack, color, 0.25
    local constraint = Instance.new("UITextSizeConstraint")
    constraint.MaxTextSize, constraint.MinTextSize, constraint.Parent = size, 10, item
    item.ZIndex, item.Parent = 8, parent
    return item
end
local function preview(id: string, mutation: string?): Model
    local model = Instance.new("Model")
    local mesh = CreatureArt.Get(id, mutation)
    if mesh then
        mesh.CFrame = CFrame.new()
        mesh.Parent = model
        model.PrimaryPart = mesh
    end
    return model
end

function Director.Play(parent: ScreenGui, data: any, alive: () -> boolean, actions: Actions?)
    local tier = Reveals[data.Rarity] or Reveals.Comum
    local reduced = parent:GetAttribute("ReducedMotion") == true
    local overlay = Instance.new("Frame")
    overlay.Name, overlay.Size, overlay.BackgroundColor3 = "RarityReveal", UDim2.fromScale(1,1), Color3.fromRGB(4,6,20)
    overlay.BackgroundTransparency, overlay.Active, overlay.ZIndex, overlay.Parent = 0.1, true, 4, parent
    if data.Preview then label(overlay,"PRÉVIA VISUAL • SEM RECOMPENSA",0,20,12,Color3.new(1,1,1)) end
    local bloom, blur, grade = Instance.new("BloomEffect"), Instance.new("BlurEffect"), Instance.new("ColorCorrectionEffect")
    bloom.Name, blur.Name, grade.Name = "DropRevealBloom", "DropRevealBlur", "DropRevealGrade"
    bloom.Intensity, bloom.Size, bloom.Threshold = 0.4, 30, 1
    blur.Size = if reduced then 0 else 7
    grade.TintColor = tier.Color:Lerp(Color3.new(1,1,1), 0.85)
    bloom.Parent, blur.Parent, grade.Parent = Lighting, Lighting, Lighting
    local viewport = Instance.new("ViewportFrame")
    viewport.Name, viewport.Size, viewport.Position = "CreatureReveal", UDim2.fromScale(.74,.53), UDim2.fromScale(.13,.12)
    viewport.BackgroundTransparency, viewport.ZIndex, viewport.Parent = 1, 7, overlay
    viewport.Ambient, viewport.LightColor, viewport.LightDirection = Color3.new(0.5,0.5,0.5), Color3.new(1,1,1), Vector3.new(-1,-1,-1)
    local world = Instance.new("WorldModel")
    world.Parent = viewport
    local camera = Instance.new("Camera")
    camera.FieldOfView, camera.Parent, viewport.CurrentCamera = 35, viewport, camera
    local creature = preview(data.CreatureId, data.MutationName)
    for _, size in Config.Sizes do
        if size.Name == data.SizeName and creature.PrimaryPart then
            creature:ScaleTo(CreatureArt.Size(data.CreatureId, data.SizeName, size.Scale, data.MutationName))
            break
        end
    end
    creature.Parent = world
    local colors: {[BasePart]: Color3} = {}
    local transparencies: {[BasePart]: number} = {}
    for _, p in creature:GetDescendants() do if p:IsA("BasePart") then colors[p] = p.Color;transparencies[p]=p.Transparency;p.Color = Color3.new();p.Transparency=1 end end
    local bounds, size = CFrame.new(), Vector3.one * 2.1
    if creature.PrimaryPart then bounds, size = creature:GetBoundingBox() end
    local target = bounds.Position
    local originalScale = creature:GetScale()
    local radius = math.max(size.X,size.Y,size.Z) * 2.2
    local captureOrb = OrbVisual.Create(data.OrbColor or tier.Color, math.clamp(size.Magnitude * .45, 1.65, 2.5), data.OrbId)
    captureOrb.Parent = world
    local crown = captureOrb:FindFirstChild("Crown") :: BasePart?
    local prism = captureOrb:FindFirstChild("Prism") :: BasePart?
    local crownOffset = if crown then captureOrb:GetPivot():ToObjectSpace(crown.CFrame) else CFrame.identity
    local prismColor = if prism then prism.Color else tier.Color
    local intro = FlightRules.CaptureIntroSeconds
    local absorptionEnd = .95
    local function poseOrb(frame: CFrame, gap: number)
        captureOrb:PivotTo(frame)
        if crown then crown.CFrame = frame * crownOffset * CFrame.new(0, gap, 0) * CFrame.Angles(gap * .25, 0, 0) end
    end
    local burst: {Frame} = {}
    for i = 1, (if reduced then 0 else 5 + tier.Rank * 4) do
        local piece = Instance.new("Frame")
        piece.AnchorPoint = Vector2.new(.5, .5)
        piece.Position = UDim2.fromScale(.5, .46)
        piece.Size = UDim2.fromOffset(6 + (i % 4) * 2, 6 + (i % 4) * 2)
        piece.Rotation = 45
        piece.BorderSizePixel = 0
        piece.BackgroundColor3 = tier.Color:Lerp(Color3.new(1, 1, 1), (i % 3) * .22)
        piece.Visible = false
        piece.ZIndex = 7
        piece.Parent = overlay
        table.insert(burst, piece)
    end
    local pulse = Instance.new("Frame")
    pulse.AnchorPoint = Vector2.new(.5, .5)
    pulse.Position = UDim2.fromScale(.5, .46)
    pulse.BackgroundTransparency = 1
    pulse.ZIndex = 6
    pulse.Parent = overlay
    local pulseCorner = Instance.new("UICorner")
    pulseCorner.CornerRadius, pulseCorner.Parent = UDim.new(1, 0), pulse
    local pulseEdge = Instance.new("UIStroke")
    pulseEdge.Color, pulseEdge.Thickness, pulseEdge.Transparency, pulseEdge.Parent = tier.Color, 4, 1, pulse
    local rays: {Frame} = {}
    for index = 1, (if reduced then 6 else tier.Rays) do
        local ray = Instance.new("Frame")
        ray.AnchorPoint, ray.Position, ray.Size = Vector2.new(0.5,0.5), UDim2.fromScale(0.5,0.46), UDim2.new(0,3 + tier.Rank,0.38,0)
        ray.Rotation, ray.BackgroundColor3, ray.BackgroundTransparency = index * 360 / tier.Rays, tier.Color, 0.8
        ray.BorderSizePixel, ray.ZIndex, ray.Parent = 0, 5, overlay
        local fade = Instance.new("UIGradient")
        fade.Rotation, fade.Transparency, fade.Parent = 90, NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.4,0.3),NumberSequenceKeypoint.new(1,1)}), ray
        table.insert(rays,ray)
    end
    local rings: {Frame} = {}
    for index = 1, tier.Rings do
        local ring = Instance.new("Frame")
        ring.AnchorPoint, ring.Position = Vector2.new(0.5,0.5), UDim2.fromScale(0.5,0.48)
        ring.Size, ring.BackgroundTransparency, ring.ZIndex, ring.Parent = UDim2.fromOffset(110+index*44,110+index*44), 1, 6, overlay
        local round, stroke = Instance.new("UICorner"), Instance.new("UIStroke")
        round.CornerRadius, round.Parent = UDim.new(1,0), ring
        stroke.Thickness, stroke.Color, stroke.Transparency, stroke.Parent = if index%2==0 then 1 else 3, tier.Color, 0.35, ring
        table.insert(rings,ring)
    end
    local title = label(overlay, "CONEXÃO COM A ORBE",0.06,50,40,tier.Color)
    local name = label(overlay,"? ? ?",.61,36,34,Color3.new(1,1,1))
    local detail = label(overlay,"",.71,24,18,tier.Color)
    local bundle = data.Bundle or {data}
    local captures = 0
    for _, item in bundle do if item.Captured then captures += 1 end end
    local start = os.clock()
    local revealed = false
    local revealedFullSize = false
    local lastShake = 0
    local passed = data.ShakesPassed or 0
    local attempted = math.min(3, passed + (if data.Captured then 0 else 1))
    local sounds: {Sound} = {}
    local function sound(asset: string, volume: number, pitch: number)
        local item = Instance.new("Sound")
        item.SoundId, item.Volume, item.PlaybackSpeed, item.Parent = asset, volume, pitch, SoundService
        table.insert(sounds, item); item:Play()
    end
    local ok, errorMessage = pcall(function()
        while alive() and os.clock() - start < intro + tier.Duration do
            local elapsed = os.clock() - start
            local revealAt = intro + tier.Suspense
            local after = math.max(0,elapsed-revealAt)
            local opened = elapsed >= revealAt
            if elapsed < absorptionEnd then
                local phase = math.clamp((elapsed - .18) / (absorptionEnd - .18), 0, 1)
                local suction = phase ^ 1.7
                local opening = if reduced then 0 else math.sin(phase * math.pi) * .55
                local drop = if reduced then 0 else 1.1 * math.max(0, 1 - elapsed / .26) ^ 2
                poseOrb(CFrame.new(target + Vector3.new(0, drop, 0)) * CFrame.Angles(0, -.23, 0), opening)
                if prism then prism.Color = prismColor:Lerp(Color3.new(1, 1, 1), (1 - suction) * phase) end
                if creature.PrimaryPart then
                    for part, value in transparencies do
                        part.Transparency = if elapsed < .18 then 1 else math.max(value, suction)
                    end
                    creature:ScaleTo(originalScale * math.max(.06, 1 - suction))
                    creature:PivotTo(CFrame.new(-.45 * (1 - suction), 1.05 * (1 - suction), .2))
                end
                title.Text = if elapsed < .18 then "A ORBE POUSOU" else "A ORBE ABSORVE A ENERGIA"
                pulse.Size = UDim2.fromOffset(65 + (1 - suction) * 170, 65 + (1 - suction) * 170)
                pulseEdge.Transparency = if phase == 0 then 1 else .25 + suction * .55
                for index, piece in burst do
                    local angle = index * 2.399963 + phase * 2
                    local radius = (1 - suction) * (.15 + index % 4 * .032)
                    piece.Position = UDim2.fromScale(.5 + math.cos(angle) * radius, .43 + math.sin(angle) * radius)
                    piece.Visible, piece.BackgroundTransparency = phase > 0, .14 + suction * .72
                end
            elseif elapsed < intro then
                for part in transparencies do part.Transparency = 1 end
                for _, piece in burst do piece.Visible = false end
                local beat = elapsed - absorptionEnd
                local shake = math.min(attempted, math.floor(beat / .66) + 1)
                local phase = math.clamp((beat - (shake - 1) * .66) / .66, 0, 1)
                local successful = shake <= passed
                if shake ~= lastShake then
                    lastShake = shake
                    sound("rbxasset://sounds/volume_slider.ogg", .18, if successful then .8 + shake * .18 else .58)
                end
                title.Text = "BALANÇADA " .. shake .. " / 3"
                detail.Text = if successful then "A ORBE RESISTIU" else "A CRIATURA ESTÁ SE SOLTANDO"
                local pulseColor = if successful then Color3.fromRGB(150, 255, 197) else Color3.fromRGB(255, 128, 142)
                local lift = if reduced then 0 else math.sin(phase * math.pi) * (if successful then .25 + shake * .16 else .5)
                local swing = if reduced then 0 else math.sin(phase * math.pi * 3) * (if successful then .25 + shake * .12 else .64) * (1 - phase)
                poseOrb(CFrame.new(target + Vector3.new(swing * .52, lift, 0)) * CFrame.Angles(swing * .33, -.23 + swing * .29, swing), 0)
                if prism then prism.Color = prismColor:Lerp(pulseColor, if phase < .34 then 1 - phase else .19) end
                pulseEdge.Color = pulseColor
                pulse.Size = UDim2.fromOffset(70 + phase * 155, 70 + phase * 155)
                pulseEdge.Transparency = .54 + .46 * phase
            elseif not opened then
                if captureOrb.Parent then captureOrb.Parent = nil end
                if not revealedFullSize then
                    revealedFullSize = true
                    if creature.PrimaryPart then creature:ScaleTo(originalScale) end
                    for part, value in transparencies do part.Transparency = value end
                end
                title.Text = if tier.Rank >= 5 then "UMA PRESENÇA EXTRAORDINÁRIA..." else "QUEM ESTÁ AÍ?"
                detail.Text = "REVELANDO O ENCONTRO"
            elseif not revealed then
                revealed = true
                sound("rbxasset://sounds/volume_slider.ogg",0.18,1.3+tier.Rank*0.1)
                if tier.Rank >= 4 then sound("rbxasset://sounds/impact_explosion_03.mp3",0.12,1.1) end
                for p,color in colors do p.Color = color end
                pulseEdge.Color = tier.Color:Lerp(Color3.new(1, 1, 1), .4)
                title.Text = string.upper(data.Rarity or "Comum") .. (if data.Captured then "!" else " • ENCONTRADA")
                name.Text = data.CreatureName or data.CreatureId
                local mutation = if data.MutationName == "ArcoIris" then "Shiny" else data.MutationName or "Normal"
                local sizeName = if data.SizeName == "Titanica" then "Titânica" else data.SizeName or "Normal"
                local variant = mutation .. " • " .. sizeName
                detail.Text = if data.Captured then variant .. " • $" .. Numbers.Format(data.IncomePerSec or 0) .. "/s"
                    else variant .. " • ESCAPOU • +" .. Numbers.Format(data.XPGained or 0) .. " XP"
                if #bundle > 1 then detail.Text ..= "   |   " .. captures .. "/" .. #bundle .. " capturas" end
                local stats = if data.Distance then Numbers.Format(data.Distance) .. " STUDS" else ""
                local chance = data.SpawnChance
                if type(chance) == "number" and chance > 0 and chance < 1 then
                    stats ..= (if stats == "" then "" else "   •   ") .. "VARIANTE 1 EM " .. Numbers.Format(math.ceil(1 / chance), 2)
                end
                label(overlay, stats, .78, 21, 14, tier.Color)
                if data.RareBoost then
                    title.Position, title.Size = UDim2.new(.03, 0, 0, 8), UDim2.new(.94, 0, 0, 35)
                    local bonus = label(overlay, "CHANCE DE RAROS ×" .. Numbers.Format(data.RareBoost, 2), 0, 18, 14, tier.Color)
                    bonus.Position = UDim2.new(.03, 0, 0, 44)
                    if data.NextBiome and data.NextMilestone then
                        local gate = data.NextMilestone
                        local nextBiome = label(overlay, Config.Biomes[data.NextBiome].Name .. "  ·  Desbloqueia no Nv. " .. gate.Level,
                            0, 18, 13, Color3.fromRGB(211, 222, 255))
                        nextBiome.Position = UDim2.new(.03, 0, 0, 63)
                    end
                end
            end
            local anticipation = if opened and not reduced then math.max(0, 1 - after * 3) else 0
            if opened then
                local sweep = math.clamp(after * 1.8, 0, 1)
                pulse.Size = UDim2.fromOffset(90 + sweep * (190 + tier.Rank * 42), 90 + sweep * (190 + tier.Rank * 42))
                pulseEdge.Transparency = if reduced then 1 else .32 + sweep * .68
                for index, piece in burst do
                    local rate = math.clamp(after * (1 + index % 5 * .13), 0, 1)
                    local angle = index * 2.399963
                    local distance = rate * (.18 + tier.Rank * .023 + index % 4 * .04)
                    piece.Position = UDim2.fromScale(.5 + math.cos(angle) * distance, .46 + math.sin(angle) * distance - rate * .07)
                    piece.Rotation = 45 + after * ((index % 3) - 1) * 120
                    piece.Visible = rate < 1
                    piece.BackgroundTransparency = .12 + rate * .88
                end
            end
            local rotation = if reduced then 0.15 else (if opened then math.min(after*0.6,1.8) else math.sin(elapsed*3)*0.15)
            local zoom = if opened then 1 - .18 * anticipation elseif elapsed >= intro then 1.24 else 1.06
            local height = if opened then .17 else .24
            camera.CFrame = CFrame.lookAt(target + Vector3.new(math.sin(rotation)*radius*zoom, radius*height, -math.cos(rotation)*radius*zoom),target)
            local lift = if reduced or not opened then 0 else math.sin(after * 3.1) * .10 + anticipation * .28
            local yaw = if reduced then 0 else math.sin(after * 2) * .13
            if elapsed >= absorptionEnd then creature:PivotTo(CFrame.new(0, lift, 0) * CFrame.Angles(0, yaw, 0)) end
            bloom.Intensity = math.min(1.5,0.3+tier.Rank*0.1+anticipation*0.5)
            overlay.BackgroundColor3 = if tier.Rank == 7 then Color3.fromHSV((elapsed*0.04)%1,0.5,0.055) else Color3.fromRGB(4,6,20)
            for index, ray in rays do
                local angle = index * math.pi * 2 / #rays + (if reduced then 0 else elapsed * (.08 + tier.Rank * .015))
                local radius = math.min(overlay.AbsoluteSize.X, overlay.AbsoluteSize.Y) * (0.17 + anticipation * .025)
                ray.Position = UDim2.new(.5, math.cos(angle) * radius, .46, math.sin(angle) * radius)
                ray.Rotation = math.deg(angle) + 90
                ray.BackgroundTransparency = if opened then 0.76+math.sin(elapsed*2+index)*0.08 else 0.92
            end
            for index, ring in rings do
                ring.Rotation = (if index%2==0 then -1 else 1)*elapsed*(4+tier.Rank)
                local diameter = (110+index*44)*(1+anticipation*0.3)
                ring.Size = UDim2.fromOffset(diameter,diameter)
            end
            RunService.RenderStepped:Wait()
        end
    end)
    captureOrb:Destroy()
    for _, item in sounds do item:Destroy() end
    bloom:Destroy(); blur:Destroy(); grade:Destroy()
    if ok and actions and alive() then
        for _, item in burst do item:Destroy() end
        pulse:Destroy()
        local bar = Instance.new("Frame")
        bar.Name, bar.AnchorPoint, bar.Position = "ThrowOptions", Vector2.new(.5, 1), UDim2.new(.5, 0, 1, -10)
        bar.Size, bar.BackgroundTransparency, bar.Parent = UDim2.new(.94, 0, 0, 44), 1, overlay
        local limit = Instance.new("UISizeConstraint")
        limit.MaxSize, limit.Parent = Vector2.new(460, 44), bar
        local buttons: {TextButton} = {}
        local options = {
            {Id = "Retry", Caption = "JOGAR DE NOVO", Color = Color3.fromRGB(93, 231, 138)},
            {Id = "Base", Caption = "VOLTAR À BASE", Color = Color3.fromRGB(134, 196, 255)},
        }
        for index, option in options do
            local button = Instance.new("TextButton")
            button.Name, button.Text, button.Font = "Choose" .. option.Id, option.Caption, Enum.Font.GothamBlack
            button.Position, button.Size = UDim2.fromScale((index - 1) * .52, 0), UDim2.fromScale(.48, 1)
            button.BackgroundColor3, button.TextColor3 = option.Color, Color3.fromRGB(17, 29, 43)
            button.TextSize, button.ZIndex, button.Parent = 14, 9, bar
            local rounded = Instance.new("UICorner")
            rounded.CornerRadius, rounded.Parent = UDim.new(0, 10), button
            button.Activated:Connect(function() if actions.Ready() then actions.Submit(option.Id) end end)
            table.insert(buttons, button)
        end
        local wasEnabled = false
        while alive() do
            local enabled = actions.Ready()
            for _, button in buttons do
                button.Active, button.Selectable, button.AutoButtonColor = enabled, enabled, enabled
                button.BackgroundTransparency = if enabled then 0 else .35
            end
            if enabled and not wasEnabled and UserInputService:GetLastInputType().Name:match("^Gamepad") then
                GuiService.SelectedObject = buttons[1]
            end
            wasEnabled = enabled
            task.wait(.1)
        end
    end
    overlay:Destroy()
    if not ok then warn("[RevealDirector]", errorMessage) end
end
return Director
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">ThrowPose</string>
            <string name="Source"><![CDATA[--!strict
-- Three procedural throw performances, replicated as a compact server event.
-- No uploaded animation IDs are required; final artist clips can replace this module.
local Run=game:GetService("RunService")
local Workspace=game:GetService("Workspace")
local Pose={}
local active:{[Model]:()->()}={}
function Pose.Play(character:Model,power:number,startedAt:number)
 if active[character] then active[character]() end
 local strong=power>=0.8
 local medium=power>=0.35
 local arm=if strong then 2.35 elseif medium then 1.3 else 0.55
 local twist=if strong then 0.48 elseif medium then 0.22 else 0.05
 local joints={}
 for _,joint in character:GetDescendants() do
  local name=joint.Name:gsub(" ",""):lower()
  if (joint:IsA("Motor6D") or joint.ClassName=="AnimationConstraint") and (name=="rightshoulder" or name=="leftshoulder" or name=="waist" or name=="rootjoint") then
   local ok,value=pcall(function()return (joint::any).Transform end)
   if ok and typeof(value)=="CFrame" then table.insert(joints,{Joint=joint,Name=name,Original=value}) end
  end
 end
 local connection:RBXScriptConnection?=nil
 local function clear()
  if connection then connection:Disconnect();connection=nil end
  for _,item in joints do if item.Joint.Parent then pcall(function()item.Joint.Transform=item.Original end) end end
  active[character]=nil
 end
 active[character]=clear
 connection=Run.PreSimulation:Connect(function()
  local t=Workspace:GetServerTimeNow()-startedAt
  if not character.Parent or t>1.25 then clear();return end
  local wind=math.clamp(t/0.55,0,1)
  local release=math.clamp((t-0.55)/0.22,0,1)
  local recover=1-math.clamp((t-0.77)/0.48,0,1)
  local right=(arm*wind-(arm+0.4)*release)*recover
  local body=twist*math.sin(wind*math.pi/2)*(1-2*release)*recover
  for _,item in joints do
   local transform
   if item.Name=="rightshoulder" then transform=CFrame.Angles(-right,0,right*0.12)
   elseif item.Name=="leftshoulder" then transform=CFrame.Angles(if strong then -0.6*wind*recover else -0.08*wind,0,-body)
   else transform=CFrame.Angles(body*0.4,body,body*0.08) end
   if item.Joint.Parent then pcall(function()item.Joint.Transform=item.Original*transform end) end
  end
 end)
end
return Pose
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="105">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">CommercePanels</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Settings = require(Shared:WaitForChild("ConfigGameplay"))
local Catalog = require(Shared:WaitForChild("ConfigMonetizacao"))
local Numbers = require(Shared:WaitForChild("NumberFormatter"))
local W = require(script.Parent:WaitForChild("HUDWidgets"))
local Icons = require(script.Parent:WaitForChild("HUDIcons"))
local C = W.Colors

local Commerce = {}

local function preferences(actions: any): any
	actions.Session.Commerce = actions.Session.Commerce or {Scroll = {}, Bids = {}, Selected = {}, MinimumBid = "10", TradePage = 1, AuctionPage = 1}
	return actions.Session.Commerce
end

local function nameOf(record: any): string
	local definition = Config.Creatures[record.CreatureId]
	return if definition then definition.Name else tostring(record.CreatureId)
end

local function uidList(values: any): string
	local result = {}
	for _, value in values or {} do table.insert(result, tostring(value)) end
	table.sort(result)
	return table.concat(result, ",")
end

function Commerce.Signature(kind: string, state: any, session: any): string
	state = state or {}
	session = session or {}
	local preference = session.Commerce or {}
	local values = {kind, tostring(state.CurrentBiome), tostring(state.Level)}
	if kind == "Trocas" then
		local trade = state.Trade or {}
		for _, key in {"SessionId", "Revision", "Phase", "MyReady", "PartnerReady", "MyConfirmed", "PartnerConfirmed"} do table.insert(values, tostring(trade[key])) end
		table.insert(values, uidList(trade.MyOffer)); table.insert(values, uidList(trade.PartnerOffer))
		for _, item in state.TradeCandidates or {} do table.insert(values, tostring(item.UserId) .. item.Name) end
		local selected = {}; for uid, active in preference.Selected or {} do if active then table.insert(selected, uid) end end
		table.insert(values, uidList(selected)); table.insert(values, tostring(preference.TradePage))
	elseif kind == "Leiloes" then
		-- Bids and clocks update in place, preserving an actively edited TextBox.
		for _, lot in state.Auctions or {} do table.insert(values, lot.AuctionId) end
		table.insert(values, tostring(preference.AuctionUid)); table.insert(values, tostring(preference.AuctionPage))
	elseif kind == "GrupoVIP" then
		local benefits = {}; for key, enabled in state.Benefits or {} do table.insert(benefits, key .. tostring(enabled)) end
		table.sort(benefits); table.insert(values, table.concat(benefits, ","))
		table.insert(values, tostring(state.VIPLastClaim)); table.insert(values, tostring((state.Titles or {}).Grupo))
	end
	if kind ~= "GrupoVIP" then
		for _, record in state.CapturedCreatures or {} do table.insert(values, record.Uid .. ":" .. tostring(record.Mutation) .. ":" .. tostring(record.Size) .. ":" .. tostring(record.IncomePerSec)) end
	end
	return table.concat(values, "|")
end

local function serverNow(state: any, actions: any): number
	return (state.ServerTime or os.time()) + (if actions.Elapsed then actions.Elapsed() else 0)
end

local function setCaption(button: TextButton, value: string)
	local caption = button:FindFirstChild("Caption")
	if caption and caption:IsA("TextLabel") then caption.Text = value end
end

local function disable(button: TextButton, value: boolean)
	button.Active = not value
	button.Selectable = not value
	local caption = button:FindFirstChild("Caption")
	if caption and caption:IsA("TextLabel") then caption.TextColor3 = if value then C.Muted else C.White end
end

function Commerce.Update(parent: GuiObject, state: any, actions: any)
	if not state then return end
	local now = serverNow(state, actions)
	local lots = {}; for _, lot in state.Auctions or {} do lots[lot.AuctionId] = lot end
	for _, object in parent:GetDescendants() do
		local at = object:GetAttribute("CommerceClockAt")
		if object:IsA("TextButton") and object.Name == "ConfirmTrade" then at = (state.Trade or {}).ReadyAt or at end
		if type(at) == "number" then
			local remaining = math.max(0, math.ceil(at - now))
			if object:IsA("TextLabel") then
				object.Text = if remaining > 0 then "ENCERRA EM " .. string.format("%02d:%02d", math.floor(remaining / 60), remaining % 60) else "ENCERRANDO..."
			elseif object:IsA("TextButton") and object.Name == "ConfirmTrade" then
				local trade = state.Trade or {}
				disable(object, remaining > 0 or trade.Phase ~= "Review" or trade.MyConfirmed == true)
				setCaption(object, if trade.MyConfirmed then "CONFIRMADO" elseif remaining > 0 then "REVISE • " .. remaining .. "s" else "CONFIRMAR TROCA")
			end
		end
		local auctionId = object:GetAttribute("CommerceAuctionId")
		local lot = if type(auctionId) == "string" then lots[auctionId] else nil
		if lot then
			if object:IsA("TextLabel") then object.Text = "MAIOR LANCE: $" .. Numbers.Format(lot.HighestBid) .. " • MÍNIMO: $" .. Numbers.Format(lot.MinimumBid)
			elseif object:IsA("TextButton") and object.Name == "CancelAuction" then
				disable(object, lot.HighestBid > 0); setCaption(object, if lot.HighestBid > 0 then "LOTE COM LANCE • AGUARDE" else "CANCELAR E RECEBER DE VOLTA")
			elseif object:IsA("TextButton") then
				setCaption(object, if lot.HighestBidderUserId == Players.LocalPlayer.UserId then "AUMENTAR LANCE" else "DAR LANCE")
			end
		end
		if object:IsA("TextButton") and object.Name == "ClaimVIP" then
			local vip = ((state.Rewards or {}).VIP or {})
			local remaining = math.max(0, math.ceil((vip.NextClaimAt or 0) - now))
			disable(object, remaining > 0 or (state.Benefits or {}).GoldenVIP ~= true)
			setCaption(object, if remaining > 0 then "BAÚ VIP EM " .. string.format("%02dh %02dm", math.floor(remaining / 3600), math.floor(remaining / 60) % 60) else "ABRIR BAÚ VIP DIÁRIO")
		end
	end
end

function Commerce.Render(parent: GuiObject, kind: string, state: any, actions: any): () -> ()
	state = state or {}
	local prefs = preferences(actions)
	local running: boolean = true
	local connections: {RBXScriptConnection} = {}
	local list = W.List(parent, "Commerce_" .. kind, UDim2.new(), UDim2.fromScale(1, 1))
	local order = 0
	local function ordered(object: GuiObject)
		order += 1; object.LayoutOrder = order
	end
	local function line(value: string, height: number?, color: Color3?): TextLabel
		local label = W.Label(list, "Hint", value, UDim2.new(), UDim2.new(1, -2, 0, height or 42), 13, color or C.Muted, true)
		label.TextWrapped = true; ordered(label)
		return label
	end
	local function card(name: string, height: number, color: Color3?): Frame
		local frame = W.Frame(list, name, UDim2.new(), UDim2.new(1, -2, 0, height), color or C.Card)
		ordered(frame); return frame
	end
	local function actionButton(name: string, value: string, color: Color3, callback: () -> (), height: number?): TextButton
		local button = W.Button(list, name, value, UDim2.new(), UDim2.new(1, -2, 0, height or 46), color, 14)
		ordered(button); button.Activated:Connect(callback)
		return button
	end
	local function textbox(container: Frame, name: string, initial: string, position: UDim2, size: UDim2, changed: (string) -> ()): TextBox
		local box = Instance.new("TextBox")
		box.Name = name; box.Position = position; box.Size = size
		box.BackgroundColor3 = C.Ink; box.TextColor3 = C.Gold; box.BorderSizePixel = 0
		box.Font = Enum.Font.GothamBold; box.TextSize = 15; box.ClearTextOnFocus = false
		box.Text = initial; box.PlaceholderText = "Moedas"; box.Parent = container
		W.Round(box, 8); W.Outline(box, 2, C.Blue)
		table.insert(connections, box:GetPropertyChangedSignal("Text"):Connect(function() changed(box.Text) end))
		return box
	end
	local function eligible(): boolean return (state.Level or 1) >= 15 and state.CurrentBiome == "TradingPlaza" end
	local function plazaHint()
		line("PRAÇA DE TROCAS • Nível 15+ • Apenas criaturas e moedas do jogo nesta sala.", 43)
		if not eligible() then
			local travel = actionButton("VisitPlaza", "IR À PRAÇA DE TROCAS", C.Blue, function() actions.Send("TravelToBiome", "TradingPlaza") end)
			disable(travel, (state.Level or 1) < 15)
		end
	end
	local function creatureRow(record: any, selected: boolean, callback: (() -> ())?, suffix: string?)
		local row = card("Creature_" .. record.Uid, 78)
		local iconHost = Instance.new("Frame")
		iconHost.BackgroundTransparency = 1; iconHost.Size = UDim2.fromOffset(46, 46); iconHost.Position = UDim2.fromOffset(8, 14); iconHost.Parent = row
		local definition = Config.Creatures[record.CreatureId]
		Icons.Draw(iconHost, if definition then definition.Element else "Paw", if selected then C.Gold else C.Blue)
		local name = W.Label(row, "Name", nameOf(record), UDim2.fromOffset(63, 7), UDim2.new(1, if callback then -157 else -74, 0, 24), 15, if selected then C.Gold else C.White)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local detail = W.Label(row, "Details", tostring(record.Mutation) .. " / " .. tostring(record.Size) .. " • $" .. Numbers.Format(record.IncomePerSec or 0) .. "/s", UDim2.fromOffset(63, 32), UDim2.new(1, if callback then -157 else -74, 0, 20), 10, C.Muted, true)
		detail.TextTruncate = Enum.TextTruncate.AtEnd
		W.Label(row, "Id", suffix or ("ID " .. string.sub(record.Uid, -8)), UDim2.fromOffset(63, 54), UDim2.new(1, -75, 0, 16), 9, C.Muted, true)
		if callback then
			local select = W.Button(row, "Select_" .. record.Uid, if selected then "ESCOLHIDA" else "ESCOLHER", UDim2.new(1, -89, 0.5, -23), UDim2.fromOffset(80, 46), if selected then C.Orange else C.Green, 10)
			select.Activated:Connect(callback)
		end
	end
	local function inventoryPage(pageKey: string, selected: (string) -> boolean, choose: (string) -> ())
		local records = state.CapturedCreatures or {}
		local pages = math.max(1, math.ceil(#records / 20))
		local page = math.clamp(prefs[pageKey] or 1, 1, pages)
		prefs[pageKey] = page
		line("MINHAS CRIATURAS • Página " .. page .. " / " .. pages, 28, C.Gold)
		for index = (page - 1) * 20 + 1, math.min(#records, page * 20) do
			local record = records[index]
			creatureRow(record, selected(record.Uid), function() choose(record.Uid) end)
		end
		if #records == 0 then line("Capture uma criatura para começar sua coleção.", 50) end
		if pages > 1 then
			local pagination = card("Pagination", 58)
			local previous = W.Button(pagination, "PreviousPage", "ANTERIOR", UDim2.fromOffset(8, 7), UDim2.new(0.5, -12, 0, 44), C.Blue, 12)
			local nextPage = W.Button(pagination, "NextPage", "PRÓXIMA", UDim2.new(0.5, 4, 0, 7), UDim2.new(0.5, -12, 0, 44), C.Purple, 12)
			disable(previous, page == 1); disable(nextPage, page == pages)
			previous.Activated:Connect(function() prefs[pageKey] = math.max(1, page - 1); actions.Refresh() end)
			nextPage.Activated:Connect(function() prefs[pageKey] = math.min(pages, page + 1); actions.Refresh() end)
		end
	end

	if kind == "Trocas" then
		plazaHint()
		local trade = state.Trade or {}
		if not trade.SessionId then
			prefs.TradeId = nil; prefs.Selected = {}
			line("Convide alguém da praça. Confira as ofertas, aceite e revise por 3 segundos antes da confirmação final.", 58)
			for _, candidate in state.TradeCandidates or {} do
				local row = card("Player_" .. candidate.UserId, 66)
				local name = W.Label(row, "Name", candidate.Name, UDim2.fromOffset(12, 7), UDim2.new(1, -127, 1, -14), 17)
				name.TextTruncate = Enum.TextTruncate.AtEnd
				local invite = W.Button(row, "Invite_" .. candidate.UserId, "CONVIDAR", UDim2.new(1, -110, 0, 10), UDim2.fromOffset(100, 46), C.Green, 12)
				disable(invite, not eligible())
				invite.Activated:Connect(function() actions.Send("TradeAction", "Invite", {TargetUserId = candidate.UserId}) end)
			end
			if #(state.TradeCandidates or {}) == 0 then line("Nenhum outro jogador está disponível na praça agora.", 55) end
		else
			if prefs.TradeId ~= trade.SessionId then
				prefs.TradeId = trade.SessionId; prefs.Selected = {}
				for _, uid in trade.MyOffer or {} do prefs.Selected[uid] = true end
			end
			local id, revision = trade.SessionId, trade.Revision
			local function sendTrade(action: string, extra: any?)
				local latest = if actions.GetState then actions.GetState() else state
				if (latest.Trade or {}).SessionId ~= id or (latest.Trade or {}).Revision ~= revision then actions.Notify("A oferta mudou. Confira a versão atual."); return end
				local payload = extra or {}; payload.SessionId = id; payload.Revision = revision
				actions.Send("TradeAction", action, payload)
			end
			line("TROCA COM " .. tostring(trade.PartnerName) .. " • OFERTA #" .. tostring(revision), 35, C.Gold)
			if trade.Phase == "Invited" then
				line(if trade.InviterUserId == Players.LocalPlayer.UserId then "Convite enviado. Aguarde a resposta do outro jogador." else "Você recebeu um convite de troca. Aceite para escolher as criaturas.", 63)
				if trade.InviterUserId ~= Players.LocalPlayer.UserId then actionButton("AcceptTrade", "ACEITAR CONVITE", C.Green, function() sendTrade("Accept") end) end
			elseif trade.Phase == "Offering" then
				local selected = {}; for uid, active in prefs.Selected do if active then table.insert(selected, uid) end end; table.sort(selected)
				line("Selecione até 8 criaturas e envie sua oferta. Toda alteração reinicia as confirmações.", 48)
				actionButton("SendOffer", "ENVIAR OFERTA • " .. #selected .. " CRIATURAS", C.Blue, function() sendTrade("Offer", {Uids = selected}) end)
				local ready = actionButton("ReadyTrade", if trade.MyReady then "PRONTO • AGUARDANDO PARCEIRO" else "ACEITAR OFERTAS PARA REVISÃO", C.Green, function() sendTrade("Ready") end)
				disable(ready, trade.MyReady == true or uidList(selected) ~= uidList(trade.MyOffer))
			elseif trade.Phase == "Review" then
				line("AS OFERTAS ESTÃO TRAVADAS. Confira nomes, variantes e renda dos dois lados antes de confirmar.", 58, C.Gold)
				local confirm = actionButton("ConfirmTrade", "REVISANDO...", C.Green, function() sendTrade("Confirm") end)
				confirm:SetAttribute("CommerceClockAt", trade.ReadyAt or 0)
				actionButton("EditOffer", "EDITAR OFERTA E RECOMEÇAR REVISÃO", C.Orange, function() sendTrade("Offer", {Uids = trade.MyOffer or {}}) end)
			else line("SALVANDO A TROCA... Aguarde a confirmação do servidor.", 65, C.Gold) end
			line("VOCÊ OFERECE", 28, C.Blue)
			local mine = {}; for _, uid in trade.MyOffer or {} do mine[uid] = true end
			for _, record in state.CapturedCreatures or {} do if mine[record.Uid] then creatureRow(record, true, nil) end end
			if #(trade.MyOffer or {}) == 0 then line("Nenhuma criatura na sua oferta.", 30) end
			line("VOCÊ RECEBE DE " .. tostring(trade.PartnerName), 30, C.Pink)
			for _, record in trade.PartnerCreatures or {} do creatureRow(record, false, nil) end
			if #(trade.PartnerOffer or {}) == 0 then line("O parceiro ainda não adicionou criaturas.", 35) end
			if trade.Phase == "Offering" then
				inventoryPage("TradePage", function(uid: string) return prefs.Selected[uid] == true end, function(uid: string)
					local count = 0; for _, active in prefs.Selected do if active then count += 1 end end
					if not prefs.Selected[uid] and count >= 8 then actions.Notify("Selecione no máximo 8 criaturas."); return end
					prefs.Selected[uid] = if prefs.Selected[uid] then nil else true; actions.Refresh()
				end)
			end
			if trade.Phase ~= "Committing" then actionButton("CancelTrade", "CANCELAR TROCA", C.Pink, function() sendTrade("Cancel") end) end
		end
	elseif kind == "Leiloes" then
		plazaHint()
		line("LEILÕES DESTA SALA • 120 segundos • Máximo de 10 lotes. Lances usam somente moedas do jogo.", 58, C.Gold)
		line("Criaturas e moedas ficam reservadas. Um lance superado é restituído; saídas ou interrupções cancelam o lote com restituição segura.", 62)
		local owned = {}; for _, record in state.CapturedCreatures or {} do owned[record.Uid] = record end
		if prefs.AuctionUid and not owned[prefs.AuctionUid] then prefs.AuctionUid = nil end
		local form = card("CreateAuction", 124)
		local chosen = owned[prefs.AuctionUid or ""]
		local summary = W.Label(form, "SelectedCreature", if chosen then "LOTE: " .. nameOf(chosen) else "ESCOLHA UMA CRIATURA ABAIXO", UDim2.fromOffset(12, 7), UDim2.new(1, -24, 0, 27), 15, C.Gold)
		summary.TextTruncate = Enum.TextTruncate.AtEnd
		W.Label(form, "PriceHint", "Lance mínimo em moedas", UDim2.fromOffset(12, 39), UDim2.new(1, -24, 0, 18), 11, C.Muted, true)
		textbox(form, "MinimumBid", prefs.MinimumBid or "10", UDim2.fromOffset(12, 65), UDim2.new(0.5, -18, 0, 46), function(value: string) prefs.MinimumBid = value end)
		local create = W.Button(form, "ListCreature", "CRIAR LEILÃO", UDim2.new(0.5, 5, 0, 65), UDim2.new(0.5, -17, 0, 46), C.Green, 12)
		disable(create, not chosen or not eligible())
		create.Activated:Connect(function()
			local amount = tonumber(prefs.MinimumBid)
			if not amount or amount <= 0 or amount == math.huge or amount % 1 ~= 0 then actions.Notify("Digite um lance mínimo inteiro e positivo."); return end
			actions.Send("AuctionAction", "List", {Uid = prefs.AuctionUid, MinimumBid = amount})
		end)
		for _, lot in state.Auctions or {} do
			local row = card("Auction_" .. lot.AuctionId, 180)
			local record = lot.Creature
			local name = W.Label(row, "Name", nameOf(record) .. " • " .. tostring(lot.SellerName), UDim2.fromOffset(12, 6), UDim2.new(1, -24, 0, 25), 16, C.Gold)
			name.TextTruncate = Enum.TextTruncate.AtEnd
			W.Label(row, "Details", tostring(record.Mutation) .. " / " .. tostring(record.Size) .. " • $" .. Numbers.Format(record.IncomePerSec or 0) .. "/s", UDim2.fromOffset(12, 34), UDim2.new(1, -24, 0, 20), 11, C.Muted, true)
			local clock = W.Label(row, "Deadline", "", UDim2.fromOffset(12, 59), UDim2.new(1, -24, 0, 20), 12, C.Pink)
			clock:SetAttribute("CommerceClockAt", lot.EndsAt)
				local bidLabel = W.Label(row, "Bid", "MAIOR LANCE: $" .. Numbers.Format(lot.HighestBid) .. " • MÍNIMO: $" .. Numbers.Format(lot.MinimumBid), UDim2.fromOffset(12, 85), UDim2.new(1, -24, 0, 22), 11, C.Green, true)
				bidLabel:SetAttribute("CommerceAuctionId", lot.AuctionId)
			if lot.SellerUserId == Players.LocalPlayer.UserId then
				local cancel = W.Button(row, "CancelAuction", if lot.HighestBid > 0 then "LOTE COM LANCE • AGUARDE" else "CANCELAR E RECEBER DE VOLTA", UDim2.fromOffset(12, 122), UDim2.new(1, -24, 0, 46), C.Orange, 12)
				cancel:SetAttribute("CommerceAuctionId", lot.AuctionId)
				disable(cancel, lot.HighestBid > 0)
				cancel.Activated:Connect(function() actions.Send("AuctionAction", "Cancel", {AuctionId = lot.AuctionId}) end)
			else
				prefs.Bids[lot.AuctionId] = prefs.Bids[lot.AuctionId] or tostring(math.max(lot.MinimumBid, lot.HighestBid + 1))
				textbox(row, "BidAmount_" .. lot.AuctionId, prefs.Bids[lot.AuctionId], UDim2.fromOffset(12, 122), UDim2.new(0.5, -18, 0, 46), function(value: string) prefs.Bids[lot.AuctionId] = value end)
				local bid = W.Button(row, "Bid_" .. lot.AuctionId, if lot.HighestBidderUserId == Players.LocalPlayer.UserId then "AUMENTAR LANCE" else "DAR LANCE", UDim2.new(0.5, 5, 0, 122), UDim2.new(0.5, -17, 0, 46), C.Green, 12)
				bid:SetAttribute("CommerceAuctionId", lot.AuctionId)
				disable(bid, not eligible())
				bid.Activated:Connect(function()
					local amount = tonumber(prefs.Bids[lot.AuctionId])
					if not amount or amount <= 0 or amount == math.huge or amount % 1 ~= 0 then actions.Notify("Digite um lance inteiro e positivo."); return end
					actions.Send("AuctionAction", "Bid", {AuctionId = lot.AuctionId, Amount = amount})
				end)
			end
		end
		if #(state.Auctions or {}) == 0 then line("Nenhum lote aberto nesta sala. Você pode criar o primeiro.", 55) end
		inventoryPage("AuctionPage", function(uid: string) return prefs.AuctionUid == uid end, function(uid: string) prefs.AuctionUid = uid; actions.Refresh() end)
	elseif kind == "GrupoVIP" then
		local groupConfigured = type(Settings.GroupId) == "number" and Settings.GroupId > 0
		local member = groupConfigured and (state.Benefits or {}).GroupMember == true
		line("GRUPO & VIP • Benefícios verificados pelo servidor", 38, C.Gold)
		local group = card("Group", 160)
		W.Label(group, "Title", if member then "MEMBRO DO GRUPO VERIFICADO" elseif groupConfigured then "GRUPO OFICIAL" else "GRUPO AINDA NÃO CONFIGURADO", UDim2.fromOffset(12, 9), UDim2.new(1, -24, 0, 30), 17, if member then C.Green else C.Blue).TextWrapped = true
		local description = W.Label(group, "Description", if groupConfigured then "+10% sorte, +1 espaço no santuário e acesso ao Auto-Treino para membros. Reentre após entrar no grupo para atualizar a verificação." else "O grupo oficial ainda não foi conectado. Os benefícios de membro não estão ativos.", UDim2.fromOffset(12, 46), UDim2.new(1, -24, 0, 55), 12, C.Muted, true)
		description.TextWrapped = true
		local groupClaim = W.Button(group, "ClaimGroup", "RECONHECER BÔNUS DE GRUPO", UDim2.fromOffset(12, 108), UDim2.new(1, -24, 0, 44), C.Green, 12)
		disable(groupClaim, not member or (state.Titles or {}).Grupo == true)
		groupClaim.Activated:Connect(function() actions.Send("ClaimGroupReward") end)
		local vipConfigured = false
		for _, item in Catalog.Items do if item.Key == "GoldenVIP" and item.Id > 0 then vipConfigured = true end end
		local vip = vipConfigured and (state.Benefits or {}).GoldenVIP == true
		line(if vip then "VIP DOURADO ATIVO" else "VIP DOURADO • LOJA EM PREPARAÇÃO", 35, C.Gold)
		line(if vip then "Seu VIP concede +25% moedas e XP, tag dourada e baú diário." else "Previsto: +25% moedas e XP, tag dourada, aura e baú diário. O passe ainda não está à venda.", 63)
		if vip then actionButton("ClaimVIP", "ABRIR BAÚ VIP DIÁRIO", C.Gold, function() actions.Send("ClaimVIPReward") end) end
		actionButton("Shop", "VER CATÁLOGO DA LOJA", C.Pink, function() actions.Open("Loja") end)
		actionButton("Automation", "VER AUTOMAÇÕES", C.Blue, function() actions.Open("Auto") end)
	end

	table.insert(connections, list:GetPropertyChangedSignal("CanvasPosition"):Connect(function() prefs.Scroll[kind] = list.CanvasPosition end))
	local scroll = prefs.Scroll[kind]
	if scroll then task.delay(0.05, function() if running and list.Parent then list.CanvasPosition = scroll end end) end
	Commerce.Update(parent, state, actions)
	return function()
		if not running then return end
		running = false
		prefs.Scroll[kind] = list.CanvasPosition
		for _, connection in connections do connection:Disconnect() end
		list:Destroy()
	end
end

return Commerce
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">GameplayPanels</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local meshFolder = Shared:WaitForChild("CreatureMeshes")
local Rewards = require(Shared:WaitForChild("ConfigRecompensas"))
local Progression = require(Shared:WaitForChild("ConfigProgression"))
local Numbers = require(Shared:WaitForChild("NumberFormatter"))
local W = require(script.Parent:WaitForChild("HUDWidgets"))
local Icons = require(script.Parent:WaitForChild("HUDIcons"))
local C = W.Colors
local View = {}
local names = {PotionLuck2 = "Poção 2× Sorte", PotionCoins2 = "Poção 2× Moedas", PotionLuck3 = "Poção 3× Sorte", PotionCoins3 = "Poção 3× Moedas", GlobalLuckTotem = "Totem Global 5× Sorte", SummonEvent = "Invocar evento", SkipFusion = "Pular recarga de fusão", SanctuarySlot = "+1 espaço no santuário"}
local biomeOrder = {"PradariaSolar", "FlorestaNeon", "CanionVulcanico", "AbismoGlacial", "RuinasAncestrais", "VazioCosmico"}
local missionOrder = {"Capture15", "Critical3", "Fusion1"}

local function caption(button: TextButton, text: string)
    local label = button:FindFirstChild("Caption")
    if label and label:IsA("TextLabel") then label.Text = text end
end
function View.Time(seconds: number): string
    local amount = math.max(0, math.ceil(seconds))
    if amount >= 3600 then return string.format("%dh %02dm", math.floor(amount / 3600), math.floor(amount % 3600 / 60)) end
    return string.format("%02d:%02d", math.floor(amount / 60), amount % 60)
end
local function now(): number return Workspace:GetServerTimeNow() end
local function hint(parent: Instance, text: string, y: number?): TextLabel
    local label = W.Label(parent, "Hint", text, UDim2.fromOffset(4, y or 0), UDim2.new(1, -8, 0, 42), 12, C.Muted, true)
    label.TextWrapped = true
    return label
end
local function card(parent: Instance, id: string, height: number, color: Color3): Frame
    local row = W.Frame(parent, id, UDim2.new(), UDim2.new(1, -2, 0, height), C.Card)
    W.Gradient(row, color:Lerp(C.Ink, 0.7), C.Panel)
    return row
end
local function heading(row: Frame, text: string, detail: string, icon: string, color: Color3)
    local host = Instance.new("Frame")
    host.Name = "Pictogram"
    host.Position = UDim2.fromOffset(10, 9)
    host.Size = UDim2.fromOffset(40, 40)
    host.BackgroundTransparency = 1
    host.Parent = row
    Icons.Draw(host, icon, color)
    local title = W.Label(row, "Name", text, UDim2.fromOffset(61, 8), UDim2.new(1, -73, 0, 24), 17, color)
    title.TextTruncate = Enum.TextTruncate.AtEnd
    local description = W.Label(row, "Description", detail, UDim2.fromOffset(61, 32), UDim2.new(1, -73, 0, 44), 11, C.White, true)
    description.TextWrapped = true
    description.TextYAlignment = Enum.TextYAlignment.Top
end
function View.Tabs(parent: GuiObject, entries: {any}, selected: string, choose: (string) -> ())
    for index, item in entries do
        local button = W.Button(parent, "Tab_" .. item.Id, item.Name, UDim2.new((index - 1) / #entries, 3, 0, 0), UDim2.new(1 / #entries, -6, 0, 44), if selected == item.Id then C.Gold else C.Purple, 11)
        button.Activated:Connect(function() choose(item.Id) end)
    end
end
local function panelBody(parent: GuiObject, name: string, top: number): Frame
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.Position = UDim2.fromOffset(0, top)
    frame.Size = UDim2.new(1, 0, 1, -top)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    return frame
end
function View.RewardText(reward: any, level: number?): string
    local parts = {}
    if reward.Coins then table.insert(parts, "$" .. Numbers.Format(reward.Coins * (if reward.ScaleCoinsWithLevel then level or 1 else 1))) end
    if reward.XP then table.insert(parts, "+" .. Numbers.Format(reward.XP) .. " XP base") end
    if reward.Gems then table.insert(parts, "+" .. reward.Gems .. " gemas") end
    for id, count in reward.Orbs or {} do table.insert(parts, count .. "× " .. (if Config.Orbs[id] then Config.Orbs[id].Name else id)) end
    for id, count in reward.Consumables or {} do table.insert(parts, count .. "× " .. (names[id] or id)) end
    if reward.Creature and meshFolder:FindFirstChild(reward.Creature.Id) then
        table.insert(parts, Config.Creatures[reward.Creature.Id].Name .. " • " .. reward.Creature.Mutation)
    end
    if reward.WeeklyPets then table.insert(parts, "+1 companheiro semanal cosmético") end
    if reward.Titles then table.insert(parts, "Título Fiel") end
    return table.concat(parts, " • ")
end
local function rewardButton(row: Frame, name: string, text: string, send: () -> (), color: Color3?): TextButton
    local button = W.Button(row, name, text, UDim2.fromOffset(12, 90), UDim2.new(1, -24, 0, 44), color or C.Green, 12)
    button.Activated:Connect(send)
    return button
end

local function renderDaily(parent: GuiObject, state: any, actions: any)
    local daily = state and state.Rewards and state.Rewards.Daily or {NextDay = 1, CanClaim = false, NextClaimAt = 0}
    hint(parent, if (daily.NextClaimAt or 0) > now() then "Próximo resgate: " .. os.date("!%d/%m %H:%M UTC", daily.NextClaimAt) .. " • A cada 24 h." else "Um resgate a cada 24 h. Após 48 h sem resgatar, a sequência volta ao dia 1.")
    local list = W.List(parent, "DailyList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    for index, reward in Rewards.Daily do
        local row = card(list, "Daily_" .. index, 146, if index == daily.NextDay then C.Gold else C.Purple)
        row.LayoutOrder = index
        heading(row, "DIA " .. index, View.RewardText(reward, state and state.Level or 1), "Gift", if index == 7 then C.Pink else C.Gold)
        local button = rewardButton(row, "ClaimDaily", "AGUARDANDO DIA " .. index, function() actions.Send("ClaimDailyReward") end)
        if index == daily.NextDay then
            button:SetAttribute("DailyClaim", true)
        else
            button.Active, button.Selectable = false, false
            caption(button, if state and index <= (state.DailyStreak or 0) and daily.NextDay ~= 1 then "RECEBIDO NESTE CICLO" else "AGUARDANDO DIA " .. index)
        end
    end
end
local function renderPlaytime(parent: GuiObject, state: any, actions: any)
    local timeLabel = hint(parent, "TEMPO ONLINE HOJE: 00:00 • Reinicia à meia-noite UTC.")
    timeLabel:SetAttribute("OnlineTime", true)
    local list = W.List(parent, "PlaytimeList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    for index, reward in Rewards.Playtime do
        local row = card(list, "Playtime_" .. index, 146, C.Blue)
        row.LayoutOrder = index
        heading(row, "PRESENTE • " .. math.floor(reward.Seconds / 60) .. " MIN", View.RewardText(reward, state and state.Level or 1), "Gift", C.Blue)
        local button = rewardButton(row, "ClaimPlaytime", "AGUARDE", function() actions.Send("ClaimPlaytimeReward", index) end)
        button:SetAttribute("PlaytimeClaim", index)
    end
end
local function renderMissions(parent: GuiObject, state: any, actions: any)
    local missionState = state and state.Rewards and state.Rewards.Missions or {}
    hint(parent, if missionState.Unlocked then "Missões diárias • Progresso validado no servidor • Reiniciam à meia-noite UTC." else "MISSÕES BLOQUEADAS • Alcance o nível 5 para começar.")
    local list = W.List(parent, "MissionList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    for index, id in missionOrder do
        local mission = Rewards.Missions[id]
        local count = math.min(mission.Target, (missionState.Counters or {})[mission.Counter] or 0)
        local claimed = (missionState.Claimed or {})[id] == true
        local row = card(list, id, 146, C.Green)
        row.LayoutOrder = index
        heading(row, mission.Name .. "  " .. count .. "/" .. mission.Target, mission.OrbQuantity .. " orbes do bioma atual • " .. mission.XP .. " XP base • " .. mission.Gems .. " gemas", if id == "Critical3" then "Bolt" elseif id == "Fusion1" then "Fusion" else "Paw", C.Green)
        local requiredLevel = mission.RequiredLevel or Rewards.MissionLevel
        local levelReady = state and (state.Level or 1) >= requiredLevel
        local ready = missionState.Unlocked and levelReady and count >= mission.Target and not claimed
        local button = rewardButton(row, "ClaimMission", if claimed then "RECEBIDO" elseif not levelReady then "EXIGE NÍVEL " .. requiredLevel elseif ready then "RESGATAR" else "COMPLETE O OBJETIVO", function() actions.Send("ClaimMissionReward", id) end)
        button.Active, button.Selectable = ready == true, ready == true
    end
end
local function renderConsumables(parent: GuiObject, state: any, actions: any)
    hint(parent, "Poções iguais estendem o tempo. Uma inferior não substitui uma mais forte ativa.")
    local list = W.List(parent, "ConsumableList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    local order = {"PotionLuck2", "PotionCoins2", "PotionLuck3", "PotionCoins3", "GlobalLuckTotem", "SummonEvent", "SkipFusion", "SanctuarySlot"}
    for index, id in order do
        local item = Rewards.Consumables[id]
        local quantity = state and (state.Consumables or {})[id] or 0
        local description = if item.Stat then tostring(item.Multiplier) .. "× " .. (if item.Stat == "Luck" then "sorte" else "moedas") .. " por " .. View.Time(item.Duration)
            elseif id == "GlobalLuckTotem" then "5× sorte global por 15 min. Beneficia todos nesta sala."
            elseif id == "SummonEvent" then "Invoca um evento climático quando o servidor permitir."
            elseif id == "SanctuarySlot" then "Libera um espaço adicional. No limite de 24, o token é preservado."
            else "Remove a recarga restante da máquina de fusão."
        local row = card(list, id, 166, C.Purple)
        row.LayoutOrder = index
        heading(row, (names[id] or id) .. "  ×" .. Numbers.Format(quantity), description, if id == "SkipFusion" then "Fusion" else "Cosmic", C.Purple)
        local boost = item.Stat and state and (state.Boosts or {})[item.Stat]
        local clock = W.Label(row, "ActiveBoost", "", UDim2.fromOffset(14, 76), UDim2.new(1, -28, 0, 22), 11, C.Gold, true)
        if boost and boost.ExpiresAt > now() then
            clock:SetAttribute("ClockAt", boost.ExpiresAt)
            clock:SetAttribute("ClockPrefix", "Ativo " .. boost.Multiplier .. "×: ")
            clock:SetAttribute("ClockReadyText", "Boost encerrado")
        else clock.Text = if item.Stat then "Nenhum boost desta categoria ativo" else "Consumível de uso único" end
        local button = rewardButton(row, "Use", if quantity > 0 then "USAR CONSUMÍVEL" else "SEM ESTOQUE", function() actions.Send("UseConsumable", id) end)
        button.Position = UDim2.fromOffset(12, 108)
        button.Active, button.Selectable = quantity > 0, quantity > 0
    end
end
local function renderRewards(parent: GuiObject, state: any, actions: any)
    local selected = actions.Session.RewardsTab or "Daily"
    View.Tabs(parent, {{Id = "Daily", Name = "7 DIAS"}, {Id = "Playtime", Name = "PRESENTES"}, {Id = "Missions", Name = "MISSÕES"}, {Id = "Consumables", Name = "ITENS"}}, selected, function(id)
        actions.Session.RewardsTab = id; actions.Refresh()
    end)
    local body = panelBody(parent, "RewardBody", 52)
    if selected == "Playtime" then renderPlaytime(body, state, actions)
    elseif selected == "Missions" then renderMissions(body, state, actions)
    elseif selected == "Consumables" then renderConsumables(body, state, actions)
    else renderDaily(body, state, actions) end
end
local function renderRebirth(parent: GuiObject, state: any, actions: any)
    local profile = state or {}
    local canRebirth = profile.Progression and profile.Progression.CanRebirth == true
    if not canRebirth then actions.Session.RebirthConfirmed = false end
    local confirm = actions.Session.RebirthConfirmed == true
    local list = W.List(parent, "RebirthList", UDim2.new(), UDim2.fromScale(1, 1))
    local row = card(list, "RebirthPreview", if confirm then 390 else 350, if confirm then C.Pink else C.Green)
    heading(row, if confirm then "CONFIRME SEU REBIRTH" else "RENASCER • NÍVEL 40", "+5 gemas e +1 rebirth: +100% renda, +50% sorte e +50% XP permanentes por rebirth.", "Rebirth", if confirm then C.Pink else C.Green)
    local details = W.Label(row, "ResetPreview", "VAI REINICIAR\nMoedas: $" .. Numbers.Format(profile.Coins or 0) .. " → $150\nNível " .. Numbers.Format(profile.Level or 1) .. " → 1 • XP → 0\nBiomas liberados → apenas Pradaria Solar\n\nVOCÊ MANTÉM\nForça, orbes, criaturas, bestiário, compras e resgates.", UDim2.fromOffset(16, 86), UDim2.new(1, -32, 0, 170), 13, C.White, true)
    details.TextWrapped = true
    details.TextYAlignment = Enum.TextYAlignment.Top
    local button = W.Button(row, "RebirthAction", if not canRebirth then "EXIGE NÍVEL 40" elseif confirm then "CONFIRMAR REBIRTH E REINICIAR" else "REVISAR REBIRTH", UDim2.fromOffset(14, 270), UDim2.new(1, -28, 0, 48), if confirm then C.Pink else C.Green, 12)
    button.Active, button.Selectable = canRebirth == true, canRebirth == true
    button.Activated:Connect(function()
        if confirm then actions.Session.RebirthConfirmed = false; actions.Send("RebirthRequest")
        else actions.Session.RebirthConfirmed = true; actions.Refresh() end
    end)
    if confirm then
        local cancel = W.Button(row, "CancelRebirth", "VOLTAR SEM REINICIAR", UDim2.fromOffset(14, 329), UDim2.new(1, -28, 0, 44), C.Blue, 12)
        cancel.Activated:Connect(function() actions.Session.RebirthConfirmed = false; actions.Refresh() end)
    end
end
local function renderFusion(parent: GuiObject, state: any, actions: any)
    local profile = state or {}
    local fusion = profile.Fusion or {RequiredCount = 5, ReadyAt = 0, Unlocked = false}
    local selected = actions.Session.FusionSelected or {}
    actions.Session.FusionSelected = selected
    local captures = profile.CapturedCreatures or {}
    local exists, count, reference = {}, 0, nil
    for _, record in captures do
        exists[record.Uid] = true
        if selected[record.Uid] then
            if count < fusion.RequiredCount then count += 1; reference = reference or record else selected[record.Uid] = nil end
        end
    end
    for uid in selected do if not exists[uid] then selected[uid] = nil end end
    hint(parent, if fusion.Unlocked then "Selecione a mesma espécie, mutação e tamanho. A fusão consome as criaturas selecionadas." else "A máquina de fusão desbloqueia no nível 10.")
    local fuse = W.Button(parent, "FuseSelected", "FUNDIR " .. count .. "/" .. fusion.RequiredCount, UDim2.fromOffset(4, 48), UDim2.new(0.66, -8, 0, 44), C.Purple, 12)
    fuse:SetAttribute("FusionAction", true)
    fuse:SetAttribute("SelectionCount", count)
    fuse.Activated:Connect(function()
        local ids = {}
        for _, record in (actions.GetState() or {}).CapturedCreatures or {} do if selected[record.Uid] then table.insert(ids, record.Uid) end end
        actions.Send("FuseCreatures", ids)
    end)
    local clear = W.Button(parent, "ClearFusion", "LIMPAR", UDim2.new(0.66, 4, 0, 48), UDim2.new(0.34, -8, 0, 44), C.Blue, 12)
    clear.Activated:Connect(function() actions.Session.FusionSelected = {}; actions.Refresh() end)
    local status = W.Label(parent, "FusionStatus", "Normal → Dourada 3× • Dourada → Cristal 6× • Cristal → Arco-Íris 15×", UDim2.fromOffset(5, 96), UDim2.new(1, -10, 0, 32), 10, C.Muted, true)
    status.TextWrapped = true
    local list = W.List(parent, "FusionList", UDim2.fromOffset(0, 132), UDim2.new(1, 0, 1, -132))
    if #captures == 0 then hint(list, "Capture criaturas para começar sua primeira fusão."); return end
    for index, record in captures do
        if Progression.FusionRecipes[record.Mutation] then
            local definition = Config.Creatures[record.CreatureId]
            local compatible = not reference or (record.CreatureId == reference.CreatureId and record.Mutation == reference.Mutation and record.Size == reference.Size)
            local row = card(list, record.Uid, 130, if selected[record.Uid] then C.Gold else C.Purple)
            row.LayoutOrder = index
            heading(row, if definition then definition.Name else record.CreatureId, record.Mutation .. " • " .. record.Size .. " • $" .. Numbers.Format(record.IncomePerSec) .. "/s", "Paw", if selected[record.Uid] then C.Gold else C.White)
            local toggle = W.Button(row, "Select", if selected[record.Uid] then "SELECIONADA • RETIRAR" elseif compatible then "SELECIONAR" else "COMBINAÇÃO DIFERENTE", UDim2.fromOffset(12, 78), UDim2.new(1, -24, 0, 44), if selected[record.Uid] then C.Gold else C.Blue, 11)
            toggle.Active, toggle.Selectable = fusion.Unlocked == true and compatible, fusion.Unlocked == true and compatible
            toggle.Activated:Connect(function()
                if selected[record.Uid] then selected[record.Uid] = nil
                elseif count >= fusion.RequiredCount then actions.Notify("A seleção já está completa."); return
                else selected[record.Uid] = true end
                actions.Refresh()
            end)
        end
    end
end
local function renderAuto(parent: GuiObject, state: any, actions: any)
    hint(parent, "As permissões são verificadas pelo servidor. Auto-Treino só funciona dentro do seu santuário.")
    local automation = state and state.Automation or {}
    local list = W.List(parent, "AutomationList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    for index, item in {{Id = "Throw", Name = "Auto-Arremesso", Permission = "CanThrow", Description = "Usa seu estoque e mira em criaturas acessíveis no bioma atual.", Icon = "Orb"},
        {Id = "Train", Name = "Auto-Treino", Permission = "CanTrain", Description = "Treina na base com o mesmo intervalo do treino manual.", Icon = "Bolt"},
        {Id = "Fusion", Name = "Auto-Fusão", Permission = "CanFusion", Description = "Funde comuns normais não equipadas. Exige Mega Coletor.", Icon = "Fusion"}} do
        local available, enabled = automation[item.Permission] == true, automation[item.Id] == true
        local row = card(list, item.Id, 146, if available then C.Green else C.Purple)
        row.LayoutOrder = index
        heading(row, item.Name, item.Description, item.Icon, if available then C.Green else C.Gold)
        local button = rewardButton(row, "Toggle", if not available then "ACESSO INDISPONÍVEL • VER GRUPO/PASSES" elseif enabled then "ATIVADO • DESATIVAR" else "DESATIVADO • ATIVAR", function()
            if not available then actions.Open("GrupoVIP")
            else local latest = actions.GetState(); actions.Send("SetAutoMode", item.Id, not (latest and latest.Automation and latest.Automation[item.Id])) end
        end, if enabled then C.Orange else C.Green)
    end
end
local function renderCodes(parent: GuiObject, state: any, actions: any)
    local list = W.List(parent, "CodeList", UDim2.new(), UDim2.fromScale(1, 1))
    local row = card(list, "RedeemCode", 260, C.Purple)
    heading(row, "CÓDIGOS OFICIAIS", if next(Rewards.Codes) == nil then "Nenhum código ativo no momento. Não há prêmios fictícios neste campo." else "Digite um código oficial. Cada código pode ser resgatado uma vez por perfil.", "Ticket", C.Purple)
    local input = Instance.new("TextBox")
    input.Name = "CodeInput"
    input.Position = UDim2.fromOffset(14, 94)
    input.Size = UDim2.new(1, -28, 0, 48)
    input.BackgroundColor3 = C.Ink
    input.TextColor3 = C.White
    input.PlaceholderColor3 = C.Muted
    input.PlaceholderText = "Digite seu código"
    input.Text = actions.Session.CodeText or ""
    input.TextSize = 17
    input.Font = Enum.Font.GothamBold
    input.ClearTextOnFocus = false
    input.Parent = row
    W.Round(input, 10)
    W.Outline(input, 2, C.Purple)
    input:GetPropertyChangedSignal("Text"):Connect(function()
        if #input.Text > 64 then input.Text = input.Text:sub(1, 64) end
        actions.Session.CodeText = input.Text
    end)
    local redeem = W.Button(row, "Redeem", "RESGATAR CÓDIGO", UDim2.fromOffset(14, 158), UDim2.new(1, -28, 0, 48), C.Green, 13)
    redeem.Activated:Connect(function() actions.Send("RedeemCode", input.Text) end)
    local detail = W.Label(row, "CodePrivacy", "Sem diferença entre maiúsculas e minúsculas.", UDim2.fromOffset(14, 216), UDim2.new(1, -28, 0, 30), 11, C.Muted, true)
    detail.TextWrapped = true
end
local function renderBiomes(parent: GuiObject, state: any, actions: any)
    local profile = state or {}
    hint(parent, "Visite a Floresta Neon para observar criaturas e resgatar XP e força. Faça as capturas na faixa amarela.")
    local list = W.List(parent, "BiomeList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    for index, id in biomeOrder do
        local definition = Config.Biomes[id]
        local unlocked = id == "PradariaSolar" or (profile.UnlockedBiomes or {})[id]
        local row = card(list, id, 146, if unlocked then C.Green else C.Blue)
        row.LayoutOrder = index
        heading(row, definition.Name, "Nível " .. definition.RequiredLevel .. " • " .. definition.RequiredBestiary .. " espécies • " .. (if definition.Cost == 0 then "Grátis" else "$" .. Numbers.Format(definition.Cost)), "Earth", if unlocked then C.Green else C.Gold)
        local current = profile.CurrentBiome == id
        local button = rewardButton(row, "Travel", if current then "VOCÊ ESTÁ AQUI" elseif unlocked then "VIAJAR" else "DESBLOQUEAR POR $" .. Numbers.Format(definition.Cost), function()
            actions.Send(if unlocked then "TravelToBiome" else "UnlockBiome", id)
        end)
        button.Active, button.Selectable = not current, not current
    end
    local plaza = card(list, "TradingPlaza", 146, C.Pink)
    plaza.LayoutOrder = 20
    local localPlaza = not Config.Gameplay or Config.Gameplay.TradingPlaceId == 0
    heading(plaza, if localPlaza then "PRAÇA LOCAL DE TROCAS" else "TRADING PLAZA", "Exige nível 15 • Trocas em duas confirmações e leilões por moedas.", "Shop", C.Pink)
    local travel = rewardButton(plaza, "TravelPlaza", if (profile.Level or 1) >= 15 then "IR À PRAÇA DE TROCAS" else "EXIGE NÍVEL 15", function() actions.Send("TravelToBiome", "TradingPlaza") end)
    travel.Active, travel.Selectable = (profile.Level or 1) >= 15, (profile.Level or 1) >= 15
    local hub = card(list, "Hub", 104, C.Gold)
    hub.LayoutOrder = 21
    local returnButton = W.Button(hub, "ReturnHub", "VOLTAR À PRAÇA CENTRAL", UDim2.fromOffset(14, 28), UDim2.new(1, -28, 0, 48), C.Gold, 13)
    returnButton.Activated:Connect(function() actions.Send("TravelToBiome", "Hub") end)
end
local function renderBestiaryRewards(parent: GuiObject, state: any, actions: any)
    hint(parent, "Uma recompensa por bioma completo: +10% sorte permanente, moedas e título de coleção.")
    local list = W.List(parent, "BestiaryRewardsList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    for index, id in biomeOrder do
        local total, discovered = 0, 0
        for creatureId, definition in Config.Creatures do
            if definition.Biome ~= id or not meshFolder:FindFirstChild(creatureId) then continue end
            total += 1
            if state and (state.Bestiary or {})[creatureId] then discovered += 1 end
        end
        local claimed = state and (state.BestiaryRewardClaimed or {})[id]
        local row = card(list, id, 146, C.Gold)
        row.LayoutOrder = index
        heading(row, Config.Biomes[id].Name .. "  " .. discovered .. "/" .. total, "+10% sorte • $" .. Numbers.Format(Rewards.BestiaryCoins[id]) .. " • Título de coleção", "Book", C.Gold)
        local ready = total > 0 and discovered >= total and not claimed
        local button = rewardButton(row, "ClaimBestiary", if claimed then "RECEBIDO" elseif ready then "RESGATAR BÔNUS PERMANENTE" else "COMPLETE ESTE BESTIÁRIO", function() actions.Send("ClaimBestiaryReward", id) end)
        button.Active, button.Selectable = ready == true, ready == true
    end
end
local function renderRanking(parent: GuiObject, state: any, actions: any)
    local board = state and state.Leaderboards or {Mode = "Session", Boards = {}}
    local selected = actions.Session.RankingMetric or "Coins"
    View.Tabs(parent, {{Id = "Coins", Name = "MOEDAS"}, {Id = "Capture", Name = "CAPTURA"}, {Id = "Level", Name = "NÍVEL"}, {Id = "Bestiary", Name = "BESTIÁRIO"}}, selected, function(id) actions.Session.RankingMetric = id; actions.Refresh() end)
    local body = panelBody(parent, "RankingBody", 52)
    hint(body, if board.Mode == "Global" then "Ranking global • Valores sincronizados periodicamente; ordenação aproximada em números gigantes." elseif board.Mode == "SessionFallback" then "Ranking desta sala • Dados globais temporariamente indisponíveis." else "Ranking desta sala • Atualização periódica do servidor.")
    local list = W.List(body, "LeaderboardList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
    local entries = (board.Boards or {})[selected] or {}
    if #entries == 0 then hint(list, "Aguardando a primeira atualização do placar..."); return end
    for index, entry in entries do
        local value = if selected == "Coins" then "$" .. Numbers.Format(entry.Coins) elseif selected == "Capture" then "$" .. Numbers.Format(entry.Capture) .. "/s" elseif selected == "Level" then "NV. " .. Numbers.Format(entry.ActualLevel or 1) .. " • " .. Numbers.Format(entry.Rebirths or 0) .. " rebirths" else Numbers.Format(entry.Bestiary) .. " espécies descobertas"
        local row = card(list, "Rank_" .. index, 91, if index == 1 then C.Gold else C.Blue)
        row.LayoutOrder = index
        heading(row, "#" .. index .. "  " .. entry.DisplayName, value, "Trophy", if index == 1 then C.Gold else C.Blue)
    end
end

function View.Handles(kind: string): boolean
    return ({Diario = true, Consumiveis = true, Fusao = true, Rebirth = true, Auto = true, Codigos = true, Biomas = true, BestiarioRewards = true, Ranking = true})[kind] == true
end
function View.Render(parent: GuiObject, kind: string, state: any, actions: any)
    if kind == "Diario" then renderRewards(parent, state, actions)
    elseif kind == "Consumiveis" then renderConsumables(parent, state, actions)
    elseif kind == "Fusao" then renderFusion(parent, state, actions)
    elseif kind == "Rebirth" then renderRebirth(parent, state, actions)
    elseif kind == "Auto" then renderAuto(parent, state, actions)
    elseif kind == "Codigos" then renderCodes(parent, state, actions)
    elseif kind == "Biomas" then renderBiomes(parent, state, actions)
    elseif kind == "BestiarioRewards" then renderBestiaryRewards(parent, state, actions)
    elseif kind == "Ranking" then renderRanking(parent, state, actions) end
    View.Update(parent, state, actions)
end
function View.Update(parent: GuiObject, state: any, actions: any)
    if not state then return end
    local timestamp = now()
    local rewards = state.Rewards or {}
    for _, object in parent:GetDescendants() do
        if object:IsA("TextLabel") and object:GetAttribute("ClockAt") then
            local left = object:GetAttribute("ClockAt") - timestamp
            object.Text = if left > 0 then (object:GetAttribute("ClockPrefix") or "") .. View.Time(left) else object:GetAttribute("ClockReadyText") or "PRONTO"
        elseif object:IsA("TextLabel") and object:GetAttribute("OnlineTime") then
            local seconds = ((rewards.Playtime or {}).Seconds or 0) + actions.Elapsed()
            object.Text = "ONLINE HOJE: " .. View.Time(seconds) .. " • Reinicia à meia-noite UTC."
        elseif object:IsA("TextButton") and object:GetAttribute("DailyClaim") then
            local daily = rewards.Daily or {}
            local left = (daily.NextClaimAt or 0) - timestamp
            local ready = daily.CanClaim == true or (daily.NextClaimAt or 0) > 0 and left <= 0
            caption(object, if ready then "RESGATAR DIA " .. (daily.NextDay or 1) else "PRÓXIMO RESGATE EM " .. View.Time(left))
            object.Active, object.Selectable = ready, ready
        elseif object:IsA("TextButton") and object:GetAttribute("PlaytimeClaim") then
            local id = object:GetAttribute("PlaytimeClaim")
            local played = rewards.Playtime or {}
            local claimed = (played.Claimed or {})[tostring(id)] == true
            local left = Rewards.Playtime[id].Seconds - ((played.Seconds or 0) + actions.Elapsed())
            local ready = not claimed and left <= 0
            caption(object, if claimed then "RECEBIDO HOJE" elseif ready then "RESGATAR PRESENTE" else "LIBERA EM " .. View.Time(left))
            object.Active, object.Selectable = ready, ready
        elseif object:IsA("TextButton") and object:GetAttribute("FusionAction") then
            local fusion = state.Fusion or {}
            local left = (fusion.ReadyAt or 0) - timestamp
            local selected = object:GetAttribute("SelectionCount") or 0
            local count = fusion.RequiredCount or 5
            local ready = fusion.Unlocked == true and left <= 0 and selected == count
            caption(object, if not fusion.Unlocked then "NÍVEL 10 NECESSÁRIO" elseif left > 0 then "RECARGA " .. View.Time(left) else "FUNDIR " .. selected .. "/" .. count)
            object.Active, object.Selectable = ready, ready
        end
    end
end

local function stable(value: any): string
    if type(value) ~= "table" then return tostring(value) end
    local keys = {}
    for key in value do table.insert(keys, key) end
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    local parts = {}
    for _, key in keys do table.insert(parts, tostring(key) .. "=" .. stable(value[key])) end
    return "{" .. table.concat(parts, ";") .. "}"
end
View.Stable = stable
function View.Signature(kind: string, state: any): string
    if not state then return "loading" end
    if kind == "Diario" then
        local rewards = state.Rewards or {}
        return stable({Level = state.Level, Daily = rewards.Daily, Claims = (rewards.Playtime or {}).Claimed, Day = (rewards.Playtime or {}).DayKey, Missions = rewards.Missions, Consumables = state.Consumables, Boosts = state.Boosts})
    elseif kind == "Fusao" then return stable({Level = state.Level, Fusion = state.Fusion, Captures = state.CapturedCreatures})
    elseif kind == "Rebirth" then return stable({Level = state.Level, Rebirths = state.Rebirths, Progression = state.Progression})
    elseif kind == "Auto" then return stable(state.Automation)
    elseif kind == "Codigos" then return "codes"
    elseif kind == "Consumiveis" then return stable({Consumables = state.Consumables, Boosts = state.Boosts})
    elseif kind == "Biomas" then return stable({Level = state.Level, Unlocked = state.UnlockedBiomes, Bestiary = state.Bestiary, CurrentBiome = state.CurrentBiome})
    elseif kind == "Ranking" then return stable(state.Leaderboards)
    elseif kind == "BestiarioRewards" then return stable({Bestiary = state.Bestiary, Claimed = state.BestiaryRewardClaimed}) end
    return kind
end
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">HUDIcons</string>
            <string name="Source"><![CDATA[--!strict
-- Native pictograms: no uploaded images, font glyphs, or texture dependencies.
local Icons = {}
local WHITE = Color3.fromRGB(255, 253, 231)
local INK = Color3.fromRGB(21, 18, 48)
local GOLD = Color3.fromRGB(255, 225, 91)

local function shape(parent: Instance, name: string, x: number, y: number, width: number, height: number, color: Color3, rounded: boolean?, rotation: number?): Frame
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.Position = UDim2.fromScale(x, y)
    frame.Size = UDim2.fromScale(width, height)
    frame.BackgroundColor3 = color
    frame.BorderSizePixel = 0
    frame.Active = false
    frame.Rotation = rotation or 0
    frame.Parent = parent
    if rounded then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = frame
    end
    return frame
end

local function line(parent: Instance, name: string, x1: number, y1: number, x2: number, y2: number, width: number, color: Color3): Frame
    local dx, dy = x2 - x1, y2 - y1
    local frame = shape(parent, name, (x1 + x2) * 0.5, (y1 + y2) * 0.5, math.sqrt(dx * dx + dy * dy), width, color)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Rotation = math.deg(math.atan2(dy, dx))
    return frame
end

local function stroke(frame: Frame, color: Color3, thickness: number): UIStroke
    local outline = Instance.new("UIStroke")
    outline.Color = color
    outline.Thickness = thickness
    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outline.Parent = frame
    return outline
end

local aliases = {
    bestiario = "book", loja = "shop", fusao = "fusion", diario = "gift", ranking = "trophy",
    criaturas = "paw", orbes = "orb", auto = "bolt", codigos = "ticket", forca = "bolt",
    fogo = "fire", agua = "water", planta = "leaf", raio = "bolt", gelo = "ice", terra = "earth", cosmico = "cosmic",
}

function Icons.Draw(parent: GuiObject, iconId: string, color: Color3?): Frame
    local tint = color or Color3.fromRGB(90, 205, 255)
    local canvas = Instance.new("Frame")
    canvas.Name = "Icon_" .. iconId
    canvas.AnchorPoint = Vector2.new(0.5, 0.5)
    canvas.Position = UDim2.fromScale(0.5, 0.5)
    canvas.Size = UDim2.fromScale(0.98, 0.98)
    canvas.BackgroundTransparency = 1
    canvas.Active = false
    canvas.Parent = parent
    local aspect = Instance.new("UIAspectRatioConstraint")
    aspect.AspectRatio = 1
    aspect.AspectType = Enum.AspectType.FitWithinMaxSize
    aspect.Parent = canvas
    local rim = shape(canvas, "NeonRing", 0.025, 0.025, 0.95, 0.95, Color3.new(1, 1, 1), true)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, tint:Lerp(WHITE, 0.45)), ColorSequenceKeypoint.new(0.5, tint), ColorSequenceKeypoint.new(1, tint:Lerp(INK, 0.4))})
    gradient.Rotation = 65
    gradient.Parent = rim
    local inside = shape(canvas, "Recess", 0.115, 0.115, 0.77, 0.77, tint:Lerp(INK, 0.78), true)
    local ringGlint = shape(canvas, "RimGlint", 0.25, 0.045, 0.36, 0.035, WHITE, true)
    ringGlint.BackgroundTransparency = 0.28
    local art = shape(inside, "Artwork", 0.12, 0.1, 0.76, 0.8, WHITE)
    art.BackgroundTransparency = 1
    local id = string.lower(iconId)
    id = aliases[id] or id

    if id == "orb" then
        local orbit = shape(art, "OrbitalRing", 0.04, 0.32, 0.92, 0.34, WHITE, true, -30)
        orbit.BackgroundTransparency = 1
        stroke(orbit, tint:Lerp(WHITE, 0.65), 1.5)
        shape(art, "RunicCore", 0.30, 0.26, 0.42, 0.42, tint:Lerp(WHITE, 0.6), false, 45)
        shape(art, "CoreFacet", 0.42, 0.29, 0.17, 0.32, WHITE, false, 45)
        shape(art, "Satellite", 0.07, 0.60, 0.13, 0.13, GOLD, true)
        shape(art, "RuneGlint", 0.77, 0.16, 0.13, 0.13, WHITE, false, 45)
    elseif id == "bolt" then
        shape(art, "BoltTop", 0.41, 0.03, 0.23, 0.47, GOLD, false, 28)
        shape(art, "BoltBridge", 0.23, 0.4, 0.50, 0.16, GOLD, false, -8)
        shape(art, "BoltTail", 0.34, 0.48, 0.22, 0.49, WHITE, false, 28)
    elseif id == "book" then
        shape(art, "Cover", 0.09, 0.14, 0.82, 0.7, tint:Lerp(WHITE, 0.6), true)
        shape(art, "LeftPage", 0.16, 0.18, 0.31, 0.58, WHITE)
        shape(art, "RightPage", 0.53, 0.18, 0.31, 0.58, WHITE)
        line(art, "Spine", 0.5, 0.18, 0.5, 0.8, 0.05, INK)
        line(art, "TextLeft", 0.22, 0.4, 0.4, 0.4, 0.055, tint)
        line(art, "TextRight", 0.6, 0.4, 0.78, 0.4, 0.055, tint)
    elseif id == "shop" then
        local handle = shape(art, "Handle", 0.30, 0.06, 0.40, 0.40, WHITE, true)
        handle.BackgroundTransparency = 1
        stroke(handle, WHITE, 2)
        shape(art, "Bag", 0.14, 0.31, 0.72, 0.57, tint:Lerp(WHITE, 0.65), true)
        shape(art, "BagEmblem", 0.39, 0.45, 0.22, 0.22, GOLD, false, 45)
    elseif id == "fusion" then
        line(art, "LeftLink", 0.25, 0.25, 0.5, 0.72, 0.11, WHITE)
        line(art, "RightLink", 0.75, 0.25, 0.5, 0.72, 0.11, WHITE)
        shape(art, "First", 0.04, 0.06, 0.36, 0.36, GOLD, true)
        shape(art, "Second", 0.6, 0.06, 0.36, 0.36, WHITE, true)
        shape(art, "Merged", 0.29, 0.55, 0.42, 0.42, tint:Lerp(WHITE, 0.6), true)
    elseif id == "gift" then
        shape(art, "BowLeft", 0.17, 0.04, 0.32, 0.23, WHITE, true, 25)
        shape(art, "BowRight", 0.49, 0.04, 0.32, 0.23, WHITE, true, -25)
        shape(art, "Box", 0.15, 0.36, 0.70, 0.52, tint:Lerp(WHITE, 0.20))
        shape(art, "Lid", 0.08, 0.26, 0.84, 0.18, GOLD)
        shape(art, "Ribbon", 0.43, 0.26, 0.14, 0.62, WHITE)
    elseif id == "rebirth" then
        local cycle = shape(art, "Cycle", 0.16, 0.18, 0.68, 0.64, WHITE, true)
        cycle.BackgroundTransparency = 1
        stroke(cycle, WHITE, 2.5)
        line(art, "ArrowTopA", 0.51, 0.05, 0.72, 0.18, 0.1, GOLD)
        line(art, "ArrowTopB", 0.72, 0.18, 0.51, 0.30, 0.1, GOLD)
        line(art, "ArrowBottomA", 0.49, 0.7, 0.28, 0.82, 0.1, GOLD)
        line(art, "ArrowBottomB", 0.28, 0.82, 0.49, 0.95, 0.1, GOLD)
    elseif id == "trophy" or id == "crown" then
        shape(art, "CrownBase", 0.15, 0.55, 0.70, 0.26, GOLD)
        shape(art, "LeftPoint", 0.13, 0.24, 0.17, 0.48, GOLD, false, -13)
        shape(art, "MiddlePoint", 0.40, 0.08, 0.20, 0.58, WHITE)
        shape(art, "RightPoint", 0.70, 0.24, 0.17, 0.48, GOLD, false, 13)
        shape(art, "CrownJewel", 0.42, 0.60, 0.16, 0.16, tint, false, 45)
    elseif id == "paw" then
        shape(art, "Pad", 0.25, 0.46, 0.52, 0.42, WHITE, true)
        shape(art, "Toe1", 0.04, 0.26, 0.22, 0.27, GOLD, true, -20)
        shape(art, "Toe2", 0.25, 0.08, 0.22, 0.28, WHITE, true, -8)
        shape(art, "Toe3", 0.53, 0.08, 0.22, 0.28, WHITE, true, 8)
        shape(art, "Toe4", 0.75, 0.26, 0.22, 0.27, GOLD, true, 20)
    elseif id == "ticket" then
        shape(art, "Ticket", 0.10, 0.24, 0.80, 0.53, WHITE, true, -12)
        line(art, "Perforation", 0.65, 0.29, 0.65, 0.65, 0.035, tint)
        shape(art, "Stamp", 0.27, 0.35, 0.22, 0.22, GOLD, false, 33)
    elseif id == "lock" then
        local loop = shape(art, "LockLoop", 0.27, 0.04, 0.46, 0.54, WHITE, true)
        loop.BackgroundTransparency = 1
        stroke(loop, WHITE, 2.5)
        shape(art, "LockBody", 0.15, 0.40, 0.70, 0.48, GOLD, true)
        shape(art, "Keyhole", 0.44, 0.53, 0.13, 0.23, INK, true)
    elseif id == "fire" then
        shape(art, "OuterFlame", 0.27, 0.05, 0.50, 0.77, Color3.fromRGB(255, 145, 39), true, 18)
        shape(art, "LeftFlame", 0.12, 0.35, 0.45, 0.52, GOLD, true, -25)
        shape(art, "Core", 0.33, 0.43, 0.36, 0.48, WHITE, true, 10)
    elseif id == "water" then
        shape(art, "DropTip", 0.30, 0.08, 0.40, 0.40, WHITE, false, 45)
        shape(art, "Drop", 0.18, 0.29, 0.64, 0.60, WHITE, true)
        shape(art, "DropGlint", 0.32, 0.43, 0.13, 0.23, tint, true, 20)
    elseif id == "leaf" then
        shape(art, "Leaf", 0.20, 0.13, 0.59, 0.72, WHITE, true, 36)
        line(art, "Stem", 0.22, 0.87, 0.7, 0.24, 0.07, tint)
        line(art, "Vein", 0.45, 0.58, 0.36, 0.36, 0.05, tint)
    elseif id == "ice" then
        for _, angle in {0, 60, 120} do
            local radians = math.rad(angle)
            local dx, dy = math.cos(radians) * 0.4, math.sin(radians) * 0.4
            line(art, "IceCrystal", 0.5 - dx, 0.5 - dy, 0.5 + dx, 0.5 + dy, 0.1, WHITE)
        end
        shape(art, "IceCore", 0.36, 0.36, 0.28, 0.28, GOLD, false, 45)
    elseif id == "earth" then
        shape(art, "Gem", 0.21, 0.20, 0.59, 0.59, GOLD, false, 45)
        shape(art, "Facet", 0.36, 0.26, 0.28, 0.46, WHITE, false, 45)
    elseif id == "sword" then
        line(art, "Hilt", 0.20, 0.86, 0.45, 0.59, 0.16, GOLD)
        line(art, "Blade", 0.43, 0.60, 0.83, 0.13, 0.20, WHITE)
        line(art, "Guard", 0.24, 0.42, 0.65, 0.77, 0.12, GOLD)
    elseif id == "menu" then
        for _, y in {0.25, 0.5, 0.75} do
            line(art, "MenuBar", 0.12, y, 0.88, y, 0.13, WHITE)
        end
    else
        -- Cosmic / unknown: a clear orb-and-orbit motif, never a missing glyph.
        local orbit = shape(art, "Orbit", 0.04, 0.30, 0.92, 0.36, WHITE, true, -35)
        orbit.BackgroundTransparency = 1
        stroke(orbit, WHITE, 1.5)
        shape(art, "Planet", 0.29, 0.28, 0.44, 0.44, GOLD, true)
        shape(art, "Star", 0.73, 0.11, 0.15, 0.15, WHITE, false, 45)
    end
    return canvas
end

return Icons
]]></string>
          </Properties>
