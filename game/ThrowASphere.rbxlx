        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">HUDPanels</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local meshFolder = Shared:WaitForChild("CreatureMeshes")
local GameplayMath = require(Shared:WaitForChild("GameplayMath"))
local Numbers = require(Shared:WaitForChild("NumberFormatter"))
local W = require(script.Parent:WaitForChild("HUDWidgets"))
local Icons = require(script.Parent:WaitForChild("HUDIcons"))
local Gameplay = require(script.Parent:WaitForChild("GameplayPanels"))
local OrbVisual = require(script.Parent.Parent:WaitForChild("Throw"):WaitForChild("OrbVisual"))
local C = W.Colors

local Panels = {}
Panels.Machines = require(Shared:WaitForChild("ConfigTraining")).Machines
Panels.OrbOrder = {"Comum", "Esmeralda", "Rubi", "Safira", "Runica", "Hextech", "Cosmica", "Mestre"}
Panels.MenuItems = {
    {Id = "Bestiario", Icon = "Book", Name = "Bestiário", Color = C.Blue},
    {Id = "Loja", Icon = "Shop", Name = "Loja Robux", Color = C.Pink},
    {Id = "Fusao", Icon = "Fusion", Name = "Fusão", Color = C.Purple},
    {Id = "Diario", Icon = "Gift", Name = "Presentes", Color = C.Gold},
    {Id = "Rebirth", Icon = "Rebirth", Name = "Rebirth", Color = C.Green},
    {Id = "Ranking", Icon = "Trophy", Name = "Ranking", Color = C.Orange},
    {Id = "Criaturas", Icon = "Paw", Name = "Criaturas", Color = C.Green},
    {Id = "Orbes", Icon = "Orb", Name = "Orbes", Color = C.Blue},
    {Id = "Auto", Icon = "Bolt", Name = "Auto", Color = C.Gold},
    {Id = "Codigos", Icon = "Ticket", Name = "Códigos", Color = C.Purple},
}
Panels.Titles = {
    Bestiario = "BESTIÁRIO", Loja = "LOJA ROBUX", Fusao = "FUSÃO 5 → 1", Diario = "DIÁRIO & PRESENTES",
    Rebirth = "REBIRTH", Ranking = "PLACARES", Criaturas = "MINHAS CRIATURAS", Orbes = "EVOLUÇÃO DE ORBES",
    Auto = "AUTO-ARREMESSO", Codigos = "CÓDIGOS", Menu = "EXPLORE SEU SANTUÁRIO",
    Biomas = "BIOMAS & PRAÇA DE TROCAS", GrupoVIP = "GRUPO & VIP", Trocas = "TROCAS SEGURAS", Leiloes = "LEILÕES POR MOEDAS",
    Consumiveis = "CONSUMÍVEIS & POÇÕES", Academia = "ACADEMIA", Resgates = "RESGATES DA PISTA",
}

local function hint(parent: Instance, content: string, color: Color3?): TextLabel
    local label = W.Label(parent, "PanelHint", content, UDim2.fromOffset(4, 0), UDim2.new(1, -8, 0, 42), 12, color or C.Muted, true)
    label.TextWrapped = true
    return label
end

local ELEMENT_ICONS: {[string]: string} = {Fogo = "Fire", Agua = "Water", Planta = "Leaf", Raio = "Bolt", Gelo = "Ice", Terra = "Earth", Cosmico = "Cosmic"}

local function card(parent: Instance, name: string, height: number, accent: Color3): Frame
    local row = W.Frame(parent, name, UDim2.new(), UDim2.new(1, -2, 0, height), C.Card)
    row.BackgroundColor3 = Color3.new(1, 1, 1)
    W.Gradient(row, accent:Lerp(C.Ink, 0.67), C.Panel)
    W.Pattern(row, accent, 8, 1)
    local edge = Instance.new("Frame")
    edge.Name = "CollectionAccent"
    edge.Position = UDim2.fromOffset(4, 14)
    edge.Size = UDim2.new(0, 3, 1, -28)
    edge.BackgroundColor3 = accent
    edge.BorderSizePixel = 0
    edge.Parent = row
    W.Round(edge, 2)
    local sheen = Instance.new("Frame")
    sheen.Name = "CardGleam"
    sheen.Position = UDim2.fromOffset(17, 3)
    sheen.Size = UDim2.new(1, -34, 0, 2)
    sheen.BackgroundColor3 = C.White
    sheen.BackgroundTransparency = 0.72
    sheen.BorderSizePixel = 0
    sheen.Parent = row
    return row
end

local function badge(parent: Instance, color: Color3, iconId: string): Frame
    local icon = W.Frame(parent, "Icon", UDim2.fromOffset(13, 14), UDim2.fromOffset(58, 58), C.White)
    icon.ClipsDescendants = true
    local round = icon:FindFirstChildOfClass("UICorner")
    if round then round.CornerRadius = UDim.new(0.5, 0) end
    W.Gradient(icon, color:Lerp(C.White, 0.17), color:Lerp(C.Ink, 0.2))
    local inset = Instance.new("Frame")
    inset.Name = "InnerRing"
    inset.Position = UDim2.fromScale(0.1, 0.1)
    inset.Size = UDim2.fromScale(0.8, 0.8)
    inset.BackgroundTransparency = 1
    inset.Parent = icon
    W.Round(inset, 28)
    local ring = W.Outline(inset, 1.2, C.White)
    ring.Transparency = 0.54
    local art = Instance.new("Frame")
    art.Name = "Pictogram"
    art.Position = UDim2.fromScale(0.22, 0.22)
    art.Size = UDim2.fromScale(0.56, 0.56)
    art.BackgroundTransparency = 1
    art.Parent = icon
    Icons.Draw(art, iconId, C.White)
    local gleam = Instance.new("Frame")
    gleam.Name = "MedallionGleam"
    gleam.Position = UDim2.fromScale(0.3, 0.07)
    gleam.Size = UDim2.fromScale(0.35, 0.05)
    gleam.BackgroundColor3 = C.White
    gleam.BackgroundTransparency = 0.2
    gleam.BorderSizePixel = 0
    gleam.Rotation = -12
    gleam.Parent = icon
    W.Round(gleam, 4)
    return icon
end

function Panels.Render(parent: GuiObject, kind: string, state: any, actions: any)
    if kind == "Menu" then
        hint(parent, "Todos os sistemas do seu santuário • M abre este menu.")
        local list = W.List(parent, "NavigationList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
        local menuItems = table.clone(Panels.MenuItems)
        for _, item in {{Id = "Biomas", Icon = "Earth", Name = "Biomas & Viagem", Color = C.Blue},
            {Id = "Missoes", Icon = "Book", Name = "Missões diárias", Color = C.Green},
            {Id = "Consumiveis", Icon = "Cosmic", Name = "Consumíveis & Poções", Color = C.Purple},
            {Id = "GrupoVIP", Icon = "Gift", Name = "Grupo & VIP", Color = C.Gold},
            {Id = "Trocas", Icon = "Rebirth", Name = "Trocas de criaturas", Color = C.Blue},
            {Id = "Leiloes", Icon = "Shop", Name = "Leilões por moedas", Color = C.Pink}} do table.insert(menuItems, item) end
        for index, item in menuItems do
            local button = W.Button(list, item.Id, item.Name, UDim2.new(), UDim2.new(1, -2, 0, 52), item.Color, 17)
            local caption = button:FindFirstChild("Caption") :: TextLabel
            caption.Position = UDim2.fromOffset(58, 0)
            caption.Size = UDim2.new(1, -66, 1, 0)
            caption.TextXAlignment = Enum.TextXAlignment.Left
            local icon = Instance.new("Frame")
            icon.Name = "NavigationIcon"
            icon.Position = UDim2.fromOffset(14, 10)
            icon.Size = UDim2.fromOffset(32, 32)
            icon.BackgroundTransparency = 1
            icon.Parent = button
            Icons.Draw(icon, item.Icon, C.White)
            button.LayoutOrder = index
            button.Activated:Connect(function() actions.Open(item.Id) end)
        end
        return
    end

    if kind == "Bestiario" then
        local tab = actions.Session.BestiaryTab or "Catalog"
        Gameplay.Tabs(parent, {{Id = "Catalog", Name = "CATÁLOGO"}, {Id = "Rewards", Name = "BÔNUS POR BIOMA"}}, tab, function(id)
            actions.Session.BestiaryTab = id; actions.Refresh()
        end)
        local body = Instance.new("Frame")
        body.Name = "BestiaryBody"
        body.Position = UDim2.fromOffset(0, 52)
        body.Size = UDim2.new(1, 0, 1, -52)
        body.BackgroundTransparency = 1
        body.Parent = parent
        parent = body
        if tab == "Rewards" then Gameplay.Render(parent, "BestiarioRewards", state, actions); return end
        local ordered = {}
        local discovered = 0
        for _, definition in Config.Creatures do
            local own = state and state.Bestiary and state.Bestiary[definition.Id]
            if not meshFolder:FindFirstChild(definition.Id) then continue end
            table.insert(ordered, definition)
            if own then discovered += 1 end
        end
        table.sort(ordered, function(a, b) return a.Difficulty < b.Difficulty end)
        hint(parent, string.format("%d / %d descobertas • Explore biomas, eventos e evoluções por fusão.", discovered, #ordered))
        local list = W.List(parent, "BestiaryList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
        for index, definition in ordered do
            local owned = state and state.Bestiary and state.Bestiary[definition.Id] == true
            local accent = if owned then definition.BodyColor else C.Purple
            local row = card(list, definition.Id, 94, accent)
            row.LayoutOrder = index
            badge(row, if owned then definition.BodyColor else C.Card, if owned then ELEMENT_ICONS[definition.Element] or "Paw" else "Lock")
            local title = W.Label(row, "Name", definition.Name, UDim2.fromOffset(83, 8), UDim2.new(1, -95, 0, 24), 18, if owned then C.White else C.Muted)
            title.TextTruncate = Enum.TextTruncate.AtEnd
            W.Label(row, "Details", definition.Element .. " • " .. definition.Rarity, UDim2.fromOffset(83, 32), UDim2.new(1, -95, 0, 18), 11, if owned then accent:Lerp(C.White, 0.45) else C.Muted, true)
            W.Label(row, "Income", "$" .. Numbers.Format(definition.BaseIncomePerSec) .. "/s base", UDim2.fromOffset(83, 51), UDim2.new(1, -95, 0, 21), 15, if owned then C.Green else C.Muted)
            W.Label(row, "Discovery", (if owned then "DESCOBERTA" else "NÃO DESCOBERTA") .. " • " .. (if Config.Biomes[definition.Biome] then Config.Biomes[definition.Biome].Name else "Eventos globais"), UDim2.fromOffset(83, 74), UDim2.new(1, -95, 0, 14), 9, C.Muted, true)
        end
        return
    end

    if kind == "Criaturas" then
        local captures = if state then state.CapturedCreatures or {} else {}
        local slots = if state then state.SanctuarySlots or {} else {}
        local capacity = if state then state.SlotCapacity or GameplayMath.BaseSanctuarySlots else GameplayMath.BaseSanctuarySlots
        local session = actions.Session
        local tab = session.CreaturesTab or "Pen"
        local replace = session.ReplaceCreature
        Gameplay.Tabs(parent, {
            {Id = "Pen", Name = "CURRAL " .. #slots .. "/" .. capacity},
            {Id = "Inventory", Name = "INVENTÁRIO " .. math.max(0, #captures - #slots)},
        }, tab, function(id)
            session.CreaturesTab, session.ReplaceCreature, session.SellCreature = id, nil, nil
            actions.Refresh()
        end)
        local collectionCount = #captures .. "/" .. (if state then state.InventoryCapacity or 500 else 500)
        local reserved = if state then state.InventoryReservedSlots or 0 else 0
        local summary = if replace then "Escolha qual criatura sai do curral." else "Coleção " .. collectionCount
        if not replace and reserved > 0 then summary ..= " • " .. reserved .. " vagas reservadas em comércio" end
        W.Label(parent, "Collection", summary, UDim2.fromOffset(8, 47), UDim2.new(1, -16, 0, 24), 12, C.Muted, true)
        local top = 76
        if tab == "Pen" then
            if replace then
                local cancel = W.Button(parent, "CancelReplacement", "CANCELAR TROCA", UDim2.fromOffset(4, top), UDim2.new(1, -8, 0, 41), C.Orange, 12)
                cancel.Activated:Connect(function()
                    session.CreaturesTab, session.ReplaceCreature = "Inventory", nil
                    actions.Refresh()
                end)
            else
                local best = W.Button(parent, "EquipBest", "ADICIONAR MELHORES", UDim2.fromOffset(4, top), UDim2.new(.51, -8, 0, 41), C.Green, 12)
                best.Activated:Connect(function() actions.Send("ManageCreature", "Best") end)
                local cost = state and state.Progression and state.Progression.NextSlotCost or 0
                local buy = W.Button(parent, "BuySlot", if capacity >= 24 then "MÁX. 24 ESPAÇOS" else "+1 ESPAÇO · $" .. Numbers.Format(cost),
                    UDim2.new(.51, 4, 0, top), UDim2.new(.49, -8, 0, 41), C.Gold, 11)
                buy.Active, buy.Selectable = capacity < 24 and cost > 0, capacity < 24 and cost > 0
                buy.Activated:Connect(function() if cost > 0 and capacity < 24 then actions.Send("BuySanctuarySlot") end end)
            end
            top += 48
        end
        local list = W.List(parent, "CreatureList", UDim2.fromOffset(0, top), UDim2.new(1, 0, 1, -top))
        local equipped: {[string]: boolean} = {}
        for _, uid in slots do equipped[uid] = true end
        local displayed = 0
        for _, creature in captures do
            local uid = creature.Uid
            local active = equipped[uid] == true
            if active ~= (tab == "Pen") then continue end
            displayed += 1
            local definition = Config.Creatures[creature.CreatureId]
            local hasArt = meshFolder:FindFirstChild(creature.CreatureId) ~= nil
            local accent = if definition then definition.BodyColor else C.Purple
            local row = card(list, "Creature_" .. uid, 132, accent)
            row.LayoutOrder = displayed
            badge(row, accent, if definition then ELEMENT_ICONS[definition.Element] or "Paw" else "Paw")
            local name = W.Label(row, "Name", if definition then definition.Name else creature.CreatureId, UDim2.fromOffset(83, 9), UDim2.new(1, -95, 0, 23), 17)
            name.TextTruncate = Enum.TextTruncate.AtEnd
            local mutation = if creature.Mutation == "ArcoIris" then "Shiny" else creature.Mutation
            local size = if creature.Size == "Titanica" then "Titânica" else creature.Size
            W.Label(row, "Variant", mutation .. " • " .. size .. (if hasArt then "" else " • ARTE PENDENTE"),
                UDim2.fromOffset(83, 35), UDim2.new(1, -95, 0, 18), 11, C.Muted, true).TextTruncate = Enum.TextTruncate.AtEnd
            W.Label(row, "Income", "$" .. Numbers.Format(creature.IncomePerSec) .. "/s", UDim2.fromOffset(83, 54), UDim2.new(1, -95, 0, 21), 15, C.Green)
            if active then
                local move = W.Button(row, "PenAction", if replace then "SUBSTITUIR ESTA" else "GUARDAR", UDim2.new(.51, 0, 0, 80), UDim2.new(.49, -12, 0, 41), C.Orange, 11)
                move.Activated:Connect(function()
                    if replace then
                        session.ReplaceCreature = nil
                        actions.Send("ManageCreature", "Replace", replace, uid)
                        actions.Refresh()
                    else
                        actions.EquipSanctuary(uid)
                    end
                end)
            else
                if hasArt then
                    local equip = W.Button(row, "EquipCreature", if #slots < capacity then "PÔR NO CURRAL" else "SUBSTITUIR", UDim2.fromOffset(12, 80), UDim2.new(.5, -16, 0, 41), C.Green, 11)
                    equip.Activated:Connect(function()
                        if #slots < capacity then actions.EquipSanctuary(uid); return end
                        session.CreaturesTab, session.ReplaceCreature, session.SellCreature = "Pen", uid, nil
                        actions.Refresh()
                    end)
                end
                local confirm = session.SellCreature == uid
                local price = "$" .. Numbers.Format(GameplayMath.GetCreatureSalePrice(creature.IncomePerSec))
                local sell = W.Button(row, "SellCreature", if confirm then "CONFIRMAR " .. price else "VENDER " .. price,
                    UDim2.new(.5, 4, 0, 80), UDim2.new(.5, -16, 0, 41), if confirm then C.Pink else C.Orange, 11)
                sell.Activated:Connect(function()
                    if confirm then
                        session.SellCreature = nil
                        actions.Send("ManageCreature", "Sell", uid)
                    else
                        session.SellCreature = uid
                    end
                    actions.Refresh()
                end)
            end
        end
        if displayed == 0 then
            hint(list, if tab == "Pen" then "As capturas ocupam as vagas do curral automaticamente." else "Criaturas guardadas e capturas excedentes ficam aqui.")
        end
        return
    end

    if kind == "Resgates" then
        local list = W.List(parent, "RewardList", UDim2.new(), UDim2.fromScale(1, 1))
        local rewards = (state and state.DropInfo or {}).Drops or {}
        if #rewards == 0 then
            hint(list, "As recompensas das capturas aparecem aqui.", C.Muted)
        end
        for index, reward in rewards do
            local row = card(list, "Drop_" .. index, 66, C.Green)
            row.LayoutOrder = index
            local value = "+$" .. Numbers.Format(reward.Coins)
            if reward.MasterOrbs > 0 then value ..= " · Mestre ×" .. Numbers.Format(reward.MasterOrbs) end
            local label = W.Label(row, "Value", value, UDim2.fromOffset(16, 9), UDim2.new(.59, -12, 1, -18), 15, C.Green)
            label.TextWrapped = true
            local claim = W.Button(row, "Claim", "PEGAR", UDim2.new(.62, 0, 0, 11), UDim2.new(.38, -9, 0, 44), C.Green, 12)
            claim.Activated:Connect(function() actions.Send("CollectDrop", reward.Id) end)
        end
        return
    end

    if kind == "Academia" then
        local data = state and state.Training
        if not data then hint(parent, "Carregando seu treino…"); return end
        local list = W.List(parent, "Academy", UDim2.new(), UDim2.fromScale(1, 1))
        local tier = data.MachineTier or 1
        local current = card(list, "CurrentMachine", 112, C.Orange)
        current.LayoutOrder = 1
        W.Label(current, "Name", data.MachineName, UDim2.fromOffset(14, 6), UDim2.new(1, -28, 0, 28), 19)
        W.Label(current, "Gain", "Máquina " .. tier .. " · +" .. data.Gain .. " força e +" .. data.XPPerRep .. " XP / repetição", UDim2.fromOffset(14, 35), UDim2.new(1, -28, 0, 23), 12, C.Green)
        local start = W.Button(current, "Start", "COMEÇAR TREINO", UDim2.fromOffset(12, 61), UDim2.new(1, -24, 0, 43), C.Orange, 13)
        start.Activated:Connect(function() actions.Close(); actions.Send("StartTraining") end)
        local upgrade = card(list, "NextMachine", 157, C.Blue)
        upgrade.LayoutOrder = 2
        local nextMachine = Panels.Machines[tier + 1]
        local maxed = data.Level >= data.MaxLevel
        local xp = if maxed then "NÍVEL MÁXIMO" else Numbers.Format(data.XP) .. " / " .. Numbers.Format(data.RequiredXP) .. " XP"
        W.Label(upgrade, "Level", "Nv. " .. data.Level .. "  ·  " .. xp, UDim2.fromOffset(14, 5), UDim2.new(1, -28, 0, 23), 14, C.Blue)
        local progress = W.Frame(upgrade, "XP", UDim2.fromOffset(14, 31), UDim2.new(1, -28, 0, 9), C.Ink)
        local fraction = if maxed then 1 else math.clamp(data.XP / math.max(data.RequiredXP, 1), 0, 1)
        W.Frame(progress, "Fill", UDim2.new(), UDim2.fromScale(fraction, 1), C.Blue)
        local stats = data.NextMachineStats
        if nextMachine and stats then
            W.Label(upgrade, "Next", nextMachine.Name .. " · Nv. " .. nextMachine.Level, UDim2.fromOffset(14, 46), UDim2.new(1, -28, 0, 21), 14)
            W.Label(upgrade, "Gain", "Força " .. data.Gain .. " → " .. stats.Force .. "  ·  XP " .. data.XPPerRep .. " → " .. stats.XP .. " / rep", UDim2.fromOffset(14, 68), UDim2.new(1, -28, 0, 20), 12, C.Green)
            local ready = data.Level >= nextMachine.Level and state.Coins >= nextMachine.Cost
            local title = if data.Level < nextMachine.Level then "LIBERA NO NÍVEL " .. nextMachine.Level
                elseif not ready then "FALTAM MOEDAS · $" .. Numbers.Format(nextMachine.Cost)
                else "EVOLUIR · $" .. Numbers.Format(nextMachine.Cost)
            local button = W.Button(upgrade, "Upgrade", title, UDim2.fromOffset(12, 103), UDim2.new(1, -24, 0, 43), if ready then C.Green else C.Card, 12)
            button.Active, button.Selectable = ready, ready
            button.Activated:Connect(function() if ready then actions.Send("UpgradeTrainingMachine", tier + 1) end end)
        else
            W.Label(upgrade, "Max", "Sua máquina chegou ao nível máximo!", UDim2.fromOffset(14, 56), UDim2.new(1, -28, 0, 32), 14, C.Green)
        end
        return
    end

    if kind == "Orbes" then
        local fragments = state and state.OrbFragments or 0
        hint(parent, "Orbes evoluídas têm uso livre. Fragmentos para desconto: " .. Numbers.Format(fragments))
        local tier = state and state.OrbTier or 1
        local list = W.List(parent, "OrbList", UDim2.fromOffset(0, 46), UDim2.new(1, 0, 1, -46))
        local order = table.clone(Panels.OrbOrder)
        if state and state.Benefits and state.Benefits.EternalPrism then table.insert(order, "Prismatica") end
        for index, id in order do
            local orb = Config.Orbs[id]
            local count = state and (state.Orbs or {})[id] or 0
            local active = state and state.EquippedOrb == id
            local permanent = orb.Tier and orb.Tier <= tier
            local nextTier = orb.Tier and orb.Tier == tier + 1
            local canEquip = permanent or orb.IsPrismatic or count > 0
            local row = card(list, id, 124, orb.Color)
            row.LayoutOrder = index
            local medallion = badge(row, orb.Color, "Orb")
            local pictogram = medallion:FindFirstChild("Pictogram")
            if pictogram then pictogram:Destroy() end
            local preview = Instance.new("ViewportFrame")
            preview.Name, preview.Size = "OrbModel", UDim2.fromScale(1, 1)
            preview.BackgroundTransparency, preview.Parent = 1, medallion
            preview.Ambient, preview.LightColor = Color3.fromRGB(175, 187, 204), Color3.new(1, 1, 1)
            local camera = Instance.new("Camera")
            camera.FieldOfView, camera.CFrame, camera.Parent = 35, CFrame.lookAt(Vector3.new(1.14, .96, -1.65), Vector3.zero), preview
            preview.CurrentCamera = camera
            local model = OrbVisual.Create(orb.Color, 1, id)
            model.Parent = preview
            W.Label(row, "Name", orb.Name, UDim2.fromOffset(83, 9), UDim2.new(1, -95, 0, 25), 17, if active then C.Gold else C.White)
            local status = if permanent or orb.IsPrismatic then "Uso livre" elseif count > 0 then "Bônus ×" .. Numbers.Format(count) else "Bloqueada"
            W.Label(row, "State", status .. " · Poder " .. Numbers.Format(orb.Power) .. " · Raros ×" .. Numbers.Format(orb.RareBoost, 2),
                UDim2.fromOffset(83, 35), UDim2.new(1, -95, 0, 21), 11, C.Muted).TextTruncate = Enum.TextTruncate.AtEnd
            if nextTier then
                local price, used = GameplayMath.GetOrbEvolutionPrice(orb.Price, fragments)
                local ready = state and state.Coins >= price
                local cost = "$" .. Numbers.Format(price) .. (if used > 0 then " ✦" else "")
                local evolve = W.Button(row, "Evolve", "EVOLUIR " .. cost, UDim2.fromOffset(12, 72), UDim2.new(if canEquip then .54 else 1, -24, 0, 44), if ready then C.Green else C.Card, 12)
                evolve.Active, evolve.Selectable = ready == true, ready == true
                evolve.Activated:Connect(function() if ready then actions.Send("EvolveOrb", orb.Tier) end end)
            end
            if canEquip then
                local left = if nextTier then .54 else 0
                local equip = W.Button(row, "Equip", if active then "EQUIPADA" else "EQUIPAR", UDim2.new(left, 12, 0, 72), UDim2.new(1 - left, -24, 0, 44), if active then C.Gold else C.Blue, 12)
                equip.Activated:Connect(function() if not active then actions.EquipOrb(id) end end)
            end
        end
        return
    end

    hint(parent, "Escolha uma opção no menu do santuário.")
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">HUDWidgets</string>
            <string name="Source"><![CDATA[--!strict
-- Small, asset-free UI primitives shared by the HUD and its collection panels.
local TweenService = game:GetService("TweenService")

local Widgets = {}
Widgets.Colors = {
    Ink = Color3.fromRGB(20, 17, 40),
    Panel = Color3.fromRGB(34, 28, 65),
    Card = Color3.fromRGB(53, 44, 88),
    White = Color3.fromRGB(255, 252, 245),
    Muted = Color3.fromRGB(193, 190, 221),
    Gold = Color3.fromRGB(255, 212, 63),
    Green = Color3.fromRGB(97, 243, 151),
    Blue = Color3.fromRGB(74, 193, 255),
    Pink = Color3.fromRGB(255, 102, 175),
    Purple = Color3.fromRGB(175, 119, 255),
    Orange = Color3.fromRGB(255, 158, 65),
}

function Widgets.Round(parent: Instance, radius: number)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
end

function Widgets.Outline(parent: Instance, thickness: number, color: Color3?): UIStroke
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Widgets.Colors.Ink
    stroke.Thickness = thickness
    stroke.ApplyStrokeMode = if parent:IsA("TextLabel") then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border
    stroke.LineJoinMode = Enum.LineJoinMode.Round
    stroke.Parent = parent
    return stroke
end

function Widgets.Gradient(parent: Instance, color: Color3, bottom: Color3?)
    local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
    gradient.Name = "SurfaceGradient"
    local hue, saturation, value = color:ToHSV()
    local low = bottom
    if not low then
        if value < 0.4 then low = color:Lerp(Color3.new(0, 0, 0), 0.25)
        else
            local offset = if hue < 0.16 then -0.055 elseif hue < 0.55 then 0.07 elseif hue < 0.78 then 0.035 else -0.10
            low = Color3.fromHSV((hue + offset) % 1, math.min(1, saturation + 0.16), value * 0.85)
        end
    end
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color:Lerp(Color3.new(1, 1, 1), if value < 0.4 then 0.10 else 0.30)),
        ColorSequenceKeypoint.new(0.42, color),
        ColorSequenceKeypoint.new(1, low),
    })
    gradient.Rotation = 90
    gradient.Parent = parent
    if parent:IsA("GuiObject") then parent.BackgroundColor3 = Color3.new(1, 1, 1) end
    return gradient
end

-- A small fixed stud field evokes Roblox brick surfaces without image assets or
-- per-frame work. Callers choose density; the hard cap keeps mobile GUI cost bounded.
function Widgets.Pattern(parent: GuiObject, color: Color3?, columns: number?, rows: number?): Frame
    local pattern = Instance.new("Frame")
    pattern.Name = "StudPattern"
    pattern.Size = UDim2.fromScale(1, 1)
    pattern.BackgroundTransparency = 1
    pattern.ClipsDescendants = true
    pattern.Parent = parent
    Widgets.Round(pattern, 10)
    local countX = math.clamp(math.floor(columns or 8), 1, 12)
    local countY = math.clamp(math.floor(rows or 1), 1, 2)
    local tint = color or Color3.new(1, 1, 1)
    for row = 1, countY do
        for column = 1, countX do
            local stud = Instance.new("Frame")
            stud.Name = "Stud"
            stud.AnchorPoint = Vector2.new(0.5, 0.5)
            stud.Position = UDim2.fromScale((column - 0.5) / countX, (row - 0.5) / countY)
            stud.Size = UDim2.fromOffset(7, 7)
            stud.BorderSizePixel = 0
            stud.BackgroundColor3 = tint
            stud.BackgroundTransparency = 0.91
            stud.Parent = pattern
            local stroke = Widgets.Outline(stud, 1, tint:Lerp(Widgets.Colors.Ink, 0.55))
            stroke.Transparency = 0.75
        end
    end
    return pattern
end

local function bevel(parent: GuiObject, radius: number, glossy: boolean)
    local inset = Instance.new("Frame")
    inset.Name = "InsetBevel"
    inset.Position = UDim2.fromOffset(3, 3)
    inset.Size = UDim2.new(1, -6, 1, -6)
    inset.BackgroundTransparency = 1
    inset.Parent = parent
    Widgets.Round(inset, math.max(3, radius - 2))
    local edge = Widgets.Outline(inset, 1.2, Color3.new(1, 1, 1))
    edge.Transparency = if glossy then 0.46 else 0.82
    if glossy then
        local shine = Instance.new("Frame")
        shine.Name = "GlossHighlight"
        shine.Position = UDim2.fromOffset(5, 4)
        shine.Size = UDim2.new(1, -10, 0.4, -1)
        shine.BackgroundColor3 = Color3.new(1, 1, 1)
        shine.BackgroundTransparency = 0.83
        shine.BorderSizePixel = 0
        shine.Parent = parent
        Widgets.Round(shine, radius - 3)
        local glint = Instance.new("Frame")
        glint.Name = "TopGlint"
        glint.Position = UDim2.new(0.2, 0, 0, 3)
        glint.Size = UDim2.new(0.6, 0, 0, 2)
        glint.BackgroundColor3 = Color3.new(1, 1, 1)
        glint.BackgroundTransparency = 0.35
        glint.BorderSizePixel = 0
        glint.Parent = parent
    end
    local shade = Instance.new("Frame")
    shade.Name = "BottomBevel"
    shade.AnchorPoint = Vector2.new(0, 1)
    shade.Position = UDim2.new(0, 5, 1, -3)
    shade.Size = UDim2.new(1, -10, 0, if glossy then 4 else 2)
    shade.BackgroundColor3 = Widgets.Colors.Ink
    shade.BackgroundTransparency = if glossy then 0.55 else 0.7
    shade.BorderSizePixel = 0
    shade.Parent = parent
end

function Widgets.Frame(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3?): Frame
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.Position = position
    frame.Size = size
    frame.BackgroundColor3 = color or Widgets.Colors.Panel
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Widgets.Round(frame, 14)
    Widgets.Outline(frame, 3)
    Widgets.Gradient(frame, color or Widgets.Colors.Panel)
    bevel(frame, 14, false)
    return frame
end

function Widgets.Label(parent: Instance, name: string, value: string, position: UDim2, size: UDim2, fontSize: number, color: Color3?, body: boolean?): TextLabel
    local label = Instance.new("TextLabel")
    label.Name = name
    label.BackgroundTransparency = 1
    label.Position = position
    label.Size = size
    label.Font = if body then Enum.Font.GothamBold else Enum.Font.FredokaOne
    label.Text = value
    label.TextSize = fontSize
    label.TextColor3 = color or Widgets.Colors.White
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    Widgets.Outline(label, if body then 1.5 else 2.5)
    return label
end

function Widgets.Button(parent: Instance, name: string, value: string, position: UDim2, size: UDim2, color: Color3, fontSize: number?): TextButton
    local button = Instance.new("TextButton")
    button.Name = name
    button.Position = position
    button.Size = size
    button.BackgroundColor3 = Color3.new(1, 1, 1)
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Selectable = true
    button.Parent = parent
    Widgets.Round(button, 12)
    Widgets.Outline(button, 3)
    Widgets.Gradient(button, color)
    bevel(button, 12, true)
    local label = Widgets.Label(button, "Caption", value, UDim2.fromOffset(4, 0), UDim2.new(1, -8, 1, 0), fontSize or 15)
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextWrapped = true
    local scale = Instance.new("UIScale")
    scale.Name = "InteractionScale"
    scale.Parent = button
    local activeTween: Tween? = nil
    local function animate(amount: number)
        if activeTween then activeTween:Cancel() end
        activeTween = TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = amount})
        activeTween:Play()
    end
    button.MouseEnter:Connect(function() animate(1.04) end)
    button.MouseLeave:Connect(function() animate(1) end)
    button.SelectionGained:Connect(function() animate(1.04) end)
    button.SelectionLost:Connect(function() animate(1) end)
    button.MouseButton1Down:Connect(function() animate(0.94) end)
    button.MouseButton1Up:Connect(function() animate(1) end)
    return button
end

function Widgets.List(parent: Instance, name: string, position: UDim2, size: UDim2): ScrollingFrame
    local list = Instance.new("ScrollingFrame")
    list.Name = name
    list.Position = position
    list.Size = size
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.ScrollBarThickness = 5
    list.ScrollBarImageColor3 = Widgets.Colors.Purple
    list.CanvasSize = UDim2.new()
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.Active = true
    list.Parent = parent
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 4)
    padding.PaddingRight = UDim.new(0, 9)
    padding.PaddingTop = UDim.new(0, 4)
    padding.PaddingBottom = UDim.new(0, 10)
    padding.Parent = list
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)
    layout.Parent = list
    return list
end

return Widgets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">ShopView</string>
            <string name="Source"><![CDATA[--!strict
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ConfigMonetizacao"))
local Icons = require(script.Parent:WaitForChild("HUDIcons"))
type ShopItem = Catalog.ShopItem

local ShopView = {}
local BLACK = Color3.fromRGB(11, 15, 30)
local WHITE = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(198, 211, 240)
local themes: { [string]: Color3 } = {
	Gold = Color3.fromRGB(255, 200, 60), Orange = Color3.fromRGB(255, 142, 61),
	Green = Color3.fromRGB(91, 231, 121), Blue = Color3.fromRGB(75, 156, 255),
	Violet = Color3.fromRGB(174, 110, 255), Pink = Color3.fromRGB(255, 112, 200),
	Cyan = Color3.fromRGB(61, 222, 232),
}

local function round(parent: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function stroke(parent: GuiObject, thickness: number, textStroke: boolean?, color: Color3?): UIStroke
	local outline = Instance.new("UIStroke")
	outline.Color = color or BLACK
	outline.Thickness = thickness
	outline.ApplyStrokeMode = if textStroke then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border
	outline.Parent = parent
	return outline
end

local function surface(parent: GuiObject, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Name = "Surface"
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = rotation or 90
	gradient.Parent = parent
	return gradient
end

local function frame(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3, zIndex: number): Frame
	local item = Instance.new("Frame")
	item.Name = name
	item.Position = position
	item.Size = size
	item.BackgroundColor3 = color
	item.BorderSizePixel = 0
	item.ZIndex = zIndex
	item.Parent = parent
	return item
end

-- Eight embossed studs and three quiet diagonal bands keep the cards textured,
-- while leaving their title, benefit and unavailable purchase state easy to read.
local function cardPattern(parent: Frame)
	local pattern = frame(parent, "EmbossedPattern", UDim2.fromOffset(5, 5), UDim2.new(1, -10, 1, -10), WHITE, 31)
	pattern.BackgroundTransparency = 1
	pattern.ClipsDescendants = true
	round(pattern, 12)
	for index = 1, 3 do
		local band = frame(pattern, "Diagonal" .. index, UDim2.fromScale((index - 1) * 0.43 - 0.2, -0.5), UDim2.fromScale(0.2, 2), WHITE, 31)
		band.Rotation = -26
		band.BackgroundTransparency = 0.9
	end
	for row = 1, 2 do
		for column = 1, 4 do
			local stud = frame(pattern, "Stud" .. row .. "_" .. column, UDim2.fromScale(0.12 + (column - 1) * 0.24, if row == 1 then 0.13 else 0.7), UDim2.fromOffset(10, 10), WHITE, 31)
			stud.BackgroundTransparency = 0.87
			round(stud, 2)
			local rim = stroke(stud, 1, false, WHITE)
			rim.Transparency = 0.78
		end
	end
end

local function crystal(parent: GuiObject, name: string, position: UDim2, color: Color3)
	local gem = frame(parent, name, position, UDim2.fromOffset(20, 26), WHITE, 33)
	gem.Rotation = 24
	round(gem, 5)
	stroke(gem, 2.5)
	surface(gem, color:Lerp(WHITE, 0.6), color:Lerp(BLACK, 0.25), 125)
	local facet = frame(gem, "Facet", UDim2.fromScale(0.13, 0.08), UDim2.fromScale(0.31, 0.72), WHITE, 33)
	facet.BackgroundTransparency = 0.55
	round(facet, 3)
end

local function label(parent: Instance, name: string, value: string, size: number, boldTitle: boolean?): TextLabel
	local text = Instance.new("TextLabel")
	text.Name = name
	text.BackgroundTransparency = 1
	text.Font = if boldTitle then Enum.Font.FredokaOne else Enum.Font.GothamBold
	text.TextColor3 = WHITE
	text.TextSize = size
	text.Text = value
	text.TextWrapped = true
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Center
	text.ZIndex = 32
	text.Parent = parent
	if boldTitle then stroke(text, 2, true) end
	return text
end

local function button(parent: Instance, name: string, value: string): TextButton
	local item = Instance.new("TextButton")
	item.Name = name
	item.BackgroundColor3 = WHITE
	item.BorderSizePixel = 0
	item.Text = value
	item.Font = Enum.Font.FredokaOne
	item.TextSize = 15
	item.TextColor3 = WHITE
	item.TextWrapped = true
	item.ZIndex = 33
	item.Parent = parent
	stroke(item, 2, true)
	round(item, 9)
	surface(item, Color3.fromRGB(100, 128, 192), Color3.fromRGB(45, 59, 104))
	local edge = frame(item, "BeveledEdge", UDim2.fromOffset(1, 1), UDim2.new(1, -2, 1, -2), WHITE, 33)
	edge.BackgroundTransparency = 1
	round(edge, 9)
	stroke(edge, 2, false)
	local gleam = frame(item, "TopGloss", UDim2.fromOffset(7, 3), UDim2.new(1, -14, 0, 3), WHITE, 33)
	gleam.BackgroundTransparency = 0.48
	round(gleam, 3)
	local bottom = frame(item, "BottomBevel", UDim2.new(0, 6, 1, -5), UDim2.new(1, -12, 0, 3), BLACK, 33)
	bottom.BackgroundTransparency = 0.68
	round(bottom, 3)
	return item
end

local function buttonColor(item: TextButton, top: Color3, bottom: Color3)
	local gradient = item:FindFirstChild("Surface")
	if gradient and gradient:IsA("UIGradient") then gradient.Color = ColorSequence.new(top, bottom) end
end

local function canOffer(item: ShopItem): boolean
	return Catalog.SalesEnabled == true and item.FulfillmentReady == true
		and item.Id > 0 and item.Id < math.huge and item.Id % 1 == 0
end

-- No receipt or entitlement is ever granted by this client view.
function ShopView.Render(parent: GuiObject, notify: (string) -> ()): () -> ()
	local running: boolean = true
	local revision = 0
	local selectedCategory = "Gamepasses"
	local connections: { RBXScriptConnection } = {}
	local cardConnections: { RBXScriptConnection } = {}
	local tiles: { Frame } = {}
	local currentPrompt: string? = nil
	local root = Instance.new("Frame")
	root.Name = "ShopView"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(84, 80, 100)
	root.BorderSizePixel = 0
	root.ZIndex = 30
	root.Parent = parent
	round(root, 14)
	stroke(root, 3.5)
	surface(root, Color3.fromRGB(117, 109, 124), Color3.fromRGB(58, 56, 76))
	for index, point in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		local stone = frame(root, "StoneCorner" .. index, UDim2.new(point.X, if point.X == 0 then 7 else -7, point.Y, if point.Y == 0 then 7 else -7), UDim2.fromOffset(14, 14), Color3.fromRGB(123, 116, 129), 31)
		stone.AnchorPoint = point
		stone.Rotation = if index % 2 == 0 then 12 else -12
		round(stone, 4)
		stroke(stone, 1.5)
		surface(stone, Color3.fromRGB(150, 140, 154), Color3.fromRGB(80, 76, 94), 45)
	end
	local inlay = frame(root, "StoneInlay", UDim2.fromOffset(6, 6), UDim2.new(1, -12, 1, -12), Color3.fromRGB(32, 28, 50), 30)
	round(inlay, 10)
	stroke(inlay, 2.5, false, Color3.fromRGB(37, 32, 48))
	local header = frame(root, "ShopHeader", UDim2.fromOffset(12, 9), UDim2.new(1, -24, 0, 43), WHITE, 31)
	round(header, 9)
	stroke(header, 2.5)
	surface(header, Color3.fromRGB(255, 232, 89), Color3.fromRGB(248, 151, 28), 35)
	for index = 1, 8 do
		local stud = frame(header, "HeaderStud" .. index, UDim2.new(index / 9, -4, 0.5, -4), UDim2.fromOffset(9, 9), WHITE, 31)
		stud.BackgroundTransparency = 0.72
		round(stud, 2)
		local rim = stroke(stud, 1, false, Color3.fromRGB(159, 90, 17))
		rim.Transparency = 0.67
	end
	local headerInset = frame(header, "HeaderBevel", UDim2.fromOffset(4, 4), UDim2.new(1, -8, 1, -8), WHITE, 31)
	headerInset.BackgroundTransparency = 1
	round(headerInset, 7)
	local headerRim = stroke(headerInset, 1, false, Color3.fromRGB(255, 250, 181))
	headerRim.Transparency = 0.2
	local shopTitle = label(header, "ShopTitle", "LOJA", 27, true)
	shopTitle.Position = UDim2.fromOffset(38, 0)
	shopTitle.Size = UDim2.new(1, -76, 1, 0)
	shopTitle.TextXAlignment = Enum.TextXAlignment.Center
	crystal(header, "EmeraldCorner", UDim2.fromOffset(8, 8), themes.Green)
	crystal(header, "VioletCorner", UDim2.new(1, -28, 0, 8), themes.Violet)

	local tabs = Instance.new("Frame")
	tabs.Name = "ShopTabs"
	tabs.Position = UDim2.fromOffset(12, 61)
	tabs.Size = UDim2.new(1, -24, 0, 44)
	tabs.BackgroundTransparency = 1
	tabs.ZIndex = 31
	tabs.Parent = root

	local subtitle = label(root, "ShopAvailability", "CATÁLOGO EM PREPARAÇÃO · Compras indisponíveis", 12)
	subtitle.Position = UDim2.fromOffset(12, 111)
	subtitle.Size = UDim2.new(1, -24, 0, 30)
	subtitle.TextColor3 = MUTED
	subtitle.TextXAlignment = Enum.TextXAlignment.Center

	local list = Instance.new("ScrollingFrame")
	list.Name = "ShopItems"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(9, 147)
	list.Size = UDim2.new(1, -18, 1, -156)
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 5
	list.ScrollBarImageColor3 = themes.Cyan
	list.ZIndex = 31
	list.Parent = root
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 3)
	padding.PaddingLeft = UDim.new(0, 3)
	padding.PaddingRight = UDim.new(0, 11)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.Parent = list
	local grid = Instance.new("UIGridLayout")
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.CellPadding = UDim2.fromOffset(12, 12)
	grid.CellSize = UDim2.new(1, 0, 0, 182)
	grid.Parent = list

	local function alive(token: number, itemFrame: GuiObject?): boolean
		return running and revision == token and root.Parent ~= nil
			and (itemFrame == nil or itemFrame:IsDescendantOf(root))
	end

	local function resize()
		local columns = if root.AbsoluteSize.X >= 520 then 2 else 1
		grid.CellSize = UDim2.new(1 / columns, if columns == 2 then -6 else 0, 0, 182)
		local short = root.AbsoluteSize.Y < 350
		header.Visible = not short
		tabs.Position = UDim2.fromOffset(12, if short then 10 else 61)
		subtitle.Position = UDim2.fromOffset(12, if short then 59 else 111)
		local listTop = if short then 95 else 147
		list.Position = UDim2.fromOffset(9, listTop)
		list.Size = UDim2.new(1, -18, 1, -listTop - 9)
	end
	table.insert(connections, root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize))

	local function clearCards()
		for _, connection in cardConnections do connection:Disconnect() end
		table.clear(cardConnections)
		for _, tile in tiles do tile:Destroy() end
		table.clear(tiles)
	end

	local function createCard(entry: ShopItem, index: number, token: number)
		local color = themes[entry.Theme] or themes.Blue
		local card = Instance.new("Frame")
		card.Name = "ShopItem_" .. entry.Key
		card.BackgroundColor3 = WHITE
		card.BorderSizePixel = 0
		card.LayoutOrder = index
		card.ZIndex = 31
		card.Parent = list
		round(card, 13)
		stroke(card, 2.5)
		local topColor = if entry.Category == "Gamepasses" then Color3.fromRGB(255, 226, 80) else color:Lerp(WHITE, 0.27)
		local bottomColor = if entry.Category == "Gamepasses" then Color3.fromRGB(239, 140, 26) else color:Lerp(Color3.fromRGB(63, 24, 118), 0.45)
		surface(card, topColor, bottomColor, 28)
		cardPattern(card)
		local innerRim = frame(card, "InnerRim", UDim2.fromOffset(4, 4), UDim2.new(1, -8, 1, -8), WHITE, 31)
		innerRim.BackgroundTransparency = 1
		round(innerRim, 10)
		local innerStroke = stroke(innerRim, 1, false, Color3.fromRGB(255, 250, 185))
		innerStroke.Transparency = 0.32
		table.insert(tiles, card)

		local iconHost = frame(card, "Icon", UDim2.fromOffset(11, 10), UDim2.fromOffset(54, 54), WHITE, 32)
		iconHost.BackgroundTransparency = 1
		local iconIds = {
			StarterPack = "Gift", TitanArms = "Sword", AutoThrow = "Bolt", DoubleCoins = "Shop",
			DoubleLuck = "Leaf", GiantSanctuary = "Paw", GoldenVIP = "Trophy", FusionXP = "Fusion",
			TripleThrow = "Orb", EternalPrism = "Cosmic", MegaCollector = "Gift", GlobalLuckTotem = "Leaf",
			SummonEvent = "Cosmic", PotionPack = "Water", SanctuarySlot = "Paw", SkipFusion = "Bolt",
		}
		Icons.Draw(iconHost, iconIds[entry.Key] or "Orb", color)
		local glyph = label(card, "IconAmount", entry.Glyph, 10, true)
		glyph.Position = UDim2.fromOffset(10, 50)
		glyph.Size = UDim2.fromOffset(56, 16)
		glyph.TextXAlignment = Enum.TextXAlignment.Center
		local title = label(card, "Name", entry.Name, 17, true)
		title.Position = UDim2.fromOffset(76, 10)
		title.Size = UDim2.new(1, -88, 0, 51)
		local descriptionBacking = frame(card, "BenefitBacking", UDim2.fromOffset(10, 66), UDim2.new(1, -20, 0, 54), BLACK, 31)
		descriptionBacking.BackgroundTransparency = 0.48
		round(descriptionBacking, 8)
		local description = label(card, "Description", "Previsto: " .. entry.Description, 12)
		description.Position = UDim2.fromOffset(13, 68)
		description.Size = UDim2.new(1, -26, 0, 48)
		description.TextYAlignment = Enum.TextYAlignment.Top
		description.TextColor3 = WHITE
		local priceBacking = frame(card, "PlannedPriceBacking", UDim2.new(0, 10, 1, -54), UDim2.new(1, -138, 0, 43), BLACK, 31)
		priceBacking.BackgroundTransparency = 0.36
		round(priceBacking, 8)
		local price = label(card, "Price", "Planejado: " .. tostring(entry.PlannedPrice) .. " Robux", 12)
		price.Position = UDim2.new(0, 13, 1, -49)
		price.Size = UDim2.new(1, -144, 0, 36)
		price.TextColor3 = WHITE
		local buy = button(card, "Purchase", "EM BREVE")
		buy.AnchorPoint = Vector2.new(1, 1)
		buy.Position = UDim2.new(1, -12, 1, -13)
		buy.Size = UDim2.fromOffset(112, 44)
		buttonColor(buy, Color3.fromRGB(119, 174, 108), Color3.fromRGB(53, 97, 57))
		buy.TextColor3 = Color3.fromRGB(232, 239, 220)
		buy.Active = false
		buy.Selectable = false
		buy.AutoButtonColor = false
		local scale = Instance.new("UIScale")
		scale.Parent = buy
		local buyable: boolean = false
		local function bounce(value: number)
			if not buyable or not alive(token, card) then return end
			TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = value }):Play()
		end
		table.insert(cardConnections, buy.MouseEnter:Connect(function() bounce(1.04) end))
		table.insert(cardConnections, buy.MouseLeave:Connect(function() bounce(1) end))
		table.insert(cardConnections, buy.MouseButton1Down:Connect(function() bounce(0.96) end))
		table.insert(cardConnections, buy.MouseButton1Up:Connect(function() bounce(1) end))
		table.insert(cardConnections, buy.Activated:Connect(function()
			if not alive(token, card) or not buyable or not canOffer(entry) or currentPrompt then return end
			currentPrompt = entry.Key
			local ok = pcall(function()
				if entry.Kind == "GamePass" then
					MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, entry.Id)
				else
					MarketplaceService:PromptProductPurchase(Players.LocalPlayer, entry.Id)
				end
			end)
			if not ok then
				currentPrompt = nil
				if alive(token, card) then notify("Não foi possível abrir a compra. Tente novamente mais tarde.") end
			end
		end))

		if not canOffer(entry) then return end
		buy.Text = "CONSULTANDO..."
		price.Text = "Consultando Roblox..."
		task.spawn(function()
			local ok, productInfo = pcall(function()
				return MarketplaceService:GetProductInfoAsync(entry.Id, if entry.Kind == "GamePass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
			end)
			if not alive(token, card) then return end
			if not ok or type(productInfo) ~= "table" or type(productInfo.PriceInRobux) ~= "number"
				or productInfo.PriceInRobux ~= productInfo.PriceInRobux or productInfo.PriceInRobux < 0
				or productInfo.PriceInRobux >= math.huge or productInfo.IsForSale == false then
				buy.Text = "INDISPONÍVEL"
				price.Text = "Preço indisponível"
				return
			end
			if entry.Kind == "GamePass" then
				local checked, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(Players.LocalPlayer.UserId, entry.Id)
				end)
				if not alive(token, card) then return end
				if not checked then
					buy.Text = "INDISPONÍVEL"
					price.Text = "Tente mais tarde"
					return
				elseif owns then
					buy.Text = "JÁ POSSUI"
					price.Text = "Passe permanente"
					return
				end
			end
			if not canOffer(entry) then return end
			price.Text = tostring(productInfo.PriceInRobux) .. " Robux"
			buy.Text = "COMPRAR"
			buttonColor(buy, Color3.fromRGB(161, 255, 66), Color3.fromRGB(35, 160, 57))
			buy.TextColor3 = WHITE
			buy.Active = true
			buy.Selectable = true
			buy.AutoButtonColor = true
			buyable = true
		end)
	end

	local tabButtons: { [string]: TextButton } = {}
	local function render(category: string)
		if not running then return end
		revision += 1
		selectedCategory = category
		clearCards()
		list.CanvasPosition = Vector2.zero
		for key, tab in tabButtons do
			buttonColor(tab, if key == category then themes.Gold else Color3.fromRGB(132, 122, 180), if key == category then themes.Orange else Color3.fromRGB(65, 56, 107))
		end
		local index = 0
		for _, item in Catalog.Items do
			if item.Category == category and item.Key ~= "EternalPrism" then
				index += 1
				createCard(item, index, revision)
			end
		end
		resize()
	end
	for index, tab in { { Key = "Gamepasses", Name = "Gamepasses" }, { Key = "Boosts", Name = "Totens & Poções" } } do
		local item = button(tabs, tab.Key, tab.Name)
		item.TextSize = 13
		item.Position = UDim2.new((index - 1) / 2, if index == 1 then 0 else 3, 0, 0)
		item.Size = UDim2.new(1 / 2, -5, 1, 0)
		tabButtons[tab.Key] = item
		table.insert(connections, item.Activated:Connect(function() render(tab.Key) end))
	end
	if Catalog.SalesEnabled == true then subtitle.Text = "Confira o preço atual no Roblox antes de comprar." end
	table.insert(connections, MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, _purchased: boolean)
		if not running or player ~= Players.LocalPlayer or not currentPrompt then return end
		for _, item in Catalog.Items do
			if item.Kind == "GamePass" and item.Id == passId and item.Key == currentPrompt then
				currentPrompt = nil
				render(selectedCategory)
				return
			end
		end
	end))
	table.insert(connections, MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, productId: number, _purchased: boolean)
		if not running or userId ~= Players.LocalPlayer.UserId or not currentPrompt then return end
		for _, item in Catalog.Items do
			if item.Kind == "Product" and item.Id == productId and item.Key == currentPrompt then
				currentPrompt = nil -- Only the server receipt handler can confirm delivery.
				return
			end
		end
	end))
	render("Gamepasses")
	return function()
		if not running then return end
		running = false
		revision += 1
		clearCards()
		for _, connection in connections do connection:Disconnect() end
		table.clear(connections)
		root:Destroy()
	end
end

return ShopView
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="112">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-100</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>