      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">CaptureMath</string>
          <string name="Source"><![CDATA[--!strict
-- Pure rules, runnable in the official Luau CLI without Roblox services.
local CaptureMath = {}
CaptureMath.MaxLevel = 1000

function CaptureMath.GetXPRequiredForLevel(level: number): number
	return math.floor(100 * math.clamp(level, 1, CaptureMath.MaxLevel) ^ 1.6)
end

function CaptureMath.GetMaxThrowRange(strength: number, level: number): number
	return 40 + math.max(0, strength) * 0.5 + math.clamp(level, 1, 100) * 2
end

function CaptureMath.CalculateShakeProbability(power: number, aim: number, luck: number, difficulty: number, master: boolean?): number
	if master then return 1 end
	local ratio = math.max(0, power * aim * luck) / math.max(1, difficulty)
	return math.min(1, ratio ^ (1 / 3))
end

function CaptureMath.GetAimBonus(critical: boolean, distance: number): number
	if distance > 90 then return if critical then 1.85 else 1.25 end
	return if critical then 1.5 else 1
end

return table.freeze(CaptureMath)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
local Math = require(script.Parent.CaptureMath)
local Variants = require(script.Parent.ConfigMutacoes)
local TrainingRules = require(script.Parent.ConfigTraining)
local TrainingMath = require(script.Parent.TrainingMath)
local GameplayMath = require(script.Parent.GameplayMath)
return {
	Orbs = require(script.Parent.ConfigOrbes),
	Creatures = require(script.Parent.ConfigCriaturas),
	Biomes = require(script.Parent.ConfigBiomas),
	Mutations = Variants.Mutations,
	Sizes = Variants.Sizes,
	Gameplay = require(script.Parent.ConfigGameplay),
	GetXPRequiredForLevel = Math.GetXPRequiredForLevel,
	GetMaxThrowRange = Math.GetMaxThrowRange,
	CalculateShakeProbability = Math.CalculateShakeProbability,
	GetAimBonus = Math.GetAimBonus,
	ReconcileTrainingXP = function(profile: any)
		TrainingMath.AddXP(profile, 0, TrainingRules)
	end,
	Constants = {
		MaxLevel = Math.MaxLevel, BaseSanctuarySlots = GameplayMath.BaseSanctuarySlots, MaxOfflineSeconds = 28800,
		DataStoreName = "ThrowASphere_v1", StudioPersistence = false,
		AutoSaveSeconds = 60, SessionLeaseSeconds = 180,
		InitialCoins = 150, InitialOrbs = 25, InitialThrowStrength = 10,
		CaptureLockSeconds = 4.5, ThrowCooldownSeconds = 4.5,
		TrainingCoins = 5, TrainingStrength = 1,
		MaxTrainingLevel = TrainingRules.MaxLevel, MaxTrainingMachine = #TrainingRules.Machines,
		MaxInventoryCreatures = 500, MaxSanctuarySlots = 24,
	},
}
]]></string>
        </Properties>
      </Item>
