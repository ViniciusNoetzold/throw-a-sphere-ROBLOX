      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">FlightMath</string>
          <string name="Source"><![CDATA[--!strict
-- Pure rules: clients render the same meter, but only the server fixes its value.
local FlightMath = {}
function FlightMath.MeterPosition(elapsed: number, period: number): number
    return 0.5 - 0.5 * math.cos(math.max(0, elapsed) * math.pi * 2 / period)
end
function FlightMath.Power(elapsed: number, period: number): number
    return math.clamp(1 - math.abs(FlightMath.MeterPosition(elapsed,period) - 0.5) * 2,0,1)
end
function FlightMath.AtLine(position: any, origin: any, width: number, depth: number): boolean
    return math.abs(position.X-origin.X)<=width/2 and math.abs(position.Z-origin.Z)<=depth/2 and math.abs(position.Y-origin.Y)<=8
end
function FlightMath.ThrowStyle(power: number): string
    return if power<0.35 then "Weak" elseif power<0.8 then "Medium" else "Strong"
end
function FlightMath.Distance(strength: number, level: number, orbPower: number, power: number, titan: boolean?): number
    local strengthDistance = 235 * math.log(1 + math.clamp(strength, 0, 10000) / 34)
    local base = 118 + strengthDistance + math.clamp(level, 1, 100) * 4
        + math.log10(math.clamp(orbPower, 1, 18000) + 1) * 48
    return math.max(60, base * (0.38 + math.clamp(power, 0, 1)) * (if titan then 1.35 else 1))
end
function FlightMath.Limit(raw: number, order: {string}, length: number, maximum: number, level: number, milestones: {any}?, pools: {[string]: any}?): (number, number)
    local last = 1
    for index = 2, #order do
        local goal = milestones and milestones[index]
        if goal and level < goal.Level then break end
        if pools and (not pools[order[index]] or not pools[order[index]].Comum) then break end
        last = index
    end
    local boundary = if last == #order then maximum else last * length - 1
    return math.min(raw, boundary), last
end
function FlightMath.LevelDistance(unlockedBand: number, zoneLength: number, power: number): number
    return (unlockedBand - 1) * zoneLength * (.25 + .75 * math.clamp(power, 0, 1))
end
function FlightMath.Zone(distance: number, order: {string}, zoneLength: number): (string, number, number)
    local band = math.clamp(math.floor(distance / zoneLength) + 1, 1, #order)
    local progress = math.clamp((distance - (band - 1) * zoneLength) / zoneLength, 0, 1)
    return order[band], band, progress
end
function FlightMath.RareBoost(distance: number, maximum: number, accuracy: number, orbBoost: number?): number
    local progress = math.clamp(distance / maximum, 0, 1)
    return (1 + 2.8 * progress ^ .9) * (1 + .20 * math.clamp(accuracy, 0, 1)) * (orbBoost or 1)
end
local rarityRanks: {[string]: number} = {Comum = 0, Incomum = 1, Rara = 2, Epica = 3, Mitica = 4, Lendaria = 5}
local rarestFirst = {"Secreta", "Lendaria", "Mitica", "Epica", "Rara", "Incomum"}

function FlightMath.BuildPools(creatures: {[string]: any}, order: {string}, extras: {[string]: {string}}): {[string]: {[string]: {string}}}
    local result = {}
    for _, biome in order do
        local groups: {[string]: {string}} = {}
        local seen: {[string]: boolean} = {}
        local function include(id: string, rarity: string)
            if seen[id] then return end
            seen[id] = true
            if not groups[rarity] then groups[rarity] = {} end
            table.insert(groups[rarity], id)
        end
        for id, definition in creatures do
            if definition.Biome == biome or definition.Rarity == "Secreta" then include(id, definition.Rarity) end
        end
        for _, id in extras[biome] or {} do
            local definition = creatures[id]
            if definition then include(id, definition.Rarity) end
        end
        for _, ids in groups do table.sort(ids) end
        result[biome] = groups
    end
    return result
end

-- Factor very rare checks into independent rolls below 1 in a million each.
-- This keeps huge denominators attainable even on a random generator with finite precision.
local function passes(probability: number, rng: Random): boolean
    while probability < .000001 do
        if rng:NextNumber() >= .000001 then return false end
        probability *= 1000000
    end
    return rng:NextNumber() < probability
end

function FlightMath.Encounter(groups: {[string]: {string}}, denominators: {[string]: number}, rng: Random, rareBoost: number?, previous: string?): (string?, number)
    local ids = groups.Comum
    if not ids then return nil, 0 end
    local remaining, probability = 1, 1
    for _, rarity in rarestFirst do
        local group = groups[rarity]
        local denominator = denominators[rarity]
        if group and denominator then
            local chance = math.min(.35, (rareBoost or 1) / denominator)
            if passes(chance, rng) then
                ids, probability = group, chance
                break
            end
            remaining *= 1 - chance
        end
    end
    local total = #ids - (if previous and table.find(ids, previous) then .75 else 0)
    local point = rng:NextNumber() * total
    for index, id in ids do
        local weight = if id == previous then .25 else 1
        if point < weight or index == #ids then return id, remaining * probability * weight / total end
        point -= weight
    end
    return nil, 0
end

function FlightMath.Species(creatures: {[string]: any}, biome: string, weights: {[string]: number}, roll: number, quality: number?, previous: string?): (string?, number)
    local pool, total = {}, 0
    local boost = 1 + .55 * math.clamp(quality or 0, 0, 1)
    for id, definition in creatures do
        if definition.Biome == biome then
            local weight = (weights[definition.Rarity] or 0) * boost ^ (rarityRanks[definition.Rarity] or 0)
            if id == previous then weight *= .25 end
            if weight > 0 then table.insert(pool, {Id = id, Weight = weight}); total += weight end
        end
    end
    if total == 0 then return nil, 0 end
    table.sort(pool, function(a, b) return a.Id < b.Id end)
    local accumulated = 0
    for _, entry in pool do
        accumulated += entry.Weight
        if math.clamp(roll, 0, 1 - 1e-12) * total < accumulated then return entry.Id, entry.Weight / total end
    end
    return nil, 0
end
return table.freeze(FlightMath)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">GameplayMath</string>
          <string name="Source"><![CDATA[--!strict
-- Pure benefit rules. Pass ownership is supplied by the server, never by a remote.
local GameplayMath = {}
GameplayMath.BaseSanctuarySlots = 10

function GameplayMath.GetCreatureSalePrice(income: number): number
	return math.max(1, math.floor(income * 60))
end

local function nonnegative(value: any, fallback: number?): number
	return if type(value) == "number" and value == value and value < math.huge and value >= 0 then value else fallback or 0
end

local function has(benefits: any, key: string): boolean
	return type(benefits) == "table" and benefits[key] == true
end

local function boost(profile: any, key: string, now: number): number
	local item = profile.Boosts and profile.Boosts[key]
	if type(item) ~= "table" or nonnegative(item.ExpiresAt) <= now then return 1 end
	return math.max(1, nonnegative(item.Multiplier, 1))
end

function GameplayMath.GetSlotCapacity(profile: any, benefits: any): number
	local level = nonnegative(profile.Level, 1)
	return math.min(24, GameplayMath.BaseSanctuarySlots + (if level >= 5 then 1 else 0) + (if level >= 15 then 1 else 0)
		+ math.floor(nonnegative(profile.ExtraSanctuarySlots)) + (if has(benefits, "GiantSanctuary") then 8 else 0)
		+ (if has(benefits, "GroupMember") then 1 else 0))
end

function GameplayMath.GetTrainingGain(_profile: any, benefits: any): number
	return if has(benefits, "TitanArms") then 2 else 1
end

function GameplayMath.GetRange(profile: any, benefits: any): number
	return (40 + nonnegative(profile.ThrowStrength) * 0.5 + math.clamp(nonnegative(profile.Level, 1), 1, 100) * 2)
		* (if has(benefits, "TitanArms") then 1.35 else 1)
end

function GameplayMath.GetLuck(profile: any, benefits: any, globalLuck: number?, now: number?): number
	local completed = 0
	for _, claimed in profile.BestiaryRewardClaimed or {} do if claimed == true then completed += 1 end end
	local base = 1 + (math.clamp(nonnegative(profile.Level, 1), 1, 100) - 1) * 0.015
		+ math.clamp(nonnegative(profile.PityBonus), 0, 1) + nonnegative(profile.Rebirths) * 0.5
		+ completed * 0.1 + (if has(benefits, "GroupMember") then 0.1 else 0)
	return base
		* (if has(benefits, "DoubleLuck") then 2 else 1) * boost(profile, "Luck", now or os.time())
		* math.max(1, nonnegative(globalLuck, 1))
		* (if profile.EquippedOrb == "Prismatica" and has(benefits, "EternalPrism") then 10 else 1)
end

function GameplayMath.GetIncomeMultiplier(profile: any, benefits: any, now: number?): number
	return (1 + nonnegative(profile.Rebirths)) * (if has(benefits, "DoubleCoins") then 2 else 1)
		* (if has(benefits, "GoldenVIP") then 1.25 else 1) * boost(profile, "Coins", now or os.time())
end

function GameplayMath.GetXPMultiplier(profile: any, benefits: any, now: number?): number
	return (1 + nonnegative(profile.Rebirths) * 0.5) * (if has(benefits, "FusionXP") then 2 else 1)
		* (if has(benefits, "GoldenVIP") then 1.25 else 1) * boost(profile, "XP", now or os.time())
end

function GameplayMath.GetOfflineIncome(profile: any, baseSynergyIncome: number, elapsed: number, benefits: any, now: number?): number
	local finish = now or os.time()
	local start = math.min(finish, nonnegative(profile.LastSeen, finish - nonnegative(elapsed)))
	local seconds = math.min(28800, nonnegative(elapsed), math.max(0, finish - start))
	local item = profile.Boosts and profile.Boosts.Coins
	local boostedSeconds, multiplier = 0, 1
	if type(item) == "table" then
		multiplier = math.max(1, nonnegative(item.Multiplier, 1))
		boostedSeconds = math.clamp(nonnegative(item.ExpiresAt) - start, 0, seconds)
	end
	local permanent = (1 + nonnegative(profile.Rebirths)) * (if has(benefits, "DoubleCoins") then 2 else 1)
		* (if has(benefits, "GoldenVIP") then 1.25 else 1)
	return math.floor(nonnegative(baseSynergyIncome) * permanent * (seconds + boostedSeconds * (multiplier - 1)))
end

function GameplayMath.GetOrbEvolutionPrice(base: number, fragments: number): (number, number)
    local used = math.min(math.floor(base / 10), math.max(0, math.floor(fragments)))
    return base - used * 5, used
end

return table.freeze(GameplayMath)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">NumberFormatter</string>
          <string name="Source"><![CDATA[--!strict
-- Display only: economy values stay numeric and authoritative on the server.
local NumberFormatter = {}

local SUFFIXES = {
	"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc",
	"Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd",
}

local function trimFraction(text: string): string
	return (text:gsub("(%..-)0+$", "%1"):gsub("%.$", ""))
end

local function precision(decimals: number?): number
	if decimals == nil or decimals ~= decimals or math.abs(decimals) == math.huge then
		return 1
	end
	return math.clamp(math.floor(decimals), 0, 3)
end

local function scientific(amount: number, digits: number): string
	local text = string.format("%." .. digits .. "e", amount)
	local mantissa, exponent = text:match("^(.-)e([%+%-]?%d+)$")
	if not mantissa or not exponent then
		return text
	end
	return trimFraction(mantissa) .. "e" .. tostring(tonumber(exponent))
end

function NumberFormatter.Format(value: number, decimals: number?): string
	if value ~= value then return "—" end
	if value == math.huge then return "∞" end
	if value == -math.huge then return "-∞" end

	local digits = precision(decimals)
	local amount = math.abs(value)
	local sign = if value < 0 then "-" else ""
	local tier = 1
	while amount >= 1000 and tier < #SUFFIXES do
		amount /= 1000
		tier += 1
	end
	local factor = 10 ^ digits
	local rounded = math.floor(amount * factor + 0.5) / factor
	-- The rounded display may cross a tier even when the original number did not.
	-- This also tolerates binary floating-point error at exact powers of 1000.
	if rounded >= 1000 then
		if tier == #SUFFIXES then return sign .. scientific(math.abs(value), digits) end
		amount /= 1000
		tier += 1
		rounded = math.floor(amount * factor + 0.5) / factor
	end
	if rounded == 0 then sign = "" end -- Avoid displaying negative zero.
	return sign .. trimFraction(string.format("%." .. digits .. "f", rounded)) .. SUFFIXES[tier]
end

return NumberFormatter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">TrainingMath</string>
          <string name="Source"><![CDATA[--!strict
local Training={}
function Training.RequiredXP(level:number,rules:any):number
    local progress = math.clamp(level, 1, rules.MaxLevel) - 1
    return math.floor(rules.XPBase + rules.XPLinear * progress + rules.XPGrowth * progress ^ rules.XPExponent)
end
function Training.Repetition(level: number, tier: number, titan: boolean, rules: any)
    local machine = rules.Machines[tier]
    local progress = math.clamp(level, 1, rules.MaxLevel) - 1
    local scale = 1 + progress * .035 + math.sqrt(progress) * .07
    return {
        Force = Training.Gain(level, titan, rules, machine),
        XP = math.floor(machine.XP * scale + .5),
        PlayerXP = rules.PlayerXPPerRep + math.floor(progress / 7) + tier - 1,
        Interval = rules.RepSeconds - machine.Speed,
    }
end
function Training.Gain(level: number, titan: boolean, rules: any, machine: any?): number
    return (1+math.floor((math.clamp(level,1,rules.MaxLevel)-1)/rules.LevelsPerGain) + (if machine then machine.Force else 0))*(if titan then 2 else 1)
end
function Training.AddXP(profile:any,amount:number,rules:any):(boolean, number)
    if profile.TrainingLevel>=rules.MaxLevel then profile.TrainingXP=0;return false, 0 end
    local granted = math.max(0, math.floor(amount))
    profile.TrainingXP += granted
    local up=false
    while profile.TrainingLevel<rules.MaxLevel and profile.TrainingXP>=Training.RequiredXP(profile.TrainingLevel,rules) do
        profile.TrainingXP-=Training.RequiredXP(profile.TrainingLevel,rules)
        profile.TrainingLevel+=1;up=true
    end
    if profile.TrainingLevel >= rules.MaxLevel then
        granted = math.max(0, granted - profile.TrainingXP)
        profile.TrainingXP = 0
    end
    return up, granted
end
return Training
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">VariantMath</string>
          <string name="Source"><![CDATA[--!strict
local Variants = {}
function Variants.FromQuantile(items: {any}, luck: number, quantile: number): (any, number)
    local total = 0
    for _, item in items do total += item.Weight * (if item.Name == "Normal" then 1 else luck) end
    local point, accumulated = math.clamp(quantile, 0, 1 - 1e-12) * total, 0
    for index, item in items do
        local weight = item.Weight * (if item.Name == "Normal" then 1 else luck)
        accumulated += weight
        if point < accumulated or index == #items then return item, weight / total end
    end
    return nil, 0
end
function Variants.GetPersonalLuck(profile: any, benefits: any, now: number): number
    local multiplier = if benefits.DoubleLuck then 2 else 1
    local boost = profile.Boosts and profile.Boosts.Luck
    if boost and boost.ExpiresAt > now then multiplier *= math.max(1, boost.Multiplier) end
    if profile.EquippedOrb == "Prismatica" and benefits.EternalPrism then multiplier *= 10 end
    return multiplier
end
function Variants.Apply(record: any, mutations: {any}, sizes: {any}, baseIncome: number, personalLuck: number): (any, any)
    local result = {Mutation = record.Mutation, Size = record.Size, IncomePerSec = record.IncomePerSec}
    if personalLuck <= 1 or type(record.MutationRoll) ~= "number" or type(record.SizeRoll) ~= "number" then return result, nil end
    local luck = (record.VariantLuck or 1) * personalLuck
    local mutation = Variants.FromQuantile(mutations, luck, record.MutationRoll)
    local size = Variants.FromQuantile(sizes, luck, record.SizeRoll)
    if mutation.Name == record.Mutation and size.Name == record.Size then return result, nil end
    result.Mutation, result.Size = mutation.Name, size.Name
    result.IncomePerSec = math.floor(baseIncome * mutation.Multiplier * size.Multiplier)
    return result, {MutationFrom = record.Mutation, SizeFrom = record.Size, LuckMultiplier = personalLuck}
end
return Variants
]]></string>
        </Properties>
