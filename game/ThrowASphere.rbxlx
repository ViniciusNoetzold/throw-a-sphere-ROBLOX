modalConstraint.MaxSize = Vector2.new(860, 620)
modalConstraint.Parent = modal
local modalTitle = W.Label(modal, "Title", "MINHAS CRIATURAS", UDim2.fromOffset(18, 10), UDim2.new(1, -84, 0, 36), 25, C.Gold)
modalTitle.TextTruncate = Enum.TextTruncate.AtEnd
local closeButton = W.Button(modal, "Close", "×", UDim2.new(1, -58, 0, 7), UDim2.fromOffset(44, 44), C.Pink, 25)
local content = Instance.new("Frame")
content.Name = "Content"
content.Position = UDim2.fromOffset(14, 58)
content.Size = UDim2.new(1, -28, 1, -72)
content.BackgroundTransparency = 1
content.Parent = modal
local selectedBeforeModal: GuiObject? = nil
local panelGeneration = 0
local renderedPanel: string? = nil
local function clearPanel()
    panelGeneration += 1
    if panelCleanup then panelCleanup(); panelCleanup = nil end
    for _, child in content:GetChildren() do child:Destroy() end
end
local function closePanel()
    currentPanel = nil
    session.RebirthConfirmed = false
    session.SellCreature, session.ReplaceCreature = nil, nil
    gui:SetAttribute("ModalOpen", false)
    backdrop.Visible = false
    noticeVersion += 1
    notice.Text = ""
    notice.TextColor3 = C.Muted
    notice.Visible = false
    ContextActionService:UnbindAction("ThrowASphereCloseModal")
    renderedPanel = nil
    clearPanel()
    if selectedBeforeModal and selectedBeforeModal.Parent then GuiService.SelectedObject = selectedBeforeModal else GuiService.SelectedObject = nil end
    selectedBeforeModal = nil
end
backdrop.Activated:Connect(closePanel)
closeButton.Activated:Connect(closePanel)
local actions = {
    Notify = function(message: string) showNotice(message) end,
    Open = function(kind: string) openPanel(kind) end,
    EquipOrb = function(id: string) equipOrb:FireServer(id) end,
    EquipSanctuary = function(uid: string) equipSanctuary:FireServer(uid) end,
    Close = closePanel,
    Send = function(name: string, ...: any)
        local remote = remotes:FindFirstChild(name)
        if remote and remote:IsA("RemoteEvent") then remote:FireServer(...) else showNotice("Esta ação está carregando. Tente novamente em instantes.", true) end
    end,
    GetState = function() return state end,
    Refresh = function() renderPanel() end,
    Session = session,
    Elapsed = function() return math.max(0, os.clock() - stateReceivedAt) end,
}
renderPanel = function()
    if not currentPanel then return end
    local focusedTextBox = UserInputService:GetFocusedTextBox()
    local textFocusPath: {string} = {}
    local cursor, selectionStart = -1, -1
    if focusedTextBox and focusedTextBox:IsDescendantOf(content) and renderedPanel == currentPanel then
        cursor, selectionStart = focusedTextBox.CursorPosition, focusedTextBox.SelectionStart
        local target: Instance? = focusedTextBox
        while target and target ~= content do table.insert(textFocusPath, 1, target.Name); target = target.Parent end
    end
    local focusedPath: {string} = {}
    local selected: Instance? = GuiService.SelectedObject
    if selected and selected:IsDescendantOf(content) and renderedPanel == currentPanel then
        while selected and selected ~= content do
            table.insert(focusedPath, 1, selected.Name)
            selected = selected.Parent
        end
    end
    local previousList = if renderedPanel == currentPanel then content:FindFirstChildWhichIsA("ScrollingFrame", true) else nil
    local scrollPosition = if previousList then previousList.CanvasPosition else Vector2.zero
    local listName = if previousList then previousList.Name else nil
    clearPanel()
    local generation = panelGeneration
    if currentPanel == "Resgates" then
        local count = state and (state.DropInfo or {}).ActiveCount or 0
        modalConstraint.MaxSize = Vector2.new(388, math.clamp(95 + 76 * count, 155, 350))
    elseif currentPanel == "Academia" then
        modalConstraint.MaxSize = Vector2.new(416, 356)
    else
        modalConstraint.MaxSize = Vector2.new(860, 620)
    end
    modalTitle.Text = Panels.Titles[currentPanel] or currentPanel
    if currentPanel == "Loja" then panelCleanup = ShopView.Render(content, actions.Notify)
    elseif Gameplay.Handles(currentPanel) then panelCleanup = Gameplay.Render(content, currentPanel, state, actions)
    elseif currentPanel == "Trocas" or currentPanel == "Leiloes" or currentPanel == "GrupoVIP" then panelCleanup = Commerce.Render(content, currentPanel, state, actions)
    else panelCleanup = Panels.Render(content, currentPanel, state, actions) end
    renderedPanel = currentPanel
    if #textFocusPath > 0 then
        task.defer(function()
            if generation ~= panelGeneration then return end
            local restored: Instance? = content
            for _, name in textFocusPath do restored = if restored then restored:FindFirstChild(name) else nil end
            if restored and restored:IsA("TextBox") then
                restored:CaptureFocus()
                if cursor > 0 then restored.CursorPosition = math.min(cursor, #restored.Text + 1) end
                if selectionStart > 0 then restored.SelectionStart = math.min(selectionStart, #restored.Text + 1) end
            end
        end)
    end
    if scrollPosition.Y > 0 then
        task.delay(0.05, function()
            if generation ~= panelGeneration then return end
            local list = if listName then content:FindFirstChild(listName, true) else nil
            if list and list:IsA("ScrollingFrame") then list.CanvasPosition = scrollPosition end
        end)
    end
    if UserInputService.GamepadEnabled then
        local restored: Instance? = content
        for _, name in focusedPath do restored = if restored then restored:FindFirstChild(name) else nil end
        GuiService.SelectedObject = if restored and restored:IsA("GuiButton") then restored else closeButton
    end
end
openPanel = function(kind: string)
    local rewardAlias = kind == "Missoes" or kind == "Consumiveis"
    if rewardAlias then session.RewardsTab = if kind == "Missoes" then "Missions" else "Consumables"; kind = "Diario" end
    if currentPanel == kind and not rewardAlias then closePanel(); return end
    if currentPanel ~= "Rebirth" or kind ~= "Rebirth" then session.RebirthConfirmed = false end
    if not currentPanel then selectedBeforeModal = GuiService.SelectedObject end
    currentPanel = kind
    panelSignature = if state then getPanelSignature(state) else ""
    backdrop.Visible = true
    notice.Visible = false
    gui:SetAttribute("ModalOpen", true)
    ContextActionService:BindActionAtPriority("ThrowASphereCloseModal", function(_, inputState)
        if inputState == Enum.UserInputState.Begin then closePanel() end
        return Enum.ContextActionResult.Sink
    end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.Escape, Enum.KeyCode.ButtonB)
    if kind == "Bestiario" and newDiscoveryBadge then newDiscoveryBadge.Visible = false end
    renderPanel()
end

getPanelSignature = function(snapshot: any): string
    if not snapshot then return "loading" end
    if currentPanel and Gameplay.Handles(currentPanel) then return Gameplay.Signature(currentPanel, snapshot) end
    if currentPanel == "Trocas" or currentPanel == "Leiloes" or currentPanel == "GrupoVIP" then return Commerce.Signature(currentPanel, snapshot, session) end
    local parts: {string} = {}
    if currentPanel == "Criaturas" then
        return Gameplay.Stable({Captures = snapshot.CapturedCreatures, Slots = snapshot.SanctuarySlots, SlotCapacity = snapshot.SlotCapacity, Progression = snapshot.Progression, Reserved = snapshot.InventoryReservedSlots})
    elseif currentPanel == "Bestiario" then
        return Gameplay.Stable({Bestiary = snapshot.Bestiary, Claimed = snapshot.BestiaryRewardClaimed})
    elseif currentPanel == "Resgates" then
        return Gameplay.Stable((snapshot.DropInfo or {}).Drops)
    elseif currentPanel == "Academia" then
        local training = snapshot.Training or {}
        local rules = Panels.Machines
        local nextMachine = rules[(training.MachineTier or 1) + 1]
        return Gameplay.Stable({Training = training, CanAfford = nextMachine and snapshot.Coins >= nextMachine.Cost})
    elseif currentPanel == "Orbes" then
        table.insert(parts, tostring(snapshot.OrbTier))
        table.insert(parts, tostring(snapshot.OrbFragments or 0))
        local affordable = false
        for _, orb in Config.Orbs do
            if orb.Tier == (snapshot.OrbTier or 1) + 1 then
                affordable = snapshot.Coins >= GameplayMath.GetOrbEvolutionPrice(orb.Price, snapshot.OrbFragments or 0)
            end
        end
        table.insert(parts, tostring(affordable))
        table.insert(parts, tostring(snapshot.EquippedOrb))
        for _, id in Panels.OrbOrder do table.insert(parts, tostring((snapshot.Orbs or {})[id] or 0)) end
        table.insert(parts, tostring(snapshot.Benefits and snapshot.Benefits.EternalPrism))
    elseif currentPanel == "Loja" then
        return Gameplay.Stable({Benefits = snapshot.Benefits, SalesEnabled = snapshot.SalesEnabled})
    end
    return table.concat(parts, ":")
end

stateUpdate.OnClientEvent:Connect(function(snapshot: any)
    if typeof(snapshot) ~= "table" then return end
    local previous = state
    state = snapshot
    stateReceivedAt = os.clock()
    if snapshot.Weather then worldWeather = snapshot.Weather end
    local level = snapshot.Level or 1
    local required = snapshot.XPRequired or Config.GetXPRequiredForLevel(level)
    local percent = math.clamp((snapshot.XP or 0) / math.max(1, required), 0, 1)
    if level >= Config.Constants.MaxLevel then percent = 1 end
    coinsLabel.Text = "$" .. Numbers.Format(snapshot.Coins or 0)
    incomeLabel.Text = "+$" .. Numbers.Format(snapshot.IncomePerSec or 0) .. " /s NO SANTUÁRIO"
    strengthLabel.Text = "FORÇA " .. Numbers.Format(snapshot.ThrowStrength or 10)
    gemsLabel.Text = Numbers.Format(snapshot.Gems or 0) .. " GEMAS  •  " .. Numbers.Format(snapshot.Rebirths or 0) .. " REBIRTHS"
    xpLabel.Text = "NV. " .. level .. (if level >= Config.Constants.MaxLevel then "  •  NÍVEL MÁXIMO" else "  •  " .. math.floor(percent * 100) .. "% XP")
    rankLabel.Text = Progression.GetTrainerRank(level)
    TweenService:Create(xpFill, TweenInfo.new(0.2), {Size = UDim2.fromScale(percent, 1)}):Play()
    local luck = snapshot.EffectiveLuck or 1
    luckLabel.Text = string.format("SORTE ×%.2f", luck)
    dataMode.Text = if snapshot.DataMode == "StudioMemory" then "TESTE LOCAL • DADOS NÃO SÃO SALVOS" else "SALVAMENTO AUTOMÁTICO ATIVO"
    local orb = Config.Orbs[snapshot.EquippedOrb or "Comum"]
    if orb then
        local reusable = orb.Tier and orb.Tier <= (snapshot.OrbTier or 1)
        orbLabel.Text = string.upper(orb.Name) .. (if reusable then "" elseif orb.IsPrismatic and snapshot.Benefits and snapshot.Benefits.EternalPrism then " ∞" else " ×" .. Numbers.Format((snapshot.Orbs or {})[orb.Id] or 0))
        orbLabel.TextColor3 = orb.Color
        if not previous or previous.EquippedOrb ~= snapshot.EquippedOrb then
            orbArtwork:Destroy()
            orbArtwork = Icons.Draw(orbIcon, "Orb", orb.Color)
        end
        orbPower.Text = "PODER " .. Numbers.Format(orb.Power)
    end
    if previous then
        for id, discovered in snapshot.Bestiary or {} do
            if discovered and not (previous.Bestiary or {})[id] and newDiscoveryBadge and currentPanel ~= "Bestiario" then newDiscoveryBadge.Visible = true end
        end
    end
    local rewardCount = (snapshot.DropInfo or {}).ActiveCount or 0
    local rewardCaption = rewardsButton:FindFirstChild("Caption") :: TextLabel
    rewardCaption.Text = if rewardCount > 0 then "RESGATES (" .. rewardCount .. ")" else "RESGATES"
    local accessPill = menuButtons.Auto:FindFirstChild("Planned") :: TextLabel
    accessPill.Text = if snapshot.Automation and (snapshot.Automation.CanThrow or snapshot.Automation.CanTrain) then "LIBERADO" else "TRANCADO"
    local currentBiomeLabel = room:FindFirstChild("Biome") :: TextLabel
    currentBiomeLabel.Text = if Config.Biomes[snapshot.CurrentBiome] then Config.Biomes[snapshot.CurrentBiome].Name elseif snapshot.CurrentBiome == "TradingPlaza" then "Praça local de trocas" else "Praça central"
    updateEvent()
    if currentPanel then
        local signature = getPanelSignature(snapshot)
        if signature ~= panelSignature then panelSignature = signature; renderPanel() end
        Gameplay.Update(content, state, actions)
        if Commerce.Update then Commerce.Update(content, state, actions) end
    end
    if not offlineShown and (snapshot.OfflineReward or 0) > 0 then
        offlineShown = true
        showNotice("BEM-VINDO DE VOLTA! +$" .. Numbers.Format(snapshot.OfflineReward) .. " gerados offline.")
    end
end)
feedback.OnClientEvent:Connect(function(message: any)
    if typeof(message) == "string" then showNotice(message)
    elseif typeof(message) == "table" and typeof(message.Message) == "string" then showNotice(message.Message, message.Kind == "Error") end
end)
throwResult.OnClientEvent:Connect(function(data: any)
    if typeof(data) ~= "table" then return end
    task.delay(data.PresentationDuration or 3, function() showRareCapture(data) end)
    if data.Thrower ~= player then return end
    if data.IsCritical then spawnFloatingNumber("CRÍTICO 1.5×!", C.Gold, 28) end
    if data.IsLongShot then spawnFloatingNumber("TIRO LONGO 1.25×!", C.Blue, 23) end
    if data.IsBossHit then
        showNotice(if data.BossDefeated then "CHEFE DERROTADO! Recompensa dos participantes liberada." else "ACERTO NO CHEFE! Continue reduzindo a resistência.")
        return
    end
    showNotice(if data.FlightId then "A ORBE CHEGOU! Revelando o encontro..." else "ORBE LANÇADA! Aguarde as balançadas...")
    task.delay(data.PresentationDuration or 3, function()
        local atLevelCap = (data.NewLevel or 1) >= Config.Constants.MaxLevel and not data.LeveledUp
        local gainedXP = if atLevelCap then 0 else data.XPGained or 0
        if gainedXP > 0 then spawnFloatingNumber("+" .. Numbers.Format(gainedXP) .. " XP!", C.Blue, 25) end
        if data.Captured then
            showNotice("CAPTURADO! " .. tostring(data.CreatureName or "Criatura") .. " • " .. tostring(data.MutationName or "Normal") .. " / " .. tostring(data.SizeName or "Normal"))
            if typeof(data.VariantBonus) == "table" then spawnFloatingNumber("BÔNUS DE VARIANTE!", C.Purple, 23) end
        elseif atLevelCap then showNotice("ESCAPOU! Nível máximo • +5% de sorte acumulada.")
        else showNotice("ESCAPOU! +" .. Numbers.Format(gainedXP) .. " XP e +5% de sorte acumulada.") end
        if (data.FragmentsGained or 0) > 0 then spawnFloatingNumber("+" .. Numbers.Format(data.FragmentsGained) .. " FRAGMENTOS", C.Purple, 22) end
        if data.LeveledUp then spawnFloatingNumber("NÍVEL " .. Numbers.Format(data.NewLevel or 1) .. "!", C.Gold, 32) end
    end)
end)

local function updateRoom()
    local count = #Players:GetPlayers()
    roomLabel.Text = "SALA · " .. count .. "/8"
end
Players.PlayerAdded:Connect(updateRoom)
Players.PlayerRemoving:Connect(function() task.defer(updateRoom) end)
updateRoom()
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if currentPanel and (input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Escape) then closePanel(); return end
    if not gui.Enabled or processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.C then openPanel("Criaturas")
    elseif input.KeyCode == Enum.KeyCode.V then openPanel("Orbes")
    elseif input.KeyCode == Enum.KeyCode.G then openPanel("Resgates")
    elseif input.KeyCode == Enum.KeyCode.B then openPanel("Bestiario")
    elseif input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.ButtonY then openPanel("Menu") end
end)

local function resize()
    local width, height = root.AbsoluteSize.X, root.AbsoluteSize.Y
    if width <= 0 or height <= 0 then return end
    compact = width < 980 or height < 430
    portrait = width < height
    local standardScale = if height < 620 then 0.86 else 1
    heading.Visible = false
    dataMode.Visible = false
    leftMenu.Visible = false
    navigation.Visible = true
    navigation.Position = UDim2.fromOffset(10, 4)
    leftScale.Scale = standardScale
    rightScale.Scale = if compact then 0.78 else standardScale
    rightMenu.Size = if compact then UDim2.fromOffset(176, 68) else UDim2.fromOffset(82, 308)
    rightMenu.Position = if compact then UDim2.new(1, -10, 0, 84) else UDim2.new(1, -12, 0, 92)
    for index, id in {"Criaturas", "Orbes", "Auto", "Codigos"} do
        menuButtons[id].Visible = not compact or index <= 2
        menuButtons[id].Position = if compact then UDim2.fromOffset((index - 1) * 94, 0) else UDim2.fromOffset(0, (index - 1) * 78)
    end
    statsScale.Scale = if compact then 0.59 else 0.76
    stats.AnchorPoint = if compact then Vector2.new(0, 0) else Vector2.new(0, 1)
    stats.Position = if compact then UDim2.fromOffset(10, 58) else UDim2.new(0, 12, 1, -12)
    local targetWidth = if compact then math.min(430, width - 32) else 460 * standardScale
    hotbarScale.Scale = targetWidth / 460
    hotbar.Size = UDim2.fromOffset(460, if compact then 72 else 58)
    trainButton.Size = UDim2.fromOffset(92, if compact then 44 / hotbarScale.Scale else 36)
    swapButton.Size = UDim2.fromOffset(104, if compact then 44 / hotbarScale.Scale else 36)
    local bottom = if compact and portrait then 160 else 12
    hotbar.Position = UDim2.new(0.5, 0, 1, -bottom)
    notice.Position = UDim2.new(0.5, 0, 1, -bottom - 94 * hotbarScale.Scale)
    notice.Size = UDim2.new(if compact then 0.9 else 0.65, 0, 0, if compact then 35 else 42)
    notice.TextSize = if compact then 12 else 15
    event.Size = UDim2.fromOffset(176, 24)
    eventTitle.TextSize = if compact and portrait then 10 else 13
    updateEvent()
    room.Visible = not compact and width > 1000
    modal.Size = if compact then UDim2.new(1, -16, 1, -16) else UDim2.fromScale(0.9, 0.86)
    modalTitle.TextSize = if compact then 20 else 25
    banner.Size = UDim2.fromOffset(math.min(470, width - 24), 58)
    if currentPanel then renderPanel() end
end
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
resize()
task.defer(resize)
task.spawn(function()
    while gui.Parent do
        task.wait(0.25)
        updateEvent()
        if currentPanel then
            Gameplay.Update(content, state, actions)
            if Commerce.Update then Commerce.Update(content, state, actions) end
        end
    end
end)
local worldStateUpdate = remotes:FindFirstChild("WorldStateUpdate")
if worldStateUpdate and worldStateUpdate:IsA("RemoteEvent") then worldStateUpdate.OnClientEvent:Connect(function(weather: any)
    if typeof(weather) == "table" then worldWeather = weather; if state then state.Weather = weather end; updateEvent() end
end) end
local openPanelRemote = remotes:WaitForChild("OpenPanel") :: RemoteEvent
local allowedPanels = {Menu = true, Bestiario = true, Loja = true, Fusao = true, Diario = true, Rebirth = true,
    Ranking = true, Criaturas = true, Orbes = true, Auto = true, Codigos = true, Biomas = true,
    Academia = true, Resgates = true, Missoes = true, Consumiveis = true, GrupoVIP = true, Trocas = true, Leiloes = true}
openPanelRemote.OnClientEvent:Connect(function(panelId: any)
    if typeof(panelId) ~= "string" or not allowedPanels[panelId] then return end
    -- A station prompt requests an open panel, rather than toggling it closed.
    if currentPanel == panelId then return end
    openPanel(panelId)
end)
requestState:FireServer()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">CameraFocus</string>
          <string name="Source"><![CDATA[--!strict
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ACTION = "ThrowASphereGameplayFocus"
local CameraFocus = {}
local owner: string? = nil
local original: {Camera: Camera, Type: Enum.CameraType, Subject: Instance?, CFrame: CFrame, FOV: number}? = nil

function CameraFocus.Release(key: string)
    if key ~= owner then return end
    owner = nil
    ContextActionService:UnbindAction(ACTION)
    local previous = original
    original = nil
    local camera = Workspace.CurrentCamera
    if not previous or not camera then return end
    local player = Players.LocalPlayer
    local currentHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    camera.CameraSubject = if previous.Subject and previous.Subject.Parent then previous.Subject else currentHumanoid
    camera.CFrame = previous.CFrame
    camera.FieldOfView = previous.FOV
    camera.CameraType = if camera == previous.Camera then previous.Type else Enum.CameraType.Custom
end

function CameraFocus.Begin(key: string)
    if key == owner then return end
    if owner then CameraFocus.Release(owner) end
    local camera = Workspace.CurrentCamera
    if not camera then return end
    owner = key
    original = {Camera = camera, Type = camera.CameraType, Subject = camera.CameraSubject, CFrame = camera.CFrame, FOV = camera.FieldOfView}
    camera.CameraType = Enum.CameraType.Scriptable
    ContextActionService:BindActionAtPriority(ACTION, function()
        return Enum.ContextActionResult.Sink
    end, false, Enum.ContextActionPriority.High.Value + 10,
        Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
        Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight,
        Enum.PlayerActions.CharacterJump, Enum.KeyCode.Thumbstick1, Enum.KeyCode.ButtonA)
end

function CameraFocus.Frame(key: string, target: CFrame, fov: number, delta: number, response: number)
    local camera = Workspace.CurrentCamera
    if key ~= owner or not camera then return end
    local alpha = 1 - math.exp(-math.max(0, delta) * response)
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = camera.CFrame:Lerp(target, alpha)
    camera.FieldOfView += (fov - camera.FieldOfView) * alpha
    camera.Focus = CFrame.new(camera.CFrame.Position + camera.CFrame.LookVector * 12)
end

return CameraFocus
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="96">
        <Properties>
          <string name="Name">ClientSanctuaryController</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CreatureArt = require(script.Parent:WaitForChild("CreatureArt"))

type Walker = {
    Home: Vector3,
    Phase: number,
    Caption: TextLabel,
    Left: BasePart?,
    Right: BasePart?,
}
local walkers: {[Model]: Walker} = {}

local function observe(instance: Instance)
    if not instance:IsA("Model") then return end
    local home, phase = instance:GetAttribute("PenHome"), instance:GetAttribute("WalkPhase")
    local head = instance:FindFirstChild("Head")
    local board = head and head:FindFirstChild("Label")
    local caption = board and board:FindFirstChildWhichIsA("TextLabel")
    if typeof(home) ~= "Vector3" or typeof(phase) ~= "number" or not caption or not instance.PrimaryPart then return end
    local left, right = instance:FindFirstChild("LeftFoot"), instance:FindFirstChild("RightFoot")
    walkers[instance] = {
        Home = home,
        Phase = phase,
        Caption = caption,
        Left = if left and left:IsA("BasePart") then left else nil,
        Right = if right and right:IsA("BasePart") then right else nil,
    }
    task.defer(CreatureArt.ShowOn, instance, instance.Name, instance:GetAttribute("ArtScale") or 1, 1, 11)
end

for _, model in CollectionService:GetTagged("SanctuaryWalker") do observe(model) end
CollectionService:GetInstanceAddedSignal("SanctuaryWalker"):Connect(function(model) task.defer(observe, model) end)
CollectionService:GetInstanceRemovedSignal("SanctuaryWalker"):Connect(function(model)
    if model:IsA("Model") then walkers[model] = nil end
end)

CreatureArt.Loaded:Connect(function(id: string)
    for model in walkers do
        if model.Name == id then CreatureArt.ShowOn(model, id, model:GetAttribute("ArtScale") or 1, 1, 11) end
    end
end)

task.spawn(function()
    while script.Parent do
        task.wait(.6)
        for _, model in CollectionService:GetTagged("SanctuaryWalker") do
            if model:IsA("Model") and not walkers[model] then observe(model) end
        end
    end
end)

local elapsed = 0
RunService.RenderStepped:Connect(function(delta)
    elapsed += delta
    if elapsed < 1 / 30 then return end
    elapsed %= 1 / 30
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local time = Workspace:GetServerTimeNow()
    local eye = camera.CFrame.Position
    for model, walker in walkers do
        if not model.Parent or (eye - walker.Home).Magnitude > 95 then continue end
        local angle = time * .78 + walker.Phase
        local step = math.sin(time * 8 + walker.Phase)
        local position = walker.Home + Vector3.new(math.sin(angle) * 1.35, math.abs(step) * .09, math.cos(angle) * 1.65)
        local direction = Vector3.new(math.cos(angle) * 1.35, 0, -math.sin(angle) * 1.65)
        local pose = CFrame.lookAt(position, position + direction)
        model:PivotTo(pose)
        if walker.Left then walker.Left.CFrame = pose * CFrame.new(-.62, -.72 + math.max(0, step) * .22, -.45 + step * .22) end
        if walker.Right then walker.Right.CFrame = pose * CFrame.new(.62, -.72 + math.max(0, -step) * .22, -.45 - step * .22) end
        local pulse = (1 + math.sin(time * math.pi * 2 + walker.Phase)) * .5
        walker.Caption.TextColor3 = Color3.fromRGB(94, 215, 119):Lerp(Color3.fromRGB(185, 255, 126), pulse)
        walker.Caption.TextTransparency = .22 * (1 - pulse)
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="97">
        <Properties>
          <string name="Name">ClientThrowController</string>
          <string name="Source"><![CDATA[--!strict
-- Timing meter -> server-owned flight -> rarity reveal.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Workspace=game:GetService("Workspace")
local Rules=require(RS.Shared.ConfigFlight)
local Layout=require(RS.Shared.ConfigWorld)
local Config=require(RS.Shared.Config)
local Math=require(RS.Shared.FlightMath)
local Numbers=require(RS.Shared.NumberFormatter)
local Reveal=require(script.Parent:WaitForChild("Throw"):WaitForChild("RevealDirector"))
local Pose=require(script.Parent:WaitForChild("Throw"):WaitForChild("ThrowPose"))
local Focus = require(script.Parent:WaitForChild("CameraFocus"))
local OrbVisual = require(script.Parent:WaitForChild("Throw"):WaitForChild("OrbVisual"))
local remotes=RS:WaitForChild("Remotes")
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn,gui.DisplayOrder,gui.Parent="ThrowFlightHUD",false,80,player:WaitForChild("PlayerGui")
gui:SetAttribute("ReducedMotion",false)
local function round(parent:Instance)
 local r=Instance.new("UICorner");r.CornerRadius,r.Parent=UDim.new(0,12),parent
end
local function label(parent:Instance,name:string,value:string,pos:UDim2,size:UDim2,fontSize:number):TextLabel
 local l=Instance.new("TextLabel")
 l.Name,l.Text,l.Position,l.Size=name,value,pos,size
 l.BackgroundTransparency,l.Font,l.TextColor3,l.TextSize=1,Enum.Font.GothamBlack,Color3.new(1,1,1),fontSize
 l.TextStrokeTransparency,l.Parent=0.4,parent
 return l
end
local ink = Color3.fromRGB(34, 39, 66)
local panel = Instance.new("Frame")
panel.Name, panel.AnchorPoint, panel.Position = "ForcePanel", Vector2.new(.5, 1), UDim2.new(.5, 0, 1, -76)
panel.Size, panel.BackgroundColor3 = UDim2.new(.77, 0, 0, 94), Color3.fromRGB(49, 57, 89)
panel.Visible, panel.Parent = false, gui
round(panel)
local edge = Instance.new("UIStroke")
edge.Color, edge.Thickness, edge.Parent = Color3.fromRGB(255, 225, 126), 2, panel
local limits = Instance.new("UISizeConstraint")
limits.MaxSize, limits.Parent = Vector2.new(330, 94), panel
local title = label(panel, "PowerLabel", "FORÇA", UDim2.fromOffset(7, 2), UDim2.new(1, -14, 0, 22), 15)
local meter = Instance.new("Frame")
meter.Name, meter.Position, meter.Size = "PowerMeter", UDim2.fromOffset(15, 28), UDim2.new(1, -30, 0, 19)
meter.BackgroundColor3, meter.BorderSizePixel, meter.Parent = Color3.new(1, 1, 1), 0, panel
round(meter)
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 100, 105)),
    ColorSequenceKeypoint.new(.23, Color3.fromRGB(255, 198, 70)),
    ColorSequenceKeypoint.new(.5, Color3.fromRGB(94, 245, 133)),
    ColorSequenceKeypoint.new(.77, Color3.fromRGB(255, 198, 70)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 105)),
})
gradient.Parent = meter
local perfect = Instance.new("Frame")
perfect.Position, perfect.Size = UDim2.fromScale(.465, 0), UDim2.fromScale(.07, 1)
perfect.BackgroundColor3, perfect.BackgroundTransparency, perfect.BorderSizePixel = Color3.new(1, 1, 1), .5, 0
perfect.Parent = meter
round(perfect)
local pointer = Instance.new("Frame")
pointer.Name, pointer.Size, pointer.AnchorPoint = "PowerPointer", UDim2.fromOffset(15, 23), Vector2.new(.5, .5)
pointer.BackgroundColor3, pointer.BorderSizePixel, pointer.Parent = Color3.fromRGB(255, 249, 227), 0, meter
round(pointer)
local rim = Instance.new("UIStroke")
rim.Color, rim.Thickness, rim.Parent = ink, 2, pointer
local button = Instance.new("TextButton")
button.Name, button.Position, button.Size = "LaunchButton", UDim2.fromOffset(6, 50), UDim2.new(1, -12, 0, 24)
button.Text, button.TextSize, button.Font = "CLIQUE OU TOQUE  ·  R2", 11, Enum.Font.GothamBold
button.BackgroundTransparency, button.TextColor3, button.Parent = 1, Color3.fromRGB(255, 242, 213), panel
local goal = label(panel, "NextBiomeGoal", "", UDim2.fromOffset(5, 73), UDim2.new(1, -10, 0, 17), 10)
goal.TextColor3 = Color3.fromRGB(190, 220, 250)
local top=label(gui,"Distance","",UDim2.new(0.5,0,0,70),UDim2.new(0.6,0,0,60),32)
top.AnchorPoint=Vector2.new(0.5,0)
local zone=label(gui,"Biome","",UDim2.new(0.5,0,0,130),UDim2.new(0.6,0,0,36),23)
zone.AnchorPoint=Vector2.new(0.5,0)
local session:any=nil
local generation=0
local cleanup:(()->())?=nil
local chargeHidden:{[ScreenGui]:boolean}={}
local retryAt=0
local suppressUntilExit = false
local blockingMessage: string? = nil
local hint=label(gui,"LaunchHint","Encoste na linha amarela à frente para arremessar",UDim2.new(.5,0,1,-107),UDim2.new(.8,0,0,22),13)
hint.AnchorPoint=Vector2.new(.5,0)
local function atLine():boolean
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 return root~=nil and Math.AtLine(root.Position,Rules.LinePosition,Rules.LineWidth,Rules.LineDepth)
end
local function hideChargeHUD()
 for _,screen in player.PlayerGui:GetChildren() do
  if screen~=gui and screen:IsA("ScreenGui") then chargeHidden[screen]=screen.Enabled;screen.Enabled=false end
 end
end
local function modal():boolean
 for _,s in player.PlayerGui:GetChildren() do
  if s~=gui and s:IsA("ScreenGui") and s.Enabled and s:GetAttribute("ModalOpen")==true then return true end
 end
 return false
end
local function restore()
 generation+=1
 Focus.Release("Throw")
 if cleanup then cleanup();cleanup=nil end
 for screen,enabled in chargeHidden do if screen.Parent then screen.Enabled=enabled end end
 chargeHidden={}
 gui:SetAttribute("ModalOpen",false)
 panel.Visible=false;top.Text,zone.Text="",""
end
local function idle()
    session = nil
    blockingMessage = nil
    restore()
    retryAt = os.clock() + .18
end
local function confirm()
    if not session or session.State ~= "Charging" or not atLine() then return end
    session.State = "Submitting"
    button.Text = "ARREMESSANDO…"
    remotes.LaunchThrow:FireServer(session.Id)
end
button.Activated:Connect(confirm)

Input.InputBegan:Connect(function(input)
    if not session or session.State ~= "Charging" or Input:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
        suppressUntilExit = true
        remotes.CancelThrow:FireServer(session.Id)
        idle()
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
        or input.KeyCode == Enum.KeyCode.ButtonR2 then
        confirm()
    end
end)

Run.RenderStepped:Connect(function(delta)
    local near = atLine()
    local inModal = modal()
    local training = player:GetAttribute("TrainingActive") == true
    if not near then
        suppressUntilExit = false
        if not session and panel.Visible then idle() end
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    hint.Text = if near and suppressUntilExit then "Saia da faixa e volte para arremessar de novo"
        else "Encoste na faixa amarela para arremessar"
    hint.Visible = (not near or suppressUntilExit) and not session and not inModal and not training and root ~= nil
        and (root.Position - Rules.LinePosition).Magnitude < 35
    if not session and near and not suppressUntilExit and not inModal and not training
        and player:GetAttribute("DataLoaded") == true then
        panel.Visible = true
        pointer.Visible = false
        title.Text = if blockingMessage then "ARREMESSO INDISPONÍVEL" else "PREPARE SUA ORBE"
        button.Text = blockingMessage or "PREPARANDO…"
        if os.clock() >= retryAt then
            retryAt = os.clock() + .18
            remotes.PrepareThrow:FireServer()
        end
    elseif not session then
        panel.Visible = false
    end
    if session and session.State == "Charging" then
        if inModal or not near then
            remotes.CancelThrow:FireServer(session.Id)
            idle()
            return
        end
        if root and root:IsA("BasePart") then
            local target = root.Position + root.CFrame.LookVector * 3 + Vector3.new(0, 1.2, 0)
            local viewpoint = root.Position - root.CFrame.LookVector * 10 + Vector3.new(5.8, 4, 0)
            Focus.Frame("Throw", CFrame.lookAt(viewpoint, target), 59, delta, 9)
        end
        local elapsed = Workspace:GetServerTimeNow() - session.StartedAt
        local power = Math.Power(elapsed, session.Period)
        pointer.Position = UDim2.fromScale(Math.MeterPosition(elapsed, session.Period), .5)
        title.Text = if power >= Rules.PerfectThreshold then "PERFEITO!" else "FORÇA " .. math.floor(power * 100) .. "%"
    end
end)
local function flight(data: any)
    Focus.Begin("Throw")
    local myGeneration = generation
    local character = player.Character
    local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "FlightLocalEffects", Workspace
    local orb, core = OrbVisual.Create(data.Color, 1.8, data.OrbId)
    orb.Parent = folder
    local trail = Instance.new("Trail")
    local left, right = Instance.new("Attachment"), Instance.new("Attachment")
    left.Position, right.Position = Vector3.new(0, .62, 0), Vector3.new(0, -.62, 0)
    left.Parent, right.Parent = core, core
    trail.Attachment0, trail.Attachment1 = left, right
    trail.Color = ColorSequence.new(data.Color:Lerp(Color3.new(1, 1, 1), .45), data.Color)
    trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, .03), NumberSequenceKeypoint.new(1, 1)})
    trail.LightEmission, trail.Lifetime, trail.Enabled, trail.Parent = .85, .42, false, core
    local light = Instance.new("PointLight")
    light.Color, light.Brightness, light.Range, light.Parent = data.Color, 2, 15, core
    local extras: {Model} = {}
    for _ = 2, data.Count or 1 do
        local extra = OrbVisual.Create(data.Color, 1.45, data.OrbId)
        extra.Parent = folder
        table.insert(extras, extra)
    end
    cleanup = function() folder:Destroy() end
    gui:SetAttribute("ModalOpen", true)
    panel.Visible = false
    local function alive(): boolean return generation == myGeneration and gui.Parent ~= nil end
    local ok, problem = pcall(function()
        local delta = 1 / 60
        local release = data.StartPos
        local previousZone = 0
        local zoneTime = 0
        while alive() and session and session.State == "Flying" do
            local now = Workspace:GetServerTimeNow()
            local elapsed = now - data.StartedAt
            local reduced = gui:GetAttribute("ReducedMotion") == true
            if elapsed < Rules.WindupSeconds then
                if hand and hand:IsA("BasePart") then release = hand.Position end
                orb:PivotTo(CFrame.new(release) * CFrame.Angles(.25, elapsed * 2.4, 0))
                for _, extra in extras do extra:PivotTo(orb:GetPivot()) end
                local subject = data.StartPos + Vector3.new(0, -.6, 0)
                Focus.Frame("Throw", CFrame.lookAt(subject + Vector3.new(7, 2.4, -5.6), subject), 53, delta, 8)
                top.Text = if data.Perfect then "PERFEITO!" else "FORÇA " .. math.floor(data.Power * 100) .. "%"
                zone.Text = ""
            else
                local alpha = math.clamp((elapsed - Rules.WindupSeconds) / (data.Duration - Rules.WindupSeconds), 0, 1)
                local travel = 1 - (1 - alpha) ^ 1.4
                local arc = math.min(15, 7 + data.Distance * .013)
                local pos = release:Lerp(data.EndPos, travel) + Vector3.new(0, math.sin(alpha * math.pi) * arc, 0)
                trail.Enabled = true
                orb:PivotTo(CFrame.new(pos) * CFrame.Angles(alpha * 20, alpha * 8, alpha * 3))
                for index, extra in extras do
                    local side = if index == 1 then -1 else 1
                    extra:PivotTo(orb:GetPivot() + Vector3.new(side * 3.6, math.sin(elapsed * 6 + index) * .85, 2))
                end
                local traveled = math.clamp((pos - Rules.LaunchOrigin):Dot(Rules.Direction), 0, data.Distance)
                local biomeId, zoneIndex = Math.Zone(traveled, Layout.BiomeOrder, Rules.ZoneLength)
                if zoneIndex ~= previousZone then zoneTime = now; previousZone = zoneIndex end
                local pulse = math.max(0, 1 - (now - zoneTime) * 3)
                local acceleration = math.sin(alpha * math.pi)
                local offset = Vector3.new(if reduced then 0 else math.sin(alpha * math.pi) * 3.5, 4.8, 12 + acceleration * 6)
                local shot = CFrame.lookAt(pos + offset, pos + Vector3.new(0, 0, -10))
                Focus.Frame("Throw", shot, if reduced then 64 else 64 + acceleration * 13 + pulse * 4, delta, 16)
                top.Text = Numbers.Format(traveled) .. " STUDS"
                local rareBonus = Math.RareBoost(traveled, Rules.MaxDistance, data.Power, data.OrbRareBoost)
                zone.Text = Config.Biomes[biomeId].Name .. "  ·  RAROS ×" .. Numbers.Format(rareBonus)
            end
            if elapsed > data.Duration + 10 then error("Resultado do servidor não chegou") end
            delta = Run.RenderStepped:Wait()
        end
        if alive() and session and session.Result then
            folder:Destroy()
            top.Text, zone.Text = "", ""
            local entry = session
            local actions = if entry.Automatic then nil else {
                Ready = function() return entry.Ready == true and not entry.ChoicePending end,
                Submit = function(choice: string)
                    entry.ChoicePending = true
                    remotes.ChooseAfterThrow:FireServer(entry.Id, choice)
                end,
            }
            Reveal.Play(gui, entry.Result, alive, actions)
            if actions and alive() then error("A revelação foi interrompida antes da escolha") end
        end
    end)
    if not ok then
        warn("[FlightController]", problem)
        suppressUntilExit = true
        idle()
    end
end
(remotes:WaitForChild("FlightUpdate")::RemoteEvent).OnClientEvent:Connect(function(data:any)
 if typeof(data)~="table" then return end
 if data.State=="Charging" then
  if not atLine() or modal() or suppressUntilExit then
   remotes.CancelThrow:FireServer(data.Id)
   return
  end
  Focus.Begin("Throw")
  if data.Goal and data.NextBiome then
   goal.Text = "Até " .. Numbers.Format(data.Reach) .. " studs  ·  " .. Config.Biomes[data.NextBiome].Name .. " no Nv. " .. data.Goal.Level
  elseif data.Reach then
   goal.Text = "Até " .. Numbers.Format(data.Reach) .. " studs  ·  Pista completa"
  end
  session=data;panel.Visible=true;pointer.Visible=true;hint.Visible=false
  if not next(chargeHidden) then hideChargeHUD() end
  title.Text,button.Text="PARE NO CENTRO VERDE!","CLIQUE OU TOQUE  ·  R2"
 elseif data.State=="Blocked" then
  blockingMessage=data.Message or "CONFIRA SUA ORBE E A COLEÇÃO"
  goal.Text=""
  retryAt=os.clock()+1
 elseif data.State=="Flying" then
  session=data
  title.Text=string.format("FORÇA CONFIRMADA: %d%%",math.floor(data.Power*100))
  task.spawn(flight,data)
 elseif session and data.Id==session.Id then
  if data.State=="Landed" then
   session.State,session.Result,session.Automatic="Revealing",data.Result,data.Automatic
  elseif data.State=="Ready" and not session.Automatic then
   session.Ready = true
  elseif data.State=="ChoiceRejected" then
   session.ChoicePending = false
  elseif data.State=="ChoiceAccepted" or data.State=="Cancelled" or data.State=="Ready" then
   suppressUntilExit = data.Choice ~= "Retry" and atLine()
   idle()
  end
 end
end)
;(remotes:WaitForChild("ThrowWindup")::RemoteEvent).OnClientEvent:Connect(function(data:any)
 if typeof(data)=="table" and typeof(data.Thrower)=="Instance" and data.Thrower:IsA("Player") and data.Thrower.Character then
  Pose.Play(data.Thrower.Character,data.Power,data.StartedAt)
 end
end)
player.CharacterRemoving:Connect(idle)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="98">
        <Properties>
          <string name="Name">ClientTrainingController</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Workspace=game:GetService("Workspace")
local Debris=game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Numbers = require(RS.Shared.NumberFormatter)
local Focus = require(script.Parent:WaitForChild("CameraFocus"))
local player=Players.LocalPlayer
local remotes=RS:WaitForChild("Remotes")
local gui=Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn,gui.DisplayOrder,gui.Parent="AcademyHUD",false,75,player:WaitForChild("PlayerGui")
local card=Instance.new("Frame")
card.Name,card.AnchorPoint,card.Position,card.Size="TrainingCard",Vector2.new(.5,1),UDim2.new(.5,0,1,-20),UDim2.new(.92,0,0,163)
card.BackgroundColor3,card.Visible,card.Parent=Color3.fromRGB(45,43,71),false,gui
local max=Instance.new("UISizeConstraint")
max.MinSize,max.MaxSize,max.Parent=Vector2.new(0,163),Vector2.new(369,163),card
local round=Instance.new("UICorner");round.CornerRadius,round.Parent=UDim.new(0,14),card
local accent = Instance.new("UIStroke")
accent.Color, accent.Thickness, accent.Parent = Color3.fromRGB(255, 194, 103), 2, card
local function text(name:string,y:number,h:number,size:number):TextLabel
 local label=Instance.new("TextLabel")
 label.Name,label.Position,label.Size=name,UDim2.fromOffset(12,y),UDim2.new(1,-24,0,h)
 label.BackgroundTransparency,label.TextColor3,label.TextSize,label.Font=1,Color3.new(1,1,1),size,Enum.Font.GothamBold
 label.Parent=card;return label
end
local title=text("AcademyLevel",5,24,16)
local xp=text("AcademyXP",29,17,12)
local track=Instance.new("Frame")
track.Name,track.Position,track.Size,track.BackgroundColor3,track.Parent="XPTrack",UDim2.fromOffset(16,48),UDim2.new(1,-32,0,12),Color3.fromRGB(38,54,72),card
local fill=Instance.new("Frame")
fill.Name,fill.Size,fill.BackgroundColor3,fill.BorderSizePixel,fill.Parent="XPFill",UDim2.fromScale(0,1),Color3.fromRGB(70,220,255),0,track
local reps=text("RepInfo",69,19,12)
local reward = text("RepReward", 90, 20, 12)
local rewardLimit = Instance.new("UITextSizeConstraint")
rewardLimit.MinTextSize, rewardLimit.MaxTextSize, rewardLimit.Parent = 8, 12, reward
reward.TextScaled, reward.TextColor3 = true, Color3.fromRGB(133, 244, 175)
local cadence = Instance.new("Frame")
cadence.Name, cadence.Size, cadence.Position = "RepProgress", UDim2.new(1, -32, 0, 4), UDim2.fromOffset(16, 63)
cadence.BackgroundColor3, cadence.BorderSizePixel, cadence.Parent = Color3.fromRGB(73, 70, 102), 0, card
local progress = Instance.new("Frame")
progress.Size, progress.BackgroundColor3, progress.BorderSizePixel, progress.Parent = UDim2.fromScale(0, 1), Color3.fromRGB(255, 194, 103), 0, cadence
local nextRepAt, interval = 0, 1.8
local xpTween: Tween?

local stop=Instance.new("TextButton")
stop.Name,stop.Position,stop.Size="StopTraining",UDim2.new(.5,-90,1,-48),UDim2.fromOffset(180,42)
stop.Text,stop.TextSize,stop.TextColor3,stop.BackgroundColor3="PARAR TREINO",12,Color3.new(1,1,1),Color3.fromRGB(65,80,105)
stop.Parent=card
local stopCorner = Instance.new("UICorner")
stopCorner.CornerRadius, stopCorner.Parent = UDim.new(0, 11), stop
stop.Font = Enum.Font.GothamBold
stop.Activated:Connect(function()remotes.StopTraining:FireServer()end)
local qte=Instance.new("TextButton")
qte.Name,qte.AnchorPoint,qte.Size="DoubleTrainingQTE",Vector2.new(.5,.5),UDim2.fromOffset(90,90)
qte.Text,qte.TextSize,qte.Font="2×\nAGORA!\n[E / X]",19,Enum.Font.GothamBlack
qte.TextColor3,qte.BackgroundColor3,qte.Visible,qte.Selectable,qte.ZIndex=Color3.fromRGB(10,35,25),Color3.fromRGB(100,255,150),false,true,15
qte.Parent=gui
local corner,stroke=Instance.new("UICorner"),Instance.new("UIStroke")
corner.CornerRadius,corner.Parent=UDim.new(1,0),qte
stroke.Color,stroke.Thickness,stroke.Parent=Color3.new(1,1,1),4,qte
local hidden:{[ScreenGui]:boolean}={}
local current:any=nil
local active=false
local function show(value:boolean)
 if value==active then return end
 active=value;card.Visible=value
 if value then
  reward.Text = ""
  Focus.Begin("Academy")
  gui:SetAttribute("ModalOpen", true)
  for _,screen in player.PlayerGui:GetChildren() do if screen~=gui and screen:IsA("ScreenGui") then hidden[screen]=screen.Enabled;screen.Enabled=false end end
 else
  Focus.Release("Academy")
  gui:SetAttribute("ModalOpen", false)
  for screen,enabled in hidden do if screen.Parent then screen.Enabled=enabled end end
  hidden={};current=nil;qte.Visible=false
 end
end
local function hit()
 if not current then return end
 local id=current.Id;current=nil;qte.Visible=false
 remotes.TrainingQTE:FireServer(id)
end
qte.Activated:Connect(hit)
Input.InputBegan:Connect(function(input,processed)
 if not active or Input:GetFocusedTextBox() then return end
 if input.KeyCode==Enum.KeyCode.E or input.KeyCode==Enum.KeyCode.ButtonX then hit()
 elseif input.KeyCode==Enum.KeyCode.Escape or input.KeyCode==Enum.KeyCode.ButtonB then remotes.StopTraining:FireServer() end
end)
local function render(data:any)
 title.Text = (data.MachineName or "Academia") .. "  ·  Nv. " .. tostring(data.Level or 1)
 local maxed = data.Level >= data.MaxLevel
 xp.Text = if maxed then "Nível máximo" else Numbers.Format(data.XP) .. " / " .. Numbers.Format(data.RequiredXP) .. " XP"
 if xpTween then xpTween:Cancel() end
 local fillAmount = if maxed then 1 else math.clamp(data.XP / math.max(1, data.RequiredXP), 0, 1)
 xpTween = TweenService:Create(fill, TweenInfo.new(.18), {Size = UDim2.fromScale(fillAmount, 1)})
 xpTween:Play()
 nextRepAt, interval = data.NextRepAt or 0, data.Interval or 1.8
 reps.Text = "Força " .. Numbers.Format(data.Strength) .. "  ·  +" .. Numbers.Format(data.Gain) .. " força / rep  ·  +" .. Numbers.Format(data.XPPerRep) .. " XP / rep"
 if data.GainAwarded then
  local prefix = if data.LeveledUp then "NV. " .. data.Level .. "!  " elseif data.State == "Perfect" then "2×  " else ""
  reward.Text = prefix .. "+" .. data.GainAwarded .. " força  ·  +" .. data.XPAwarded .. " XP  ·  +" .. data.PlayerXPAwarded .. " XP jogador"
 end
end
(remotes:WaitForChild("TrainingUpdate")::RemoteEvent).OnClientEvent:Connect(function(data:any)
 if typeof(data)~="table" then return end
 show(data.Active==true)
 if not data.Active then return end
 render(data)
 if data.State=="QTE" then current=data;qte.Position=UDim2.fromScale(data.X,data.Y);qte.Visible=true
 elseif data.State=="Perfect" then
  current=nil;qte.Visible=false
  local sound=Instance.new("Sound")
  sound.SoundId,sound.Volume,sound.PlaybackSpeed,sound.Parent="rbxasset://sounds/volume_slider.ogg",.15,1.5,game:GetService("SoundService")
  sound:Play();Debris:AddItem(sound,3)
 elseif data.State=="Missed" then current=nil;qte.Visible=false end
end)
Run.RenderStepped:Connect(function(delta)
 if active then
  local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if root and root:IsA("BasePart") then
   local target = root.Position + Vector3.new(0, 1.1, 0)
   local position = target + root.CFrame.RightVector * 9 + root.CFrame.LookVector * 9 + Vector3.new(0, 2.3, 0)
   Focus.Frame("Academy", CFrame.lookAt(position, target), 56, delta, 8)
  end
 end
 if active and nextRepAt > 0 then
  local fraction = 1 - math.clamp((nextRepAt - Workspace:GetServerTimeNow()) / interval, 0, 1)
  progress.Size = UDim2.fromScale(fraction, 1)
 end
 if current then
  local remaining=current.ExpiresAt-Workspace:GetServerTimeNow()
  if remaining<=0 then current=nil;qte.Visible=false;return end
  stroke.Transparency=math.clamp(1-remaining/2,0,.9)
 end
end)
local animations:{[Player]:any}={}
local function stopPose(who:Player)
 local entry=animations[who];if not entry then return end
 entry.Connection:Disconnect()
 for _,item in entry.Joints do if item.Joint.Parent then pcall(function()item.Joint.Transform=item.Original end)end end
 animations[who]=nil
end
(remotes:WaitForChild("TrainingPose")::RemoteEvent).OnClientEvent:Connect(function(data:any)
 if typeof(data)~="table" or typeof(data.Player)~="Instance" or not data.Player:IsA("Player") then return end
 local who=data.Player
 stopPose(who)
 if not data.Active or not who.Character then return end
 local character=who.Character
 local joints={}
 for _,joint in character:GetDescendants() do
  local name=joint.Name:gsub(" ",""):lower()
  if (joint:IsA("Motor6D") or joint.ClassName=="AnimationConstraint") and (name=="rightshoulder" or name=="leftshoulder" or name=="waist" or name=="rootjoint" or name=="root" or name=="rightelbow" or name=="leftelbow") then
   local ok,value=pcall(function()return (joint::any).Transform end)
   if ok and typeof(value)=="CFrame" then table.insert(joints,{Joint=joint,Name=name,Original=value})end
  end
 end
 local connection
 connection=Run.PreSimulation:Connect(function()
  if not character.Parent or who.Character~=character then stopPose(who);return end
  local phase=(Workspace:GetServerTimeNow()-data.StartedAt)/data.Interval*math.pi*2
  local lift=(1-math.cos(phase))*.5
  for _,item in joints do
   local value
   if item.Name=="rightshoulder" then value=CFrame.Angles(-2.5+lift*.7,0,.15)
   elseif item.Name=="leftshoulder" then value=CFrame.Angles(-2.5+lift*.7,0,-.15)
   elseif item.Name=="rightelbow" or item.Name=="leftelbow" then value=CFrame.Angles(-lift*.9,0,0)
   elseif item.Name=="waist" then value=CFrame.Angles(-lift*.11,0,0)
   else value=CFrame.new(0,lift*.72,0)*CFrame.Angles(-lift*.05,0,0)end
   if item.Joint.Parent then pcall(function()item.Joint.Transform=item.Original*value end)end
  end
 end)
 animations[who]={Joints=joints,Connection=connection}
end)
player.CharacterRemoving:Connect(function()show(false);stopPose(player)end)
Players.PlayerRemoving:Connect(stopPose)
]]></string>
        </Properties>
